// SatelliteQ
requires("1.53");

SATELLITEQ_VERSION = "V1.0.0";


function pad3(n) {
    if (n < 10) return "00" + n;
    if (n < 100) return "0" + n;
    return "" + n;
}

function cleanSQName(name) {
    name = replace(name, ".tif", "");
    name = replace(name, ".tiff", "");
    name = replace(name, ".TIF", "");
    name = replace(name, ".TIFF", "");
    name = replace(name, ".lif", "");
    name = replace(name, ".LIF", "");
    name = replace(name, ".czi", "");
    name = replace(name, ".CZI", "");
    name = replace(name, " ", "_");
    name = replace(name, "-", "_");
    name = replace(name, ".", "_");
    name = replace(name, "(", "_");
    name = replace(name, ")", "_");
    name = replace(name, "[", "_");
    name = replace(name, "]", "_");
    name = replace(name, ":", "_");
    name = replace(name, "/", "_");
    name = replace(name, "\\", "_");
    return name;
}

function normalizeDirPath(path) {
    path = replace(path, "\\", "/");
    path = replace(path, "\n", "");
    path = replace(path, "\r", "");
    if (!endsWith(path, "/")) path = path + "/";
    return path;
}

function findColumnIndex(headerLine, colName) {
    cols = split(headerLine, ",");
    for (ii = 0; ii < cols.length; ii++) {
        if (cols[ii] == colName) return ii;
    }
    return -1;
}

function getFieldSafe(line, idx) {
    parts = split(line, ",");
    if (idx < 0) return "";
    if (idx >= parts.length) return "";
    return parts[idx];
}

function summarize2DCSV(csvPath, frameNumber, timeMin) {
    txt = File.openAsString(csvPath);
    lines = split(txt, "\n");
    if (lines.length < 2) return "" + frameNumber + "," + timeMin + ",0,0,NaN,NaN,NaN";
    header = lines[0];
    areaCol = findColumnIndex(header, "Satellite_Area_um2");
    if (areaCol < 0) areaCol = findColumnIndex(header, "Area");
    intCol = findColumnIndex(header, "Integrated_Intensity_AU");
    if (intCol < 0) intCol = findColumnIndex(header, "Integrated_Intensity");
    distCol = findColumnIndex(header, "Distance_to_Nearest_Centrosome_um");
    if (distCol < 0) distCol = findColumnIndex(header, "Nearest_Centrosome_Distance");
    cellCol = findColumnIndex(header, "Cell_ID");
    count = 0; assigned = 0; areaSum = 0; intSum = 0; distSum = 0; distCount = 0;
    for (li = 1; li < lines.length; li++) {
        line = lines[li];
        if (startsWith(line, "Satellite,")) {
            count++;
            a = parseFloat(getFieldSafe(line, areaCol)); if (!isNaN(a)) areaSum += a;
            inten = parseFloat(getFieldSafe(line, intCol)); if (!isNaN(inten)) intSum += inten;
            d = parseFloat(getFieldSafe(line, distCol)); if (!isNaN(d)) { distSum += d; distCount++; }
            cellVal = getFieldSafe(line, cellCol); if (cellVal != "" && cellVal != "NaN" && cellVal != "nan") assigned++;
        }
    }
    meanArea = "NaN"; meanDist = "NaN";
    if (count > 0) meanArea = d2s(areaSum / count, 6);
    if (distCount > 0) meanDist = d2s(distSum / distCount, 6);
    return "" + frameNumber + "," + timeMin + "," + count + "," + assigned + "," + meanArea + "," + d2s(intSum, 6) + "," + meanDist;
}

function summarize3DCSV(csvPath, frameNumber, timeMin) {
    txt = File.openAsString(csvPath);
    lines = split(txt, "\n");
    if (lines.length < 2) return "" + frameNumber + "," + timeMin + ",0,0,NaN,NaN,NaN";
    header = lines[0];
    volCol = findColumnIndex(header, "Volume_um3");
    if (volCol < 0) volCol = findColumnIndex(header, "Volume (micron^3)");
    if (volCol < 0) volCol = findColumnIndex(header, "Volume");
    surfCol = findColumnIndex(header, "Surface_um2");
    if (surfCol < 0) surfCol = findColumnIndex(header, "Surface (micron^2)");
    if (surfCol < 0) surfCol = findColumnIndex(header, "Surface");
    distCol = findColumnIndex(header, "Distance_to_nearest_centrosome_3D_um");
    if (distCol < 0) distCol = findColumnIndex(header, "Distance_to_nearest_centrosome_3D");
    assignDistCol = findColumnIndex(header, "Distance_to_Assigned_Centrosome_3D_um");
    if (assignDistCol < 0) assignDistCol = findColumnIndex(header, "Distance_to_Assigned_Centrosome_3D");
    cellCol = findColumnIndex(header, "Cell_ID");
    count = 0; assigned = 0; volSum = 0; surfSum = 0; distSum = 0; distCount = 0;
    for (li = 1; li < lines.length; li++) {
        line = lines[li];
        if (lengthOf(line) > 2) {
            count++;
            v = parseFloat(getFieldSafe(line, volCol)); if (!isNaN(v)) volSum += v;
            s = parseFloat(getFieldSafe(line, surfCol)); if (!isNaN(s)) surfSum += s;
            d = parseFloat(getFieldSafe(line, assignDistCol)); if (isNaN(d)) d = parseFloat(getFieldSafe(line, distCol));
            if (!isNaN(d)) { distSum += d; distCount++; }
            cellVal = getFieldSafe(line, cellCol); if (cellVal != "" && cellVal != "NaN" && cellVal != "nan") assigned++;
        }
    }
    meanVol = "NaN"; meanDist = "NaN";
    if (count > 0) meanVol = d2s(volSum / count, 6);
    if (distCount > 0) meanDist = d2s(distSum / distCount, 6);
    return "" + frameNumber + "," + timeMin + "," + count + "," + assigned + "," + meanVol + "," + d2s(surfSum, 6) + "," + meanDist;
}

function append2DFrameRows(csvPath, frameNumber, timeMin, combinedPath, headerWritten) {
    txt = File.openAsString(csvPath);
    lines = split(txt, "\n");
    if (lines.length < 1) return headerWritten;
    header = lines[0];
    if (!headerWritten) {
        File.append("Frame,Time_min," + header + "\n", combinedPath);
        headerWritten = true;
    }
    for (li = 1; li < lines.length; li++) {
        line = lines[li];
        if (startsWith(line, "Satellite,")) File.append("" + frameNumber + "," + timeMin + "," + line + "\n", combinedPath);
    }
    return headerWritten;
}

function append3DFrameRows(csvPath, frameNumber, timeMin, combinedPath, headerWritten) {
    txt = File.openAsString(csvPath);
    lines = split(txt, "\n");
    if (lines.length < 1) return headerWritten;
    header = lines[0];
    if (!headerWritten) {
        File.append("Frame,Time_min," + header + "\n", combinedPath);
        headerWritten = true;
    }
    for (li = 1; li < lines.length; li++) {
        line = lines[li];
        if (lengthOf(line) > 2) File.append("" + frameNumber + "," + timeMin + "," + line + "\n", combinedPath);
    }
    return headerWritten;
}

if (nImages == 0) exit("Please open an image first, then run SatelliteQ.");
launcherOriginalTitle = getTitle();
originalTitle = launcherOriginalTitle;

newImage("SatelliteQ Welcome", "RGB white", 760, 560, 1);
setForegroundColor(235, 225, 255);
makeRectangle(0, 0, 760, 560);
run("Fill");

setForegroundColor(110, 70, 160);
setFont("SansSerif", 34, "bold");
drawString("SatelliteQ", 40, 65);

setFont("SansSerif", 18, "bold");
drawString("Centriolar satellite quantification workflow", 40, 105);

setForegroundColor(45, 45, 55);
setFont("SansSerif", 15, "plain");
drawString("SatelliteQ helps quantify centriolar satellite properties from microscopy images.", 40, 145);
drawString("It can analyze 2D projections, 3D stacks, and time-lapse datasets.", 40, 175);

setForegroundColor(110, 70, 160);
setFont("SansSerif", 14, "bold");
drawString("Main outputs include:", 40, 220);

setForegroundColor(45, 45, 55);
setFont("SansSerif", 14, "plain");
drawString("- Satellite number, size, intensity, and cell assignment", 65, 250);
drawString("- Satellite-to-centrosome distance when centrosomes are provided", 65, 275);
drawString("- Excel/CSV result tables and interactive graph exploration", 65, 300);

setForegroundColor(110, 70, 160);
setFont("SansSerif", 14, "bold");
drawString("Workflow:", 40, 375);

setForegroundColor(45, 45, 55);
setFont("SansSerif", 14, "plain");
drawString("1. Choose analysis mode", 65, 405);
drawString("2. Set channels and segmentation options", 65, 430);
drawString("3. Review detected objects and cell ROIs", 65, 455);
drawString("4. Export Excel/CSV files and open graphs", 65, 480);

setForegroundColor(110, 70, 160);
setFont("SansSerif", 13, "plain");
drawString("Close this welcome window whenever you want. The analysis menu will open after you click OK.", 40, 525);

waitForUser("SatelliteQ", "Welcome to SatelliteQ.\n\nThis purple window is only an information card.\nClick OK to choose the analysis mode.");

if (isOpen("SatelliteQ Welcome")) {
    selectWindow("SatelliteQ Welcome");
    setOption("Changes", false);
    close();
}
if (isOpen(launcherOriginalTitle)) selectWindow(launcherOriginalTitle);

Dialog.create("SatelliteQ / SatelliteQuantify");
Dialog.addMessage("Choose analysis mode");
Dialog.addMessage("Select the type of image you want to analyze.");
Dialog.addMessage("Time-lapse modes now process the full selected frame range automatically using the confirmed 2D or 3D settings.");

mode2Dsingle = "2D single image  - projected 2D analysis for one image/field";
mode3Dsingle = "3D single stack  - true 3D object volume/surface/distance analysis";
mode2DTL     = "2D time-lapse  - repeat 2D analysis over multiple frames";
mode3DTL     = "3D time-lapse  - repeat 3D analysis over multiple frames";
Dialog.addMessage("Satellite quantification modes:");
Dialog.addRadioButtonGroup(
    "Analysis mode:",
    newArray(mode2Dsingle, mode3Dsingle, mode2DTL, mode3DTL),
    5,
    1,
    mode2Dsingle
);

Dialog.show();

analysisModeSelection = Dialog.getRadioButton();

if (analysisModeSelection == mode2Dsingle) analysisMode = "2D single image";
else if (analysisModeSelection == mode3Dsingle) analysisMode = "3D single stack";
else if (analysisModeSelection == mode2DTL) analysisMode = "2D time-lapse";
else if (analysisModeSelection == mode3DTL) analysisMode = "3D time-lapse";
else analysisMode = "2D single image";

tempDir = getDirectory("temp");
if (tempDir == "") tempDir = getDirectory("home");
tempDir = normalizeDirPath(tempDir);

if (analysisMode == "2D single image") {
macro2Dsingle = "";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "requires(\"1.53\");\n";
macro2Dsingle = macro2Dsingle + "sqVersion = \"" + SATELLITEQ_VERSION + "\";\n";
macro2Dsingle = macro2Dsingle + "function safeSelectionContains(px, py) {\n";
macro2Dsingle = macro2Dsingle + "    if (selectionType() == -1) return false;\n";
macro2Dsingle = macro2Dsingle + "    return selectionContains(px, py);\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "function cleanFileName(name) {\n";
macro2Dsingle = macro2Dsingle + "    name = replace(name, \".tif\", \"\");\n";
macro2Dsingle = macro2Dsingle + "    name = replace(name, \".tiff\", \"\");\n";
macro2Dsingle = macro2Dsingle + "    name = replace(name, \".TIF\", \"\");\n";
macro2Dsingle = macro2Dsingle + "    name = replace(name, \".TIFF\", \"\");\n";
macro2Dsingle = macro2Dsingle + "    name = replace(name, \" \", \"_\");\n";
macro2Dsingle = macro2Dsingle + "    name = replace(name, \"-\", \"_\");\n";
macro2Dsingle = macro2Dsingle + "    name = replace(name, \".\", \"_\");\n";
macro2Dsingle = macro2Dsingle + "    name = replace(name, \"(\", \"_\");\n";
macro2Dsingle = macro2Dsingle + "    name = replace(name, \")\", \"_\");\n";
macro2Dsingle = macro2Dsingle + "    name = replace(name, \"[\", \"_\");\n";
macro2Dsingle = macro2Dsingle + "    name = replace(name, \"]\", \"_\");\n";
macro2Dsingle = macro2Dsingle + "    return name;\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "function projectChannel(channelNumber, originalTitle, projectionMethod, newName, slices) {\n";
macro2Dsingle = macro2Dsingle + "    channelTitle = \"C\" + channelNumber + \"-\" + originalTitle;\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(newName)) { selectWindow(newName); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    sourceTitle = channelTitle;\n";
macro2Dsingle = macro2Dsingle + "    if (!isOpen(sourceTitle) && channelNumber == 1 && isOpen(originalTitle)) sourceTitle = originalTitle;\n";
macro2Dsingle = macro2Dsingle + "    if (!isOpen(sourceTitle)) {\n";
macro2Dsingle = macro2Dsingle + "        exit(\"Could not find channel source for channel \" + channelNumber + \".\\n\\nIf this is a single-channel image, SatelliteQ expects channel 1.\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(sourceTitle);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Select None\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (slices > 1) {\n";
macro2Dsingle = macro2Dsingle + "        run(\"Z Project...\", \"projection=[\" + projectionMethod + \"]\");\n";
macro2Dsingle = macro2Dsingle + "        rename(newName);\n";
macro2Dsingle = macro2Dsingle + "    } else {\n";
macro2Dsingle = macro2Dsingle + "        run(\"Duplicate...\", \"title=\" + newName);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    return newName;\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "function prepareCellROIDrawingView(cellProjection, displayMode) {\n";
macro2Dsingle = macro2Dsingle + "    viewTitle = cellProjection;\n";
macro2Dsingle = macro2Dsingle + "    if (displayMode == \"Cell signal channel + cell boundary only\") { selectWindow(viewTitle); return viewTitle; }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Cell_ROI_Drawing_View\")) { selectWindow(\"Cell_ROI_Drawing_View\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_CellROI_Boundary_Tmp\")) { selectWindow(\"SQ_CellROI_Boundary_Tmp\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_CellROI_Sat_Tmp\")) { selectWindow(\"SQ_CellROI_Sat_Tmp\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_CellROI_Cent_Tmp\")) { selectWindow(\"SQ_CellROI_Cent_Tmp\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Cell_ROI_Centrosome_Projection\")) { selectWindow(\"Cell_ROI_Centrosome_Projection\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(cellProjection); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CellROI_Boundary_Tmp\"); selectWindow(\"SQ_CellROI_Boundary_Tmp\"); run(\"8-bit\");\n";
macro2Dsingle = macro2Dsingle + "    if (displayMode == \"Cell signal channel + cell boundary + satellite\" || displayMode == \"Cell signal channel + cell boundary + centrosome + satellite\" || displayMode == \"Cell signal channel + cell boundary + centrosome + centrosome numbers + satellite\") { selectWindow(\"Satellite_Projection\"); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CellROI_Sat_Tmp\"); selectWindow(\"SQ_CellROI_Sat_Tmp\"); run(\"8-bit\"); } else { selectWindow(cellProjection); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CellROI_Sat_Tmp\"); selectWindow(\"SQ_CellROI_Sat_Tmp\"); run(\"8-bit\"); run(\"Multiply...\", \"value=0\"); }\n";
macro2Dsingle = macro2Dsingle + "    if ((displayMode == \"Cell signal channel + cell boundary + centrosome\" || displayMode == \"Cell signal channel + cell boundary + centrosome + satellite\" || displayMode == \"Cell signal channel + cell boundary + centrosome + centrosome numbers + satellite\") && centrosomeChannel > 0) { centProjectionForCellROI = projectChannel(centrosomeChannel, originalTitle, projectionMethod, \"Cell_ROI_Centrosome_Projection\", slices); selectWindow(centProjectionForCellROI); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CellROI_Cent_Tmp\"); selectWindow(\"SQ_CellROI_Cent_Tmp\"); run(\"8-bit\"); } else { selectWindow(cellProjection); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CellROI_Cent_Tmp\"); selectWindow(\"SQ_CellROI_Cent_Tmp\"); run(\"8-bit\"); run(\"Multiply...\", \"value=0\"); }\n";
macro2Dsingle = macro2Dsingle + "    run(\"Merge Channels...\", \"c1=[SQ_CellROI_Sat_Tmp] c2=[SQ_CellROI_Boundary_Tmp] c3=[SQ_CellROI_Cent_Tmp] create keep\"); rename(\"Cell_ROI_Drawing_View\"); run(\"Make Composite\", \"display=Composite\"); viewTitle = \"Cell_ROI_Drawing_View\";\n";
macro2Dsingle = macro2Dsingle + "    if (displayMode == \"Cell signal channel + cell boundary + centrosome + centrosome numbers + satellite\" && centrosomeCount > 0) { selectWindow(viewTitle); setFont(\"SansSerif\", 10, \"bold\"); setColor(\"yellow\"); for (cc = 0; cc < centrosomeCount; cc++) drawString(\"C\" + (cc + 1), centXpix[cc] + 4, centYpix[cc] - 4); }\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(viewTitle); return viewTitle;\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "function prepareCentrosomeDrawingView(displayMode) {\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Centrosome_ROI_Drawing_View\")) { selectWindow(\"Centrosome_ROI_Drawing_View\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_CentROI_Sat_Tmp\")) { selectWindow(\"SQ_CentROI_Sat_Tmp\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_CentROI_Cent_Tmp\")) { selectWindow(\"SQ_CentROI_Cent_Tmp\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    viewTitle = \"Centrosome_BackgroundSubtracted\";\n";
macro2Dsingle = macro2Dsingle + "    if (displayMode == \"Centrosome channel only\") { selectWindow(viewTitle); return viewTitle; }\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Centrosome_BackgroundSubtracted\"); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CentROI_Cent_Tmp\"); selectWindow(\"SQ_CentROI_Cent_Tmp\"); run(\"8-bit\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Satellite_Projection\"); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CentROI_Sat_Tmp\"); selectWindow(\"SQ_CentROI_Sat_Tmp\"); run(\"8-bit\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Merge Channels...\", \"c1=[SQ_CentROI_Cent_Tmp] c2=[SQ_CentROI_Sat_Tmp] create keep\"); rename(\"Centrosome_ROI_Drawing_View\"); run(\"Make Composite\", \"display=Composite\"); viewTitle = \"Centrosome_ROI_Drawing_View\";\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(viewTitle); return viewTitle;\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "// SatelliteQ primary-cilium length helper.\n";
macro2Dsingle = macro2Dsingle + "// Length follows the CiliaQ approach: 3x upscaling, Gaussian smoothing,\n";
macro2Dsingle = macro2Dsingle + "// Skeletonize (2D/3D), and the longest-shortest-path measurement from AnalyzeSkeleton.\n";
macro2Dsingle = macro2Dsingle + "function sqCiliumSkeletonSerialized(maskTitle, is3D, pw, ph, pz, lengthUnit, gaussianSigmaOriginalPixels) {\n";
macro2Dsingle = macro2Dsingle + "    if (!isOpen(maskTitle)) return \"\";\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_Cilium_SkeletonWork\")) { selectWindow(\"SQ_Cilium_SkeletonWork\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_Cilium_Scaled\")) { selectWindow(\"SQ_Cilium_Scaled\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(maskTitle);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Duplicate...\", \"title=SQ_Cilium_SkeletonWork duplicate\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"SQ_Cilium_SkeletonWork\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"8-bit\");\n";
macro2Dsingle = macro2Dsingle + "    setThreshold(1, 255);\n";
macro2Dsingle = macro2Dsingle + "    setOption(\"BlackBackground\", true);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Convert to Mask\", \"method=Default background=Dark black stack\");\n";
macro2Dsingle = macro2Dsingle + "    if (is3D) run(\"Scale...\", \"x=3 y=3 z=3 interpolation=None create\");\n";
macro2Dsingle = macro2Dsingle + "    else run(\"Scale...\", \"x=3 y=3 interpolation=None create\");\n";
macro2Dsingle = macro2Dsingle + "    rename(\"SQ_Cilium_Scaled\");\n";
macro2Dsingle = macro2Dsingle + "    if (is3D) setVoxelSize(pw / 3, ph / 3, pz / 3, lengthUnit);\n";
macro2Dsingle = macro2Dsingle + "    else setVoxelSize(pw / 3, ph / 3, 1, lengthUnit);\n";
macro2Dsingle = macro2Dsingle + "    sigmaScaled = gaussianSigmaOriginalPixels * 3;\n";
macro2Dsingle = macro2Dsingle + "    if (sigmaScaled > 0) run(\"Gaussian Blur...\", \"sigma=\" + sigmaScaled + \" stack\");\n";
macro2Dsingle = macro2Dsingle + "    setThreshold(128, 255);\n";
macro2Dsingle = macro2Dsingle + "    setOption(\"BlackBackground\", true);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Convert to Mask\", \"method=Default background=Dark black stack\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Skeletonize (2D/3D)\");\n";
macro2Dsingle = macro2Dsingle + "    cjs = \"var IJ=Packages.ij.IJ; var AS=Packages.sc.fiji.analyzeSkeleton.AnalyzeSkeleton_; var imp=IJ.getImage(); var sk=new AS(); sk.setup('',imp); var res=sk.run(AS.NONE,false,true,null,true,false); var lens=res.getShortestPathList(); var paths=sk.getShortestPathPoints(); var starts=res.getSpStartPosition(); var cal=imp.getCalibration(); var out=''; for(var i=0;i<lens.size();i++){var pp=paths[i]; var sx=0,sy=0,sz=0,ps=''; if(pp!=null && pp.size()>0){for(var j=0;j<pp.size();j++){var p=pp.get(j); var xx=p.x*cal.pixelWidth; var yy=p.y*cal.pixelHeight; var zz=p.z*cal.pixelDepth; sx+=xx; sy+=yy; sz+=zz; if(j>0)ps+=';'; ps+=xx+':'+yy+':'+zz;} sx/=pp.size(); sy/=pp.size(); sz/=pp.size();}else{sx=starts[i][0]; sy=starts[i][1]; sz=starts[i][2];} if(i>0)out+='#'; out+=(i+1)+'~'+Number(lens.get(i))+'~'+sx+'~'+sy+'~'+sz+'~'+ps;} out;\";\n";
macro2Dsingle = macro2Dsingle + "    serialized = eval(\"script\", cjs);\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_Cilium_Scaled\")) { selectWindow(\"SQ_Cilium_Scaled\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_Cilium_SkeletonWork\")) { selectWindow(\"SQ_Cilium_SkeletonWork\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    return serialized;\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "function thresholdToMask(imageTitle, maskTitle, thresholdMode, autoMethod, manualValue, hysteresisMultiplier, doWatershed) {\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(imageTitle);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Duplicate...\", \"title=\" + maskTitle);\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(maskTitle);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (thresholdMode == \"Auto\" || thresholdMode == \"Hysteresis-like\") {\n";
macro2Dsingle = macro2Dsingle + "        setAutoThreshold(autoMethod + \" dark\");\n";
macro2Dsingle = macro2Dsingle + "    } else {\n";
macro2Dsingle = macro2Dsingle + "        setThreshold(manualValue, 65535);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    setOption(\"BlackBackground\", false);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Convert to Mask\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (doWatershed) {\n";
macro2Dsingle = macro2Dsingle + "        run(\"Watershed\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";

macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "function cellThresholdToMask(imageTitle, maskTitle, thresholdMode, globalMethod, localMethod, localRadius, manualValue) {\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(imageTitle);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Duplicate...\", \"title=\" + maskTitle);\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(maskTitle);\n";
macro2Dsingle = macro2Dsingle + "    if (localRadius < 1) localRadius = 15;\n";
macro2Dsingle = macro2Dsingle + "    if (thresholdMode == \"Manual threshold\") {\n";
macro2Dsingle = macro2Dsingle + "        setThreshold(manualValue, 65535);\n";
macro2Dsingle = macro2Dsingle + "        setOption(\"BlackBackground\", false);\n";
macro2Dsingle = macro2Dsingle + "        run(\"Convert to Mask\");\n";
macro2Dsingle = macro2Dsingle + "    } else if (thresholdMode == \"Local auto threshold\") {\n";
macro2Dsingle = macro2Dsingle + "        run(\"8-bit\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Auto Local Threshold\", \"method=\" + localMethod + \" radius=\" + localRadius + \" parameter_1=0 parameter_2=0 white\");\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(maskTitle);\n";
macro2Dsingle = macro2Dsingle + "        run(\"8-bit\");\n";
macro2Dsingle = macro2Dsingle + "        setThreshold(1, 255);\n";
macro2Dsingle = macro2Dsingle + "        setOption(\"BlackBackground\", false);\n";
macro2Dsingle = macro2Dsingle + "        run(\"Convert to Mask\");\n";
macro2Dsingle = macro2Dsingle + "    } else {\n";
macro2Dsingle = macro2Dsingle + "        setAutoThreshold(globalMethod + \" dark\");\n";
macro2Dsingle = macro2Dsingle + "        setOption(\"BlackBackground\", false);\n";
macro2Dsingle = macro2Dsingle + "        run(\"Convert to Mask\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(maskTitle);\n";
macro2Dsingle = macro2Dsingle + "    run(\"8-bit\");\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "function splitSatelliteMaskByLocalPeaks(intensityTitle, maskTitle, outTitle, prominence) {\n";
macro2Dsingle = macro2Dsingle + "    if (prominence <= 0) prominence = 20;\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatPeak_Source\")) { selectWindow(\"SQ_SatPeak_Source\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatPeak_Segmented\")) { selectWindow(\"SQ_SatPeak_Segmented\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(outTitle)) { selectWindow(outTitle); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(intensityTitle);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Duplicate...\", \"title=SQ_SatPeak_Source\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"SQ_SatPeak_Source\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Gaussian Blur...\", \"sigma=0.7\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Find Maxima...\", \"prominence=\" + prominence + \" output=[Segmented Particles] exclude\");\n";
macro2Dsingle = macro2Dsingle + "    rename(\"SQ_SatPeak_Segmented\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    imageCalculator(\"AND create\", \"SQ_SatPeak_Segmented\", maskTitle);\n";
macro2Dsingle = macro2Dsingle + "    rename(outTitle);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatPeak_Source\")) { selectWindow(\"SQ_SatPeak_Source\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatPeak_Segmented\")) { selectWindow(\"SQ_SatPeak_Segmented\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(outTitle);\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "function countMaskObjectsLargerThan(maskTitle, minArea) {\n";
macro2Dsingle = macro2Dsingle + "    if (!isOpen(maskTitle)) return 0;\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Set Measurements...\", \"area centroid redirect=None decimal=3\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(maskTitle);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Analyze Particles...\", \"size=\" + minArea + \"-Infinity show=Nothing clear add\");\n";
macro2Dsingle = macro2Dsingle + "    nLargeTmp = roiManager(\"count\");\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "    return nLargeTmp;\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "function splitLargeMaskToPeakSpotMask(intensityTitle, largeMaskTitle, outTitle, prominence, spotRadiusPix) {\n";
macro2Dsingle = macro2Dsingle + "    if (spotRadiusPix < 1) spotRadiusPix = 1;\n";
macro2Dsingle = macro2Dsingle + "    if (prominence < 1) prominence = 1;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatPeakOnlyIntensity\")) { selectWindow(\"SQ_SatPeakOnlyIntensity\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatPeakOnlyIntensityMasked\")) { selectWindow(\"SQ_SatPeakOnlyIntensityMasked\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatPeakSpotsRaw\")) { selectWindow(\"SQ_SatPeakSpotsRaw\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatPeakSpotsRestricted\")) { selectWindow(\"SQ_SatPeakSpotsRestricted\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(outTitle)) { selectWindow(outTitle); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(intensityTitle);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Duplicate...\", \"title=SQ_SatPeakOnlyIntensity\");\n";
macro2Dsingle = macro2Dsingle + "    imageCalculator(\"Multiply create 32-bit\", \"SQ_SatPeakOnlyIntensity\", largeMaskTitle);\n";
macro2Dsingle = macro2Dsingle + "    rename(\"SQ_SatPeakOnlyIntensityMasked\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    tryProm = prominence;\n";
macro2Dsingle = macro2Dsingle + "    peakCount = 0;\n";
macro2Dsingle = macro2Dsingle + "    attempt = 0;\n";
macro2Dsingle = macro2Dsingle + "    while (attempt < 4 && peakCount < 2) {\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"SQ_SatPeakOnlyIntensityMasked\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Find Maxima...\", \"prominence=\" + tryProm + \" output=List exclude\");\n";
macro2Dsingle = macro2Dsingle + "        peakCount = nResults;\n";
macro2Dsingle = macro2Dsingle + "        if (peakCount < 2) {\n";
macro2Dsingle = macro2Dsingle + "            tryProm = tryProm / 2;\n";
macro2Dsingle = macro2Dsingle + "            if (tryProm < 1) tryProm = 1;\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "        attempt = attempt + 1;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(largeMaskTitle);\n";
macro2Dsingle = macro2Dsingle + "    getDimensions(pkW, pkH, pkC, pkZ, pkT);\n";
macro2Dsingle = macro2Dsingle + "    newImage(\"SQ_SatPeakSpotsRaw\", \"8-bit black\", pkW, pkH, 1);\n";
macro2Dsingle = macro2Dsingle + "    setForegroundColor(255, 255, 255);\n";
macro2Dsingle = macro2Dsingle + "    setBackgroundColor(0, 0, 0);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (peakCount > 0) {\n";
macro2Dsingle = macro2Dsingle + "        for (pk = 0; pk < peakCount; pk++) {\n";
macro2Dsingle = macro2Dsingle + "            xpk = getResult(\"X\", pk);\n";
macro2Dsingle = macro2Dsingle + "            ypk = getResult(\"Y\", pk);\n";
macro2Dsingle = macro2Dsingle + "            selectWindow(\"SQ_SatPeakSpotsRaw\");\n";
macro2Dsingle = macro2Dsingle + "            makeOval(xpk - spotRadiusPix, ypk - spotRadiusPix, spotRadiusPix * 2 + 1, spotRadiusPix * 2 + 1);\n";
macro2Dsingle = macro2Dsingle + "            run(\"Fill\", \"slice\");\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "        imageCalculator(\"AND create\", \"SQ_SatPeakSpotsRaw\", largeMaskTitle);\n";
macro2Dsingle = macro2Dsingle + "        rename(\"SQ_SatPeakSpotsRestricted\");\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"SQ_SatPeakSpotsRestricted\");\n";
macro2Dsingle = macro2Dsingle + "        getRawStatistics(pkNPix, pkMean, pkMin, pkMax, pkStd);\n";
macro2Dsingle = macro2Dsingle + "        if (pkMax > 0) {\n";
macro2Dsingle = macro2Dsingle + "            rename(outTitle);\n";
macro2Dsingle = macro2Dsingle + "        } else {\n";
macro2Dsingle = macro2Dsingle + "            if (isOpen(\"SQ_SatPeakSpotsRestricted\")) { selectWindow(\"SQ_SatPeakSpotsRestricted\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "            selectWindow(largeMaskTitle);\n";
macro2Dsingle = macro2Dsingle + "            run(\"Duplicate...\", \"title=\" + outTitle);\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    } else {\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(largeMaskTitle);\n";
macro2Dsingle = macro2Dsingle + "        run(\"Duplicate...\", \"title=\" + outTitle);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatPeakOnlyIntensity\")) { selectWindow(\"SQ_SatPeakOnlyIntensity\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatPeakOnlyIntensityMasked\")) { selectWindow(\"SQ_SatPeakOnlyIntensityMasked\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatPeakSpotsRaw\")) { selectWindow(\"SQ_SatPeakSpotsRaw\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatPeakSpotsRestricted\")) { selectWindow(\"SQ_SatPeakSpotsRestricted\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(outTitle);\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "function splitLargeObjectsWithOriginalPeakSplitter(intensityTitle, originalMaskTitle, largeMaskTitle, outTitle, prominence) {\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatFullPeakSplit_ForLarge\")) { selectWindow(\"SQ_SatFullPeakSplit_ForLarge\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatLargeSplitOnly_FromFull\")) { selectWindow(\"SQ_SatLargeSplitOnly_FromFull\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(outTitle)) { selectWindow(outTitle); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    splitSatelliteMaskByLocalPeaks(intensityTitle, originalMaskTitle, \"SQ_SatFullPeakSplit_ForLarge\", prominence);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (!isOpen(\"SQ_SatFullPeakSplit_ForLarge\")) {\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(largeMaskTitle);\n";
macro2Dsingle = macro2Dsingle + "        run(\"Duplicate...\", \"title=\" + outTitle);\n";
macro2Dsingle = macro2Dsingle + "        return;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    imageCalculator(\"AND create\", \"SQ_SatFullPeakSplit_ForLarge\", largeMaskTitle);\n";
macro2Dsingle = macro2Dsingle + "    rename(\"SQ_SatLargeSplitOnly_FromFull\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"SQ_SatLargeSplitOnly_FromFull\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"8-bit\");\n";
macro2Dsingle = macro2Dsingle + "    setThreshold(1, 255);\n";
macro2Dsingle = macro2Dsingle + "    setOption(\"BlackBackground\", false);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Convert to Mask\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    getRawStatistics(lsNPix, lsMean, lsMin, lsMax, lsStd);\n";
macro2Dsingle = macro2Dsingle + "    if (lsMax > 0) {\n";
macro2Dsingle = macro2Dsingle + "        rename(outTitle);\n";
macro2Dsingle = macro2Dsingle + "    } else {\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(\"SQ_SatLargeSplitOnly_FromFull\")) { selectWindow(\"SQ_SatLargeSplitOnly_FromFull\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(largeMaskTitle);\n";
macro2Dsingle = macro2Dsingle + "        run(\"Duplicate...\", \"title=\" + outTitle);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatFullPeakSplit_ForLarge\")) { selectWindow(\"SQ_SatFullPeakSplit_ForLarge\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(outTitle);\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "function selectiveLargeSatelliteSplit(intensityTitle, maskTitle, outTitle, splitMethod, splitMinArea, prominence, spotRadiusPix) {\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatLargeMask\")) { selectWindow(\"SQ_SatLargeMask\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatLargeSplitMask\")) { selectWindow(\"SQ_SatLargeSplitMask\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatSelectiveSplit_Result\")) { selectWindow(\"SQ_SatSelectiveSplit_Result\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(outTitle)) { selectWindow(outTitle); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(maskTitle);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Duplicate...\", \"title=\" + outTitle);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (splitMethod == \"Off\" || splitMinArea <= 0) {\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(outTitle);\n";
macro2Dsingle = macro2Dsingle + "        return;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Set Measurements...\", \"area centroid redirect=None decimal=3\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(maskTitle);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Analyze Particles...\", \"size=\" + splitMinArea + \"-Infinity show=Nothing clear add\");\n";
macro2Dsingle = macro2Dsingle + "    largeCountForSplit = roiManager(\"count\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (largeCountForSplit == 0) {\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(outTitle);\n";
macro2Dsingle = macro2Dsingle + "        return;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(maskTitle);\n";
macro2Dsingle = macro2Dsingle + "    getDimensions(splitW, splitH, splitC, splitZ, splitT);\n";
macro2Dsingle = macro2Dsingle + "    newImage(\"SQ_SatLargeMask\", \"8-bit black\", splitW, splitH, 1);\n";
macro2Dsingle = macro2Dsingle + "    setForegroundColor(255, 255, 255);\n";
macro2Dsingle = macro2Dsingle + "    setBackgroundColor(0, 0, 0);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    for (lg = 0; lg < largeCountForSplit; lg++) {\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"SQ_SatLargeMask\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Select\", lg);\n";
macro2Dsingle = macro2Dsingle + "        run(\"Fill\", \"slice\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    setBackgroundColor(0, 0, 0);\n";
macro2Dsingle = macro2Dsingle + "    for (lg = 0; lg < largeCountForSplit; lg++) {\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(outTitle);\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Select\", lg);\n";
macro2Dsingle = macro2Dsingle + "        run(\"Clear\", \"slice\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (splitMethod == \"Local intensity peaks\") {\n";
macro2Dsingle = macro2Dsingle + "        run(\"Set Measurements...\", \"area centroid redirect=None decimal=3\");\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"SQ_SatLargeMask\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Duplicate...\", \"title=SQ_SatLargeSplitMask\");\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"SQ_SatLargeSplitMask\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Watershed\");\n";
macro2Dsingle = macro2Dsingle + "    } else if (splitMethod == \"Local intensity peaks\") {\n";
macro2Dsingle = macro2Dsingle + "        splitLargeObjectsWithOriginalPeakSplitter(intensityTitle, maskTitle, \"SQ_SatLargeMask\", \"SQ_SatLargeSplitMask\", prominence);\n";
macro2Dsingle = macro2Dsingle + "    } else if (splitMethod == \"Local intensity peaks\") {\n";
macro2Dsingle = macro2Dsingle + "        splitLargeMaskToPeakSpotMask(intensityTitle, \"SQ_SatLargeMask\", \"SQ_SatLargeSplitMask\", prominence, spotRadiusPix);\n";
macro2Dsingle = macro2Dsingle + "    } else {\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"SQ_SatLargeMask\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Duplicate...\", \"title=SQ_SatLargeSplitMask\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    splitHasSignal = 0;\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatLargeSplitMask\")) {\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"SQ_SatLargeSplitMask\");\n";
macro2Dsingle = macro2Dsingle + "        getRawStatistics(splitNPix, splitMean, splitMin, splitMax, splitStd);\n";
macro2Dsingle = macro2Dsingle + "        if (splitMax > 0) splitHasSignal = 1;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    if (splitHasSignal == 0) {\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(\"SQ_SatLargeSplitMask\")) { selectWindow(\"SQ_SatLargeSplitMask\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"SQ_SatLargeMask\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Duplicate...\", \"title=SQ_SatLargeSplitMask\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    imageCalculator(\"OR create\", outTitle, \"SQ_SatLargeSplitMask\");\n";
macro2Dsingle = macro2Dsingle + "    rename(\"SQ_SatSelectiveSplit_Result\");\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(outTitle)) { selectWindow(outTitle); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"SQ_SatSelectiveSplit_Result\");\n";
macro2Dsingle = macro2Dsingle + "    rename(outTitle);\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(outTitle);\n";
macro2Dsingle = macro2Dsingle + "    getDimensions(outW, outH, outC, outZ, outT);\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(intensityTitle);\n";
macro2Dsingle = macro2Dsingle + "    getDimensions(intW, intH, intC, intZ, intT);\n";
macro2Dsingle = macro2Dsingle + "    if (outW != intW || outH != intH) {\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(outTitle)) { selectWindow(outTitle); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(maskTitle);\n";
macro2Dsingle = macro2Dsingle + "        run(\"Duplicate...\", \"title=\" + outTitle);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatLargeMask\")) { selectWindow(\"SQ_SatLargeMask\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"SQ_SatLargeSplitMask\")) { selectWindow(\"SQ_SatLargeSplitMask\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(outTitle);\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "function exportCellBoundaryROIs(boundaryCSV, sourceTitleForBoundary, runIDForBoundary, frameForBoundary, pixelWidthForBoundary, pixelHeightForBoundary) {\n";
macro2Dsingle = macro2Dsingle + "    if (roiManager(\"count\") <= 0) return;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (!File.exists(boundaryCSV)) {\n";
macro2Dsingle = macro2Dsingle + "        File.saveString(\"Source_Input,Run_ID,Image,Frame,Cell_ID,Point_Index,X_um,Y_um,X_pixel,Y_pixel\\n\", boundaryCSV);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    safeBoundaryImage = replace(sourceTitleForBoundary, \",\", \";\");\n";
macro2Dsingle = macro2Dsingle + "    safeBoundaryRunID = replace(runIDForBoundary, \",\", \";\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    boundaryRoiCount = roiManager(\"count\");\n";
macro2Dsingle = macro2Dsingle + "    for (bc = 0; bc < boundaryRoiCount; bc++) {\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Select\", bc);\n";
macro2Dsingle = macro2Dsingle + "        getSelectionCoordinates(boundaryXPoints, boundaryYPoints);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (boundaryXPoints.length > 0) {\n";
macro2Dsingle = macro2Dsingle + "            for (bp = 0; bp < boundaryXPoints.length; bp++) {\n";
macro2Dsingle = macro2Dsingle + "                bxPix = boundaryXPoints[bp];\n";
macro2Dsingle = macro2Dsingle + "                byPix = boundaryYPoints[bp];\n";
macro2Dsingle = macro2Dsingle + "                bxUm = bxPix * pixelWidthForBoundary;\n";
macro2Dsingle = macro2Dsingle + "                byUm = byPix * pixelHeightForBoundary;\n";
macro2Dsingle = macro2Dsingle + "                File.append(safeBoundaryImage + \",\" + safeBoundaryRunID + \",\" + safeBoundaryImage + \",\" + frameForBoundary + \",\" + (bc + 1) + \",\" + (bp + 1) + \",\" + bxUm + \",\" + byUm + \",\" + bxPix + \",\" + byPix + \"\\n\", boundaryCSV);\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "            bxPix = boundaryXPoints[0];\n";
macro2Dsingle = macro2Dsingle + "            byPix = boundaryYPoints[0];\n";
macro2Dsingle = macro2Dsingle + "            bxUm = bxPix * pixelWidthForBoundary;\n";
macro2Dsingle = macro2Dsingle + "            byUm = byPix * pixelHeightForBoundary;\n";
macro2Dsingle = macro2Dsingle + "            File.append(safeBoundaryImage + \",\" + safeBoundaryRunID + \",\" + safeBoundaryImage + \",\" + frameForBoundary + \",\" + (bc + 1) + \",\" + (boundaryXPoints.length + 1) + \",\" + bxUm + \",\" + byUm + \",\" + bxPix + \",\" + byPix + \"\\n\", boundaryCSV);\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (nImages == 0) {\n";
macro2Dsingle = macro2Dsingle + "    exit(\"Please open an image in Fiji first, then run this macro.\");\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "originalTitle = getTitle();\n";
macro2Dsingle = macro2Dsingle + "baseName = cleanFileName(originalTitle);\n";
macro2Dsingle = macro2Dsingle + "getDimensions(width, height, channels, slices, frames);\n";
macro2Dsingle = macro2Dsingle + "getPixelSize(unit, pixelWidth, pixelHeight, voxelDepth);\n";
macro2Dsingle = macro2Dsingle + "if (pixelWidth == 0) pixelWidth = 1;\n";
macro2Dsingle = macro2Dsingle + "if (pixelHeight == 0) pixelHeight = pixelWidth;\n";
macro2Dsingle = macro2Dsingle + "if (voxelDepth == 0) voxelDepth = pixelWidth;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "sqCalTempDir = getDirectory(\"temp\");\n";
macro2Dsingle = macro2Dsingle + "if (sqCalTempDir == \"\") sqCalTempDir = getDirectory(\"home\");\n";
macro2Dsingle = macro2Dsingle + "sqScalePath = sqCalTempDir + \"SQ_timelapse_scale_settings.txt\";\n";
macro2Dsingle = macro2Dsingle + "if (File.exists(sqScalePath)) File.delete(sqScalePath);\n";
macro2Dsingle = macro2Dsingle + "calibrationSource = \"Image metadata\";\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (File.exists(sqScalePath)) {\n";
macro2Dsingle = macro2Dsingle + "    sqScaleTxt = File.openAsString(sqScalePath);\n";
macro2Dsingle = macro2Dsingle + "    sqScaleTxt = replace(sqScaleTxt, \"\\n\", \"\");\n";
macro2Dsingle = macro2Dsingle + "    sqScaleTxt = replace(sqScaleTxt, \"\\r\", \"\");\n";
macro2Dsingle = macro2Dsingle + "    sqScaleVals = split(sqScaleTxt, \"|\");\n";
macro2Dsingle = macro2Dsingle + "    if (sqScaleVals.length >= 3) {\n";
macro2Dsingle = macro2Dsingle + "        pixelWidth = parseFloat(sqScaleVals[0]);\n";
macro2Dsingle = macro2Dsingle + "        pixelHeight = parseFloat(sqScaleVals[1]);\n";
macro2Dsingle = macro2Dsingle + "        voxelDepth = parseFloat(sqScaleVals[2]);\n";
macro2Dsingle = macro2Dsingle + "        if (sqScaleVals.length >= 4) calibrationSource = sqScaleVals[3]; else calibrationSource = \"Time-lapse parent calibration\";\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "} else {\n";
macro2Dsingle = macro2Dsingle + "    defaultScaleChoice = \"Use current image calibration\";\n";
macro2Dsingle = macro2Dsingle + "    if (unit == \"pixel\" || unit == \"pixels\") defaultScaleChoice = \"Enter pixel size manually in microns\";\n";
macro2Dsingle = macro2Dsingle + "    Dialog.create(\"SatelliteQ image scale / calibration\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addMessage(\"Fiji detected this image scale from the image metadata: unit=\" + unit + \", XY pixel size=\" + pixelWidth + \" x \" + pixelHeight + \", Z step=\" + voxelDepth);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addChoice(\"Image scale/calibration:\", newArray(\"Use current image calibration\", \"Enter pixel size manually in microns\"), defaultScaleChoice);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"XY pixel size, microns per pixel:\", pixelWidth);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Z-step size, microns per slice:\", voxelDepth);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "    scaleChoice = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "    manualXY = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    manualZ = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    if (scaleChoice == \"Enter pixel size manually in microns\") {\n";
macro2Dsingle = macro2Dsingle + "        pixelWidth = manualXY;\n";
macro2Dsingle = macro2Dsingle + "        pixelHeight = manualXY;\n";
macro2Dsingle = macro2Dsingle + "        voxelDepth = manualZ;\n";
macro2Dsingle = macro2Dsingle + "        calibrationSource = \"Manual input\";\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "if (pixelWidth <= 0) pixelWidth = 1;\n";
macro2Dsingle = macro2Dsingle + "if (pixelHeight <= 0) pixelHeight = pixelWidth;\n";
macro2Dsingle = macro2Dsingle + "if (voxelDepth <= 0) voxelDepth = pixelWidth;\n";
macro2Dsingle = macro2Dsingle + "run(\"Properties...\", \"channels=\" + channels + \" slices=\" + slices + \" frames=\" + frames + \" unit=micron pixel_width=\" + pixelWidth + \" pixel_height=\" + pixelHeight + \" voxel_depth=\" + voxelDepth);\n";
macro2Dsingle = macro2Dsingle + "safeUnit = \"um\";\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "getDateAndTime(year, month, dayOfWeek, dayOfMonth, hour, minute, second, msec);\n";
macro2Dsingle = macro2Dsingle + "month = month + 1;\n";
macro2Dsingle = macro2Dsingle + "runTimestamp = d2s(year, 0) + \"_\" + d2s(month, 0) + \"_\" + d2s(dayOfMonth, 0) + \"_\" + d2s(hour, 0) + \"_\" + d2s(minute, 0) + \"_\" + d2s(second, 0);\n";
macro2Dsingle = macro2Dsingle + "runID = baseName + \"_\" + runTimestamp;\n";
macro2Dsingle = macro2Dsingle + "boundaryFrame = -1;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "initialRoiCount = 0;\n";
macro2Dsingle = macro2Dsingle + "if (isOpen(\"ROI Manager\")) {\n";
macro2Dsingle = macro2Dsingle + "    initialRoiCount = roiManager(\"count\");\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "sqTempDir = getDirectory(\"temp\");\n";
macro2Dsingle = macro2Dsingle + "if (sqTempDir == \"\") sqTempDir = getDirectory(\"home\");\n";
macro2Dsingle = macro2Dsingle + "sqTLModePath = sqTempDir + \"SQ_timelapse_frame_settings_mode.txt\";\n";
macro2Dsingle = macro2Dsingle + "sqTL2DSettingsPath = sqTempDir + \"SQ_timelapse_2D_settings.txt\";\n";
macro2Dsingle = macro2Dsingle + "sqTLActive = false; // single-image mode: do not reuse stale time-lapse settings\n";
macro2Dsingle = macro2Dsingle + "sqTLMode = \"\";\n";
macro2Dsingle = macro2Dsingle + "sqTLUseSame = false;\n";
macro2Dsingle = macro2Dsingle + "sqTLAskPrev = false;\n";
macro2Dsingle = macro2Dsingle + "sqTLHasPrev = false;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (sqTLActive) {\n";
macro2Dsingle = macro2Dsingle + "    sqTLMode = File.openAsString(sqTLModePath);\n";
macro2Dsingle = macro2Dsingle + "    sqTLMode = replace(sqTLMode, \"\\\\n\", \"\");\n";
macro2Dsingle = macro2Dsingle + "    sqTLMode = replace(sqTLMode, \"\\\\r\", \"\");\n";
macro2Dsingle = macro2Dsingle + "    if (sqTLMode == \"USE_SAME_SETTINGS\") sqTLUseSame = true; else sqTLUseSame = false;\n";
macro2Dsingle = macro2Dsingle + "    if (sqTLMode == \"ASK_WITH_PREVIOUS_DEFAULTS\") sqTLAskPrev = true; else sqTLAskPrev = false;\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + " d_treatSlicesAsChannels = true;\n";
macro2Dsingle = macro2Dsingle + " d_saveQCImages = true;\n";
macro2Dsingle = macro2Dsingle + " d_satelliteChannel = 1;\n";
macro2Dsingle = macro2Dsingle + " d_centrosomeChannel = 2;\n";
macro2Dsingle = macro2Dsingle + " d_membraneChannel = 0;\n";
macro2Dsingle = macro2Dsingle + " d_ciliumChannel = 0;\n";
macro2Dsingle = macro2Dsingle + " d_projectionMethod = \"Max Intensity\";\n";
macro2Dsingle = macro2Dsingle + " d_satRollingBall = 20;\n";
macro2Dsingle = macro2Dsingle + " d_satThresholdMode = \"Auto\";\n";
macro2Dsingle = macro2Dsingle + " d_satThreshold = \"Otsu\";\n";
macro2Dsingle = macro2Dsingle + " d_satManualThreshold = 100;\n";
macro2Dsingle = macro2Dsingle + " d_satHysteresisMultiplier = 1.25;\n";
macro2Dsingle = macro2Dsingle + " d_minSatSize = 0.05;\n";
macro2Dsingle = macro2Dsingle + " d_maxSatSize = 5.00;\n";
macro2Dsingle = macro2Dsingle + " d_doSatWatershed = true;\n";
macro2Dsingle = macro2Dsingle + " d_satSplitMethod = \"Off\";\n";
macro2Dsingle = macro2Dsingle + " d_satPeakProminence = 10;\n";
macro2Dsingle = macro2Dsingle + " d_satLargeSplitMinSize = 2.0;\n";
macro2Dsingle = macro2Dsingle + " d_satForcedSpotRadiusPix = 2.0;\n";
macro2Dsingle = macro2Dsingle + " d_reviewSatellitesBeforeContinue = true;\n";
macro2Dsingle = macro2Dsingle + " d_centrosomeDetectionMode = \"Bright puncta threshold + top intensity\";\n";
macro2Dsingle = macro2Dsingle + " d_centRollingBall = 20;\n";
macro2Dsingle = macro2Dsingle + " d_centGaussianSigma = 1.0;\n";
macro2Dsingle = macro2Dsingle + " d_centBrightThresholdMode = \"Mean + SD multiplier\";\n";
macro2Dsingle = macro2Dsingle + " d_centSDMultiplier = 6.0;\n";
macro2Dsingle = macro2Dsingle + " d_centPercentMax = 50;\n";
macro2Dsingle = macro2Dsingle + " d_centManualThreshold = 100;\n";
macro2Dsingle = macro2Dsingle + " d_minCentSize = 0.05;\n";
macro2Dsingle = macro2Dsingle + " d_maxCentSize = 5.00;\n";
macro2Dsingle = macro2Dsingle + " d_maxCentrosomesWholeImage = 0;\n";
macro2Dsingle = macro2Dsingle + " d_centDisplayDiameter = 10;\n";
macro2Dsingle = macro2Dsingle + " d_reviewCentrosomesBeforeContinue = true;\n";
macro2Dsingle = macro2Dsingle + " d_centROIDisplayMode = \"Centrosome channel + satellite channel\";\n";
macro2Dsingle = macro2Dsingle + " d_cellAssignmentMode = \"No cell assignment\";\n";
macro2Dsingle = macro2Dsingle + " d_centrosomeRadiusMicron = 3.0;\n";
macro2Dsingle = macro2Dsingle + " d_cellRollingBall = 50;\n";
macro2Dsingle = macro2Dsingle + " d_cellThreshold = \"Otsu\";\n";
macro2Dsingle = macro2Dsingle + " d_cellBoundarySourceType = \"Membrane/boundary marker\";\n";
macro2Dsingle = macro2Dsingle + " d_cellThresholdMode = \"Global auto threshold\";\n";
macro2Dsingle = macro2Dsingle + " d_cellLocalThresholdMethod = \"Phansalkar\";\n";
macro2Dsingle = macro2Dsingle + " d_cellLocalRadius = 25;\n";
macro2Dsingle = macro2Dsingle + " d_cellManualThreshold = 100;\n";
macro2Dsingle = macro2Dsingle + " d_cellPreprocessStrength = \"Medium\";\n";
macro2Dsingle = macro2Dsingle + " d_minCellArea = 100;\n";
macro2Dsingle = macro2Dsingle + " d_maxCellArea = 1000000;\n";
macro2Dsingle = macro2Dsingle + " d_cellCleanupMode = \"Medium-strong\";\n";
macro2Dsingle = macro2Dsingle + " d_cellROIDisplayMode = \"Cell signal channel + cell boundary only\";\n";
macro2Dsingle = macro2Dsingle + " d_cellDoWatershed = true;\n";
macro2Dsingle = macro2Dsingle + " d_cellWatershedProtection = \"Medium\";\n";
macro2Dsingle = macro2Dsingle + " d_exportOutsideMode = \"Selected cell areas only - ignore outside\";\n";
macro2Dsingle = macro2Dsingle + " d_multiCentrosomeMode = \"Use all centrosomes in cell (assign nearest)\";\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (File.exists(sqTL2DSettingsPath) && (sqTLUseSame || sqTLAskPrev)) {\n";
macro2Dsingle = macro2Dsingle + "    sqTL2D = File.openAsString(sqTL2DSettingsPath);\n";
macro2Dsingle = macro2Dsingle + "    sqTL2D = replace(sqTL2D, \"\\\\n\", \"\");\n";
macro2Dsingle = macro2Dsingle + "    sqTL2D = replace(sqTL2D, \"\\\\r\", \"\");\n";
macro2Dsingle = macro2Dsingle + "    sqVals = split(sqTL2D, \"|\");\n";
macro2Dsingle = macro2Dsingle + "    if (sqVals.length >= 34) {\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals[0] == \"true\" || sqVals[0] == \"1\") d_treatSlicesAsChannels = true; else d_treatSlicesAsChannels = false;\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals[1] == \"true\" || sqVals[1] == \"1\") d_saveQCImages = true; else d_saveQCImages = false;\n";
macro2Dsingle = macro2Dsingle + "        d_satelliteChannel = parseFloat(sqVals[2]);\n";
macro2Dsingle = macro2Dsingle + "        d_centrosomeChannel = parseFloat(sqVals[3]);\n";
macro2Dsingle = macro2Dsingle + "        d_membraneChannel = parseFloat(sqVals[4]);\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 49) d_satSplitMethod = sqVals[48];\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 50) d_satPeakProminence = parseFloat(sqVals[49]);\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 51) d_satLargeSplitMinSize = parseFloat(sqVals[50]);\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 52) d_satForcedSpotRadiusPix = parseFloat(sqVals[51]);\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 53) d_centROIDisplayMode = sqVals[52];\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 54) d_cellROIDisplayMode = sqVals[53];\n";
macro2Dsingle = macro2Dsingle + "        d_projectionMethod = sqVals[5];\n";
macro2Dsingle = macro2Dsingle + "        d_satRollingBall = parseFloat(sqVals[6]);\n";
macro2Dsingle = macro2Dsingle + "        d_satThresholdMode = sqVals[7];\n";
macro2Dsingle = macro2Dsingle + "        d_satThreshold = sqVals[8]; if (d_satThreshold != \"Otsu\" && d_satThreshold != \"Triangle\" && d_satThreshold != \"Moments\" && d_satThreshold != \"Default\" && d_satThreshold != \"Li\" && d_satThreshold != \"Yen\") d_satThreshold = \"Otsu\";\n";
macro2Dsingle = macro2Dsingle + "        d_satManualThreshold = parseFloat(sqVals[9]);\n";
macro2Dsingle = macro2Dsingle + "        d_satHysteresisMultiplier = parseFloat(sqVals[10]);\n";
macro2Dsingle = macro2Dsingle + "        d_minSatSize = parseFloat(sqVals[11]);\n";
macro2Dsingle = macro2Dsingle + "        d_maxSatSize = parseFloat(sqVals[12]);\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals[13] == \"true\" || sqVals[13] == \"1\") d_doSatWatershed = true; else d_doSatWatershed = false;\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals[14] == \"true\" || sqVals[14] == \"1\") d_reviewSatellitesBeforeContinue = true; else d_reviewSatellitesBeforeContinue = false;\n";
macro2Dsingle = macro2Dsingle + "        d_centrosomeDetectionMode = sqVals[15];\n";
macro2Dsingle = macro2Dsingle + "        d_centRollingBall = parseFloat(sqVals[16]);\n";
macro2Dsingle = macro2Dsingle + "        d_centGaussianSigma = parseFloat(sqVals[17]);\n";
macro2Dsingle = macro2Dsingle + "        d_centBrightThresholdMode = sqVals[18];\n";
macro2Dsingle = macro2Dsingle + "        d_centSDMultiplier = parseFloat(sqVals[19]);\n";
macro2Dsingle = macro2Dsingle + "        d_centPercentMax = parseFloat(sqVals[20]);\n";
macro2Dsingle = macro2Dsingle + "        d_centManualThreshold = parseFloat(sqVals[21]);\n";
macro2Dsingle = macro2Dsingle + "        d_minCentSize = parseFloat(sqVals[22]);\n";
macro2Dsingle = macro2Dsingle + "        d_maxCentSize = parseFloat(sqVals[23]);\n";
macro2Dsingle = macro2Dsingle + "        d_maxCentrosomesWholeImage = parseFloat(sqVals[24]);\n";
macro2Dsingle = macro2Dsingle + "        d_centDisplayDiameter = parseFloat(sqVals[25]);\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals[26] == \"true\" || sqVals[26] == \"1\") d_reviewCentrosomesBeforeContinue = true; else d_reviewCentrosomesBeforeContinue = false;\n";
macro2Dsingle = macro2Dsingle + "        d_cellAssignmentMode = sqVals[27];\n";
macro2Dsingle = macro2Dsingle + "        d_centrosomeRadiusMicron = parseFloat(sqVals[28]);\n";
macro2Dsingle = macro2Dsingle + "        d_cellRollingBall = parseFloat(sqVals[29]);\n";
macro2Dsingle = macro2Dsingle + "        d_cellThreshold = sqVals[30];\n";
macro2Dsingle = macro2Dsingle + "        d_minCellArea = parseFloat(sqVals[31]);\n";
macro2Dsingle = macro2Dsingle + "        d_maxCellArea = parseFloat(sqVals[32]);\n";
macro2Dsingle = macro2Dsingle + "        d_exportOutsideMode = sqVals[33];\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 35) d_multiCentrosomeMode = sqVals[34];\n";
