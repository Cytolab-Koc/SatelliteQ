macroTL = macroTL + "    run(\"Subtract Background...\", \"rolling=\" + centRollingBall + \" stack\");\n";
macroTL = macroTL + "    centStackTitle = getTitle();\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    centStackForReviewPath = outputDir + \"_TEMP_centrosome_BGsubtracted_stack_for_review.tif\";\n";
macroTL = macroTL + "    saveAs(\"Tiff\", centStackForReviewPath);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    open(centStackForReviewPath);\n";
macroTL = macroTL + "    centReviewStackTitle = getTitle();\n";
macroTL = macroTL + "    getDimensions(cw, ch, cc, cSlices, cf);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(centReviewStackTitle);\n";
macroTL = macroTL + "    if (cSlices > 1) {\n";
macroTL = macroTL + "        run(\"Z Project...\", \"start=1 stop=\" + cSlices + \" projection=[Max Intensity]\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "    run(\"Enhance Contrast\", \"saturated=0.35\");\n";
macroTL = macroTL + "    if (saveQCImages) {\n";
macroTL = macroTL + "        saveAs(\"Tiff\", qcDir + runID + \"_centrosome_BGsubtracted_max_projection_for_review.tif\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    run(\"Duplicate...\", \"title=SQ3D_centrosome_DETECTION_grayscale_BGsub_max_projection\");\n";
macroTL = macroTL + "    centDetectionImageTitle = getTitle();\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(centDetectionImageTitle);\n";
macroTL = macroTL + "    run(\"Duplicate...\", \"title=SQ3D_centrosome_REVIEW_real_BGsub_max_projection\");\n";
macroTL = macroTL + "    centReviewImageTitle = getTitle();\n";
macroTL = macroTL + "    run(\"RGB Color\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (centrosomeSelectionMode == \"Automatic bright puncta then review\") {\n";
macroTL = macroTL + "        if (isOpen(centDetectionImageTitle)) selectWindow(centDetectionImageTitle);\n";
macroTL = macroTL + "        getStatistics(cAreaTmp, cMean, cMin, cMax, cStd);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (centThresholdMode == \"Mean + SD multiplier\") {\n";
