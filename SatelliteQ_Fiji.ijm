macroTL = macroTL + "            satYForDistance = yArr[i] * pixelHeight;\n";
macroTL = macroTL + "            satZForDistance = (zArr[i] - 1) * voxelDepth;\n";
macroTL = macroTL + "            satCoordOK = 1;\n";
macroTL = macroTL + "            if (satXForDistance != satXForDistance || satYForDistance != satYForDistance || satZForDistance != satZForDistance) satCoordOK = 0;\n";
macroTL = macroTL + "            bestCent = -1;\n";
macroTL = macroTL + "            bestDist = 999999999;\n";
macroTL = macroTL + "            if (satCoordOK == 1) {\n";
