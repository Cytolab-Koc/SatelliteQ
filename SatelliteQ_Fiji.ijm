macroTL = macroTL + "        validDistanceCount = 0;\n";
macroTL = macroTL + "        distanceDebugTxt = \"Satellite_ID,Satellite_X,Satellite_Y,Satellite_Z_used,Nearest_Centrosome_ID,Centrosome_X,Centrosome_Y,Centrosome_Z_used,Distance_used\\n\";\n";
macroTL = macroTL + "        distanceDebugTxt = distanceDebugTxt + \"# Coordinate source: parseFloat clean satellite X/Y/Z + parseFloat reloaded centrosome coordinates; satellite coords calibrated to microns\\n\";\n";
