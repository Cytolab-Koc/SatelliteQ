macro2Dsingle = macro2Dsingle + "    Dialog.addMessage(\"- Manual centrosome ROIs during macro: you draw/review centrosomes manually during the run.\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addMessage(\"- Existing ROIs in ROI Manager: use centrosome ROIs already loaded before starting.\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addMessage(\"- Skip centrosome: no centrosome detection or distance output.\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addChoice(\"Centrosome detection mode:\", newArray(\"Automatic centrosome detection\", \"Manual centrosome ROIs during macro\", \"Existing ROIs in ROI Manager\", \"Skip centrosome\"), \"Skip centrosome\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Centrosome rolling ball radius, pixels:\", d_centRollingBall);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Gaussian blur sigma before centrosome detection, pixels:\", d_centGaussianSigma);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addChoice(\"Bright centrosome threshold mode:\", newArray(\"Mean + SD multiplier\", \"Percent of image maximum\", \"Manual value\"), d_centBrightThresholdMode);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Mean + SD multiplier:\", d_centSDMultiplier);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Percent of image maximum:\", d_centPercentMax);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Manual centrosome intensity threshold, AU:\", d_centManualThreshold);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Minimum centrosome object size, pixels^2:\", d_minCentSize);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Maximum centrosome object size, pixels^2:\", d_maxCentSize);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Maximum centrosomes to keep, 0 = keep all thresholded objects:\", d_maxCentrosomesWholeImage);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Centrosome display circle diameter, pixels:\", d_centDisplayDiameter);\n";
