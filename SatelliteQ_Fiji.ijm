macroTL = macroTL + "optionsTxt = optionsTxt + \"Minimum centrosome area on max projection, micrometers^2: \" + minCentArea + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Maximum centrosome area on max projection, micrometers^2: \" + maxCentArea + \"\\n\";\n";
