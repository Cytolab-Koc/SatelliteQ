macroTL = macroTL + "            if (dist < bestDistance) {\n";
macroTL = macroTL + "                bestDistance = dist;\n";
macroTL = macroTL + "                bestCent = c;\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (bestCent >= 0) {\n";
