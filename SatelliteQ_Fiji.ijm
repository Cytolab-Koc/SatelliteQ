macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "        File.saveString(centCoordTxt, centCoordPath);\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        centParsedTxt = File.openAsString(centCoordPath);\n";
macro3Dsingle = macro3Dsingle + "        centParsedTxt = replace(centParsedTxt, \"\\r\\n\", \"\\n\");\n";
