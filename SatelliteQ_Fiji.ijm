macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Mean + SD multiplier:\", ciliumSDMultiplier);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Percent of image maximum:\", ciliumPercentMax);\n";
