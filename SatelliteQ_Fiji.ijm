macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (cellAssignmentMode == \"Manual cell ROIs during macro\" || cellAssignmentMode == \"Existing cell ROIs in ROI Manager\" || cellAssignmentMode == \"Membrane marker\" || cellAssignmentMode == \"Cytoplasmic signal boundary\") {\n";
macroTL = macroTL + "    if (cellAssignmentMode == \"Manual cell ROIs during macro\" && File.exists(manualCellRoiZip)) {\n";
