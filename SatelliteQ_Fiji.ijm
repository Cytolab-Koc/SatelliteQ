macro3Dsingle = macro3Dsingle + "            labelY = gcy + 5;\n";
macro3Dsingle = macro3Dsingle + "            setColor(0, 0, 0);\n";
macro3Dsingle = macro3Dsingle + "            drawString(\"C\" + (rr + 1), labelX + 1, labelY + 1);\n";
macro3Dsingle = macro3Dsingle + "            drawString(\"C\" + (rr + 1), labelX - 1, labelY - 1);\n";
macro3Dsingle = macro3Dsingle + "            setColor(255, 255, 0);\n";
macro3Dsingle = macro3Dsingle + "            drawString(\"C\" + (rr + 1), labelX, labelY);\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "\n";
