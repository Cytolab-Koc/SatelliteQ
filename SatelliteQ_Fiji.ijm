macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "// Export final selected options summary as a human-readable text file.\n";
macroTL = macroTL + "selectedOptionsPath = outputDir + runID + \"_SELECTED_OPTIONS_SUMMARY.txt\";\n";
macroTL = macroTL + "optionsTxt = \"SatelliteQ SELECTED OPTIONS SUMMARY\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"This file records the final options used for this run, including changes made during redo/review dialogs.\\n\\n\";\n";
