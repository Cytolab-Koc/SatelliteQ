macroTL = macroTL + "        getSelectionBounds(rx, ry, rw, rh);\n";
macroTL = macroTL + "        centXpix[c] = rx + rw / 2;\n";
macroTL = macroTL + "        centYpix[c] = ry + rh / 2;\n";
macroTL = macroTL + "        centX[c] = centXpix[c] * pixelWidth;\n";
