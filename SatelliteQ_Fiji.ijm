macro3Dsingle = macro3Dsingle + "        \"Click OK when finished. Z-position will be estimated automatically.\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    centrosomeCount = roiManager(\"count\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    if (centrosomeCount > 0) {\n";
macro3Dsingle = macro3Dsingle + "        centHaveXYZ = true;\n";
