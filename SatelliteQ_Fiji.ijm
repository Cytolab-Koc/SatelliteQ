macro3Dsingle = macro3Dsingle + "membraneChannel = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "ciliumChannel = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "Dialog.create(\"SatelliteQuantify 3D - Step 2/4: Satellites\");\n";
macro3Dsingle = macro3Dsingle + "Dialog.addMessage(\"Image: \" + originalTitle);\n";
macro3Dsingle = macro3Dsingle + "Dialog.addMessage(\"Channels: \" + channels + \"    Z slices: \" + slices);\n";
macro3Dsingle = macro3Dsingle + "Dialog.addMessage(\"This step detects 3D satellite objects from the satellite marker channel.\");\n";
macro3Dsingle = macro3Dsingle + "Dialog.addMessage(\"- Auto threshold: uses Otsu.\");\n";
macro3Dsingle = macro3Dsingle + "Dialog.addMessage(\"- Manual value: use a fixed intensity threshold for all images.\");\n";
macro3Dsingle = macro3Dsingle + "Dialog.addMessage(\"- Exclude edge objects: removes objects touching the stack edges.\");\n";
macro3Dsingle = macro3Dsingle + "Dialog.addNumber(\"Rolling ball radius, pixels:\", 20);\n";
macro3Dsingle = macro3Dsingle + "Dialog.addChoice(\"Threshold mode:\", newArray(\"Auto\", \"Manual value\"), \"Auto\");\n";
macro3Dsingle = macro3Dsingle + "Dialog.addChoice(\"Auto-threshold method:\", newArray(\"Otsu\"), \"Otsu\");\n";
