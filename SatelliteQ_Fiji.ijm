macro2Dsingle = macro2Dsingle + "    satForcedSpotRadiusPix = d_satForcedSpotRadiusPix;\n";
macro2Dsingle = macro2Dsingle + "    reviewSatellitesBeforeContinue = d_reviewSatellitesBeforeContinue;\n";
macro2Dsingle = macro2Dsingle + "} else {\n";
