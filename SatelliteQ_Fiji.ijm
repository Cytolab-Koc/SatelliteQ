macroTL = macroTL + "                    centCoordOK = 1;\n";
macroTL = macroTL + "                    if (centXArr[c] != centXArr[c] || centYArr[c] != centYArr[c] || centZArr[c] != centZArr[c]) centCoordOK = 0;\n";
macroTL = macroTL + "                    if (centCoordOK == 1) {\n";
macroTL = macroTL + "                        dx = satXForDistance - centXArr[c]; dy = satYForDistance - centYArr[c]; dz = satZForDistance - centZArr[c];\n";
macroTL = macroTL + "                        dist = sqrt(dx * dx + dy * dy + dz * dz);\n";
macroTL = macroTL + "                        if (dist == dist && dist < bestDist) { bestDist = dist; bestCent = c; }\n";
macroTL = macroTL + "                    }\n";
