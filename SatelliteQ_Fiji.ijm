macroTL = macroTL + "\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";
macroTL = macroTL + "    run(\"Clear Results\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "centrosomeCount = 0;\n";
macroTL = macroTL + "centX = newArray(0);\n";
macroTL = macroTL + "centY = newArray(0);\n";
macroTL = macroTL + "centXpix = newArray(0);\n";
macroTL = macroTL + "centYpix = newArray(0);\n";
macroTL = macroTL + "centIntensity = newArray(0);\n";
macroTL = macroTL + "centArea = newArray(0);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (centrosomeDetectionMode == \"Bright puncta threshold + top intensity\") {\n";
macroTL = macroTL + "    centrosomeProjection = projectChannel(centrosomeChannel, originalTitle, projectionMethod, \"Centrosome_Projection\", slices);\n";
