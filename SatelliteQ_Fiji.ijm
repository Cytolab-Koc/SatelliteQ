macro2Dsingle = macro2Dsingle + "    Dialog.addCheckbox(\"Use binary watershed for touching satellites\", d_doSatWatershed);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addChoice(\"Large-cluster satellite splitting:\", newArray(\"Off\", \"Local intensity peaks\"), d_satSplitMethod);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Only split satellite objects larger than this size:\", d_satLargeSplitMinSize);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Forced peak-centered spot radius, pixels:\", d_satForcedSpotRadiusPix);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Local-peak prominence for cluster splitting, AU:\", d_satPeakProminence);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addCheckbox(\"Review/edit detected satellites before quantification:\", d_reviewSatellitesBeforeContinue);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    satRollingBall = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    satThresholdMode = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "    satThreshold = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "    satManualThreshold = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    satHysteresisMultiplier = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    minSatSize = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    maxSatSize = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    doSatWatershed = Dialog.getCheckbox();\n";
macro2Dsingle = macro2Dsingle + "    satSplitMethod = Dialog.getChoice();\n";
