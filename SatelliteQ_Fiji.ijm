macro2Dsingle = macro2Dsingle + "        if (ciliumGaussianSigma < 0) ciliumGaussianSigma = 0;\n";
macro2Dsingle = macro2Dsingle + "        if (ciliumMinLength < 0) ciliumMinLength = 0;\n";
