macro3Dsingle = macro3Dsingle + "Dialog.addNumber(\"Maximum object size, pixels (3D stack object size):\", 999999999);\n";
macro3Dsingle = macro3Dsingle + "Dialog.addCheckbox(\"Exclude objects touching stack edges\", false);\n";
