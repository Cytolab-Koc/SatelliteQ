macroTL = macroTL + "                            zArr[parsedRows] = 0;\n";
macroTL = macroTL + "                        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "                        idArr[parsedRows] = parsedRows + 1;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "                        if (parsedRows < 10) {\n";
macroTL = macroTL + "                            parsedCoordinateDebug = parsedCoordinateDebug + \"row \" + (parsedRows + 1) + \": X=\" + xArr[parsedRows] + \", Y=\" + yArr[parsedRows] + \", Z=\" + zArr[parsedRows] + \"\\n\";\n";
macroTL = macroTL + "                        }\n";
macroTL = macroTL + "                    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "                    parsedRows = parsedRows + 1;\n";
macroTL = macroTL + "                }\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "            parsedCoordinateDebug = parsedCoordinateDebug + \"parsedRows: \" + parsedRows + \"\\n\";\n";
macroTL = macroTL + "            parsedCoordinateDebug = parsedCoordinateDebug + \"satCount: \" + satCount + \"\\n\";\n";
macroTL = macroTL + "            parsedCoordinateDebug = parsedCoordinateDebug + \"haveXY: \" + haveXY + \"\\n\";\n";
macroTL = macroTL + "            parsedCoordinateDebug = parsedCoordinateDebug + \"haveXYZ: \" + haveXYZ + \"\\n\";\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "} else {\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (review3DSatellitesBeforeContinue && satCount > 0 && haveXY) {\n";
macroTL = macroTL + "    selectWindow(originalTitle);\n";
macroTL = macroTL + "    if (channels > 1) {\n";
macroTL = macroTL + "        Stack.setChannel(satelliteChannel);\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=SQ3D_Satellite_Review_Source duplicate channels=\" + satelliteChannel);\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=SQ3D_Satellite_Review_Source\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    run(\"Subtract Background...\", \"rolling=\" + rollingBall + \" stack\");\n";
macroTL = macroTL + "    getDimensions(rw, rh, rch, rz, rf);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    rename(\"SQ3D_Satellite_Review_Stack\");\n";
macroTL = macroTL + "    reviewTitle = getTitle();\n";
macroTL = macroTL + "    getDimensions(reviewWtmp, reviewHtmp, reviewCtmp, reviewZtmp, reviewFtmp);\n";
macroTL = macroTL + "    if (nSlices > 1) { midSliceTmp = floor(nSlices / 2) + 1; if (midSliceTmp > nSlices) midSliceTmp = nSlices; setSlice(midSliceTmp); }\n";
macroTL = macroTL + "    run(\"Enhance Contrast\", \"saturated=0.35\");\n";
macroTL = macroTL + "    reviewTitle = getTitle();\n";
macroTL = macroTL + "    satRawReviewTitle = reviewTitle;\n";
macroTL = macroTL + "    selectWindow(satRawReviewTitle);\n";
macroTL = macroTL + "    run(\"Duplicate...\", \"title=SQ3D_Satellite_Review_Raw_For_Overlay duplicate\");\n";
macroTL = macroTL + "    satRawOverlayTitle = getTitle();\n";
macroTL = macroTL + "    run(\"8-bit\");\n";
macroTL = macroTL + "    if (isOpen(counterSourceTitle)) {\n";
macroTL = macroTL + "        selectWindow(counterSourceTitle);\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=SQ3D_Satellite_REAL_3D_Object_Mask duplicate\");\n";
macroTL = macroTL + "        satMaskOverlayTitle = getTitle();\n";
macroTL = macroTL + "        if (counterSourceTitle == \"SQ3D_processed_satellite\") {\n";
macroTL = macroTL + "            setThreshold(counterThresholdValue, 65535);\n";
macroTL = macroTL + "            setOption(\"BlackBackground\", false);\n";
macroTL = macroTL + "            run(\"Convert to Mask\", \"method=Default background=Dark black\");\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "        selectWindow(satMaskOverlayTitle);\n";
macroTL = macroTL + "        run(\"8-bit\");\n";
macroTL = macroTL + "        selectWindow(satRawOverlayTitle);\n";
macroTL = macroTL + "        run(\"8-bit\");\n";
macroTL = macroTL + "        run(\"Merge Channels...\", \"c1=[\" + satRawOverlayTitle + \"] c2=[\" + satMaskOverlayTitle + \"] create\");\n";
macroTL = macroTL + "        rename(\"SQ3D_Satellite_REAL_3D_OBJECTS_review_stack\");\n";
macroTL = macroTL + "        reviewTitle = getTitle();\n";
macroTL = macroTL + "        if (nSlices > 1) { midSliceTmp = floor(nSlices / 2) + 1; if (midSliceTmp > nSlices) midSliceTmp = nSlices; setSlice(midSliceTmp); }\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";

macroTL = macroTL + "\n";
macroTL = macroTL + "    waitForUser(\"3D satellite ROI review\",\n";
macroTL = macroTL + "        \"Review detected 3D satellites on a real 3D object-overlay stack. You can scroll through Z.\\n\\n\" +\n";
macroTL = macroTL + "        \"- Colored mask 3D pixels show the real segmented 3D satellite object at each Z\\n\" +\n";
macroTL = macroTL + "        \"- No same-sized centroid circles are drawn in this clean overlay mode\\n\\n\" +\n";
macroTL = macroTL + "        \"Click OK to continue. After that, SatelliteQ will ask whether to accept these 3D satellites or go back and change the 3D satellite settings.\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (!isOpen(reviewTitle)) {\n";
macroTL = macroTL + "        reviewTitle = getTitle();\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (saveQCImages) {\n";
macroTL = macroTL + "        if (roiManager(\"count\") > 0) roiManager(\"Save\", qcDir + runID + \"_satellite_review_rois_AFTER_EDIT.zip\");\n";
macroTL = macroTL + "        if (isOpen(reviewTitle)) {\n";
macroTL = macroTL + "            selectWindow(reviewTitle);\n";
macroTL = macroTL + "            saveAs(\"Tiff\", qcDir + runID + \"_satellite_review_stack_WITH_EDITABLE_ROIS.tif\");\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        if (roiManager(\"count\") > 0) roiManager(\"Save\", outputDir + runID + \"_satellite_review_rois_AFTER_EDIT.zip\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    keepFlags = newArray(satCount);\n";
macroTL = macroTL + "    for (ki = 0; ki < satCount; ki++) keepFlags[ki] = 0;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    remainingRois = roiManager(\"count\");\n";
macroTL = macroTL + "    if (remainingRois == 0) {\n";
macroTL = macroTL + "        for (ki = 0; ki < satCount; ki++) keepFlags[ki] = 1;\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        if (isOpen(reviewTitle)) {\n";
macroTL = macroTL + "            selectWindow(reviewTitle);\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "        for (rr = 0; rr < remainingRois; rr++) {\n";
macroTL = macroTL + "            roiManager(\"Select\", rr);\n";
macroTL = macroTL + "            for (ki = 0; ki < satCount; ki++) {\n";
macroTL = macroTL + "                if (safeSelectionContains(xArr[ki], yArr[ki])) {\n";
macroTL = macroTL + "                    keepFlags[ki] = 1;\n";
macroTL = macroTL + "                }\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    finalLines = split(finalTxt, \"\\n\");\n";
macroTL = macroTL + "    if (finalLines.length > 0) {\n";
macroTL = macroTL + "        newFinalTxt = finalLines[0] + \"\\n\";\n";
macroTL = macroTL + "        newXArr = newArray(satCount);\n";
macroTL = macroTL + "        newYArr = newArray(satCount);\n";
macroTL = macroTL + "        newZArr = newArray(satCount);\n";
macroTL = macroTL + "        newIdArr = newArray(satCount);\n";
macroTL = macroTL + "        newCount = 0;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        for (rli = 1; rli < finalLines.length; rli++) {\n";
macroTL = macroTL + "            fline = finalLines[rli];\n";
macroTL = macroTL + "            if (lengthOf(fline) > 1) {\n";
macroTL = macroTL + "                firstSep = indexOf(fline, sep);\n";
macroTL = macroTL + "                if (firstSep > 0) {\n";
macroTL = macroTL + "                    oldIDtxt = substring(fline, 0, firstSep);\n";
macroTL = macroTL + "                    oldID = floor(parseFloat(oldIDtxt) + 0.5);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "                    if (oldID >= 1 && oldID <= satCount && keepFlags[oldID - 1] == 1) {\n";
macroTL = macroTL + "                        rest = substring(fline, firstSep + lengthOf(sep));\n";
macroTL = macroTL + "                        newCount = newCount + 1;\n";
macroTL = macroTL + "                        newFinalTxt = newFinalTxt + newCount + sep + rest + \"\\n\";\n";
