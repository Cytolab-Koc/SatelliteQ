macroTL = macroTL + "        Dialog.addRadioButtonGroup(\"Next step:\", newArray(\"Accept 3D centrosomes and continue\", \"Change 3D centrosome settings and re-detect\"), 2, 1, \"Accept 3D centrosomes and continue\");\n";
macroTL = macroTL + "        Dialog.show();\n";
