macroTL = macroTL + "    selectWindow(\"Centrosome_Mask\");\n";
macroTL = macroTL + "    run(\"Analyze Particles...\", \"size=\" + minCentSize + \"-\" + maxCentSize + \" show=Outlines display clear add\");\n";
