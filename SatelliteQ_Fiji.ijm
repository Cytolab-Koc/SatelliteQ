macroTL = macroTL + "                acceptedCellCountBeforeSave = cellCount2D;\n";
macroTL = macroTL + "                roiManager(\"Show All with labels\");\n";
macroTL = macroTL + "                roiManager(\"Deselect\");\n";
macroTL = macroTL + "                roiManager(\"Save\", cellRoiZip);\n";
macroTL = macroTL + "                exportCellBoundaryROIs(cellBoundaryCSV, originalTitle, runID, boundaryFrame, pixelWidth, pixelHeight);\n";
macroTL = macroTL + "                cellArea2DArr = newArray(cellCount2D + 1);\n";
macroTL = macroTL + "                cellVolume3DArrFrom2DROI = newArray(cellCount2D + 1);\n";
macroTL = macroTL + "                for (cell = 0; cell <= cellCount2D; cell++) { cellArea2DArr[cell] = \"NaN\"; cellVolume3DArrFrom2DROI[cell] = \"NaN\"; }\n";
macroTL = macroTL + "                for (cell = 1; cell <= cellCount2D; cell++) {\n";
