macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "Dialog.create(\"SatelliteQuantify 3D - Step 1/4: Channels\");\n";
macro3Dsingle = macro3Dsingle + "Dialog.addMessage(\"Choose the image channels first. The following steps will use these channel choices.\");\n";
