macro2Dsingle = macro2Dsingle + "ciliumCount = 0;\n";
macro2Dsingle = macro2Dsingle + "cLen = newArray(0); cX = newArray(0); cY = newArray(0); cZ = newArray(0); cCell = newArray(0); cPath = newArray(0);\n";
