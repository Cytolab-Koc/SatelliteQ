macro3Dsingle = macro3Dsingle + "            currentN = roiManager(\"count\");\n";
macro3Dsingle = macro3Dsingle + "            if (currentN > maxCentrosomesKeep) {\n";
macro3Dsingle = macro3Dsingle + "                scores = newArray(currentN);\n";
macro3Dsingle = macro3Dsingle + "                keep = newArray(currentN);\n";
macro3Dsingle = macro3Dsingle + "\n";
