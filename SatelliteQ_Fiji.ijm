macro2Dsingle = macro2Dsingle + "        run(\"Duplicate...\", \"title=SQ_QC_selected_cell_boundaries_full_image\");\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"SQ_QC_selected_cell_boundaries_full_image\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Select None\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"RGB Color\");\n";
macro2Dsingle = macro2Dsingle + "        getDimensions(qcW, qcH, qcC, qcZ, qcT);\n";
macro2Dsingle = macro2Dsingle + "        setFont(\"SansSerif\", 12, \"bold\");\n";
macro2Dsingle = macro2Dsingle + "        setLineWidth(3);\n";
macro2Dsingle = macro2Dsingle + "        setColor(185, 90, 255);\n";
macro2Dsingle = macro2Dsingle + "\n";
