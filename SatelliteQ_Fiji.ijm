macro3Dsingle = macro3Dsingle + "        } else {\n";
macro3Dsingle = macro3Dsingle + "            centThresholdValue = centManualThreshold;\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        run(\"Duplicate...\", \"title=SQ3D_centrosome_detection_mask\");\n";
macro3Dsingle = macro3Dsingle + "        setThreshold(centThresholdValue, 65535);\n";
macro3Dsingle = macro3Dsingle + "        run(\"Convert to Mask\", \"method=Default background=Default black\");\n";
macro3Dsingle = macro3Dsingle + "        run(\"Set Measurements...\", \"area mean min max centroid center integrated median redirect=None decimal=3\");\n";
macro3Dsingle = macro3Dsingle + "        run(\"Analyze Particles...\", \"size=\" + minCentArea + \"-\" + maxCentArea + \" show=Nothing display clear add\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"SQ3D_centrosome_detection_mask\")) {\n";
