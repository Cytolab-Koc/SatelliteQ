macro3Dsingle = macro3Dsingle + "        centReviewImageTitle = centReviewGuideTitle;\n";
macro3Dsingle = macro3Dsingle + "    } else {\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(centReviewImageTitle)) selectWindow(centReviewImageTitle);\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    if (isOpen(centReviewStackTitle)) {\n";
macro3Dsingle = macro3Dsingle + "        selectWindow(centReviewStackTitle);\n";
macro3Dsingle = macro3Dsingle + "        run(\"Duplicate...\", \"title=SQ3D_centrosome_REVIEW_stack_WITH_ROIS\");\n";
macro3Dsingle = macro3Dsingle + "        centReviewImageTitle = getTitle();\n";
macro3Dsingle = macro3Dsingle + "        getDimensions(centWtmp, centHtmp, centCtmp, centZtmp, centFtmp);\n";
macro3Dsingle = macro3Dsingle + "        if (nSlices > 1) { midSliceTmp = floor(nSlices / 2) + 1; if (midSliceTmp > nSlices) midSliceTmp = nSlices; setSlice(midSliceTmp); }\n";
macro3Dsingle = macro3Dsingle + "        run(\"Enhance Contrast\", \"saturated=0.35\");\n";
