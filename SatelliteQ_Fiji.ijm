macroTL = macroTL + "                run(\"RGB Color\");\n";
macroTL = macroTL + "                setFont(\"SansSerif\", 16, \"bold antialiased\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "                for (c = 0; c < centrosomeCount; c++) {\n";
macroTL = macroTL + "                    cxPixSphere = centXArr[c] / pixelWidth;\n";
