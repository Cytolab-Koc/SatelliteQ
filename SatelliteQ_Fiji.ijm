macroTL = macroTL + "    roiManager(\"Open\", initialRoiZip);\n";
macroTL = macroTL + "    centrosomeCount = roiManager(\"count\");\n";
macroTL = macroTL + "    centX = newArray(centrosomeCount);\n";
macroTL = macroTL + "    centY = newArray(centrosomeCount);\n";
macroTL = macroTL + "    centXpix = newArray(centrosomeCount);\n";
macroTL = macroTL + "    centYpix = newArray(centrosomeCount);\n";
macroTL = macroTL + "    centIntensity = newArray(centrosomeCount);\n";
macroTL = macroTL + "    centArea = newArray(centrosomeCount);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(\"Satellite_Projection\");\n";
macroTL = macroTL + "    for (c = 0; c < centrosomeCount; c++) {\n";
