macroTL = macroTL + "    cellLocalThresholdMethod = d_cellLocalThresholdMethod;\n";
macroTL = macroTL + "    cellLocalRadius = d_cellLocalRadius;\n";
macroTL = macroTL + "    cellManualThreshold = d_cellManualThreshold;\n";
macroTL = macroTL + "    cellPreprocessStrength = d_cellPreprocessStrength;\n";
macroTL = macroTL + "    minCellArea = d_minCellArea;\n";
macroTL = macroTL + "    maxCellArea = d_maxCellArea;\n";
macroTL = macroTL + "    cellCleanupMode = d_cellCleanupMode;\n";
macroTL = macroTL + "    cellROIDisplayMode = d_cellROIDisplayMode;\n";
macroTL = macroTL + "    if (cellCleanupMode == \"Light\") cellCleanupMode = \"Very light\";\n";
macroTL = macroTL + "    if (cellCleanupMode == \"Standard\") cellCleanupMode = \"Standard\";\n";
macroTL = macroTL + "    if (cellCleanupMode == \"Strong\") cellCleanupMode = \"Strong\";\n";
macroTL = macroTL + "    cellDoWatershed = d_cellDoWatershed;\n";
macroTL = macroTL + "    cellWatershedProtection = d_cellWatershedProtection;\n";
macroTL = macroTL + "    multiCentrosomeMode = d_multiCentrosomeMode;\n";
macroTL = macroTL + "} else {\n";
macroTL = macroTL + "    Dialog.create(\"SatelliteQuantify 2D time-lapse - Step 3a/4: Centrosomes\");\n";
macroTL = macroTL + "    Dialog.addMessage(\"Optional: detect centrosomes so each satellite can be assigned a distance to its cell centrosome.\");\n";
