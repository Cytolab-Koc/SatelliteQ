macro3Dsingle = macro3Dsingle + "            if (channels > 1) { Stack.setChannel(satelliteChannel); run(\"Duplicate...\", \"title=SQ3D_centrosome_REVIEW_satellite_stack duplicate channels=\" + satelliteChannel); } else { run(\"Duplicate...\", \"title=SQ3D_centrosome_REVIEW_satellite_stack\"); }\n";
macro3Dsingle = macro3Dsingle + "            centSatOverlayTitle = getTitle();\n";
