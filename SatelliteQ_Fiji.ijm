macro2Dsingle = macro2Dsingle + "cellROIDisplayMode = d_cellROIDisplayMode;\n";
macro2Dsingle = macro2Dsingle + "if (sqTLUseSame && sqTLHasPrev) {\n";
macro2Dsingle = macro2Dsingle + "    centrosomeDetectionMode = d_centrosomeDetectionMode;\n";
macro2Dsingle = macro2Dsingle + "    centRollingBall = d_centRollingBall;\n";
macro2Dsingle = macro2Dsingle + "    centGaussianSigma = d_centGaussianSigma;\n";
macro2Dsingle = macro2Dsingle + "    centBrightThresholdMode = d_centBrightThresholdMode;\n";
macro2Dsingle = macro2Dsingle + "    centSDMultiplier = d_centSDMultiplier;\n";
macro2Dsingle = macro2Dsingle + "    centPercentMax = d_centPercentMax;\n";
macro2Dsingle = macro2Dsingle + "    centManualThreshold = d_centManualThreshold;\n";
macro2Dsingle = macro2Dsingle + "    minCentSize = d_minCentSize;\n";
macro2Dsingle = macro2Dsingle + "    maxCentSize = d_maxCentSize;\n";
macro2Dsingle = macro2Dsingle + "    maxCentrosomesWholeImage = d_maxCentrosomesWholeImage;\n";
macro2Dsingle = macro2Dsingle + "    centDisplayDiameter = d_centDisplayDiameter;\n";
macro2Dsingle = macro2Dsingle + "    reviewCentrosomesBeforeContinue = d_reviewCentrosomesBeforeContinue;\n";
macro2Dsingle = macro2Dsingle + "    cellAssignmentMode = d_cellAssignmentMode;\n";
macro2Dsingle = macro2Dsingle + "    centrosomeRadiusMicron = d_centrosomeRadiusMicron;\n";
macro2Dsingle = macro2Dsingle + "    cellRollingBall = d_cellRollingBall;\n";
macro2Dsingle = macro2Dsingle + "    cellThreshold = d_cellThreshold;\n";
macro2Dsingle = macro2Dsingle + "    cellBoundarySourceType = d_cellBoundarySourceType;\n";
macro2Dsingle = macro2Dsingle + "    cellThresholdMode = d_cellThresholdMode;\n";
macro2Dsingle = macro2Dsingle + "    cellLocalThresholdMethod = d_cellLocalThresholdMethod;\n";
macro2Dsingle = macro2Dsingle + "    cellLocalRadius = d_cellLocalRadius;\n";
macro2Dsingle = macro2Dsingle + "    cellManualThreshold = d_cellManualThreshold;\n";
macro2Dsingle = macro2Dsingle + "    cellPreprocessStrength = d_cellPreprocessStrength;\n";
macro2Dsingle = macro2Dsingle + "    minCellArea = d_minCellArea;\n";
macro2Dsingle = macro2Dsingle + "    maxCellArea = d_maxCellArea;\n";
macro2Dsingle = macro2Dsingle + "    cellCleanupMode = d_cellCleanupMode;\n";
macro2Dsingle = macro2Dsingle + "    cellROIDisplayMode = d_cellROIDisplayMode;\n";
macro2Dsingle = macro2Dsingle + "    if (cellCleanupMode == \"Light\") cellCleanupMode = \"Very light\";\n";
macro2Dsingle = macro2Dsingle + "    if (cellCleanupMode == \"Standard\") cellCleanupMode = \"Standard\";\n";
macro2Dsingle = macro2Dsingle + "    if (cellCleanupMode == \"Strong\") cellCleanupMode = \"Strong\";\n";
macro2Dsingle = macro2Dsingle + "    cellDoWatershed = d_cellDoWatershed;\n";
