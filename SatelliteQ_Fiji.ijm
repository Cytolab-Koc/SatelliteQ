macroTL = macroTL + "                distanceDebugTxt = distanceDebugTxt + idArr[i] + \",\" + satXForDistance + \",\" + satYForDistance + \",\" + satZForDistance + \",\" + centIdArr[bestCent] + \",\" + centXArr[bestCent] + \",\" + centYArr[bestCent] + \",\" + centZArr[bestCent] + \",\" + bestDist + \"\\n\";\n";
macroTL = macroTL + "            } else {\n";
