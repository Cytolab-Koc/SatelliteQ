macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (centrosomeDetectionMode == \"Manual centrosome ROIs during macro\") {\n";
macroTL = macroTL + "    centrosomeProjection = projectChannel(centrosomeChannel, originalTitle, projectionMethod, \"Centrosome_Projection\", slices);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(centrosomeProjection);\n";
