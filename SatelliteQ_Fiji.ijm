macroTL = macroTL + "    Dialog.addNumber(\"Local threshold radius, pixels:\", d_cellLocalRadius);\n";
macroTL = macroTL + "    Dialog.addNumber(\"Manual cell threshold value, AU:\", d_cellManualThreshold);\n";
macroTL = macroTL + "    Dialog.addChoice(\"Microtubule/cytoskeleton preprocessing strength:\", newArray(\"Off\", \"Light\", \"Medium\", \"Strong\", \"Very strong\"), d_cellPreprocessStrength);\n";
macroTL = macroTL + "    Dialog.addChoice(\"Cell mask cleanup strength:\", newArray(\"None\", \"Very light\", \"Standard\", \"Medium-strong\", \"Strong\", \"Very strong\"), d_cellCleanupMode);\n";
macroTL = macroTL + "    Dialog.addChoice(\"Cell ROI drawing/review image:\", newArray(\"Cell signal channel + cell boundary only\", \"Cell signal channel + cell boundary + centrosome\", \"Cell signal channel + cell boundary + satellite\", \"Cell signal channel + cell boundary + centrosome + satellite\", \"Cell signal channel + cell boundary + centrosome + centrosome numbers + satellite\"), \"Cell signal channel + cell boundary only\");\n";
