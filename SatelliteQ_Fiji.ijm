macroTL = macroTL + "optionsTxt = optionsTxt + \"Final centrosome count: \" + centrosomeCount + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"\\n[CELL AREA / CELL ASSIGNMENT]\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Cell assignment mode: \" + cellAssignmentMode + \"\\n\";\n";
