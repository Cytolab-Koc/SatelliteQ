macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "            setLineWidth(4);\n";
macro3Dsingle = macro3Dsingle + "            setColor(0, 255, 255);\n";
macro3Dsingle = macro3Dsingle + "            makeOval(gcx - guideRadius, gcy - guideRadius, centDisplayDiameter, centDisplayDiameter);\n";
macro3Dsingle = macro3Dsingle + "            if (selectionType() != -1) run(\"Draw\", \"slice\");\n";
