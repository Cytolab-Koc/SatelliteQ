macroTL = macroTL + "        makeOval(cx - 2, cy - 2, 4, 4);\n";
macroTL = macroTL + "        if (selectionType() != -1) run(\"Draw\", \"slice\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        setColor(255, 255, 0);\n";
macroTL = macroTL + "        drawString(\"\" + idArr[i], cx + 4, cy - 4);\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    saveAs(\"Tiff\", qcDir + runID + \"_satellite_ID_labeled_max_projection_SMALL_LABELS.tif\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(originalTitle);\n";
macroTL = macroTL + "    if (channels > 1) {\n";
