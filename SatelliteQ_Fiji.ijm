macro3Dsingle = macro3Dsingle + "        roiManager(\"Reset\");\n";
macro3Dsingle = macro3Dsingle + "        run(\"Clear Results\");\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"SQ3D_processed_centrosome\")) { selectWindow(\"SQ3D_processed_centrosome\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"SQ3D_centrosome_final_QC\")) { selectWindow(\"SQ3D_centrosome_final_QC\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"SQ3D_centrosome_review_guide\")) { selectWindow(\"SQ3D_centrosome_review_guide\"); setOption(\"Changes\", false); close(); }\n";
