macroTL = macroTL + "            centY[k] = candY[k];\n";
macroTL = macroTL + "            centXpix[k] = candXpix[k];\n";
macroTL = macroTL + "            centYpix[k] = candYpix[k];\n";
macroTL = macroTL + "            centIntensity[k] = candIntensity[k];\n";
