macroTL = macroTL + "d_centGaussianSigma = centGaussianSigma;\n";
macroTL = macroTL + "d_centBrightThresholdMode = centBrightThresholdMode;\n";
macroTL = macroTL + "d_centSDMultiplier = centSDMultiplier;\n";
macroTL = macroTL + "d_centPercentMax = centPercentMax;\n";
macroTL = macroTL + "d_centManualThreshold = centManualThreshold;\n";
macroTL = macroTL + "d_minCentSize = minCentSize;\n";
macroTL = macroTL + "d_maxCentSize = maxCentSize;\n";
macroTL = macroTL + "d_maxCentrosomesWholeImage = maxCentrosomesWholeImage;\n";
macroTL = macroTL + "d_centDisplayDiameter = centDisplayDiameter;\n";
macroTL = macroTL + "d_reviewCentrosomesBeforeContinue = reviewCentrosomesBeforeContinue;\n";
macroTL = macroTL + "d_centROIDisplayMode = centROIDisplayMode;\n";
macroTL = macroTL + "d_cellROIDisplayMode = cellROIDisplayMode;\n";
macroTL = macroTL + "d_cellAssignmentMode = cellAssignmentMode;\n";
macroTL = macroTL + "d_centrosomeRadiusMicron = centrosomeRadiusMicron;\n";
macroTL = macroTL + "d_cellRollingBall = cellRollingBall;\n";
macroTL = macroTL + "d_cellThreshold = cellThreshold;\n";
macroTL = macroTL + "d_cellBoundarySourceType = cellBoundarySourceType;\n";
macroTL = macroTL + "d_cellThresholdMode = cellThresholdMode;\n";
macroTL = macroTL + "d_cellLocalThresholdMethod = cellLocalThresholdMethod;\n";
macroTL = macroTL + "d_cellLocalRadius = cellLocalRadius;\n";
macroTL = macroTL + "d_cellManualThreshold = cellManualThreshold;\n";
macroTL = macroTL + "d_cellPreprocessStrength = cellPreprocessStrength;\n";
macroTL = macroTL + "d_minCellArea = minCellArea;\n";
macroTL = macroTL + "d_maxCellArea = maxCellArea;\n";
macroTL = macroTL + "d_cellCleanupMode = cellCleanupMode;\n";
macroTL = macroTL + "d_cellDoWatershed = cellDoWatershed;\n";
macroTL = macroTL + "d_cellWatershedProtection = cellWatershedProtection;\n";
macroTL = macroTL + "d_multiCentrosomeMode = multiCentrosomeMode;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "centThresholdMode = \"Auto\";\n";
macroTL = macroTL + "centThreshold = \"Otsu\";\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (cellAssignmentMode == \"No cell assignment\") {\n";
macroTL = macroTL + "    exportOutsideMode = \"Whole image - export all satellites\";\n";
macroTL = macroTL + "} else {\n";
macroTL = macroTL + "    if (sqTLUseSame && sqTLHasPrev) {\n";
macroTL = macroTL + "        exportOutsideMode = d_exportOutsideMode;\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        Dialog.create(\"SatelliteQuantify 2D time-lapse - Step 4/4: Processing/export mode\");\n";
macroTL = macroTL + "        Dialog.addMessage(\"This controls satellites outside selected cell ROIs, cell masks, or centrosome-radius regions.\");\n";
macroTL = macroTL + "        Dialog.addMessage(\"Choose whether to export only assigned satellites or keep all satellites for whole-image QC.\");\n";
macroTL = macroTL + "        exportModeAssignedOnly = \"Selected cell areas only - ignore outside\";\n";
macroTL = macroTL + "        exportModeWholeImage = \"Whole image - export outside as Cell_ID NaN\";\n";
macroTL = macroTL + "        Dialog.addRadioButtonGroup(\n";
macroTL = macroTL + "            \"Export mode:\",\n";
macroTL = macroTL + "            newArray(exportModeAssignedOnly, exportModeWholeImage),\n";
macroTL = macroTL + "            2,\n";
macroTL = macroTL + "            1,\n";
macroTL = macroTL + "            d_exportOutsideMode\n";
macroTL = macroTL + "        );\n";
macroTL = macroTL + "        Dialog.addMessage(\"Selected cell areas only: exports only satellites assigned to a cell/ROI/radius region.\");\n";
macroTL = macroTL + "        Dialog.addMessage(\"Whole image: exports assigned satellites plus unassigned satellites at the bottom with Cell_ID = NaN.\");\n";
macroTL = macroTL + "        Dialog.show();\n";
macroTL = macroTL + "        exportOutsideMode = Dialog.getRadioButton();\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "d_exportOutsideMode = exportOutsideMode;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (sqTLActive) {\n";
macroTL = macroTL + "    sqTL2DSave = \"\" + d_treatSlicesAsChannels + \"|\" + d_saveQCImages + \"|\" + d_satelliteChannel + \"|\" + d_centrosomeChannel + \"|\" + d_membraneChannel + \"|\" + d_projectionMethod + \"|\" + d_satRollingBall + \"|\" + d_satThresholdMode + \"|\" + d_satThreshold + \"|\" + d_satManualThreshold + \"|\" + d_satHysteresisMultiplier + \"|\" + d_minSatSize + \"|\" + d_maxSatSize + \"|\" + d_doSatWatershed + \"|\" + d_reviewSatellitesBeforeContinue + \"|\" + d_centrosomeDetectionMode + \"|\" + d_centRollingBall + \"|\" + d_centGaussianSigma + \"|\" + d_centBrightThresholdMode + \"|\" + d_centSDMultiplier + \"|\" + d_centPercentMax + \"|\" + d_centManualThreshold + \"|\" + d_minCentSize + \"|\" + d_maxCentSize + \"|\" + d_maxCentrosomesWholeImage + \"|\" + d_centDisplayDiameter + \"|\" + d_reviewCentrosomesBeforeContinue + \"|\" + d_cellAssignmentMode + \"|\" + d_centrosomeRadiusMicron + \"|\" + d_cellRollingBall + \"|\" + d_cellThreshold + \"|\" + d_minCellArea + \"|\" + d_maxCellArea + \"|\" + d_exportOutsideMode + \"|\" + d_multiCentrosomeMode + \"|\" + d_cellBoundarySourceType + \"|\" + d_cellThresholdMode + \"|\" + d_cellLocalThresholdMethod + \"|\" + d_cellLocalRadius + \"|\" + d_cellManualThreshold + \"|\" + d_cellPreprocessStrength + \"|\" + d_cellWatershedProtection + \"|0|false|20|Otsu|20|1000|\" + d_satSplitMethod + \"|\" + d_satPeakProminence + \"|\" + d_satLargeSplitMinSize + \"|\" + d_satForcedSpotRadiusPix + \"|\" + d_centROIDisplayMode + \"|\" + d_cellROIDisplayMode + \"|\" + d_ciliumChannel + \"|\" + d_ciliumRollingBall + \"|\" + d_ciliumGaussianSigma + \"|\" + d_ciliumThresholdMode + \"|\" + d_ciliumSDMultiplier + \"|\" + d_ciliumPercentMax + \"|\" + d_ciliumManualThreshold + \"|\" + d_ciliumMinLength + \"|\" + d_ciliumMaxLength;\n";
macroTL = macroTL + "    File.saveString(sqTL2DSave, sqTL2DSettingsPath);\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "includeUnassignedSatellites = false;\n";
macroTL = macroTL + "if (exportOutsideMode == \"Whole image - export outside as Cell_ID NaN\") includeUnassignedSatellites = true;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (centrosomeDetectionMode == \"Segmentation from channel\" && centrosomeChannel == 0) exit(\"Centrosome segmentation selected, but centrosome channel is 0.\");\n";
macroTL = macroTL + "if (centrosomeDetectionMode == \"Bright puncta threshold + top intensity\" && centrosomeChannel == 0) exit(\"Bright puncta centrosome detection selected, but centrosome channel is 0.\");\n";
macroTL = macroTL + "if (centrosomeDetectionMode == \"Manual centrosome ROIs during macro\" && centrosomeChannel == 0) exit(\"Manual centrosome ROI mode selected, but centrosome channel is 0.\");\n";
macroTL = macroTL + "if ((cellAssignmentMode == \"Membrane marker\" || cellAssignmentMode == \"Cytoplasmic signal boundary\") && membraneChannel == 0) exit(\"Cell boundary assignment selected, but membrane/cytoplasmic boundary channel is 0.\");\n";
macroTL = macroTL + "if (cellAssignmentMode == \"Centrosome radius\" && centrosomeChannel == 0 && centrosomeDetectionMode != \"Existing ROIs in ROI Manager\") exit(\"Centrosome radius mode needs centrosomes.\");\n";
macroTL = macroTL + "if (cellAssignmentMode == \"Existing cell ROIs in ROI Manager\" && initialRoiCount == 0) exit(\"Existing cell ROIs selected, but ROI Manager had 0 ROIs at the start.\");\n";
macroTL = macroTL + "if (centrosomeDetectionMode == \"Existing ROIs in ROI Manager\" && initialRoiCount == 0) exit(\"Existing centrosome ROIs selected, but ROI Manager had 0 ROIs at the start.\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "selectWindow(originalTitle);\n";
macroTL = macroTL + "if (channels > 1) run(\"Split Channels\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "satelliteProjection = projectChannel(satelliteChannel, originalTitle, projectionMethod, \"Satellite_Projection\", slices);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "satelliteDetectionAccepted = false;\n";
macroTL = macroTL + "while (satelliteDetectionAccepted == false) {\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (isOpen(\"Satellite_BackgroundSubtracted\")) { selectWindow(\"Satellite_BackgroundSubtracted\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"Satellite_Mask\")) { selectWindow(\"Satellite_Mask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"Satellite_QC_Outlines\")) { selectWindow(\"Satellite_QC_Outlines\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"Satellite_Selected_ROI_Review_QC\")) { selectWindow(\"Satellite_Selected_ROI_Review_QC\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";
macroTL = macroTL + "    run(\"Clear Results\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(satelliteProjection);\n";
macroTL = macroTL + "    run(\"Select None\");\n";
macroTL = macroTL + "    run(\"Duplicate...\", \"title=Satellite_BackgroundSubtracted\");\n";
macroTL = macroTL + "    selectWindow(\"Satellite_BackgroundSubtracted\");\n";
macroTL = macroTL + "    run(\"Subtract Background...\", \"rolling=\" + satRollingBall);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    thresholdToMask(\"Satellite_BackgroundSubtracted\", \"Satellite_Mask\", satThresholdMode, satThreshold, satManualThreshold, satHysteresisMultiplier, doSatWatershed);\n";
macroTL = macroTL + "    if (satSplitMethod == \"Local intensity peaks\") {\n";
macroTL = macroTL + "        splitSatelliteMaskByLocalPeaks(\"Satellite_BackgroundSubtracted\", \"Satellite_Mask\", \"Satellite_Mask_PeakSplit\", satPeakProminence);\n";
macroTL = macroTL + "        if (isOpen(\"Satellite_Mask\")) { selectWindow(\"Satellite_Mask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        selectWindow(\"Satellite_Mask_PeakSplit\");\n";
macroTL = macroTL + "        rename(\"Satellite_Mask\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "    if (satSplitMethod == \"Local intensity peaks\" || satSplitMethod == \"Local intensity peaks\" || satSplitMethod == \"Local intensity peaks\") {\n";
macroTL = macroTL + "        selectiveLargeSatelliteSplit(\"Satellite_BackgroundSubtracted\", \"Satellite_Mask\", \"Satellite_Mask_LargeSelectiveSplit\", satSplitMethod, satLargeSplitMinSize, satPeakProminence, satForcedSpotRadiusPix);\n";
macroTL = macroTL + "        if (isOpen(\"Satellite_Mask\")) { selectWindow(\"Satellite_Mask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        selectWindow(\"Satellite_Mask_LargeSelectiveSplit\");\n";
macroTL = macroTL + "        rename(\"Satellite_Mask\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    run(\"Clear Results\");\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";
macroTL = macroTL + "    run(\"Set Measurements...\", \"area mean integrated centroid center shape redirect=None decimal=3\");\n";
macroTL = macroTL + "    selectWindow(\"Satellite_Mask\");\n";
macroTL = macroTL + "    run(\"Analyze Particles...\", \"size=\" + minSatSize + \"-\" + maxSatSize + \" show=Outlines display clear add\");\n";
macroTL = macroTL + "    rename(\"Satellite_QC_Outlines\");\n";
macroTL = macroTL + "    run(\"Clear Results\");\n";
macroTL = macroTL + "    run(\"Set Measurements...\", \"area mean integrated centroid center shape redirect=None decimal=3\");\n";
macroTL = macroTL + "    selectWindow(\"Satellite_BackgroundSubtracted\");\n";
macroTL = macroTL + "    roiManager(\"Deselect\");\n";
macroTL = macroTL + "    if (roiManager(\"count\") > 0) roiManager(\"Measure\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (satThresholdMode == \"Hysteresis-like\") {\n";
macroTL = macroTL + "        selectWindow(\"Satellite_BackgroundSubtracted\");\n";
macroTL = macroTL + "        setAutoThreshold(satThreshold + \" dark\");\n";
macroTL = macroTL + "        getThreshold(satLowThresholdValue, satUpperThresholdValue);\n";
macroTL = macroTL + "        satHighThresholdValue = satLowThresholdValue * satHysteresisMultiplier;\n";
macroTL = macroTL + "        resetThreshold();\n";
macroTL = macroTL + "        satRoiCount = roiManager(\"count\");\n";
macroTL = macroTL + "        keepSatRoi = newArray(satRoiCount);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        for (hs = 0; hs < satRoiCount; hs++) {\n";
macroTL = macroTL + "            roiManager(\"Select\", hs);\n";
macroTL = macroTL + "            getStatistics(hAreaTmp, hMeanTmp, hMinTmp, hMaxTmp, hStdTmp);\n";
macroTL = macroTL + "            if (hMaxTmp >= satHighThresholdValue) keepSatRoi[hs] = 1;\n";
macroTL = macroTL + "            else keepSatRoi[hs] = 0;\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        for (hs = satRoiCount - 1; hs >= 0; hs--) {\n";
macroTL = macroTL + "            if (keepSatRoi[hs] == 0) {\n";
macroTL = macroTL + "                roiManager(\"Select\", hs);\n";
macroTL = macroTL + "                roiManager(\"Delete\");\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        run(\"Clear Results\");\n";
macroTL = macroTL + "        run(\"Set Measurements...\", \"area mean integrated centroid center shape redirect=None decimal=3\");\n";
macroTL = macroTL + "        roiManager(\"Deselect\");\n";
macroTL = macroTL + "        if (roiManager(\"count\") > 0) roiManager(\"Measure\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (isOpen(\"Satellite_QC_Outlines\")) {\n";
macroTL = macroTL + "            selectWindow(\"Satellite_QC_Outlines\");\n";
macroTL = macroTL + "            close();\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (reviewSatellitesBeforeContinue) {\n";
