macroTL = macroTL + "                    roiManager(\"Select\", cell - 1);\n";
macroTL = macroTL + "                    getStatistics(tmpCellArea);\n";
macroTL = macroTL + "                    cellArea2DArr[cell] = tmpCellArea;\n";
macroTL = macroTL + "                }\n";
macroTL = macroTL + "                selectWindow(\"SQ3D_TL_Cell_Channel_For2DROI\");\n";
macroTL = macroTL + "                run(\"Duplicate...\", \"title=SQ3D_TL_Cell_3DMask_ForROI_Volume duplicate\");\n";
macroTL = macroTL + "                selectWindow(\"SQ3D_TL_Cell_3DMask_ForROI_Volume\");\n";
macroTL = macroTL + "                if (cellThresholdMode == \"Global auto threshold\") { setAutoThreshold(cellThreshold + \" dark\"); setOption(\"BlackBackground\", true); run(\"Convert to Mask\", \"method=Default background=Dark black stack\"); }\n";
macroTL = macroTL + "                else if (cellThresholdMode == \"Manual threshold\") { setThreshold(cellManualThreshold, 65535); setOption(\"BlackBackground\", true); run(\"Convert to Mask\", \"method=Default background=Dark black stack\"); }\n";
macroTL = macroTL + "                else { run(\"Auto Local Threshold\", \"method=\" + cellLocalThresholdMethod + \" radius=\" + cellLocalRadius + \" parameter_1=0 parameter_2=0 white stack\"); }\n";
macroTL = macroTL + "                cellMask3DTitleForVolume = getTitle();\n";
macroTL = macroTL + "                getDimensions(cellMaskVolW, cellMaskVolH, cellMaskVolC, cellMaskVolZ, cellMaskVolF);\n";
macroTL = macroTL + "                for (cell = 1; cell <= cellCount2D; cell++) {\n";
macroTL = macroTL + "                    voxelSumForCell = 0;\n";
macroTL = macroTL + "                    for (zv = 1; zv <= cellMaskVolZ; zv++) {\n";
macroTL = macroTL + "                        selectWindow(cellMask3DTitleForVolume); setSlice(zv); roiManager(\"Select\", cell - 1);\n";
macroTL = macroTL + "                        getRawStatistics(tmpNPixCellVol, tmpMeanCellVol, tmpMinCellVol, tmpMaxCellVol, tmpStdCellVol);\n";
macroTL = macroTL + "                        voxelSumForCell = voxelSumForCell + (tmpNPixCellVol * tmpMeanCellVol / 255.0);\n";
macroTL = macroTL + "                    }\n";
macroTL = macroTL + "                    cellVolume3DArrFrom2DROI[cell] = voxelSumForCell * pixelWidth * pixelHeight * voxelDepth;\n";
macroTL = macroTL + "                }\n";
macroTL = macroTL + "                for (c = 0; c < cellCount2D; c++) {\n";
macroTL = macroTL + "                    roiManager(\"Select\", c);\n";
macroTL = macroTL + "                    for (i = 0; i < satCount; i++) {\n";
macroTL = macroTL + "                        if (satCellID2D[i] == 0) {\n";
macroTL = macroTL + "                            if (safeSelectionContains(xArr[i], yArr[i])) {\n";
macroTL = macroTL + "                                satCellID2D[i] = c + 1;\n";
macroTL = macroTL + "                                satCellArea2D[i] = cellArea2DArr[c + 1];\n";
macroTL = macroTL + "                                satCellVolume2D[i] = cellVolume3DArrFrom2DROI[c + 1];\n";
macroTL = macroTL + "                            }\n";
macroTL = macroTL + "                        }\n";
macroTL = macroTL + "                    }\n";
macroTL = macroTL + "                }\n";
macroTL = macroTL + "                centCellID2D = newArray(centrosomeCount);\n";
macroTL = macroTL + "                for (c = 0; c < centrosomeCount; c++) centCellID2D[c] = 0;\n";
macroTL = macroTL + "                for (cell = 1; cell <= cellCount2D; cell++) {\n";
macroTL = macroTL + "                    roiManager(\"Select\", cell - 1);\n";
macroTL = macroTL + "                    for (c = 0; c < centrosomeCount; c++) {\n";
macroTL = macroTL + "                        cxPixTmp = centXArr[c] / pixelWidth; cyPixTmp = centYArr[c] / pixelHeight;\n";
macroTL = macroTL + "                        if (safeSelectionContains(cxPixTmp, cyPixTmp)) centCellID2D[c] = cell;\n";
macroTL = macroTL + "                    }\n";
macroTL = macroTL + "                }\n";
macroTL = macroTL + "                for (i = 0; i < satCount; i++) {\n";
macroTL = macroTL + "                    thisCellID = satCellID2D[i];\n";
macroTL = macroTL + "                    if (thisCellID > 0 && centrosomeCount > 0) {\n";
macroTL = macroTL + "                        localN = 0; bestDistLocal = 999999999; bestCentLocal = -1; midX = 0; midY = 0; midZ = 0;\n";
macroTL = macroTL + "                        for (c = 0; c < centrosomeCount; c++) {\n";
macroTL = macroTL + "                            if (centCellID2D[c] == thisCellID) {\n";
macroTL = macroTL + "                                localN = localN + 1; midX = midX + centXArr[c]; midY = midY + centYArr[c]; midZ = midZ + centZArr[c];\n";
macroTL = macroTL + "                                sxUm = xArr[i] * pixelWidth; syUm = yArr[i] * pixelHeight; szUm = (zArr[i] - 1) * voxelDepth;\n";
macroTL = macroTL + "                                dx = sxUm - centXArr[c]; dy = syUm - centYArr[c]; dz = szUm - centZArr[c];\n";
macroTL = macroTL + "                                distLocal = sqrt(dx * dx + dy * dy + dz * dz);\n";
macroTL = macroTL + "                                if (distLocal < bestDistLocal) { bestDistLocal = distLocal; bestCentLocal = c; }\n";
macroTL = macroTL + "                            }\n";
macroTL = macroTL + "                        }\n";
macroTL = macroTL + "                        if (localN == 0) { satAssignedCent2D[i] = \"NaN\"; satAssignedCentDist2D[i] = \"NaN\"; }\n";
macroTL = macroTL + "                        else if (localN == 1 || multiCentrosomeMode == \"Use all centrosomes in cell (assign nearest)\") { satAssignedCent2D[i] = centIdArr[bestCentLocal]; satAssignedCentDist2D[i] = bestDistLocal; }\n";
macroTL = macroTL + "                        else if (multiCentrosomeMode == \"Use midpoint of centrosomes in cell\") { midX = midX / localN; midY = midY / localN; midZ = midZ / localN; sxUm = xArr[i] * pixelWidth; syUm = yArr[i] * pixelHeight; szUm = (zArr[i] - 1) * voxelDepth; dx = sxUm - midX; dy = syUm - midY; dz = szUm - midZ; satAssignedCent2D[i] = \"midpoint\"; satAssignedCentDist2D[i] = sqrt(dx * dx + dy * dy + dz * dz); }\n";
macroTL = macroTL + "                        else if (multiCentrosomeMode == \"Ignore cells with multiple centrosomes\") { satCellID2D[i] = -1; satAssignedCent2D[i] = \"Ignored_multi_centrosome_cell\"; satAssignedCentDist2D[i] = \"NaN\"; }\n";
macroTL = macroTL + "                    }\n";
macroTL = macroTL + "                }\n";
macroTL = macroTL + "                if (saveQCImages) { selectWindow(cellProjectionTitle); roiManager(\"Show All with labels\"); run(\"Flatten\"); rename(\"SQ3D_TL_Cell_Projection_ROI_QC\"); saveAs(\"Tiff\", qcDir + runID + \"_cell_2D_projection_ROI_review_QC.tif\"); close(); }\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        cleanTxt = File.openAsString(resultsPath);\n";
macroTL = macroTL + "        cleanTxt = replace(cleanTxt, \"\\r\\n\", \"\\n\");\n";
macroTL = macroTL + "        cleanTxt = replace(cleanTxt, \"\\r\", \"\\n\");\n";
macroTL = macroTL + "        cleanLines = split(cleanTxt, \"\\n\");\n";
macroTL = macroTL + "        sphericityVolumeCol = sqFindColumnIndex(cleanLines[0], \"Volume_um3\");\n";
macroTL = macroTL + "        if (sphericityVolumeCol < 0) sphericityVolumeCol = sqFindColumnIndex(cleanLines[0], \"Volume (micron^3)\");\n";
macroTL = macroTL + "        if (sphericityVolumeCol < 0) sphericityVolumeCol = sqFindColumnIndex(cleanLines[0], \"Volume\");\n";
macroTL = macroTL + "        sphericitySurfaceCol = sqFindColumnIndex(cleanLines[0], \"Surface_um2\");\n";
macroTL = macroTL + "        if (sphericitySurfaceCol < 0) sphericitySurfaceCol = sqFindColumnIndex(cleanLines[0], \"Surface (micron^2)\");\n";
macroTL = macroTL + "        if (sphericitySurfaceCol < 0) sphericitySurfaceCol = sqFindColumnIndex(cleanLines[0], \"Surface\");\n";
macroTL = macroTL + "        cleanWithDistanceTxt = \"\";\n";
macroTL = macroTL + "        distanceRowIndex = 0;\n";
macroTL = macroTL + "        for (rr = 0; rr < cleanLines.length; rr++) {\n";
macroTL = macroTL + "            line = cleanLines[rr];\n";
macroTL = macroTL + "            if (lengthOf(line) > 0) {\n";
macroTL = macroTL + "                if (rr == 0) {\n";
macroTL = macroTL + "                    cleanWithDistanceTxt = cleanWithDistanceTxt + line + sep + \"Sphericity_3D\" + sep + \"Nearest_Centrosome_ID\" + sep + \"Distance_to_nearest_centrosome_3D\";\n";
macroTL = macroTL + "                    if (cellAssignmentMode == \"Centrosome-centered sphere\") cleanWithDistanceTxt = cleanWithDistanceTxt + sep + \"Cell_ID\" + sep + \"Cell_Volume\" + sep + \"Assigned_Centrosome_ID\" + sep + \"Inside_Cell_Sphere\" + sep + \"Distance_to_Assigned_Centrosome_3D\";\n";
macroTL = macroTL + "                    if (cellAssignmentMode == \"Membrane marker - 2D projected ROI\" || cellAssignmentMode == \"Cytoplasmic signal boundary - 2D projected ROI\") cleanWithDistanceTxt = cleanWithDistanceTxt + sep + \"Cell_ID\" + sep + \"Cell_Area_um2\" + sep + \"Cell_Volume_um3\" + sep + \"Assigned_Centrosome_ID\" + sep + \"Inside_Cell_ROI_2D\" + sep + \"Distance_to_Assigned_Centrosome_3D\";\n";
macroTL = macroTL + "                    cleanWithDistanceTxt = cleanWithDistanceTxt + \"\\n\";\n";
macroTL = macroTL + "                } else {\n";
macroTL = macroTL + "                    if (distanceRowIndex < satCount) {\n";
macroTL = macroTL + "                        nearestID = nearestCentArr[distanceRowIndex];\n";
macroTL = macroTL + "                        nearestDist = nearestDistArr[distanceRowIndex];\n";
macroTL = macroTL + "                        sphericityValue = \"NaN\";\n";
macroTL = macroTL + "                        metricFields = split(line, sep);\n";
macroTL = macroTL + "                        if (sphericityVolumeCol >= 0 && sphericitySurfaceCol >= 0 && metricFields.length > sphericityVolumeCol && metricFields.length > sphericitySurfaceCol) {\n";
macroTL = macroTL + "                            metricVolume = parseFloat(metricFields[sphericityVolumeCol]);\n";
macroTL = macroTL + "                            metricSurface = parseFloat(metricFields[sphericitySurfaceCol]);\n";
macroTL = macroTL + "                            if (metricVolume > 0 && metricSurface > 0) sphericityValue = pow(3.14159265359, 1.0 / 3.0) * pow(6.0 * metricVolume, 2.0 / 3.0) / metricSurface;\n";
macroTL = macroTL + "                        }\n";
macroTL = macroTL + "                        metricLine = line + sep + sphericityValue;\n";
macroTL = macroTL + "                        if (cellAssignmentMode == \"Membrane marker - 2D projected ROI\" || cellAssignmentMode == \"Cytoplasmic signal boundary - 2D projected ROI\") {\n";
macroTL = macroTL + "                            cellID = satCellID2D[distanceRowIndex]; cellArea = satCellArea2D[distanceRowIndex]; cellVolume = satCellVolume2D[distanceRowIndex]; assignedCent = satAssignedCent2D[distanceRowIndex]; assignedDist = satAssignedCentDist2D[distanceRowIndex];\n";
macroTL = macroTL + "                            insideROI = 0; if (cellID > 0) insideROI = 1;\n";
macroTL = macroTL + "                            if (insideROI == 1 || exportOutsideMode == \"Whole image - export outside as Cell_ID NaN\") {\n";
macroTL = macroTL + "                                if (cellID == 0) cellID = \"NaN\";\n";
macroTL = macroTL + "                                cleanWithDistanceTxt = cleanWithDistanceTxt + metricLine + sep + nearestID + sep + nearestDist + sep + cellID + sep + cellArea + sep + cellVolume + sep + assignedCent + sep + insideROI + sep + assignedDist + \"\\n\";\n";
macroTL = macroTL + "                            }\n";
macroTL = macroTL + "                        } else if (cellAssignmentMode == \"Centrosome-centered sphere\") {\n";
macroTL = macroTL + "                            satXAssign = xArr[distanceRowIndex] * pixelWidth; satYAssign = yArr[distanceRowIndex] * pixelHeight; satZAssign = (zArr[distanceRowIndex] - 1) * voxelDepth;\n";
macroTL = macroTL + "                            coordOKAssign = 1; if (satXAssign != satXAssign || satYAssign != satYAssign || satZAssign != satZAssign) coordOKAssign = 0;\n";
macroTL = macroTL + "                            candidateCount = 0; bestInsideCent = -1; bestInsideDist = 999999999; candidateSumX = 0; candidateSumY = 0; candidateSumZ = 0;\n";
macroTL = macroTL + "                            if (coordOKAssign == 1) for (c = 0; c < centrosomeCount; c++) {\n";
macroTL = macroTL + "                                centCoordOK = 1; if (centXArr[c] != centXArr[c] || centYArr[c] != centYArr[c] || centZArr[c] != centZArr[c]) centCoordOK = 0; candDist = 999999999; if (centCoordOK == 1) { dx = satXAssign - centXArr[c]; dy = satYAssign - centYArr[c]; dz = satZAssign - centZArr[c]; candDist = sqrt(dx * dx + dy * dy + dz * dz); }\n";
macroTL = macroTL + "                                if (candDist <= cellSphereRadius) { candidateCount = candidateCount + 1; candidateSumX = candidateSumX + centXArr[c]; candidateSumY = candidateSumY + centYArr[c]; candidateSumZ = candidateSumZ + centZArr[c]; if (candDist < bestInsideDist) { bestInsideDist = candDist; bestInsideCent = c; } }\n";
macroTL = macroTL + "                            }\n";
macroTL = macroTL + "                            if (candidateCount == 0) { cellID = \"NaN\"; cellVolume = \"NaN\"; assignedCent = \"NaN\"; insideSphere = 0; assignedDist = \"NaN\"; }\n";
macroTL = macroTL + "                            else if (candidateCount == 1 || multiSphereMode == \"Use all overlapping spheres (assign nearest centrosome)\") { cellID = centIdArr[bestInsideCent]; cellVolume = (4.0 / 3.0) * 3.14159265359 * cellSphereRadius * cellSphereRadius * cellSphereRadius; assignedCent = centIdArr[bestInsideCent]; insideSphere = 1; assignedDist = bestInsideDist; }\n";
macroTL = macroTL + "                            else if (multiSphereMode == \"Use midpoint of overlapping centrosomes\") { midX = candidateSumX / candidateCount; midY = candidateSumY / candidateCount; midZ = candidateSumZ / candidateCount; dx = satXAssign - midX; dy = satYAssign - midY; dz = satZAssign - midZ; cellID = centIdArr[bestInsideCent]; cellVolume = (4.0 / 3.0) * 3.14159265359 * cellSphereRadius * cellSphereRadius * cellSphereRadius; assignedCent = \"midpoint\"; insideSphere = 1; assignedDist = sqrt(dx * dx + dy * dy + dz * dz); }\n";
macroTL = macroTL + "                            else { cellID = \"NaN\"; cellVolume = \"NaN\"; assignedCent = \"NaN\"; insideSphere = 0; assignedDist = \"NaN\"; }\n";
macroTL = macroTL + "                            if (insideSphere == 1 || outsideSphereMode == \"Keep as Cell_ID NaN\") cleanWithDistanceTxt = cleanWithDistanceTxt + metricLine + sep + nearestID + sep + nearestDist + sep + cellID + sep + cellVolume + sep + assignedCent + sep + insideSphere + sep + assignedDist + \"\\n\";\n";
macroTL = macroTL + "                        } else {\n";
macroTL = macroTL + "                            cleanWithDistanceTxt = cleanWithDistanceTxt + metricLine + sep + nearestID + sep + nearestDist + \"\\n\";\n";
macroTL = macroTL + "                        }\n";
macroTL = macroTL + "                        distanceRowIndex = distanceRowIndex + 1;\n";
macroTL = macroTL + "                    }\n";
macroTL = macroTL + "                }\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        File.saveString(cleanWithDistanceTxt, resultsPath);\n";
macroTL = macroTL + "        excelTsvTxt = replace(cleanWithDistanceTxt, \",\", \"\\t\");\n";

macroTL = macroTL + "\n";
macroTL = macroTL + "        if (saveQCImages && cellAssignmentMode == \"Centrosome-centered sphere\" && centrosomeCount > 0) {\n";
macroTL = macroTL + "            sphereRadiusPixX = cellSphereRadius / pixelWidth;\n";
