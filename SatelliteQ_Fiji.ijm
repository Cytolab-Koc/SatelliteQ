macroTL = macroTL + "                            bestCent = c;\n";
macroTL = macroTL + "                        }\n";
macroTL = macroTL + "                    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "                    if (bestCent >= 0) {\n";
macroTL = macroTL + "                        satNearestCentID[i] = bestCent + 1;\n";
macroTL = macroTL + "                        satNearestCentX[i] = centX[bestCent];\n";
macroTL = macroTL + "                        satNearestCentY[i] = centY[bestCent];\n";
macroTL = macroTL + "                        satNearestCentDistance[i] = bestDistance;\n";
macroTL = macroTL + "                        satAssignedCentLabel[i] = centLabel[bestCent];\n";
macroTL = macroTL + "                    }\n";
macroTL = macroTL + "                }\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (cellAssignmentMode == \"Centrosome radius\" && centrosomeCount > 0) {\n";
macroTL = macroTL + "    for (c = 0; c < centrosomeCount; c++) {\n";
macroTL = macroTL + "        centCellID[c] = c + 1;\n";
macroTL = macroTL + "        centLabel[c] = \"\" + (c + 1);\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";

macroTL = macroTL + "if (!hasCellAreaROIs && cellAssignmentMode != \"Centrosome radius\" && centrosomeCount > 0) {\n";
