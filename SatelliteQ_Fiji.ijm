macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Large-cluster satellite splitting: \" + satSplitMethod + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Only split satellite objects larger than this size: \" + satLargeSplitMinSize + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Forced peak-centered spot radius, pixels: \" + satForcedSpotRadiusPix + \"\\n\";\n";
