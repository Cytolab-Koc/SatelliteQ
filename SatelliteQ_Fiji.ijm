macro2Dsingle = macro2Dsingle + "    Dialog.addChoice(\"Satellite auto-threshold method:\", newArray(\"Otsu\", \"Triangle\", \"Moments\", \"Default\", \"Li\", \"Yen\"), d_satThreshold);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Manual satellite threshold value:\", d_satManualThreshold);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Hysteresis high-threshold multiplier:\", d_satHysteresisMultiplier);\n";
