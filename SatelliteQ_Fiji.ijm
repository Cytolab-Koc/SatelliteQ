macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    roiManager(\"Reset\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    if (centrosomeSelectionMode == \"Automatic bright puncta then review\") {\n";
