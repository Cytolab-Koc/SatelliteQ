macro3Dsingle = macro3Dsingle + "                } else {\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.create(\"Redo 2D projected cell ROI settings\");\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addNumber(\"Cell rolling ball radius, pixels; 0 = off:\", cellRollingBall);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addChoice(\"Cell boundary source type:\", newArray(\"Membrane/boundary marker\", \"Diffuse cytoplasmic protein\", \"Microtubule/cytoskeleton staining\"), cellBoundarySourceType);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addChoice(\"Cell threshold mode:\", newArray(\"Global auto threshold\", \"Local auto threshold\", \"Manual threshold\"), cellThresholdMode);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addChoice(\"Cell global threshold method:\", newArray(\"Otsu\", \"Triangle\", \"Moments\", \"Default\", \"Li\", \"Yen\", \"Huang\"), cellThreshold);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addChoice(\"Cell local threshold method:\", newArray(\"Phansalkar\", \"Sauvola\", \"Bernsen\", \"Niblack\", \"Mean\", \"Median\"), cellLocalThresholdMethod);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addNumber(\"Local threshold radius, pixels:\", cellLocalRadius);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addNumber(\"Manual cell threshold value, AU:\", cellManualThreshold);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addChoice(\"Microtubule/cytoskeleton preprocessing strength:\", newArray(\"Off\", \"Light\", \"Medium\", \"Strong\", \"Very strong\"), cellPreprocessStrength);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addChoice(\"Cell mask cleanup strength:\", newArray(\"None\", \"Very light\", \"Standard\", \"Medium-strong\", \"Strong\", \"Very strong\"), cellCleanupMode);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addCheckbox(\"Split touching/large projected cell ROIs with watershed\", cellDoWatershed);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addChoice(\"Watershed over-splitting protection:\", newArray(\"Off\", \"Light\", \"Medium\", \"Strong\"), cellWatershedProtection);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addNumber(\"Minimum projected cell area, microns^2:\", minCellVoxels);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.addNumber(\"Maximum projected cell area, microns^2:\", maxCellVoxels);\n";
macro3Dsingle = macro3Dsingle + "                    Dialog.show();\n";
macro3Dsingle = macro3Dsingle + "                    cellRollingBall = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "                    cellBoundarySourceType = Dialog.getChoice();\n";
macro3Dsingle = macro3Dsingle + "                    cellThresholdMode = Dialog.getChoice();\n";
macro3Dsingle = macro3Dsingle + "                    cellThreshold = Dialog.getChoice();\n";
macro3Dsingle = macro3Dsingle + "                    cellLocalThresholdMethod = Dialog.getChoice();\n";
macro3Dsingle = macro3Dsingle + "                    cellLocalRadius = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "                    cellManualThreshold = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "                    cellPreprocessStrength = Dialog.getChoice();\n";
macro3Dsingle = macro3Dsingle + "                    cellCleanupMode = Dialog.getChoice();\n";
macro3Dsingle = macro3Dsingle + "                    cellDoWatershed = Dialog.getCheckbox();\n";
macro3Dsingle = macro3Dsingle + "                    cellWatershedProtection = Dialog.getChoice();\n";
macro3Dsingle = macro3Dsingle + "                    minCellVoxels = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "                    maxCellVoxels = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "                }\n";
macro3Dsingle = macro3Dsingle + "            }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "            cellCount2D = roiManager(\"count\");\n";
macro3Dsingle = macro3Dsingle + "            if (cellCount2D > 0) {\n";
macro3Dsingle = macro3Dsingle + "                has2DProjectedCellROIs = true;\n";
macro3Dsingle = macro3Dsingle + "                acceptedCellCountBeforeSave = cellCount2D;\n";
macro3Dsingle = macro3Dsingle + "                roiManager(\"Show All with labels\");\n";
macro3Dsingle = macro3Dsingle + "                roiManager(\"Deselect\");\n";
macro3Dsingle = macro3Dsingle + "                roiManager(\"Save\", cellRoiZip);\n";
macro3Dsingle = macro3Dsingle + "                exportCellBoundaryROIs(cellBoundaryCSV, originalTitle, runID, -1, pixelWidth, pixelHeight);\n";

macro3Dsingle = macro3Dsingle + "                cellArea2DArr = newArray(cellCount2D + 1);\n";
macro3Dsingle = macro3Dsingle + "                for (cell = 0; cell <= cellCount2D; cell++) cellArea2DArr[cell] = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "                cellVolume3DArrFrom2DROI = newArray(cellCount2D + 1);\n";
macro3Dsingle = macro3Dsingle + "                for (cell = 0; cell <= cellCount2D; cell++) cellVolume3DArrFrom2DROI[cell] = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "                cellMask3DTitleForVolume = \"\";\n";
macro3Dsingle = macro3Dsingle + "                if (isOpen(\"SQ3D_Cell_3DMask_ForROI_Volume\")) { selectWindow(\"SQ3D_Cell_3DMask_ForROI_Volume\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "                if (isOpen(\"SQ3D_Cell_3DMask_Boundary_ForROI_Volume\")) { selectWindow(\"SQ3D_Cell_3DMask_Boundary_ForROI_Volume\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "                if (isOpen(\"SQ3D_Cell_ZStack_ROI_3DVolume_Review\")) { selectWindow(\"SQ3D_Cell_ZStack_ROI_3DVolume_Review\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "                if (isOpen(\"SQ3D_Cell_Channel_For2DROI\")) {\n";
macro3Dsingle = macro3Dsingle + "                    selectWindow(\"SQ3D_Cell_Channel_For2DROI\");\n";
macro3Dsingle = macro3Dsingle + "                    run(\"Duplicate...\", \"title=SQ3D_Cell_3DMask_ForROI_Volume duplicate\");\n";
macro3Dsingle = macro3Dsingle + "                    selectWindow(\"SQ3D_Cell_3DMask_ForROI_Volume\");\n";
macro3Dsingle = macro3Dsingle + "                    if (cellThresholdMode == \"Global auto threshold\") { setAutoThreshold(cellThreshold + \" dark\"); setOption(\"BlackBackground\", true); run(\"Convert to Mask\", \"method=Default background=Dark black stack\"); }\n";
macro3Dsingle = macro3Dsingle + "                    else if (cellThresholdMode == \"Manual threshold\") { setThreshold(cellManualThreshold, 65535); setOption(\"BlackBackground\", true); run(\"Convert to Mask\", \"method=Default background=Dark black stack\"); }\n";
macro3Dsingle = macro3Dsingle + "                    else { run(\"Auto Local Threshold\", \"method=\" + cellLocalThresholdMethod + \" radius=\" + cellLocalRadius + \" parameter_1=0 parameter_2=0 white stack\"); }\n";
macro3Dsingle = macro3Dsingle + "                    setOption(\"BlackBackground\", true);\n";
macro3Dsingle = macro3Dsingle + "                    if (cellCleanupMode == \"Very light\") { run(\"Fill Holes\", \"stack\"); }\n";
macro3Dsingle = macro3Dsingle + "                    if (cellCleanupMode == \"Standard\") { run(\"Close-\", \"stack\"); run(\"Fill Holes\", \"stack\"); }\n";
macro3Dsingle = macro3Dsingle + "                    if (cellCleanupMode == \"Medium-strong\") { run(\"Close-\", \"stack\"); run(\"Close-\", \"stack\"); run(\"Fill Holes\", \"stack\"); }\n";
macro3Dsingle = macro3Dsingle + "                    if (cellCleanupMode == \"Strong\") { run(\"Close-\", \"stack\"); run(\"Close-\", \"stack\"); run(\"Close-\", \"stack\"); run(\"Fill Holes\", \"stack\"); }\n";
macro3Dsingle = macro3Dsingle + "                    if (cellCleanupMode == \"Very strong\") { run(\"Close-\", \"stack\"); run(\"Close-\", \"stack\"); run(\"Close-\", \"stack\"); run(\"Fill Holes\", \"stack\"); run(\"Open\", \"stack\"); run(\"Close-\", \"stack\"); run(\"Fill Holes\", \"stack\"); }\n";
macro3Dsingle = macro3Dsingle + "                    cellMask3DTitleForVolume = getTitle();\n";
macro3Dsingle = macro3Dsingle + "                    getDimensions(cellMaskVolW, cellMaskVolH, cellMaskVolC, cellMaskVolZ, cellMaskVolF);\n";
macro3Dsingle = macro3Dsingle + "                    for (cell = 1; cell <= cellCount2D; cell++) {\n";
macro3Dsingle = macro3Dsingle + "                        voxelSumForCell = 0;\n";
macro3Dsingle = macro3Dsingle + "                        for (zv = 1; zv <= cellMaskVolZ; zv++) {\n";
macro3Dsingle = macro3Dsingle + "                            selectWindow(cellMask3DTitleForVolume);\n";
macro3Dsingle = macro3Dsingle + "                            setSlice(zv);\n";
macro3Dsingle = macro3Dsingle + "                            roiManager(\"Select\", cell - 1);\n";
macro3Dsingle = macro3Dsingle + "                            getRawStatistics(tmpNPixCellVol, tmpMeanCellVol, tmpMinCellVol, tmpMaxCellVol, tmpStdCellVol);\n";
macro3Dsingle = macro3Dsingle + "                            voxelSumForCell = voxelSumForCell + (tmpNPixCellVol * tmpMeanCellVol / 255.0);\n";
macro3Dsingle = macro3Dsingle + "                        }\n";
macro3Dsingle = macro3Dsingle + "                        cellVolume3DArrFrom2DROI[cell] = voxelSumForCell * pixelWidth * pixelHeight * voxelDepth;\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                    selectWindow(\"SQ3D_Cell_Channel_For2DROI\");\n";
macro3Dsingle = macro3Dsingle + "                    run(\"Duplicate...\", \"title=SQ3D_Cell_ZStack_ROI_3DVolume_Review duplicate\");\n";
macro3Dsingle = macro3Dsingle + "                    cell3DVolReviewTitle = getTitle();\n";
macro3Dsingle = macro3Dsingle + "                    run(\"8-bit\");\n";
macro3Dsingle = macro3Dsingle + "                    resetMinAndMax();\n";
macro3Dsingle = macro3Dsingle + "                    run(\"Enhance Contrast\", \"saturated=0.35 stack\");\n";
macro3Dsingle = macro3Dsingle + "                    selectWindow(cellMask3DTitleForVolume);\n";
macro3Dsingle = macro3Dsingle + "                    run(\"Duplicate...\", \"title=SQ3D_Cell_3DMask_Boundary_ForROI_Volume duplicate\");\n";
macro3Dsingle = macro3Dsingle + "                    cellBoundaryMaskForVolTitle = getTitle();\n";
macro3Dsingle = macro3Dsingle + "                    setThreshold(1, 255);\n";
macro3Dsingle = macro3Dsingle + "                    setOption(\"BlackBackground\", true);\n";
macro3Dsingle = macro3Dsingle + "                    run(\"Convert to Mask\", \"method=Default background=Dark black stack\");\n";
macro3Dsingle = macro3Dsingle + "                    selectWindow(cell3DVolReviewTitle);\n";
macro3Dsingle = macro3Dsingle + "                    Overlay.remove;\n";
macro3Dsingle = macro3Dsingle + "                    run(\"Select None\");\n";
macro3Dsingle = macro3Dsingle + "                    cellBoundaryRoiStartCountForVol = roiManager(\"count\");\n";
macro3Dsingle = macro3Dsingle + "                    if (cellBoundaryMaskForVolTitle != \"\" && isOpen(cellBoundaryMaskForVolTitle)) {\n";
macro3Dsingle = macro3Dsingle + "                        selectWindow(cellBoundaryMaskForVolTitle);\n";
macro3Dsingle = macro3Dsingle + "                        getDimensions(boundCellW, boundCellH, boundCellC, boundCellZ, boundCellF);\n";
macro3Dsingle = macro3Dsingle + "                        for (maskZ = 1; maskZ <= boundCellZ; maskZ++) {\n";
macro3Dsingle = macro3Dsingle + "                            selectWindow(cellBoundaryMaskForVolTitle);\n";
macro3Dsingle = macro3Dsingle + "                            setSlice(maskZ);\n";
macro3Dsingle = macro3Dsingle + "                            resetThreshold();\n";
macro3Dsingle = macro3Dsingle + "                            getStatistics(maskAreaCell, maskMeanCell, maskMinCell, maskMaxCell, maskStdCell);\n";
macro3Dsingle = macro3Dsingle + "                            if (maskMaxCell > 0) {\n";
macro3Dsingle = macro3Dsingle + "                                setThreshold(1, 255);\n";
macro3Dsingle = macro3Dsingle + "                                run(\"Create Selection\");\n";
macro3Dsingle = macro3Dsingle + "                                if (selectionType() != -1) {\n";
macro3Dsingle = macro3Dsingle + "                                    roiManager(\"Add\");\n";
macro3Dsingle = macro3Dsingle + "                                    tmpBoundaryIndexCell = roiManager(\"count\") - 1;\n";
macro3Dsingle = macro3Dsingle + "                                    selectWindow(cell3DVolReviewTitle);\n";
macro3Dsingle = macro3Dsingle + "                                    setSlice(maskZ);\n";
macro3Dsingle = macro3Dsingle + "                                    roiManager(\"Select\", tmpBoundaryIndexCell);\n";
macro3Dsingle = macro3Dsingle + "                                    Roi.setStrokeColor(\"magenta\");\n";
macro3Dsingle = macro3Dsingle + "                                    Roi.setStrokeWidth(2);\n";
macro3Dsingle = macro3Dsingle + "                                    Roi.setPosition(maskZ);\n";
macro3Dsingle = macro3Dsingle + "                                    Overlay.addSelection();\n";
macro3Dsingle = macro3Dsingle + "                                    run(\"Select None\");\n";
macro3Dsingle = macro3Dsingle + "                                }\n";
macro3Dsingle = macro3Dsingle + "                            }\n";
macro3Dsingle = macro3Dsingle + "                        }\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                    cellRoiCountAfterMaskBoundary = roiManager(\"count\");\n";
macro3Dsingle = macro3Dsingle + "                    for (delR = cellRoiCountAfterMaskBoundary - 1; delR >= cellBoundaryRoiStartCountForVol; delR--) {\n";
macro3Dsingle = macro3Dsingle + "                        roiManager(\"Select\", delR);\n";
macro3Dsingle = macro3Dsingle + "                        roiManager(\"Delete\");\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                    roiManager(\"Deselect\");\n";
macro3Dsingle = macro3Dsingle + "                    cellCount2D = roiManager(\"count\");\n";
macro3Dsingle = macro3Dsingle + "                    if (cellCount2D != acceptedCellCountBeforeSave) {\n";
macro3Dsingle = macro3Dsingle + "                        showMessage(\"Cell ROI count warning\", \"SatelliteQ expected \" + acceptedCellCountBeforeSave + \" accepted cell ROIs, but ROI Manager currently contains \" + cellCount2D + \". Please report this number if it happens again.\");\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                    roiManager(\"Show All with labels\");\n";
macro3Dsingle = macro3Dsingle + "                    roiManager(\"Deselect\");\n";
macro3Dsingle = macro3Dsingle + "                    roiManager(\"Save\", cellRoiZip);\n";
macro3Dsingle = macro3Dsingle + "                    selectWindow(cell3DVolReviewTitle);\n";
macro3Dsingle = macro3Dsingle + "                    getDimensions(reviewCellW, reviewCellH, reviewCellC, reviewCellZ, reviewCellF);\n";
macro3Dsingle = macro3Dsingle + "                    setFont(\"SansSerif\", 6, \"plain antialiased\");\n";
macro3Dsingle = macro3Dsingle + "                    for (rz = 1; rz <= reviewCellZ; rz++) {\n";
macro3Dsingle = macro3Dsingle + "                        selectWindow(cell3DVolReviewTitle);\n";
macro3Dsingle = macro3Dsingle + "                        setSlice(rz);\n";
macro3Dsingle = macro3Dsingle + "                        for (cell = 0; cell < cellCount2D; cell++) {\n";
macro3Dsingle = macro3Dsingle + "                            roiManager(\"Select\", cell);\n";
macro3Dsingle = macro3Dsingle + "                            Roi.setStrokeColor(\"cyan\");\n";
macro3Dsingle = macro3Dsingle + "                            Roi.setStrokeWidth(3);\n";
macro3Dsingle = macro3Dsingle + "                            Roi.setPosition(rz);\n";
macro3Dsingle = macro3Dsingle + "                            Overlay.addSelection();\n";
macro3Dsingle = macro3Dsingle + "                        }\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                    selectWindow(cell3DVolReviewTitle);\n";
macro3Dsingle = macro3Dsingle + "                    setColor(0, 255, 255);\n";
macro3Dsingle = macro3Dsingle + "                    setFont(\"SansSerif\", 10, \"bold antialiased\");\n";
macro3Dsingle = macro3Dsingle + "                    for (rz = 1; rz <= reviewCellZ; rz++) {\n";
macro3Dsingle = macro3Dsingle + "                        selectWindow(cell3DVolReviewTitle);\n";
macro3Dsingle = macro3Dsingle + "                        setSlice(rz);\n";
macro3Dsingle = macro3Dsingle + "                        for (cell = 0; cell < cellCount2D; cell++) {\n";
macro3Dsingle = macro3Dsingle + "                            roiManager(\"Select\", cell);\n";
macro3Dsingle = macro3Dsingle + "                            getSelectionBounds(cellBoxX, cellBoxY, cellBoxW, cellBoxH);\n";
macro3Dsingle = macro3Dsingle + "                            Overlay.drawString(\"C\" + (cell + 1), cellBoxX + 3, cellBoxY + 12);\n";
macro3Dsingle = macro3Dsingle + "                        }\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                    selectWindow(cell3DVolReviewTitle);\n";
macro3Dsingle = macro3Dsingle + "                    midReviewZ = floor(reviewCellZ / 2);\n";
macro3Dsingle = macro3Dsingle + "                    if (midReviewZ < 1) midReviewZ = 1;\n";
macro3Dsingle = macro3Dsingle + "                    setSlice(midReviewZ);\n";
macro3Dsingle = macro3Dsingle + "                    Overlay.show;\n";
macro3Dsingle = macro3Dsingle + "                    waitForUser(\"Review cell-volume Z-stack\", \"This is the scrollable Z-stack review.\\n\\nCyan thick outlines + C labels = accepted projected cell ROIs repeated through Z.\\nMagenta boundaries = thresholded 3D positive cell mask used for volume measurement.\\n\\nCell volume is counted through all Z slices inside each accepted ROI.\\n\\nClick OK to continue.\");\n";
macro3Dsingle = macro3Dsingle + "                    roiManager(\"Reset\");\n";
macro3Dsingle = macro3Dsingle + "                    if (File.exists(cellRoiZip)) roiManager(\"Open\", cellRoiZip);\n";
macro3Dsingle = macro3Dsingle + "                    cellCount2D = roiManager(\"count\");\n";
macro3Dsingle = macro3Dsingle + "                    if (cellBoundaryMaskForVolTitle != \"\" && isOpen(cellBoundaryMaskForVolTitle)) { selectWindow(cellBoundaryMaskForVolTitle); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "                }\n";
macro3Dsingle = macro3Dsingle + "                selectWindow(cellProjectionTitle);\n";
macro3Dsingle = macro3Dsingle + "                for (c = 0; c < cellCount2D; c++) {\n";
macro3Dsingle = macro3Dsingle + "                    roiManager(\"Select\", c);\n";
macro3Dsingle = macro3Dsingle + "                    getStatistics(tmpCellArea);\n";
macro3Dsingle = macro3Dsingle + "                    cellArea2DArr[c + 1] = tmpCellArea;\n";
macro3Dsingle = macro3Dsingle + "                    for (i = 0; i < satCount; i++) {\n";
macro3Dsingle = macro3Dsingle + "                        if (safeSelectionContains(xArr[i], yArr[i])) {\n";
macro3Dsingle = macro3Dsingle + "                            if (satCellID2D[i] == 0) {\n";
macro3Dsingle = macro3Dsingle + "                                satCellID2D[i] = c + 1;\n";
macro3Dsingle = macro3Dsingle + "                                satCellArea2D[i] = tmpCellArea;\n";
macro3Dsingle = macro3Dsingle + "                                if (c + 1 <= cellCount2D) satCellVolume2D[i] = cellVolume3DArrFrom2DROI[c + 1];\n";
macro3Dsingle = macro3Dsingle + "                            }\n";
macro3Dsingle = macro3Dsingle + "                        }\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                centCellID2D = newArray(centrosomeCount);\n";
macro3Dsingle = macro3Dsingle + "                for (c = 0; c < centrosomeCount; c++) centCellID2D[c] = 0;\n";
macro3Dsingle = macro3Dsingle + "                if (centrosomeCount > 0) {\n";
macro3Dsingle = macro3Dsingle + "                    selectWindow(cellProjectionTitle);\n";
macro3Dsingle = macro3Dsingle + "                    for (c = 0; c < centrosomeCount; c++) {\n";
macro3Dsingle = macro3Dsingle + "                        cxCell2D = centXArr[c] / pixelWidth;\n";
macro3Dsingle = macro3Dsingle + "                        cyCell2D = centYArr[c] / pixelHeight;\n";
macro3Dsingle = macro3Dsingle + "                        for (cell = 1; cell <= cellCount2D; cell++) {\n";
macro3Dsingle = macro3Dsingle + "                            roiManager(\"Select\", cell - 1);\n";
macro3Dsingle = macro3Dsingle + "                            if (safeSelectionContains(cxCell2D, cyCell2D) && centCellID2D[c] == 0) centCellID2D[c] = cell;\n";
macro3Dsingle = macro3Dsingle + "                        }\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                for (i = 0; i < satCount; i++) {\n";
macro3Dsingle = macro3Dsingle + "                    thisCellID = satCellID2D[i];\n";
macro3Dsingle = macro3Dsingle + "                    if (thisCellID > 0 && centrosomeCount > 0) {\n";
macro3Dsingle = macro3Dsingle + "                        localN = 0; bestDistLocal = 999999999; bestCentLocal = -1; midX = 0; midY = 0; midZ = 0;\n";
macro3Dsingle = macro3Dsingle + "                        for (c = 0; c < centrosomeCount; c++) {\n";
macro3Dsingle = macro3Dsingle + "                            if (centCellID2D[c] == thisCellID) {\n";
macro3Dsingle = macro3Dsingle + "                                localN = localN + 1;\n";
macro3Dsingle = macro3Dsingle + "                                midX = midX + centXArr[c]; midY = midY + centYArr[c]; midZ = midZ + centZArr[c];\n";
macro3Dsingle = macro3Dsingle + "                                sxUm = xArr[i] * pixelWidth; syUm = yArr[i] * pixelHeight; szUm = (zArr[i] - 1) * voxelDepth;\n";
macro3Dsingle = macro3Dsingle + "                                dx = sxUm - centXArr[c]; dy = syUm - centYArr[c]; dz = szUm - centZArr[c];\n";
macro3Dsingle = macro3Dsingle + "                                distLocal = sqrt(dx * dx + dy * dy + dz * dz);\n";
macro3Dsingle = macro3Dsingle + "                                if (distLocal < bestDistLocal) { bestDistLocal = distLocal; bestCentLocal = c; }\n";
macro3Dsingle = macro3Dsingle + "                            }\n";
macro3Dsingle = macro3Dsingle + "                        }\n";
macro3Dsingle = macro3Dsingle + "                        if (localN == 0) { satAssignedCent2D[i] = \"NaN\"; satAssignedCentDist2D[i] = \"NaN\"; }\n";
macro3Dsingle = macro3Dsingle + "                        else if (localN == 1 || multiCentrosomeMode == \"Use all centrosomes in cell (assign nearest)\") { satAssignedCent2D[i] = centIdArr[bestCentLocal]; satAssignedCentDist2D[i] = bestDistLocal; }\n";
macro3Dsingle = macro3Dsingle + "                        else if (multiCentrosomeMode == \"Use midpoint of centrosomes in cell\") {\n";
macro3Dsingle = macro3Dsingle + "                            midX = midX / localN; midY = midY / localN; midZ = midZ / localN;\n";
macro3Dsingle = macro3Dsingle + "                            sxUm = xArr[i] * pixelWidth; syUm = yArr[i] * pixelHeight; szUm = (zArr[i] - 1) * voxelDepth;\n";
macro3Dsingle = macro3Dsingle + "                            dx = sxUm - midX; dy = syUm - midY; dz = szUm - midZ;\n";
macro3Dsingle = macro3Dsingle + "                            satAssignedCent2D[i] = \"midpoint\"; satAssignedCentDist2D[i] = sqrt(dx * dx + dy * dy + dz * dz);\n";
macro3Dsingle = macro3Dsingle + "                        } else if (multiCentrosomeMode == \"Ignore cells with multiple centrosomes\") {\n";
macro3Dsingle = macro3Dsingle + "                            satCellID2D[i] = -1;\n";
macro3Dsingle = macro3Dsingle + "                            satAssignedCent2D[i] = \"Ignored_multi_centrosome_cell\";\n";
macro3Dsingle = macro3Dsingle + "                            satAssignedCentDist2D[i] = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "                        }\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                if (saveQCImages) {\n";
macro3Dsingle = macro3Dsingle + "                    selectWindow(cellProjectionTitle);\n";
macro3Dsingle = macro3Dsingle + "                    roiManager(\"Show All with labels\");\n";
macro3Dsingle = macro3Dsingle + "                    run(\"Flatten\");\n";
macro3Dsingle = macro3Dsingle + "                    rename(\"SQ3D_Cell_Projection_ROI_QC\");\n";
macro3Dsingle = macro3Dsingle + "                    saveAs(\"Tiff\", qcDir + runID + \"_cell_2D_projection_ROI_review_QC.tif\");\n";
macro3Dsingle = macro3Dsingle + "                    setOption(\"Changes\", false); close();\n";
macro3Dsingle = macro3Dsingle + "                }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                if (isOpen(\"SQ3D_Satellite_Review_Stack\")) {\n";
macro3Dsingle = macro3Dsingle + "                    selectWindow(\"SQ3D_Satellite_Review_Stack\");\n";
macro3Dsingle = macro3Dsingle + "                    for (c = 0; c < cellCount2D; c++) {\n";
macro3Dsingle = macro3Dsingle + "                        roiManager(\"Select\", c);\n";
macro3Dsingle = macro3Dsingle + "                        Roi.setStrokeColor(\"cyan\");\n";
macro3Dsingle = macro3Dsingle + "                        Roi.setStrokeWidth(1);\n";
macro3Dsingle = macro3Dsingle + "                        Overlay.addSelection();\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                    Overlay.show;\n";
macro3Dsingle = macro3Dsingle + "                }\n";
macro3Dsingle = macro3Dsingle + "            }\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "}\n";

macro3Dsingle = macro3Dsingle + "// -------------------------------------------------------------------------\n";
macro3Dsingle = macro3Dsingle + "// Primary-cilium cell assignment/export for 3D source data. Cilium measurements remain 2D max-projection measurements.\n";
macro3Dsingle = macro3Dsingle + "// -------------------------------------------------------------------------\n";
macro3Dsingle = macro3Dsingle + "if (ciliumChannel > 0) {\n";
macro3Dsingle = macro3Dsingle + "    ciliumCellRoisSaved = false;\n";
macro3Dsingle = macro3Dsingle + "    if ((cellAssignmentMode == \"Membrane marker - 2D projected ROI\" || cellAssignmentMode == \"Cytoplasmic signal boundary - 2D projected ROI\") && cellRoiZip != \"\" && File.exists(cellRoiZip)) {\n";
macro3Dsingle = macro3Dsingle + "        roiManager(\"Reset\"); roiManager(\"Open\", cellRoiZip); if (roiManager(\"count\") > 0) ciliumCellRoisSaved = true;\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "    ciliumCellTotal = 0;\n";
macro3Dsingle = macro3Dsingle + "    if (ciliumCellRoisSaved) ciliumCellTotal = roiManager(\"count\");\n";
macro3Dsingle = macro3Dsingle + "    for (ci = 0; ci < ciliumCount; ci++) {\n";
macro3Dsingle = macro3Dsingle + "        cCell[ci] = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "        if (ciliumCellRoisSaved) {\n";
macro3Dsingle = macro3Dsingle + "            for (ccx = 0; ccx < roiManager(\"count\"); ccx++) { roiManager(\"Select\", ccx); if (safeSelectionContains(cX[ci]/pixelWidth, cY[ci]/pixelHeight)) { cCell[ci] = ccx + 1; ccx = roiManager(\"count\"); } }\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "    cHeader = \"Run_ID,Image,Frame,Mode,Cilium_ID,Cell_ID,Cilium_Length_um,Cilium_X_um,Cilium_Y_um,Cilium_Z_um,Ciliated,Ciliation_Length_Threshold_um\\n\"; File.saveString(cHeader, ciliumQuantPath);\n";
macro3Dsingle = macro3Dsingle + "    skHeader = \"Run_ID,Image,Frame,Mode,Cilium_ID,Cell_ID,Point_Index,X_um,Y_um,Z_um\\n\"; File.saveString(skHeader, ciliumSkeletonPath);\n";
macro3Dsingle = macro3Dsingle + "    for (ci = 0; ci < ciliumCount; ci++) {\n";
macro3Dsingle = macro3Dsingle + "        cflag = 1; File.append(runID + \",\" + originalTitle + \",,2D,\" + (ci+1) + \",\" + cCell[ci] + \",\" + cLen[ci] + \",\" + cX[ci] + \",\" + cY[ci] + \",\" + cZ[ci] + \",\" + cflag + \",\" + ciliumMinLength + \"\\n\", ciliumQuantPath);\n";
macro3Dsingle = macro3Dsingle + "        if (lengthOf(cPath[ci]) > 0) { pts = split(cPath[ci], \";\"); for (pi = 0; pi < pts.length; pi++) { xyz = split(pts[pi], \":\"); if (xyz.length >= 3) File.append(runID + \",\" + originalTitle + \",,2D,\" + (ci+1) + \",\" + cCell[ci] + \",\" + (pi+1) + \",\" + xyz[0] + \",\" + xyz[1] + \",\" + xyz[2] + \"\\n\", ciliumSkeletonPath); } }\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "    csHeader = \"Run_ID,Image,Frame,Mode,Cell_ID,Cilium_Count,Longest_Cilium_Length_um,Mean_Cilium_Length_um,Ciliated,Ciliation_Length_Threshold_um\\n\"; File.saveString(csHeader, ciliumCellSummaryPath);\n";
macro3Dsingle = macro3Dsingle + "    for (cellC = 1; cellC <= ciliumCellTotal; cellC++) {\n";
macro3Dsingle = macro3Dsingle + "        nC = 0; sumC = 0; maxC = 0; for (ci = 0; ci < ciliumCount; ci++) if (cCell[ci] == cellC) { nC++; sumC += cLen[ci]; if (cLen[ci] > maxC) maxC = cLen[ci]; }\n";
macro3Dsingle = macro3Dsingle + "        meanC = 0; if (nC > 0) meanC = sumC/nC; ciliatedC = 0; if (nC > 0) ciliatedC = 1;\n";
macro3Dsingle = macro3Dsingle + "        File.append(runID + \",\" + originalTitle + \",,2D,\" + cellC + \",\" + nC + \",\" + maxC + \",\" + meanC + \",\" + ciliatedC + \",\" + ciliumMinLength + \"\\n\", ciliumCellSummaryPath);\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "// Export final selected options summary as a human-readable text file.\n";
macro3Dsingle = macro3Dsingle + "selectedOptionsPath = outputDir + runID + \"_SELECTED_OPTIONS_SUMMARY.txt\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = \"SatelliteQ SELECTED OPTIONS SUMMARY\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"This file records the final options used for this run, including changes made during redo/review dialogs.\\n\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Run ID: \" + runID + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"SatelliteQ version: \" + sqVersion + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Original image: \" + originalTitle + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Analysis mode: 3D single stack\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Output folder: \" + outputDir + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Save intermediate images: \" + saveQCImages + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Pixel width um: \" + pixelWidth + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Pixel height um: \" + pixelHeight + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Image width pixels: \" + width + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Image height pixels: \" + height + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Voxel depth um: \" + voxelDepth + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"\\n[SATELLITE DETECTION - 3D]\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Satellite channel: \" + satelliteChannel + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Rolling ball radius: \" + rollingBall + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Threshold mode: \" + thresholdMode + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Auto-threshold method: \" + autoMethod + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Manual threshold value: \" + manualThreshold + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Minimum object size, pixels: \" + minVoxels + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Maximum object size, pixels (3D stack object size): \" + maxVoxels + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Exclude objects touching stack edges: \" + excludeEdges + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Override size/edge filters and quantify every detected 3D object: \" + forceQuantifyAll3D + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Effective minimum object size used by 3D counter, voxels: \" + counterMinVoxels + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Effective maximum object size used by 3D counter, voxels: \" + counterMaxVoxels + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Effective exclude-edge setting used by 3D counter: \" + counterExcludeEdges + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Review detected 3D satellites before final export: \" + review3DSatellitesBeforeContinue + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Final 3D satellite count: \" + satCount + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"\\n[CENTROSOME DETECTION / DISTANCE]\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Centrosome channel: \" + centrosomeChannel + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Centrosome selection mode: \" + centrosomeSelectionMode + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Centrosome rolling ball radius, pixels: \" + centRollingBall + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Centrosome threshold mode: \" + centThresholdMode + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Centrosome mean + SD multiplier: \" + centSDMultiplier + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Centrosome percent of max: \" + centPercentMax + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Centrosome manual threshold value, AU: \" + centManualThreshold + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Minimum centrosome area on max projection, micrometers^2: \" + minCentArea + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Maximum centrosome area on max projection, micrometers^2: \" + maxCentArea + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Maximum centrosomes to keep, 0 = keep all: \" + maxCentrosomesKeep + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Centrosome display circle diameter, pixels: \" + centDisplayDiameter + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Centrosome ROI review image: \" + centROIDisplayMode3D + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Final centrosome count: \" + centrosomeCount + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"\\n[PRIMARY CILIUM - 2D MAX PROJECTION]\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cilium channel: \" + ciliumChannel + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cilium measurement dimensionality: 2D max-Z projection of the cilium channel\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cilium rolling ball radius, pixels: \" + ciliumRollingBall + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cilium Gaussian sigma, pixels: \" + ciliumGaussianSigma + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cilium threshold mode: \" + ciliumThresholdMode + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cilium minimum path length um: \" + ciliumMinLength + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cilium maximum path length um: \" + ciliumMaxLength + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"\\n[CELL AREA / CELL ASSIGNMENT]\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cell assignment mode: \" + cellAssignmentMode + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cell boundary / membrane channel: \" + membraneChannel + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cell boundary source type: \" + cellBoundarySourceType + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cell ROI drawing/review image: \" + cellROIDisplayMode + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cell rolling ball radius, pixels: \" + cellRollingBall + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cell threshold mode: \" + cellThresholdMode + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cell global threshold method: \" + cellThreshold + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cell local threshold method: \" + cellLocalThresholdMethod + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Local threshold radius, pixels: \" + cellLocalRadius + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Manual cell threshold value, AU: \" + cellManualThreshold + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Microtubule/cytoskeleton preprocessing strength: \" + cellPreprocessStrength + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cell mask cleanup strength: \" + cellCleanupMode + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Split touching/large cell ROIs or volumes with watershed: \" + cellDoWatershed + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Watershed over-splitting protection: \" + cellWatershedProtection + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "if (cellAssignmentMode == \"Skip cell assignment\") {\n";
macro3Dsingle = macro3Dsingle + "    optionsTxt = optionsTxt + \"Minimum cell filter: Not applied (cell assignment skipped)\\n\";\n";
macro3Dsingle = macro3Dsingle + "    optionsTxt = optionsTxt + \"Maximum cell filter: Not applied (cell assignment skipped)\\n\";\n";
macro3Dsingle = macro3Dsingle + "} else {\n";
macro3Dsingle = macro3Dsingle + "    optionsTxt = optionsTxt + \"Minimum cell filter: \" + minCellVoxels + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "    optionsTxt = optionsTxt + \"Maximum cell filter: \" + maxCellVoxels + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Where to detect/export satellites: \" + exportOutsideMode + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"If a cell contains >1 centrosome: \" + multiCentrosomeMode + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cell sphere radius, microns: \" + cellSphereRadius + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Satellites outside all spheres: \" + outsideSphereMode + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"If a satellite falls inside >1 sphere: \" + multiSphereMode + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"\\n[OUTPUT FILES]\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Clean 3D results CSV: \" + resultsPath + \"\\n\";\n";

macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Cell boundary ROI coordinate CSV: \" + cellBoundaryCSV + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "optionsTxt = optionsTxt + \"Selected options summary: \" + selectedOptionsPath + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "File.saveString(optionsTxt, selectedOptionsPath);\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "if (centrosomeChannel > 0 && File.exists(centStackForReviewPath)) {\n";
macro3Dsingle = macro3Dsingle + "    File.delete(centStackForReviewPath);\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "if (File.exists(rawResultsPath)) {\n";
macro3Dsingle = macro3Dsingle + "    File.delete(rawResultsPath);\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "if (centrosomeChannel > 0 && File.exists(centCoordPath)) {\n";
macro3Dsingle = macro3Dsingle + "    File.delete(centCoordPath);\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "imageTitles = getList(\"image.titles\");\n";
macro3Dsingle = macro3Dsingle + "for (w = imageTitles.length - 1; w >= 0; w--) {\n";
macro3Dsingle = macro3Dsingle + "    selectWindow(imageTitles[w]);\n";
macro3Dsingle = macro3Dsingle + "    close();\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "if (isOpen(\"Results\")) {\n";
macro3Dsingle = macro3Dsingle + "    selectWindow(\"Results\");\n";
macro3Dsingle = macro3Dsingle + "    run(\"Close\");\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "if (isOpen(\"Log\")) {\n";
macro3Dsingle = macro3Dsingle + "    selectWindow(\"Log\");\n";
macro3Dsingle = macro3Dsingle + "    print(\"\\\\Clear\");\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "if (isOpen(\"Summary\")) {\n";
macro3Dsingle = macro3Dsingle + "    selectWindow(\"Summary\");\n";
macro3Dsingle = macro3Dsingle + "    run(\"Close\");\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "if (isOpen(\"ROI Manager\")) {\n";
macro3Dsingle = macro3Dsingle + "    roiManager(\"Reset\");\n";
macro3Dsingle = macro3Dsingle + "    selectWindow(\"ROI Manager\");\n";
macro3Dsingle = macro3Dsingle + "    run(\"Close\");\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "if (isOpen(\"Threshold\")) {\n";
macro3Dsingle = macro3Dsingle + "    selectWindow(\"Threshold\");\n";
macro3Dsingle = macro3Dsingle + "    run(\"Close\");\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "if (isOpen(\"B&C\")) {\n";
macro3Dsingle = macro3Dsingle + "    selectWindow(\"B&C\");\n";
macro3Dsingle = macro3Dsingle + "    run(\"Close\");\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "if (isOpen(\"Brightness/Contrast\")) {\n";
macro3Dsingle = macro3Dsingle + "    selectWindow(\"Brightness/Contrast\");\n";
macro3Dsingle = macro3Dsingle + "    run(\"Close\");\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "// Final cleanup of leftover result/quantification windows.\n";
macro3Dsingle = macro3Dsingle + "run(\"Clear Results\");\n";
macro3Dsingle = macro3Dsingle + "allWinTitles = getList(\"window.titles\");\n";
macro3Dsingle = macro3Dsingle + "for (ww = allWinTitles.length - 1; ww >= 0; ww--) {\n";
macro3Dsingle = macro3Dsingle + "    thisWin = allWinTitles[ww];\n";
macro3Dsingle = macro3Dsingle + "    lw = toLowerCase(thisWin);\n";
macro3Dsingle = macro3Dsingle + "    if (lw == \"results\" || lw == \"summary\" || indexOf(lw, \"results\") >= 0 || indexOf(lw, \"summary\") >= 0 || indexOf(lw, \"3d objects\") >= 0 || indexOf(lw, \"3d object\") >= 0 || indexOf(lw, \"counter\") >= 0 || indexOf(lw, \"quantification\") >= 0 || indexOf(lw, \"measure\") >= 0) {\n";
macro3Dsingle = macro3Dsingle + "        selectWindow(thisWin);\n";
macro3Dsingle = macro3Dsingle + "        run(\"Close\");\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "run(\"Collect Garbage\");\n";
macro3Dsingle = macro3Dsingle + "showMessage(\"SatelliteQuantify 3D\",\n";
macro3Dsingle = macro3Dsingle + "    \"3D satellite/cell analysis completed.\\n\\n\" +\n";
macro3Dsingle = macro3Dsingle + "    \"Satellite count: \" + satCount + \"\\n\\n\" +\n";
macro3Dsingle = macro3Dsingle + "    \"Clean results saved to:\\n\" + resultsPath + \"\\n\\n\" +\n";
macro3Dsingle = macro3Dsingle + "    \"Output folder:\\n\" + outputDir + \"\\n\\nSelected options summary:\\n\" + selectedOptionsPath);\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
    selectedMacroPath = tempDir + "SatelliteQ_selected_3D_single.ijm";
    if (File.exists(selectedMacroPath)) File.delete(selectedMacroPath);
    File.saveString(macro3Dsingle, selectedMacroPath);
    runMacro(selectedMacroPath);
    exit();
}

if (analysisMode == "2D time-lapse" || analysisMode == "3D time-lapse") {
tlInputTitle = getTitle();
tlInputID = getImageID();
originalTitle = tlInputTitle;
getDimensions(parentWidth, parentHeight, channels, slices, frames);
if (frames < 1) frames = 1;
if (frames < 2) exit("This image has fewer than 2 frames. Use 2D single image or 3D single stack mode instead.");

Dialog.create("SatelliteQ time-lapse frame range");
Dialog.addMessage("Image: " + tlInputTitle);
Dialog.addMessage("Detected dimensions: channels=" + channels + ", slices=" + slices + ", frames=" + frames);
Dialog.addNumber("First frame:", 1);
Dialog.addNumber("Last frame:", frames);
Dialog.addNumber("Time interval between frames, minutes:", 1.0);
Dialog.show();
firstFrame = round(Dialog.getNumber());
lastFrame = round(Dialog.getNumber());
timeInterval = Dialog.getNumber();
if (firstFrame < 1) firstFrame = 1;
if (lastFrame > frames) lastFrame = frames;
if (lastFrame < firstFrame) exit("Last frame must be greater than or equal to first frame.");
if (timeInterval < 0) timeInterval = 0;

parentTLOut = getDirectory("Choose main output folder for SatelliteQ time-lapse results");
if (parentTLOut == "") exit("No output folder selected.");
parentTLOut = replace(parentTLOut, "\\", "/");
if (!endsWith(parentTLOut, "/")) parentTLOut = parentTLOut + "/";
tlBaseName = cleanSQName(tlInputTitle);
tlModeName = replace(analysisMode, " ", "_");
tlModeName = replace(tlModeName, "-", "_");
tlOut = parentTLOut + tlBaseName + "_" + tlModeName + "_SatelliteQ_timelapse" + File.separator;
if (!File.exists(tlOut)) File.makeDirectory(tlOut);

summaryCSV = tlOut + tlBaseName + "_timelapse_frame_summary.csv";
combinedCSV = tlOut + tlBaseName + "_timelapse_satellite_rows_combined.csv";
logPath = tlOut + tlBaseName + "_timelapse_log.csv";
File.saveString("", combinedCSV);
if (analysisMode == "2D time-lapse") {
    File.saveString("Frame,Time_min,Satellite_count,Assigned_satellites,Mean_area_um2,Total_intensity_AU,Mean_distance_to_centrosome_um\n", summaryCSV);
} else {
    File.saveString("Frame,Time_min,Satellite_count,Assigned_satellites,Mean_volume_um3,Total_surface_um2,Mean_distance_to_centrosome_3D_um\n", summaryCSV);
}

Dialog.create("SatelliteQ time-lapse settings behavior");
Dialog.addMessage("Choose how the 2D/3D detection and cell ROI settings are handled across frames.");
Dialog.addRadioButtonGroup("Settings behavior:", newArray("Use same accepted settings for all frames", "Ask for settings each frame using previous settings as defaults"), 2, 1, "Use same accepted settings for all frames");
Dialog.show();
frameSettingsChoice = Dialog.getRadioButton();
if (frameSettingsChoice == "Ask for settings each frame using previous settings as defaults") frameSettingsBehavior = "ASK_WITH_PREVIOUS_DEFAULTS";
else frameSettingsBehavior = "USE_SAME_SETTINGS";
sqModePath = tempDir + "SQ_timelapse_frame_settings_mode.txt";
sq2dSettingsPath = tempDir + "SQ_timelapse_2D_settings.txt";
sq3dSettingsPath = tempDir + "SQ_timelapse_3D_settings.txt";
sqScalePath = tempDir + "SQ_timelapse_scale_settings.txt";
sqOutputPath = tempDir + "SQ_timelapse_output_dir.txt";
tempStackPath = tempDir + "SQ_timelapse_parent_stack.tif";
File.saveString(frameSettingsBehavior, sqModePath);
File.saveString(tlOut, sqOutputPath);
getPixelSize(tlUnit, tlPixelWidth, tlPixelHeight, tlVoxelDepth);
if (tlPixelWidth == 0) tlPixelWidth = 1;
if (tlPixelHeight == 0) tlPixelHeight = tlPixelWidth;
if (tlVoxelDepth == 0) tlVoxelDepth = tlPixelWidth;

tlCalibrationSource = "Time-lapse parent image metadata";
tlDefaultScaleChoice = "Use current image calibration";
if (tlUnit == "pixel" || tlUnit == "pixels") tlDefaultScaleChoice = "Enter pixel size manually in microns";

Dialog.create("SatelliteQ image scale / calibration");
Dialog.addMessage("Fiji detected this image scale from the time-lapse image metadata:");
Dialog.addMessage("Unit = " + tlUnit + ", XY pixel size = " + tlPixelWidth + " x " + tlPixelHeight + ", Z step = " + tlVoxelDepth);
Dialog.addMessage("This scale will be reused for all selected time-lapse frames.");
Dialog.addChoice("Image scale/calibration:", newArray("Use current image calibration", "Enter pixel size manually in microns"), tlDefaultScaleChoice);
Dialog.addNumber("XY pixel size, microns per pixel:", tlPixelWidth);
Dialog.addNumber("Z-step size, microns per slice:", tlVoxelDepth);
Dialog.show();
tlScaleChoice = Dialog.getChoice();
tlManualXY = Dialog.getNumber();
tlManualZ = Dialog.getNumber();
if (tlScaleChoice == "Enter pixel size manually in microns") {
    tlPixelWidth = tlManualXY;
    tlPixelHeight = tlManualXY;
    tlVoxelDepth = tlManualZ;
    tlCalibrationSource = "Time-lapse parent manual input";
}
if (tlPixelWidth <= 0) tlPixelWidth = 1;
if (tlPixelHeight <= 0) tlPixelHeight = tlPixelWidth;
if (tlVoxelDepth <= 0) tlVoxelDepth = tlPixelWidth;

File.saveString(tlPixelWidth + "|" + tlPixelHeight + "|" + tlVoxelDepth + "|" + tlCalibrationSource, sqScalePath);
if (File.exists(sq2dSettingsPath)) File.delete(sq2dSettingsPath);
if (File.exists(sq3dSettingsPath)) File.delete(sq3dSettingsPath);
if (File.exists(tempStackPath)) File.delete(tempStackPath);
// Keep the original time-lapse hyperstack open in memory.
// Do NOT save/reopen it as TIFF: that can flatten or reinterpret the T dimension.
selectWindow(tlInputTitle);

if (analysisMode == "2D time-lapse") {
macroTL = "";
macroTL = macroTL + "\n";
macroTL = macroTL + "requires(\"1.53\");\n";
macroTL = macroTL + "sqVersion = \"" + SATELLITEQ_VERSION + "\";\n";
macroTL = macroTL + "function safeSelectionContains(px, py) {\n";
macroTL = macroTL + "    if (selectionType() == -1) return false;\n";
macroTL = macroTL + "    return selectionContains(px, py);\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "function cleanFileName(name) {\n";
macroTL = macroTL + "    name = replace(name, \".tif\", \"\");\n";
macroTL = macroTL + "    name = replace(name, \".tiff\", \"\");\n";
macroTL = macroTL + "    name = replace(name, \".TIF\", \"\");\n";
macroTL = macroTL + "    name = replace(name, \".TIFF\", \"\");\n";
macroTL = macroTL + "    name = replace(name, \" \", \"_\");\n";
macroTL = macroTL + "    name = replace(name, \"-\", \"_\");\n";
macroTL = macroTL + "    name = replace(name, \".\", \"_\");\n";
macroTL = macroTL + "    name = replace(name, \"(\", \"_\");\n";
macroTL = macroTL + "    name = replace(name, \")\", \"_\");\n";
macroTL = macroTL + "    name = replace(name, \"[\", \"_\");\n";
macroTL = macroTL + "    name = replace(name, \"]\", \"_\");\n";
macroTL = macroTL + "    return name;\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "function projectChannel(channelNumber, originalTitle, projectionMethod, newName, slices) {\n";
macroTL = macroTL + "    channelTitle = \"C\" + channelNumber + \"-\" + originalTitle;\n";
macroTL = macroTL + "    if (isOpen(newName)) { selectWindow(newName); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    sourceTitle = channelTitle;\n";
macroTL = macroTL + "    if (!isOpen(sourceTitle) && channelNumber == 1 && isOpen(originalTitle)) sourceTitle = originalTitle;\n";
macroTL = macroTL + "    if (!isOpen(sourceTitle)) {\n";
macroTL = macroTL + "        exit(\"Could not find channel source for channel \" + channelNumber + \".\\n\\nIf this is a single-channel image, SatelliteQ expects channel 1.\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(sourceTitle);\n";
macroTL = macroTL + "    run(\"Select None\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (slices > 1) {\n";
macroTL = macroTL + "        run(\"Z Project...\", \"projection=[\" + projectionMethod + \"]\");\n";
macroTL = macroTL + "        rename(newName);\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=\" + newName);\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "    return newName;\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "function prepareCellROIDrawingView(cellProjection, displayMode) {\n";
macroTL = macroTL + "    viewTitle = cellProjection;\n";
macroTL = macroTL + "    if (displayMode == \"Cell signal channel + cell boundary only\") { selectWindow(viewTitle); return viewTitle; }\n";
macroTL = macroTL + "    if (isOpen(\"Cell_ROI_Drawing_View\")) { selectWindow(\"Cell_ROI_Drawing_View\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_CellROI_Boundary_Tmp\")) { selectWindow(\"SQ_CellROI_Boundary_Tmp\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_CellROI_Sat_Tmp\")) { selectWindow(\"SQ_CellROI_Sat_Tmp\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_CellROI_Cent_Tmp\")) { selectWindow(\"SQ_CellROI_Cent_Tmp\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"Cell_ROI_Centrosome_Projection\")) { selectWindow(\"Cell_ROI_Centrosome_Projection\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    selectWindow(cellProjection); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CellROI_Boundary_Tmp\"); selectWindow(\"SQ_CellROI_Boundary_Tmp\"); run(\"8-bit\");\n";
macroTL = macroTL + "    if (displayMode == \"Cell signal channel + cell boundary + satellite\" || displayMode == \"Cell signal channel + cell boundary + centrosome + satellite\" || displayMode == \"Cell signal channel + cell boundary + centrosome + centrosome numbers + satellite\") { selectWindow(\"Satellite_Projection\"); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CellROI_Sat_Tmp\"); selectWindow(\"SQ_CellROI_Sat_Tmp\"); run(\"8-bit\"); } else { selectWindow(cellProjection); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CellROI_Sat_Tmp\"); selectWindow(\"SQ_CellROI_Sat_Tmp\"); run(\"8-bit\"); run(\"Multiply...\", \"value=0\"); }\n";
macroTL = macroTL + "    if ((displayMode == \"Cell signal channel + cell boundary + centrosome\" || displayMode == \"Cell signal channel + cell boundary + centrosome + satellite\" || displayMode == \"Cell signal channel + cell boundary + centrosome + centrosome numbers + satellite\") && centrosomeChannel > 0) { centProjectionForCellROI = projectChannel(centrosomeChannel, originalTitle, projectionMethod, \"Cell_ROI_Centrosome_Projection\", slices); selectWindow(centProjectionForCellROI); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CellROI_Cent_Tmp\"); selectWindow(\"SQ_CellROI_Cent_Tmp\"); run(\"8-bit\"); } else { selectWindow(cellProjection); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CellROI_Cent_Tmp\"); selectWindow(\"SQ_CellROI_Cent_Tmp\"); run(\"8-bit\"); run(\"Multiply...\", \"value=0\"); }\n";
macroTL = macroTL + "    run(\"Merge Channels...\", \"c1=[SQ_CellROI_Sat_Tmp] c2=[SQ_CellROI_Boundary_Tmp] c3=[SQ_CellROI_Cent_Tmp] create keep\"); rename(\"Cell_ROI_Drawing_View\"); run(\"Make Composite\", \"display=Composite\"); viewTitle = \"Cell_ROI_Drawing_View\";\n";
macroTL = macroTL + "    if (displayMode == \"Cell signal channel + cell boundary + centrosome + centrosome numbers + satellite\" && centrosomeCount > 0) { selectWindow(viewTitle); setFont(\"SansSerif\", 10, \"bold\"); setColor(\"yellow\"); for (cc = 0; cc < centrosomeCount; cc++) drawString(\"C\" + (cc + 1), centXpix[cc] + 4, centYpix[cc] - 4); }\n";
macroTL = macroTL + "    selectWindow(viewTitle); return viewTitle;\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "function prepareCentrosomeDrawingView(displayMode) {\n";
macroTL = macroTL + "    if (isOpen(\"Centrosome_ROI_Drawing_View\")) { selectWindow(\"Centrosome_ROI_Drawing_View\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_CentROI_Sat_Tmp\")) { selectWindow(\"SQ_CentROI_Sat_Tmp\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_CentROI_Cent_Tmp\")) { selectWindow(\"SQ_CentROI_Cent_Tmp\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    viewTitle = \"Centrosome_BackgroundSubtracted\";\n";
macroTL = macroTL + "    if (displayMode == \"Centrosome channel only\") { selectWindow(viewTitle); return viewTitle; }\n";
macroTL = macroTL + "    selectWindow(\"Centrosome_BackgroundSubtracted\"); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CentROI_Cent_Tmp\"); selectWindow(\"SQ_CentROI_Cent_Tmp\"); run(\"8-bit\");\n";
macroTL = macroTL + "    selectWindow(\"Satellite_Projection\"); run(\"Select None\"); run(\"Duplicate...\", \"title=SQ_CentROI_Sat_Tmp\"); selectWindow(\"SQ_CentROI_Sat_Tmp\"); run(\"8-bit\");\n";
macroTL = macroTL + "    run(\"Merge Channels...\", \"c1=[SQ_CentROI_Cent_Tmp] c2=[SQ_CentROI_Sat_Tmp] create keep\"); rename(\"Centrosome_ROI_Drawing_View\"); run(\"Make Composite\", \"display=Composite\"); viewTitle = \"Centrosome_ROI_Drawing_View\";\n";
macroTL = macroTL + "    selectWindow(viewTitle); return viewTitle;\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "// SatelliteQ primary-cilium length helper.\n";
macroTL = macroTL + "// Length follows the CiliaQ approach: 3x upscaling, Gaussian smoothing,\n";
macroTL = macroTL + "// Skeletonize (2D/3D), and the longest-shortest-path measurement from AnalyzeSkeleton.\n";
macroTL = macroTL + "function sqCiliumSkeletonSerialized(maskTitle, is3D, pw, ph, pz, lengthUnit, gaussianSigmaOriginalPixels) {\n";
macroTL = macroTL + "    if (!isOpen(maskTitle)) return \"\";\n";
macroTL = macroTL + "    if (isOpen(\"SQ_Cilium_SkeletonWork\")) { selectWindow(\"SQ_Cilium_SkeletonWork\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_Cilium_Scaled\")) { selectWindow(\"SQ_Cilium_Scaled\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    selectWindow(maskTitle);\n";
macroTL = macroTL + "    run(\"Duplicate...\", \"title=SQ_Cilium_SkeletonWork duplicate\");\n";
macroTL = macroTL + "    selectWindow(\"SQ_Cilium_SkeletonWork\");\n";
macroTL = macroTL + "    run(\"8-bit\");\n";
macroTL = macroTL + "    setThreshold(1, 255);\n";
macroTL = macroTL + "    setOption(\"BlackBackground\", true);\n";
macroTL = macroTL + "    run(\"Convert to Mask\", \"method=Default background=Dark black stack\");\n";
macroTL = macroTL + "    if (is3D) run(\"Scale...\", \"x=3 y=3 z=3 interpolation=None create\");\n";
macroTL = macroTL + "    else run(\"Scale...\", \"x=3 y=3 interpolation=None create\");\n";
macroTL = macroTL + "    rename(\"SQ_Cilium_Scaled\");\n";
macroTL = macroTL + "    if (is3D) setVoxelSize(pw / 3, ph / 3, pz / 3, lengthUnit);\n";
macroTL = macroTL + "    else setVoxelSize(pw / 3, ph / 3, 1, lengthUnit);\n";
macroTL = macroTL + "    sigmaScaled = gaussianSigmaOriginalPixels * 3;\n";
macroTL = macroTL + "    if (sigmaScaled > 0) run(\"Gaussian Blur...\", \"sigma=\" + sigmaScaled + \" stack\");\n";
macroTL = macroTL + "    setThreshold(128, 255);\n";
macroTL = macroTL + "    setOption(\"BlackBackground\", true);\n";
macroTL = macroTL + "    run(\"Convert to Mask\", \"method=Default background=Dark black stack\");\n";
macroTL = macroTL + "    run(\"Skeletonize (2D/3D)\");\n";
macroTL = macroTL + "    cjs = \"var IJ=Packages.ij.IJ; var AS=Packages.sc.fiji.analyzeSkeleton.AnalyzeSkeleton_; var imp=IJ.getImage(); var sk=new AS(); sk.setup('',imp); var res=sk.run(AS.NONE,false,true,null,true,false); var lens=res.getShortestPathList(); var paths=sk.getShortestPathPoints(); var starts=res.getSpStartPosition(); var cal=imp.getCalibration(); var out=''; for(var i=0;i<lens.size();i++){var pp=paths[i]; var sx=0,sy=0,sz=0,ps=''; if(pp!=null && pp.size()>0){for(var j=0;j<pp.size();j++){var p=pp.get(j); var xx=p.x*cal.pixelWidth; var yy=p.y*cal.pixelHeight; var zz=p.z*cal.pixelDepth; sx+=xx; sy+=yy; sz+=zz; if(j>0)ps+=';'; ps+=xx+':'+yy+':'+zz;} sx/=pp.size(); sy/=pp.size(); sz/=pp.size();}else{sx=starts[i][0]; sy=starts[i][1]; sz=starts[i][2];} if(i>0)out+='#'; out+=(i+1)+'~'+Number(lens.get(i))+'~'+sx+'~'+sy+'~'+sz+'~'+ps;} out;\";\n";
macroTL = macroTL + "    serialized = eval(\"script\", cjs);\n";
macroTL = macroTL + "    if (isOpen(\"SQ_Cilium_Scaled\")) { selectWindow(\"SQ_Cilium_Scaled\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_Cilium_SkeletonWork\")) { selectWindow(\"SQ_Cilium_SkeletonWork\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    return serialized;\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "function thresholdToMask(imageTitle, maskTitle, thresholdMode, autoMethod, manualValue, hysteresisMultiplier, doWatershed) {\n";
macroTL = macroTL + "    selectWindow(imageTitle);\n";
macroTL = macroTL + "    run(\"Duplicate...\", \"title=\" + maskTitle);\n";
macroTL = macroTL + "    selectWindow(maskTitle);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (thresholdMode == \"Auto\" || thresholdMode == \"Hysteresis-like\") {\n";
macroTL = macroTL + "        setAutoThreshold(autoMethod + \" dark\");\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        setThreshold(manualValue, 65535);\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    setOption(\"BlackBackground\", false);\n";
macroTL = macroTL + "    run(\"Convert to Mask\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (doWatershed) {\n";
macroTL = macroTL + "        run(\"Watershed\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";

macroTL = macroTL + "\n";
macroTL = macroTL + "function cellThresholdToMask(imageTitle, maskTitle, thresholdMode, globalMethod, localMethod, localRadius, manualValue) {\n";
macroTL = macroTL + "    selectWindow(imageTitle);\n";
macroTL = macroTL + "    run(\"Duplicate...\", \"title=\" + maskTitle);\n";
macroTL = macroTL + "    selectWindow(maskTitle);\n";
macroTL = macroTL + "    if (localRadius < 1) localRadius = 15;\n";
macroTL = macroTL + "    if (thresholdMode == \"Manual threshold\") {\n";
macroTL = macroTL + "        setThreshold(manualValue, 65535);\n";
macroTL = macroTL + "        setOption(\"BlackBackground\", false);\n";
macroTL = macroTL + "        run(\"Convert to Mask\");\n";
macroTL = macroTL + "    } else if (thresholdMode == \"Local auto threshold\") {\n";
macroTL = macroTL + "        run(\"8-bit\");\n";
macroTL = macroTL + "        run(\"Auto Local Threshold\", \"method=\" + localMethod + \" radius=\" + localRadius + \" parameter_1=0 parameter_2=0 white\");\n";
macroTL = macroTL + "        selectWindow(maskTitle);\n";
macroTL = macroTL + "        run(\"8-bit\");\n";
macroTL = macroTL + "        setThreshold(1, 255);\n";
macroTL = macroTL + "        setOption(\"BlackBackground\", false);\n";
macroTL = macroTL + "        run(\"Convert to Mask\");\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        setAutoThreshold(globalMethod + \" dark\");\n";
macroTL = macroTL + "        setOption(\"BlackBackground\", false);\n";
macroTL = macroTL + "        run(\"Convert to Mask\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "    selectWindow(maskTitle);\n";
macroTL = macroTL + "    run(\"8-bit\");\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "function splitSatelliteMaskByLocalPeaks(intensityTitle, maskTitle, outTitle, prominence) {\n";
macroTL = macroTL + "    if (prominence <= 0) prominence = 20;\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatPeak_Source\")) { selectWindow(\"SQ_SatPeak_Source\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatPeak_Segmented\")) { selectWindow(\"SQ_SatPeak_Segmented\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(outTitle)) { selectWindow(outTitle); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(intensityTitle);\n";
macroTL = macroTL + "    run(\"Duplicate...\", \"title=SQ_SatPeak_Source\");\n";
macroTL = macroTL + "    selectWindow(\"SQ_SatPeak_Source\");\n";
macroTL = macroTL + "    run(\"Gaussian Blur...\", \"sigma=0.7\");\n";
macroTL = macroTL + "    run(\"Find Maxima...\", \"prominence=\" + prominence + \" output=[Segmented Particles] exclude\");\n";
macroTL = macroTL + "    rename(\"SQ_SatPeak_Segmented\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    imageCalculator(\"AND create\", \"SQ_SatPeak_Segmented\", maskTitle);\n";
macroTL = macroTL + "    rename(outTitle);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatPeak_Source\")) { selectWindow(\"SQ_SatPeak_Source\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatPeak_Segmented\")) { selectWindow(\"SQ_SatPeak_Segmented\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    selectWindow(outTitle);\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "function countMaskObjectsLargerThan(maskTitle, minArea) {\n";
macroTL = macroTL + "    if (!isOpen(maskTitle)) return 0;\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";
macroTL = macroTL + "    run(\"Clear Results\");\n";
macroTL = macroTL + "    run(\"Set Measurements...\", \"area centroid redirect=None decimal=3\");\n";
macroTL = macroTL + "    selectWindow(maskTitle);\n";
macroTL = macroTL + "    run(\"Analyze Particles...\", \"size=\" + minArea + \"-Infinity show=Nothing clear add\");\n";
macroTL = macroTL + "    nLargeTmp = roiManager(\"count\");\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";
macroTL = macroTL + "    run(\"Clear Results\");\n";
macroTL = macroTL + "    return nLargeTmp;\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "function splitLargeMaskToPeakSpotMask(intensityTitle, largeMaskTitle, outTitle, prominence, spotRadiusPix) {\n";
macroTL = macroTL + "    if (spotRadiusPix < 1) spotRadiusPix = 1;\n";
macroTL = macroTL + "    if (prominence < 1) prominence = 1;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatPeakOnlyIntensity\")) { selectWindow(\"SQ_SatPeakOnlyIntensity\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatPeakOnlyIntensityMasked\")) { selectWindow(\"SQ_SatPeakOnlyIntensityMasked\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatPeakSpotsRaw\")) { selectWindow(\"SQ_SatPeakSpotsRaw\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatPeakSpotsRestricted\")) { selectWindow(\"SQ_SatPeakSpotsRestricted\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(outTitle)) { selectWindow(outTitle); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(intensityTitle);\n";
macroTL = macroTL + "    run(\"Duplicate...\", \"title=SQ_SatPeakOnlyIntensity\");\n";
macroTL = macroTL + "    imageCalculator(\"Multiply create 32-bit\", \"SQ_SatPeakOnlyIntensity\", largeMaskTitle);\n";
macroTL = macroTL + "    rename(\"SQ_SatPeakOnlyIntensityMasked\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    tryProm = prominence;\n";
macroTL = macroTL + "    peakCount = 0;\n";
macroTL = macroTL + "    attempt = 0;\n";
macroTL = macroTL + "    while (attempt < 4 && peakCount < 2) {\n";
macroTL = macroTL + "        selectWindow(\"SQ_SatPeakOnlyIntensityMasked\");\n";
macroTL = macroTL + "        run(\"Clear Results\");\n";
macroTL = macroTL + "        run(\"Find Maxima...\", \"prominence=\" + tryProm + \" output=List exclude\");\n";
macroTL = macroTL + "        peakCount = nResults;\n";
macroTL = macroTL + "        if (peakCount < 2) {\n";
macroTL = macroTL + "            tryProm = tryProm / 2;\n";
macroTL = macroTL + "            if (tryProm < 1) tryProm = 1;\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "        attempt = attempt + 1;\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(largeMaskTitle);\n";
macroTL = macroTL + "    getDimensions(pkW, pkH, pkC, pkZ, pkT);\n";
macroTL = macroTL + "    newImage(\"SQ_SatPeakSpotsRaw\", \"8-bit black\", pkW, pkH, 1);\n";
macroTL = macroTL + "    setForegroundColor(255, 255, 255);\n";
macroTL = macroTL + "    setBackgroundColor(0, 0, 0);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (peakCount > 0) {\n";
macroTL = macroTL + "        for (pk = 0; pk < peakCount; pk++) {\n";
macroTL = macroTL + "            xpk = getResult(\"X\", pk);\n";
macroTL = macroTL + "            ypk = getResult(\"Y\", pk);\n";
macroTL = macroTL + "            selectWindow(\"SQ_SatPeakSpotsRaw\");\n";
macroTL = macroTL + "            makeOval(xpk - spotRadiusPix, ypk - spotRadiusPix, spotRadiusPix * 2 + 1, spotRadiusPix * 2 + 1);\n";
macroTL = macroTL + "            run(\"Fill\", \"slice\");\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "        imageCalculator(\"AND create\", \"SQ_SatPeakSpotsRaw\", largeMaskTitle);\n";
macroTL = macroTL + "        rename(\"SQ_SatPeakSpotsRestricted\");\n";
macroTL = macroTL + "        selectWindow(\"SQ_SatPeakSpotsRestricted\");\n";
macroTL = macroTL + "        getRawStatistics(pkNPix, pkMean, pkMin, pkMax, pkStd);\n";
macroTL = macroTL + "        if (pkMax > 0) {\n";
macroTL = macroTL + "            rename(outTitle);\n";
macroTL = macroTL + "        } else {\n";
macroTL = macroTL + "            if (isOpen(\"SQ_SatPeakSpotsRestricted\")) { selectWindow(\"SQ_SatPeakSpotsRestricted\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "            selectWindow(largeMaskTitle);\n";
macroTL = macroTL + "            run(\"Duplicate...\", \"title=\" + outTitle);\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        selectWindow(largeMaskTitle);\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=\" + outTitle);\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatPeakOnlyIntensity\")) { selectWindow(\"SQ_SatPeakOnlyIntensity\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatPeakOnlyIntensityMasked\")) { selectWindow(\"SQ_SatPeakOnlyIntensityMasked\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatPeakSpotsRaw\")) { selectWindow(\"SQ_SatPeakSpotsRaw\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatPeakSpotsRestricted\")) { selectWindow(\"SQ_SatPeakSpotsRestricted\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    run(\"Clear Results\");\n";
macroTL = macroTL + "    selectWindow(outTitle);\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "function splitLargeObjectsWithOriginalPeakSplitter(intensityTitle, originalMaskTitle, largeMaskTitle, outTitle, prominence) {\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatFullPeakSplit_ForLarge\")) { selectWindow(\"SQ_SatFullPeakSplit_ForLarge\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatLargeSplitOnly_FromFull\")) { selectWindow(\"SQ_SatLargeSplitOnly_FromFull\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(outTitle)) { selectWindow(outTitle); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    splitSatelliteMaskByLocalPeaks(intensityTitle, originalMaskTitle, \"SQ_SatFullPeakSplit_ForLarge\", prominence);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (!isOpen(\"SQ_SatFullPeakSplit_ForLarge\")) {\n";
macroTL = macroTL + "        selectWindow(largeMaskTitle);\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=\" + outTitle);\n";
macroTL = macroTL + "        return;\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    imageCalculator(\"AND create\", \"SQ_SatFullPeakSplit_ForLarge\", largeMaskTitle);\n";
macroTL = macroTL + "    rename(\"SQ_SatLargeSplitOnly_FromFull\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(\"SQ_SatLargeSplitOnly_FromFull\");\n";
macroTL = macroTL + "    run(\"8-bit\");\n";
macroTL = macroTL + "    setThreshold(1, 255);\n";
macroTL = macroTL + "    setOption(\"BlackBackground\", false);\n";
macroTL = macroTL + "    run(\"Convert to Mask\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    getRawStatistics(lsNPix, lsMean, lsMin, lsMax, lsStd);\n";
macroTL = macroTL + "    if (lsMax > 0) {\n";
macroTL = macroTL + "        rename(outTitle);\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        if (isOpen(\"SQ_SatLargeSplitOnly_FromFull\")) { selectWindow(\"SQ_SatLargeSplitOnly_FromFull\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        selectWindow(largeMaskTitle);\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=\" + outTitle);\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatFullPeakSplit_ForLarge\")) { selectWindow(\"SQ_SatFullPeakSplit_ForLarge\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    selectWindow(outTitle);\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "function selectiveLargeSatelliteSplit(intensityTitle, maskTitle, outTitle, splitMethod, splitMinArea, prominence, spotRadiusPix) {\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatLargeMask\")) { selectWindow(\"SQ_SatLargeMask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatLargeSplitMask\")) { selectWindow(\"SQ_SatLargeSplitMask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatSelectiveSplit_Result\")) { selectWindow(\"SQ_SatSelectiveSplit_Result\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(outTitle)) { selectWindow(outTitle); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(maskTitle);\n";
macroTL = macroTL + "    run(\"Duplicate...\", \"title=\" + outTitle);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (splitMethod == \"Off\" || splitMinArea <= 0) {\n";
macroTL = macroTL + "        selectWindow(outTitle);\n";
macroTL = macroTL + "        return;\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";
macroTL = macroTL + "    run(\"Clear Results\");\n";
macroTL = macroTL + "    run(\"Set Measurements...\", \"area centroid redirect=None decimal=3\");\n";
macroTL = macroTL + "    selectWindow(maskTitle);\n";
macroTL = macroTL + "    run(\"Analyze Particles...\", \"size=\" + splitMinArea + \"-Infinity show=Nothing clear add\");\n";
macroTL = macroTL + "    largeCountForSplit = roiManager(\"count\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (largeCountForSplit == 0) {\n";
macroTL = macroTL + "        roiManager(\"Reset\");\n";
macroTL = macroTL + "        selectWindow(outTitle);\n";
macroTL = macroTL + "        return;\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(maskTitle);\n";
macroTL = macroTL + "    getDimensions(splitW, splitH, splitC, splitZ, splitT);\n";
macroTL = macroTL + "    newImage(\"SQ_SatLargeMask\", \"8-bit black\", splitW, splitH, 1);\n";
macroTL = macroTL + "    setForegroundColor(255, 255, 255);\n";
macroTL = macroTL + "    setBackgroundColor(0, 0, 0);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    for (lg = 0; lg < largeCountForSplit; lg++) {\n";
macroTL = macroTL + "        selectWindow(\"SQ_SatLargeMask\");\n";
macroTL = macroTL + "        roiManager(\"Select\", lg);\n";
macroTL = macroTL + "        run(\"Fill\", \"slice\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    setBackgroundColor(0, 0, 0);\n";
macroTL = macroTL + "    for (lg = 0; lg < largeCountForSplit; lg++) {\n";
macroTL = macroTL + "        selectWindow(outTitle);\n";
macroTL = macroTL + "        roiManager(\"Select\", lg);\n";
macroTL = macroTL + "        run(\"Clear\", \"slice\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (splitMethod == \"Local intensity peaks\") {\n";
macroTL = macroTL + "        run(\"Set Measurements...\", \"area centroid redirect=None decimal=3\");\n";
macroTL = macroTL + "        selectWindow(\"SQ_SatLargeMask\");\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=SQ_SatLargeSplitMask\");\n";
macroTL = macroTL + "        selectWindow(\"SQ_SatLargeSplitMask\");\n";
macroTL = macroTL + "        run(\"Watershed\");\n";
macroTL = macroTL + "    } else if (splitMethod == \"Local intensity peaks\") {\n";
macroTL = macroTL + "        splitLargeObjectsWithOriginalPeakSplitter(intensityTitle, maskTitle, \"SQ_SatLargeMask\", \"SQ_SatLargeSplitMask\", prominence);\n";
macroTL = macroTL + "    } else if (splitMethod == \"Local intensity peaks\") {\n";
macroTL = macroTL + "        splitLargeMaskToPeakSpotMask(intensityTitle, \"SQ_SatLargeMask\", \"SQ_SatLargeSplitMask\", prominence, spotRadiusPix);\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        selectWindow(\"SQ_SatLargeMask\");\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=SQ_SatLargeSplitMask\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    splitHasSignal = 0;\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatLargeSplitMask\")) {\n";
macroTL = macroTL + "        selectWindow(\"SQ_SatLargeSplitMask\");\n";
macroTL = macroTL + "        getRawStatistics(splitNPix, splitMean, splitMin, splitMax, splitStd);\n";
macroTL = macroTL + "        if (splitMax > 0) splitHasSignal = 1;\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "    if (splitHasSignal == 0) {\n";
macroTL = macroTL + "        if (isOpen(\"SQ_SatLargeSplitMask\")) { selectWindow(\"SQ_SatLargeSplitMask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        selectWindow(\"SQ_SatLargeMask\");\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=SQ_SatLargeSplitMask\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    imageCalculator(\"OR create\", outTitle, \"SQ_SatLargeSplitMask\");\n";
macroTL = macroTL + "    rename(\"SQ_SatSelectiveSplit_Result\");\n";
macroTL = macroTL + "    if (isOpen(outTitle)) { selectWindow(outTitle); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    selectWindow(\"SQ_SatSelectiveSplit_Result\");\n";
macroTL = macroTL + "    rename(outTitle);\n";
macroTL = macroTL + "    selectWindow(outTitle);\n";
macroTL = macroTL + "    getDimensions(outW, outH, outC, outZ, outT);\n";
macroTL = macroTL + "    selectWindow(intensityTitle);\n";
macroTL = macroTL + "    getDimensions(intW, intH, intC, intZ, intT);\n";
macroTL = macroTL + "    if (outW != intW || outH != intH) {\n";
macroTL = macroTL + "        if (isOpen(outTitle)) { selectWindow(outTitle); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        selectWindow(maskTitle);\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=\" + outTitle);\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatLargeMask\")) { selectWindow(\"SQ_SatLargeMask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    if (isOpen(\"SQ_SatLargeSplitMask\")) { selectWindow(\"SQ_SatLargeSplitMask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";
macroTL = macroTL + "    selectWindow(outTitle);\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "function exportCellBoundaryROIs(boundaryCSV, sourceTitleForBoundary, runIDForBoundary, frameForBoundary, pixelWidthForBoundary, pixelHeightForBoundary) {\n";
macroTL = macroTL + "    if (roiManager(\"count\") <= 0) return;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (!File.exists(boundaryCSV)) {\n";
macroTL = macroTL + "        File.saveString(\"Source_Input,Run_ID,Image,Frame,Cell_ID,Point_Index,X_um,Y_um,X_pixel,Y_pixel\\n\", boundaryCSV);\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    safeBoundaryImage = replace(sourceTitleForBoundary, \",\", \";\");\n";
macroTL = macroTL + "    safeBoundaryRunID = replace(runIDForBoundary, \",\", \";\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    boundaryRoiCount = roiManager(\"count\");\n";
macroTL = macroTL + "    for (bc = 0; bc < boundaryRoiCount; bc++) {\n";
macroTL = macroTL + "        roiManager(\"Select\", bc);\n";
macroTL = macroTL + "        getSelectionCoordinates(boundaryXPoints, boundaryYPoints);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (boundaryXPoints.length > 0) {\n";
macroTL = macroTL + "            for (bp = 0; bp < boundaryXPoints.length; bp++) {\n";
macroTL = macroTL + "                bxPix = boundaryXPoints[bp];\n";
macroTL = macroTL + "                byPix = boundaryYPoints[bp];\n";
macroTL = macroTL + "                bxUm = bxPix * pixelWidthForBoundary;\n";
macroTL = macroTL + "                byUm = byPix * pixelHeightForBoundary;\n";
macroTL = macroTL + "                File.append(safeBoundaryImage + \",\" + safeBoundaryRunID + \",\" + safeBoundaryImage + \",\" + frameForBoundary + \",\" + (bc + 1) + \",\" + (bp + 1) + \",\" + bxUm + \",\" + byUm + \",\" + bxPix + \",\" + byPix + \"\\n\", boundaryCSV);\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "            bxPix = boundaryXPoints[0];\n";
macroTL = macroTL + "            byPix = boundaryYPoints[0];\n";
macroTL = macroTL + "            bxUm = bxPix * pixelWidthForBoundary;\n";
macroTL = macroTL + "            byUm = byPix * pixelHeightForBoundary;\n";
macroTL = macroTL + "            File.append(safeBoundaryImage + \",\" + safeBoundaryRunID + \",\" + safeBoundaryImage + \",\" + frameForBoundary + \",\" + (bc + 1) + \",\" + (boundaryXPoints.length + 1) + \",\" + bxUm + \",\" + byUm + \",\" + bxPix + \",\" + byPix + \"\\n\", boundaryCSV);\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (nImages == 0) {\n";
macroTL = macroTL + "    exit(\"Please open an image in Fiji first, then run this macro.\");\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "originalTitle = getTitle();\n";
macroTL = macroTL + "baseName = cleanFileName(originalTitle);\n";
macroTL = macroTL + "getDimensions(width, height, channels, slices, frames);\n";
macroTL = macroTL + "getPixelSize(unit, pixelWidth, pixelHeight, voxelDepth);\n";
macroTL = macroTL + "if (pixelWidth == 0) pixelWidth = 1;\n";
macroTL = macroTL + "if (pixelHeight == 0) pixelHeight = pixelWidth;\n";
macroTL = macroTL + "if (voxelDepth == 0) voxelDepth = pixelWidth;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "sqCalTempDir = getDirectory(\"temp\");\n";
macroTL = macroTL + "if (sqCalTempDir == \"\") sqCalTempDir = getDirectory(\"home\");\n";
macroTL = macroTL + "sqScalePath = sqCalTempDir + \"SQ_timelapse_scale_settings.txt\";\n";
macroTL = macroTL + "calibrationSource = \"Image metadata\";\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (File.exists(sqScalePath)) {\n";
macroTL = macroTL + "    sqScaleTxt = File.openAsString(sqScalePath);\n";
macroTL = macroTL + "    sqScaleTxt = replace(sqScaleTxt, \"\\n\", \"\");\n";
macroTL = macroTL + "    sqScaleTxt = replace(sqScaleTxt, \"\\r\", \"\");\n";
macroTL = macroTL + "    sqScaleVals = split(sqScaleTxt, \"|\");\n";
macroTL = macroTL + "    if (sqScaleVals.length >= 3) {\n";
macroTL = macroTL + "        pixelWidth = parseFloat(sqScaleVals[0]);\n";
macroTL = macroTL + "        pixelHeight = parseFloat(sqScaleVals[1]);\n";
macroTL = macroTL + "        voxelDepth = parseFloat(sqScaleVals[2]);\n";
macroTL = macroTL + "        if (sqScaleVals.length >= 4) calibrationSource = sqScaleVals[3]; else calibrationSource = \"Time-lapse parent calibration\";\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "} else {\n";
macroTL = macroTL + "    defaultScaleChoice = \"Use current image calibration\";\n";
macroTL = macroTL + "    if (unit == \"pixel\" || unit == \"pixels\") defaultScaleChoice = \"Enter pixel size manually in microns\";\n";
macroTL = macroTL + "    Dialog.create(\"SatelliteQ image scale / calibration\");\n";
macroTL = macroTL + "    Dialog.addMessage(\"Fiji detected this image scale from the image metadata: unit=\" + unit + \", XY pixel size=\" + pixelWidth + \" x \" + pixelHeight + \", Z step=\" + voxelDepth);\n";
macroTL = macroTL + "    Dialog.addChoice(\"Image scale/calibration:\", newArray(\"Use current image calibration\", \"Enter pixel size manually in microns\"), defaultScaleChoice);\n";
macroTL = macroTL + "    Dialog.addNumber(\"XY pixel size, microns per pixel:\", pixelWidth);\n";
macroTL = macroTL + "    Dialog.addNumber(\"Z-step size, microns per slice:\", voxelDepth);\n";
macroTL = macroTL + "    Dialog.show();\n";
macroTL = macroTL + "    scaleChoice = Dialog.getChoice();\n";
macroTL = macroTL + "    manualXY = Dialog.getNumber();\n";
macroTL = macroTL + "    manualZ = Dialog.getNumber();\n";
macroTL = macroTL + "    if (scaleChoice == \"Enter pixel size manually in microns\") {\n";
macroTL = macroTL + "        pixelWidth = manualXY;\n";
macroTL = macroTL + "        pixelHeight = manualXY;\n";
macroTL = macroTL + "        voxelDepth = manualZ;\n";
macroTL = macroTL + "        calibrationSource = \"Manual input\";\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "if (pixelWidth <= 0) pixelWidth = 1;\n";
macroTL = macroTL + "if (pixelHeight <= 0) pixelHeight = pixelWidth;\n";
macroTL = macroTL + "if (voxelDepth <= 0) voxelDepth = pixelWidth;\n";
macroTL = macroTL + "run(\"Properties...\", \"channels=\" + channels + \" slices=\" + slices + \" frames=\" + frames + \" unit=micron pixel_width=\" + pixelWidth + \" pixel_height=\" + pixelHeight + \" voxel_depth=\" + voxelDepth);\n";
macroTL = macroTL + "safeUnit = \"um\";\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "getDateAndTime(year, month, dayOfWeek, dayOfMonth, hour, minute, second, msec);\n";
macroTL = macroTL + "month = month + 1;\n";
macroTL = macroTL + "runTimestamp = d2s(year, 0) + \"_\" + d2s(month, 0) + \"_\" + d2s(dayOfMonth, 0) + \"_\" + d2s(hour, 0) + \"_\" + d2s(minute, 0) + \"_\" + d2s(second, 0);\n";
macroTL = macroTL + "runID = baseName;\n";
macroTL = macroTL + "boundaryFrame = -1;\n";
macroTL = macroTL + "if (startsWith(baseName, \"SQF_\")) {\n";
macroTL = macroTL + "    boundaryFrame = parseFloat(substring(baseName, 4));\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "initialRoiCount = 0;\n";
macroTL = macroTL + "if (isOpen(\"ROI Manager\")) {\n";
macroTL = macroTL + "    initialRoiCount = roiManager(\"count\");\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "sqTempDir = getDirectory(\"temp\");\n";
macroTL = macroTL + "if (sqTempDir == \"\") sqTempDir = getDirectory(\"home\");\n";
macroTL = macroTL + "sqTLModePath = sqTempDir + \"SQ_timelapse_frame_settings_mode.txt\";\n";
macroTL = macroTL + "sqTL2DSettingsPath = sqTempDir + \"SQ_timelapse_2D_settings.txt\";\n";
macroTL = macroTL + "sqTLActive = File.exists(sqTLModePath);\n";
macroTL = macroTL + "sqTLMode = \"\";\n";
macroTL = macroTL + "sqTLUseSame = false;\n";
macroTL = macroTL + "sqTLAskPrev = false;\n";
macroTL = macroTL + "sqTLHasPrev = false;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (sqTLActive) {\n";
macroTL = macroTL + "    sqTLMode = File.openAsString(sqTLModePath);\n";
macroTL = macroTL + "    sqTLMode = replace(sqTLMode, \"\\\\n\", \"\");\n";
macroTL = macroTL + "    sqTLMode = replace(sqTLMode, \"\\\\r\", \"\");\n";
macroTL = macroTL + "    if (sqTLMode == \"USE_SAME_SETTINGS\") sqTLUseSame = true; else sqTLUseSame = false;\n";
macroTL = macroTL + "    if (sqTLMode == \"ASK_WITH_PREVIOUS_DEFAULTS\") sqTLAskPrev = true; else sqTLAskPrev = false;\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + " d_treatSlicesAsChannels = true;\n";
macroTL = macroTL + " d_saveQCImages = true;\n";
macroTL = macroTL + " d_satelliteChannel = 1;\n";
macroTL = macroTL + " d_centrosomeChannel = 2;\n";
macroTL = macroTL + " d_membraneChannel = 0;\n";macroTL = macroTL + " d_ciliumChannel = 0;\n";
macroTL = macroTL + " d_ciliumRollingBall = 20;\n";
macroTL = macroTL + " d_ciliumGaussianSigma = 1.0;\n";
macroTL = macroTL + " d_ciliumThresholdMode = \"Mean + SD multiplier\";\n";
macroTL = macroTL + " d_ciliumSDMultiplier = 2.0;\n";
macroTL = macroTL + " d_ciliumPercentMax = 25.0;\n";
macroTL = macroTL + " d_ciliumManualThreshold = 100;\n";
macroTL = macroTL + " d_ciliumMinLength = 1.0;\n";
macroTL = macroTL + " d_ciliumMaxLength = 10.0;\n";

macroTL = macroTL + " d_projectionMethod = \"Max Intensity\";\n";
macroTL = macroTL + " d_satRollingBall = 20;\n";
macroTL = macroTL + " d_satThresholdMode = \"Auto\";\n";
macroTL = macroTL + " d_satThreshold = \"Otsu\";\n";
macroTL = macroTL + " d_satManualThreshold = 100;\n";
macroTL = macroTL + " d_satHysteresisMultiplier = 1.25;\n";
macroTL = macroTL + " d_minSatSize = 0.05;\n";
macroTL = macroTL + " d_maxSatSize = 5.00;\n";
macroTL = macroTL + " d_doSatWatershed = true;\n";
macroTL = macroTL + " d_satSplitMethod = \"Off\";\n";
macroTL = macroTL + " d_satPeakProminence = 10;\n";
macroTL = macroTL + " d_satLargeSplitMinSize = 2.0;\n";
macroTL = macroTL + " d_satForcedSpotRadiusPix = 2.0;\n";
macroTL = macroTL + " d_reviewSatellitesBeforeContinue = true;\n";
macroTL = macroTL + " d_centrosomeDetectionMode = \"Bright puncta threshold + top intensity\";\n";
macroTL = macroTL + " d_centRollingBall = 20;\n";
macroTL = macroTL + " d_centGaussianSigma = 1.0;\n";
macroTL = macroTL + " d_centBrightThresholdMode = \"Mean + SD multiplier\";\n";
macroTL = macroTL + " d_centSDMultiplier = 6.0;\n";
macroTL = macroTL + " d_centPercentMax = 50;\n";
macroTL = macroTL + " d_centManualThreshold = 100;\n";
macroTL = macroTL + " d_minCentSize = 0.05;\n";
macroTL = macroTL + " d_maxCentSize = 5.00;\n";
macroTL = macroTL + " d_maxCentrosomesWholeImage = 0;\n";
macroTL = macroTL + " d_centDisplayDiameter = 10;\n";
macroTL = macroTL + " d_reviewCentrosomesBeforeContinue = true;\n";
macroTL = macroTL + " d_centROIDisplayMode = \"Centrosome channel + satellite channel\";\n";
macroTL = macroTL + " d_cellAssignmentMode = \"No cell assignment\";\n";
macroTL = macroTL + " d_centrosomeRadiusMicron = 3.0;\n";
macroTL = macroTL + " d_cellRollingBall = 50;\n";
macroTL = macroTL + " d_cellThreshold = \"Otsu\";\n";
macroTL = macroTL + " d_cellBoundarySourceType = \"Membrane/boundary marker\";\n";
macroTL = macroTL + " d_cellThresholdMode = \"Global auto threshold\";\n";
macroTL = macroTL + " d_cellLocalThresholdMethod = \"Phansalkar\";\n";
macroTL = macroTL + " d_cellLocalRadius = 25;\n";
macroTL = macroTL + " d_cellManualThreshold = 100;\n";
macroTL = macroTL + " d_cellPreprocessStrength = \"Medium\";\n";
macroTL = macroTL + " d_minCellArea = 100;\n";
macroTL = macroTL + " d_maxCellArea = 1000000;\n";
macroTL = macroTL + " d_cellCleanupMode = \"Medium-strong\";\n";
macroTL = macroTL + " d_cellROIDisplayMode = \"Cell signal channel + cell boundary only\";\n";
macroTL = macroTL + " d_cellDoWatershed = true;\n";
macroTL = macroTL + " d_cellWatershedProtection = \"Medium\";\n";
macroTL = macroTL + " d_exportOutsideMode = \"Selected cell areas only - ignore outside\";\n";
macroTL = macroTL + " d_multiCentrosomeMode = \"Use all centrosomes in cell (assign nearest)\";\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (File.exists(sqTL2DSettingsPath) && (sqTLUseSame || sqTLAskPrev)) {\n";
macroTL = macroTL + "    sqTL2D = File.openAsString(sqTL2DSettingsPath);\n";
macroTL = macroTL + "    sqTL2D = replace(sqTL2D, \"\\\\n\", \"\");\n";
macroTL = macroTL + "    sqTL2D = replace(sqTL2D, \"\\\\r\", \"\");\n";
macroTL = macroTL + "    sqVals = split(sqTL2D, \"|\");\n";
macroTL = macroTL + "    if (sqVals.length >= 34) {\n";
macroTL = macroTL + "        if (sqVals[0] == \"true\" || sqVals[0] == \"1\") d_treatSlicesAsChannels = true; else d_treatSlicesAsChannels = false;\n";
macroTL = macroTL + "        if (sqVals[1] == \"true\" || sqVals[1] == \"1\") d_saveQCImages = true; else d_saveQCImages = false;\n";
macroTL = macroTL + "        d_satelliteChannel = parseFloat(sqVals[2]);\n";
macroTL = macroTL + "        d_centrosomeChannel = parseFloat(sqVals[3]);\n";
macroTL = macroTL + "        d_membraneChannel = parseFloat(sqVals[4]);\n";
macroTL = macroTL + "        if (sqVals.length >= 49) d_satSplitMethod = sqVals[48];\n";
macroTL = macroTL + "        if (sqVals.length >= 50) d_satPeakProminence = parseFloat(sqVals[49]);\n";
macroTL = macroTL + "        if (sqVals.length >= 51) d_satLargeSplitMinSize = parseFloat(sqVals[50]);\n";
