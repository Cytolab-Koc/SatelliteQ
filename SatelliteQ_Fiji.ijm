macro3Dsingle = macro3Dsingle + "            run(\"Merge Channels...\", \"c1=[\" + centSatOverlayTitle + \"] c2=[\" + centRawOverlayTitle + \"] c3=[\" + centMaskOverlayTitle + \"] create keep\");\n";
macro3Dsingle = macro3Dsingle + "            rename(\"SQ3D_centrosome_REAL_3D_OBJECTS_review_stack\");\n";
