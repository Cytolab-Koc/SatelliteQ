macroTL = macroTL + "                        newZArr[newCount - 1] = zArr[oldID - 1];\n";
macroTL = macroTL + "                        newIdArr[newCount - 1] = newCount;\n";
macroTL = macroTL + "                    }\n";
macroTL = macroTL + "                }\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        satCount = newCount;\n";
