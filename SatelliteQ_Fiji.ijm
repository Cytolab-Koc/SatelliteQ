macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Review detected satellites before continuing: \" + reviewSatellitesBeforeContinue + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Raw satellite count before cell filtering: \" + satelliteCount + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Exported assigned satellites: \" + exportedAssignedSatelliteCount + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Exported unassigned satellites: \" + exportedUnassignedSatelliteCount + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Exported total satellites: \" + exportedSatelliteCount + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"\\n[CENTROSOME DETECTION / ASSIGNMENT]\\n\";\n";
