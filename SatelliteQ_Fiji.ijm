macro2Dsingle = macro2Dsingle + "            diameterPixelsQC = radiusPixelsQC * 2;\n";
macro2Dsingle = macro2Dsingle + "            for (c = 0; c < centrosomeCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "                setColor(185, 90, 255);\n";
macro2Dsingle = macro2Dsingle + "                setLineWidth(3);\n";
macro2Dsingle = macro2Dsingle + "                makeOval(centXpix[c] - radiusPixelsQC, centYpix[c] - radiusPixelsQC, diameterPixelsQC, diameterPixelsQC);\n";
macro2Dsingle = macro2Dsingle + "                run(\"Draw\", \"slice\");\n";
macro2Dsingle = macro2Dsingle + "                drawString(\"Cell \" + (c + 1), centXpix[c] + 7, centYpix[c] - 8);\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "        } else if (cellCount > 0 && roiManager(\"count\") >= cellCount) {\n";
macro2Dsingle = macro2Dsingle + "            for (c = 0; c < cellCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "                roiManager(\"Select\", c);\n";
macro2Dsingle = macro2Dsingle + "                setColor(185, 90, 255);\n";
macro2Dsingle = macro2Dsingle + "                setLineWidth(3);\n";
macro2Dsingle = macro2Dsingle + "                run(\"Draw\", \"slice\");\n";
macro2Dsingle = macro2Dsingle + "                getSelectionBounds(rx, ry, rw, rh);\n";
macro2Dsingle = macro2Dsingle + "                drawString(\"Cell \" + (c + 1), rx + 6, ry + 16);\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Deselect\");\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        saveAs(\"Tiff\", qcDir + runID + \"_QC_selected_cell_boundaries_full_image.tif\");\n";
macro2Dsingle = macro2Dsingle + "        setOption(\"Changes\", false);\n";
macro2Dsingle = macro2Dsingle + "        close();\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Satellite_Projection\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Select None\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Duplicate...\", \"title=SQ_QC_COMBINED_full_image\");\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"SQ_QC_COMBINED_full_image\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Select None\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"RGB Color\");\n";
macro2Dsingle = macro2Dsingle + "        getDimensions(qcW, qcH, qcC, qcZ, qcT);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        setFont(\"SansSerif\", 12, \"bold\");\n";
macro2Dsingle = macro2Dsingle + "        setLineWidth(3);\n";
macro2Dsingle = macro2Dsingle + "        setColor(185, 90, 255);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (cellAssignmentMode == \"No cell assignment\") {\n";
macro2Dsingle = macro2Dsingle + "            makeRectangle(2, 2, qcW - 4, qcH - 4);\n";
macro2Dsingle = macro2Dsingle + "            run(\"Draw\", \"slice\");\n";
macro2Dsingle = macro2Dsingle + "            drawString(\"Whole image\", 15, 25);\n";
macro2Dsingle = macro2Dsingle + "        } else if (cellAssignmentMode == \"Centrosome radius\") {\n";
macro2Dsingle = macro2Dsingle + "            radiusPixelsQC = centrosomeRadiusMicron / pixelWidth;\n";
macro2Dsingle = macro2Dsingle + "            diameterPixelsQC = radiusPixelsQC * 2;\n";
macro2Dsingle = macro2Dsingle + "            for (c = 0; c < centrosomeCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "                setColor(185, 90, 255);\n";
macro2Dsingle = macro2Dsingle + "                setLineWidth(3);\n";
macro2Dsingle = macro2Dsingle + "                makeOval(centXpix[c] - radiusPixelsQC, centYpix[c] - radiusPixelsQC, diameterPixelsQC, diameterPixelsQC);\n";
macro2Dsingle = macro2Dsingle + "                run(\"Draw\", \"slice\");\n";
macro2Dsingle = macro2Dsingle + "                drawString(\"Cell \" + (c + 1), centXpix[c] + 7, centYpix[c] - 8);\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "        } else if (cellCount > 0 && roiManager(\"count\") >= cellCount) {\n";
macro2Dsingle = macro2Dsingle + "            for (c = 0; c < cellCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "                roiManager(\"Select\", c);\n";
macro2Dsingle = macro2Dsingle + "                setColor(185, 90, 255);\n";
macro2Dsingle = macro2Dsingle + "                setLineWidth(3);\n";
macro2Dsingle = macro2Dsingle + "                run(\"Draw\", \"slice\");\n";
macro2Dsingle = macro2Dsingle + "                getSelectionBounds(rx, ry, rw, rh);\n";
macro2Dsingle = macro2Dsingle + "                drawString(\"Cell \" + (c + 1), rx + 6, ry + 16);\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Deselect\");\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        centQCRadius = centDisplayDiameter / 2;\n";
macro2Dsingle = macro2Dsingle + "        if (centQCRadius < 4) centQCRadius = 4;\n";
macro2Dsingle = macro2Dsingle + "        setFont(\"SansSerif\", 12, \"bold\");\n";
macro2Dsingle = macro2Dsingle + "        for (c = 0; c < centrosomeCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "            setLineWidth(3);\n";
macro2Dsingle = macro2Dsingle + "            setColor(255, 0, 255);\n";
macro2Dsingle = macro2Dsingle + "            makeOval(centXpix[c] - centQCRadius, centYpix[c] - centQCRadius, centQCRadius * 2, centQCRadius * 2);\n";
macro2Dsingle = macro2Dsingle + "            run(\"Draw\", \"slice\");\n";
macro2Dsingle = macro2Dsingle + "            drawString(\"C\" + (c + 1), centXpix[c] + centQCRadius + 3, centYpix[c] + 3);\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        setFont(\"SansSerif\", 9, \"bold\");\n";
macro2Dsingle = macro2Dsingle + "        for (i = 0; i < satelliteCount; i++) {\n";
macro2Dsingle = macro2Dsingle + "            setLineWidth(2);\n";
macro2Dsingle = macro2Dsingle + "            setColor(255, 255, 0);\n";
macro2Dsingle = macro2Dsingle + "            makeOval(satXpix[i] - 4, satYpix[i] - 4, 8, 8);\n";
macro2Dsingle = macro2Dsingle + "            run(\"Draw\", \"slice\");\n";
macro2Dsingle = macro2Dsingle + "            drawString(\"S\" + (i + 1), satXpix[i] + 5, satYpix[i] + 5);\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        saveAs(\"Tiff\", qcDir + runID + \"_QC_COMBINED_full_image_cells_centrosomes_satellites.tif\");\n";
macro2Dsingle = macro2Dsingle + "        setOption(\"Changes\", false);\n";
macro2Dsingle = macro2Dsingle + "        close();\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(\"Satellite_Projection\")) {\n";
macro2Dsingle = macro2Dsingle + "            selectWindow(\"Satellite_Projection\");\n";
macro2Dsingle = macro2Dsingle + "            run(\"Select None\");\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    qcReadme = \"SatelliteQ QC images\\n\";\n";
macro2Dsingle = macro2Dsingle + "    qcReadme = qcReadme + \"Original specific QC images are kept, including satellite and centrosome QC images.\\n\";\n";
macro2Dsingle = macro2Dsingle + "    qcReadme = qcReadme + \"Flattened ROI review windows are saved immediately after OK: satellite_selected_ROI_review_QC, centrosome_selected_ROI_review_QC, and cell_selected_ROI_review_QC when available.\\n\";\n";
macro2Dsingle = macro2Dsingle + "    qcReadme = qcReadme + \"Additional full-image QC images were added:\\n\";\n";
macro2Dsingle = macro2Dsingle + "    qcReadme = qcReadme + \"- _QC_selected_cell_boundaries_full_image.tif\\n\";\n";
macro2Dsingle = macro2Dsingle + "    qcReadme = qcReadme + \"- _QC_COMBINED_full_image_cells_centrosomes_satellites.tif\\n\";\n";
macro2Dsingle = macro2Dsingle + "    qcReadme = qcReadme + \"Colors in combined image: Yellow = satellites, Magenta = centrosomes, Purple = cell boundaries/assignment regions.\\n\";\n";
macro2Dsingle = macro2Dsingle + "    qcReadme = qcReadme + \"Duplicate _openWindow_ images are not saved.\\n\";\n";
macro2Dsingle = macro2Dsingle + "    File.saveString(qcReadme, qcDir + runID + \"_QC_README.txt\");\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "pythonRan = false;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "allOpenImages = getList(\"image.titles\");\n";
macro2Dsingle = macro2Dsingle + "for (q = allOpenImages.length - 1; q >= 0; q--) {\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(allOpenImages[q]);\n";
macro2Dsingle = macro2Dsingle + "    close();\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "if (isOpen(\"Results\")) {\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Results\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Close\");\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "if (isOpen(\"Summary\")) {\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Summary\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Close\");\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "if (isOpen(\"Log\")) {\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Log\");\n";
macro2Dsingle = macro2Dsingle + "    print(\"\\\\Clear\");\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "if (isOpen(\"ROI Manager\")) {\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "// Export final selected options summary as a human-readable text file.\n";
macro2Dsingle = macro2Dsingle + "selectedOptionsPath = outputDir + runID + \"_SELECTED_OPTIONS_SUMMARY.txt\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = \"SatelliteQ SELECTED OPTIONS SUMMARY\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"This file records the final options used for this run, including changes made during redo/review dialogs.\\n\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Run ID: \" + runID + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"SatelliteQ version: \" + sqVersion + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Original image: \" + originalTitle + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Analysis mode: 2D single image / projection\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Output folder: \" + outputDir + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Save intermediate images: \" + saveQCImages + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Calibration source: \" + calibrationSource + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Pixel width um: \" + pixelWidth + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Pixel height um: \" + pixelHeight + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Image width pixels: \" + width + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Image height pixels: \" + height + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Voxel depth um: \" + voxelDepth + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"\\n[SATELLITE DETECTION]\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Satellite channel: \" + satelliteChannel + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Projection method: \" + projectionMethod + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Rolling ball radius: \" + satRollingBall + \"\\n\";\n";
