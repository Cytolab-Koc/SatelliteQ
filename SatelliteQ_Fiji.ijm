macroTL = macroTL + "                setLineWidth(4);\n";
macroTL = macroTL + "                setColor(255);\n";
macroTL = macroTL + "                makeOval(cxPixSphere - sphereRadiusPixX, cyPixSphere - sphereRadiusPixX, sphereDiameterPix, sphereDiameterPix);\n";
macroTL = macroTL + "                if (selectionType() != -1) run(\"Draw\", \"slice\");\n";
macroTL = macroTL + "                drawString(\"Cell \" + centIdArr[c], cxPixSphere + 6, cyPixSphere - 8);\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "            saveAs(\"Tiff\", qcDir + runID + \"_cell_sphere_mask_projection.tif\");\n";
macroTL = macroTL + "            close();\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    } else if (centrosomeChannel > 0) {\n";
