macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "if (centrosomeChannel > 0) {\n";
macro3Dsingle = macro3Dsingle + "    Dialog.create(\"SatelliteQuantify 3D - Step 3/4: Centrosomes\");\n";
