macroTL = macroTL + "    setOption(\"BlackBackground\", false);\n";
macroTL = macroTL + "    run(\"Convert to Mask\", \"method=Default background=Default black\");\n";
macroTL = macroTL + "    rename(\"SQ3D_3D_binary_segmentation_mask\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    getDimensions(mWidth, mHeight, mChannels, mSlices, mFrames);\n";
