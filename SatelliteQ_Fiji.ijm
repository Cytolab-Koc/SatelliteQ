macroTL = macroTL + "\n";
macroTL = macroTL + "                    setLineWidth(4);\n";
macroTL = macroTL + "                    setColor(0, 255, 255);\n";
macroTL = macroTL + "                    makeOval(cxPixSphere - sphereRadiusPixX, cyPixSphere - sphereRadiusPixX, sphereDiameterPix, sphereDiameterPix);\n";
macroTL = macroTL + "                    if (selectionType() != -1) run(\"Draw\", \"slice\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "                    setColor(0, 0, 0);\n";
macroTL = macroTL + "                    drawString(\"Cell \" + centIdArr[c], cxPixSphere + 7, cyPixSphere - 7);\n";
macroTL = macroTL + "                    drawString(\"Cell \" + centIdArr[c], cxPixSphere + 5, cyPixSphere - 9);\n";
macroTL = macroTL + "                    setColor(255, 255, 0);\n";
