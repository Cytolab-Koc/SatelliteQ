macro3Dsingle = macro3Dsingle + "        if (isOpen(\"SQ3D_centrosome_REVIEW_raw_for_overlay\")) { selectWindow(\"SQ3D_centrosome_REVIEW_raw_for_overlay\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"SQ3D_centrosome_REVIEW_satellite_stack\")) { selectWindow(\"SQ3D_centrosome_REVIEW_satellite_stack\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"SQ3D_centrosome_REAL_3D_Object_Mask\")) { selectWindow(\"SQ3D_centrosome_REAL_3D_Object_Mask\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"SQ3D_centrosome_REAL_3D_OBJECTS_review_stack\")) { selectWindow(\"SQ3D_centrosome_REAL_3D_OBJECTS_review_stack\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"SQ3D_centrosome_BGsubtracted_for_review\")) { selectWindow(\"SQ3D_centrosome_BGsubtracted_for_review\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "\n";
