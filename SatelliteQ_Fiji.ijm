macroTL = macroTL + "    run(\"Enhance Contrast\", \"saturated=0.35\");\n";
macroTL = macroTL + "    run(\"RGB Color\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    setFont(\"SansSerif\", 7, \"antialiased\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    for (i = 0; i < satCount; i++) {\n";
macroTL = macroTL + "        cx = xArr[i];\n";
macroTL = macroTL + "        cy = yArr[i];\n";
macroTL = macroTL + "\n";
