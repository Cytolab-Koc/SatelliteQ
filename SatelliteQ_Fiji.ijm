macroTL = macroTL + "    Dialog.addMessage(\"- Skip centrosome: no centrosome detection or distance output.\");\n";
macroTL = macroTL + "    Dialog.addChoice(\"Centrosome detection mode:\", newArray(\"Automatic centrosome detection\", \"Manual centrosome ROIs during macro\", \"Existing ROIs in ROI Manager\", \"Skip centrosome\"), \"Skip centrosome\");\n";
macroTL = macroTL + "    Dialog.addNumber(\"Centrosome rolling ball radius, pixels:\", d_centRollingBall);\n";
macroTL = macroTL + "    Dialog.addNumber(\"Gaussian blur sigma before centrosome detection, pixels:\", d_centGaussianSigma);\n";
macroTL = macroTL + "    Dialog.addChoice(\"Bright centrosome threshold mode:\", newArray(\"Mean + SD multiplier\", \"Percent of image maximum\", \"Manual value\"), d_centBrightThresholdMode);\n";
