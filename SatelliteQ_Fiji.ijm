macroTL = macroTL + "    centYpix = newArray(centrosomeCount);\n";
macroTL = macroTL + "    centIntensity = newArray(centrosomeCount);\n";
macroTL = macroTL + "    centArea = newArray(centrosomeCount);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    for (c = 0; c < centrosomeCount; c++) {\n";
