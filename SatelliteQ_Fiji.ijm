macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        if (centDisplayDiameter < 2) centDisplayDiameter = 2;\n";
macro3Dsingle = macro3Dsingle + "        guideRadius = centDisplayDiameter / 2;\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        for (rr = 0; rr < detectedBeforeReview; rr++) {\n";
