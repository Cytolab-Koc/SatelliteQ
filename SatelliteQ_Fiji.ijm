macroTL = macroTL + "            \"Use ROI Manager to delete bad ROIs, add missing cells, or modify boundaries.\\n\" +\n";
macroTL = macroTL + "            \"For cytoplasmic signal mode, keep only true cell boundary ROIs.\\n\\n\" +\n";
macroTL = macroTL + "            \"When the final cell ROIs are correct, click OK.\");\n";
macroTL = macroTL + "        cellCount = roiManager(\"count\");\n";
macroTL = macroTL + "        if (saveQCImages) {\n";
macroTL = macroTL + "            selectWindow(cellROIDrawingTitle);\n";
macroTL = macroTL + "            roiManager(\"Show All with labels\");\n";
macroTL = macroTL + "            run(\"Flatten\");\n";
macroTL = macroTL + "            rename(\"Cell_Selected_ROI_Review_QC\");\n";
macroTL = macroTL + "            saveAs(\"Tiff\", qcDir + runID + \"_cell_selected_ROI_review_QC.tif\");\n";
macroTL = macroTL + "            saveAs(\"Tiff\", qcDir + runID + \"_cell_ROI_review_final.tif\");\n";
macroTL = macroTL + "            setOption(\"Changes\", false);\n";
macroTL = macroTL + "            close();\n";
macroTL = macroTL + "            if (isOpen(cellROIDrawingTitle)) selectWindow(cellROIDrawingTitle);\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "        if (isOpen(\"Cell_ROI_Review\")) {\n";
macroTL = macroTL + "            selectWindow(\"Cell_ROI_Review\");\n";
macroTL = macroTL + "            close();\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(\"Satellite_Projection\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    for (c = 0; c < cellCount; c++) {\n";
macroTL = macroTL + "        roiManager(\"Select\", c);\n";
macroTL = macroTL + "        for (i = 0; i < satelliteCount; i++) {\n";
macroTL = macroTL + "            if (safeSelectionContains(satXpix[i], satYpix[i])) {\n";
macroTL = macroTL + "                satCellID[i] = c + 1;\n";
macroTL = macroTL + "                satCellMode[i] = cellAssignmentMode;\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (isOpen(cellROIDrawingTitle)) selectWindow(cellROIDrawingTitle);\n";
macroTL = macroTL + "        else if (isOpen(\"Cell_ROI_Review\")) selectWindow(\"Cell_ROI_Review\");\n";
macroTL = macroTL + "        else if (isOpen(\"Cell_Projection\")) selectWindow(\"Cell_Projection\");\n";
macroTL = macroTL + "        roiManager(\"Show All with labels\");\n";
macroTL = macroTL + "        Dialog.create(\"Accept cell ROIs?\");\n";
macroTL = macroTL + "        Dialog.addMessage(\"Detected / selected cell ROIs: \" + cellCount);\n";
macroTL = macroTL + "        Dialog.addRadioButtonGroup(\"Next step:\", newArray(\"Accept cell ROIs and continue\", \"Change cell ROI settings and re-detect\"), 2, 1, \"Accept cell ROIs and continue\");\n";
macroTL = macroTL + "        Dialog.show();\n";
macroTL = macroTL + "        cellDecision = Dialog.getRadioButton();\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (cellDecision == \"Accept cell ROIs and continue\") {\n";
macroTL = macroTL + "            cellDetectionAccepted = true;\n";
macroTL = macroTL + "        } else {\n";
macroTL = macroTL + "            Dialog.create(\"Redo cell ROI settings\");\n";
macroTL = macroTL + "            Dialog.addNumber(\"Cell rolling ball radius, pixels:\", cellRollingBall);\n";
macroTL = macroTL + "            Dialog.addChoice(\"Cell boundary source type:\", newArray(\"Membrane/boundary marker\", \"Diffuse cytoplasmic protein\", \"Microtubule/cytoskeleton staining\"), cellBoundarySourceType);\n";
macroTL = macroTL + "            Dialog.addChoice(\"Cell threshold mode:\", newArray(\"Global auto threshold\", \"Local auto threshold\", \"Manual threshold\"), cellThresholdMode);\n";
macroTL = macroTL + "            Dialog.addChoice(\"Cell global threshold method:\", newArray(\"Otsu\", \"Triangle\", \"Moments\", \"Default\", \"Li\", \"Yen\", \"Huang\"), cellThreshold);\n";
macroTL = macroTL + "            Dialog.addChoice(\"Cell local threshold method:\", newArray(\"Phansalkar\", \"Sauvola\", \"Bernsen\", \"Niblack\", \"Mean\", \"Median\"), cellLocalThresholdMethod);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Local threshold radius, pixels:\", cellLocalRadius);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Manual cell threshold value, AU:\", cellManualThreshold);\n";
macroTL = macroTL + "            Dialog.addChoice(\"Microtubule/cytoskeleton preprocessing strength:\", newArray(\"Off\", \"Light\", \"Medium\", \"Strong\", \"Very strong\"), cellPreprocessStrength);\n";
macroTL = macroTL + "            Dialog.addChoice(\"Cell mask cleanup strength:\", newArray(\"None\", \"Very light\", \"Standard\", \"Medium-strong\", \"Strong\", \"Very strong\"), cellCleanupMode);\n";
macroTL = macroTL + "            Dialog.addCheckbox(\"Split touching/large cell ROIs with watershed\", cellDoWatershed);\n";
macroTL = macroTL + "            Dialog.addChoice(\"Watershed over-splitting protection:\", newArray(\"Off\", \"Light\", \"Medium\", \"Strong\"), cellWatershedProtection);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Minimum cell area, pixels^2:\", minCellArea);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Maximum cell area, pixels^2:\", maxCellArea);\n";
macroTL = macroTL + "            Dialog.show();\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "            cellRollingBall = Dialog.getNumber();\n";
macroTL = macroTL + "            cellBoundarySourceType = Dialog.getChoice();\n";
macroTL = macroTL + "            cellThresholdMode = Dialog.getChoice();\n";
macroTL = macroTL + "            cellThreshold = Dialog.getChoice();\n";
macroTL = macroTL + "            cellLocalThresholdMethod = Dialog.getChoice();\n";
macroTL = macroTL + "            cellLocalRadius = Dialog.getNumber();\n";
macroTL = macroTL + "            cellManualThreshold = Dialog.getNumber();\n";
macroTL = macroTL + "            cellPreprocessStrength = Dialog.getChoice();\n";
macroTL = macroTL + "            cellCleanupMode = Dialog.getChoice();\n";
macroTL = macroTL + "            cellDoWatershed = Dialog.getCheckbox();\n";
macroTL = macroTL + "            cellWatershedProtection = Dialog.getChoice();\n";
macroTL = macroTL + "            minCellArea = Dialog.getNumber();\n";
macroTL = macroTL + "            maxCellArea = Dialog.getNumber();\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "            d_cellRollingBall = cellRollingBall;\n";
macroTL = macroTL + "            d_cellThreshold = cellThreshold;\n";
macroTL = macroTL + "            d_cellBoundarySourceType = cellBoundarySourceType;\n";
macroTL = macroTL + "            d_cellThresholdMode = cellThresholdMode;\n";
macroTL = macroTL + "            d_cellLocalThresholdMethod = cellLocalThresholdMethod;\n";
macroTL = macroTL + "            d_cellLocalRadius = cellLocalRadius;\n";
macroTL = macroTL + "            d_cellManualThreshold = cellManualThreshold;\n";
macroTL = macroTL + "            d_cellPreprocessStrength = cellPreprocessStrength;\n";
macroTL = macroTL + "            d_minCellArea = minCellArea;\n";
macroTL = macroTL + "            d_maxCellArea = maxCellArea;\n";
macroTL = macroTL + "            d_cellCleanupMode = cellCleanupMode;\n";
macroTL = macroTL + "            d_cellDoWatershed = cellDoWatershed;\n";
macroTL = macroTL + "            d_cellWatershedProtection = cellWatershedProtection;\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (cellAssignmentMode == \"Centrosome radius\") {\n";
macroTL = macroTL + "    centrosomeRadiusAccepted = false;\n";
macroTL = macroTL + "    centrosomeRadiusCellRoiZip = roiDir + runID + \"_centrosome_radius_cell_rois.zip\";\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    while (!centrosomeRadiusAccepted) {\n";
macroTL = macroTL + "        radiusPixels = centrosomeRadiusMicron / pixelWidth;\n";
macroTL = macroTL + "        if (radiusPixels < 1) radiusPixels = 1;\n";
macroTL = macroTL + "        diameterPixels = radiusPixels * 2;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        roiManager(\"Reset\");\n";
macroTL = macroTL + "        selectWindow(\"Satellite_Projection\");\n";
macroTL = macroTL + "        run(\"Select None\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        for (c = 0; c < centrosomeCount; c++) {\n";
macroTL = macroTL + "            makeOval(centXpix[c] - radiusPixels, centYpix[c] - radiusPixels, diameterPixels, diameterPixels);\n";
macroTL = macroTL + "            roiManager(\"Add\");\n";
macroTL = macroTL + "            roiManager(\"Select\", c);\n";
macroTL = macroTL + "            roiManager(\"Rename\", \"Cell_\" + (c + 1) + \"_radius_around_centrosome_\" + (c + 1));\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "        cellCount = roiManager(\"count\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (isOpen(\"Centrosome_Radius_Cell_ROI_Review\")) { selectWindow(\"Centrosome_Radius_Cell_ROI_Review\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        selectWindow(\"Satellite_Projection\");\n";
macroTL = macroTL + "        run(\"Select None\");\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=Centrosome_Radius_Cell_ROI_Review\");\n";
macroTL = macroTL + "        selectWindow(\"Centrosome_Radius_Cell_ROI_Review\");\n";
macroTL = macroTL + "        roiManager(\"Show All with labels\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        waitForUser(\"Review centrosome-radius cell ROIs\",\n";
macroTL = macroTL + "            \"I drew one circular Cell ROI around each selected centrosome.\\n\\n\" +\n";
macroTL = macroTL + "            \"Radius = \" + centrosomeRadiusMicron + \" micrometers.\\n\\n\" +\n";
macroTL = macroTL + "            \"You can edit these circles in ROI Manager now:\\n\" +\n";
macroTL = macroTL + "            \"- select a ROI, move/resize it, then click Update in ROI Manager\\n\" +\n";
macroTL = macroTL + "            \"- if you moved only the currently selected ROI, I will also auto-update it when you click OK\\n\" +\n";
macroTL = macroTL + "            \"- delete unwanted ROIs\\n\" +\n";
macroTL = macroTL + "            \"- add extra ROIs manually with T if needed\\n\\n\" +\n";
macroTL = macroTL + "            \"Each ROI will become a separate Cell_ID.\\n\" +\n";
macroTL = macroTL + "            \"When the ROI Manager contains the final circular cell ROIs, click OK.\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        selectWindow(\"Centrosome_Radius_Cell_ROI_Review\");\n";
macroTL = macroTL + "        if (selectionType() != -1) roiManager(\"Update\");\n";
macroTL = macroTL + "        roiManager(\"Show All with labels\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        cellCount = roiManager(\"count\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        Dialog.create(\"Accept centrosome-radius cell ROIs?\");\n";
macroTL = macroTL + "        Dialog.addChoice(\"Next step:\", newArray(\"Accept ROIs and continue\", \"Change radius and redraw\"), \"Accept ROIs and continue\");\n";
macroTL = macroTL + "        Dialog.addNumber(\"Radius for redraw, micrometers:\", centrosomeRadiusMicron);\n";
macroTL = macroTL + "        Dialog.show();\n";
macroTL = macroTL + "        radiusNextStep = Dialog.getChoice();\n";
macroTL = macroTL + "        centrosomeRadiusMicron = Dialog.getNumber();\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (radiusNextStep == \"Accept ROIs and continue\") {\n";
macroTL = macroTL + "            selectWindow(\"Centrosome_Radius_Cell_ROI_Review\");\n";
macroTL = macroTL + "            if (selectionType() != -1) roiManager(\"Update\");\n";
macroTL = macroTL + "            roiManager(\"Show All with labels\");\n";
macroTL = macroTL + "            centrosomeRadiusAccepted = true;\n";
macroTL = macroTL + "        } else {\n";
macroTL = macroTL + "            if (isOpen(\"Centrosome_Radius_Cell_ROI_Review\")) { selectWindow(\"Centrosome_Radius_Cell_ROI_Review\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (cellCount > 0) roiManager(\"Save\", centrosomeRadiusCellRoiZip);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (saveQCImages && isOpen(\"Centrosome_Radius_Cell_ROI_Review\")) {\n";
macroTL = macroTL + "        selectWindow(\"Centrosome_Radius_Cell_ROI_Review\");\n";
macroTL = macroTL + "        roiManager(\"Show All with labels\");\n";
macroTL = macroTL + "        run(\"Flatten\");\n";
macroTL = macroTL + "        rename(\"Centrosome_Radius_Cell_ROI_Review_QC\");\n";
macroTL = macroTL + "        saveAs(\"Tiff\", qcDir + runID + \"_centrosome_radius_cell_ROI_review_QC.tif\");\n";
macroTL = macroTL + "        setOption(\"Changes\", false);\n";
macroTL = macroTL + "        close();\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    radiusCellCenterXpix = newArray(cellCount);\n";
macroTL = macroTL + "    radiusCellCenterYpix = newArray(cellCount);\n";
macroTL = macroTL + "    radiusCellCenterX = newArray(cellCount);\n";
macroTL = macroTL + "    radiusCellCenterY = newArray(cellCount);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    selectWindow(\"Satellite_Projection\");\n";
macroTL = macroTL + "    for (cell = 1; cell <= cellCount; cell++) {\n";
macroTL = macroTL + "        roiManager(\"Select\", cell - 1);\n";
macroTL = macroTL + "        getSelectionBounds(rx, ry, rw, rh);\n";
macroTL = macroTL + "        radiusCellCenterXpix[cell - 1] = rx + rw / 2;\n";
macroTL = macroTL + "        radiusCellCenterYpix[cell - 1] = ry + rh / 2;\n";
macroTL = macroTL + "        radiusCellCenterX[cell - 1] = radiusCellCenterXpix[cell - 1] * pixelWidth;\n";
macroTL = macroTL + "        radiusCellCenterY[cell - 1] = radiusCellCenterYpix[cell - 1] * pixelHeight;\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    for (i = 0; i < satelliteCount; i++) {\n";
macroTL = macroTL + "        bestDistance = 999999999;\n";
macroTL = macroTL + "        bestCell = 0;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        for (cell = 1; cell <= cellCount; cell++) {\n";
macroTL = macroTL + "            roiManager(\"Select\", cell - 1);\n";
macroTL = macroTL + "            if (safeSelectionContains(satXpix[i], satYpix[i])) {\n";
macroTL = macroTL + "                dx = satX[i] - radiusCellCenterX[cell - 1];\n";
macroTL = macroTL + "                dy = satY[i] - radiusCellCenterY[cell - 1];\n";
macroTL = macroTL + "                dist = sqrt(dx * dx + dy * dy);\n";
macroTL = macroTL + "                if (dist < bestDistance) {\n";
macroTL = macroTL + "                    bestDistance = dist;\n";
macroTL = macroTL + "                    bestCell = cell;\n";
macroTL = macroTL + "                }\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (bestCell > 0) {\n";
macroTL = macroTL + "            satCellID[i] = bestCell;\n";
macroTL = macroTL + "            satCellMode[i] = \"Centrosome radius\";\n";
macroTL = macroTL + "            satNearestCentID[i] = bestCell;\n";
macroTL = macroTL + "            satNearestCentX[i] = radiusCellCenterX[bestCell - 1];\n";
macroTL = macroTL + "            satNearestCentY[i] = radiusCellCenterY[bestCell - 1];\n";
macroTL = macroTL + "            satNearestCentDistance[i] = bestDistance;\n";
macroTL = macroTL + "            satAssignedCentLabel[i] = \"Radius_ROI_\" + bestCell;\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "    roiManager(\"Deselect\");\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (cellAssignmentMode == \"Manual cell ROIs during macro\" ||\n";
macroTL = macroTL + "    cellAssignmentMode == \"Existing cell ROIs in ROI Manager\" ||\n";
macroTL = macroTL + "    cellAssignmentMode == \"Membrane marker\" ||\n";
macroTL = macroTL + "    cellAssignmentMode == \"Cytoplasmic signal boundary\" ||\n";
macroTL = macroTL + "    cellAssignmentMode == \"Centrosome radius\") {\n";
macroTL = macroTL + "    if (cellCount > 0) {\n";
macroTL = macroTL + "        exportCellBoundaryROIs(cellBoundaryCSV, originalTitle, runID, boundaryFrame, pixelWidth, pixelHeight);\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";

macroTL = macroTL + "if (cellAssignmentMode == \"No cell assignment\") {\n";
macroTL = macroTL + "    cellCount = 1;\n";
macroTL = macroTL + "    for (i = 0; i < satelliteCount; i++) {\n";
macroTL = macroTL + "        satCellID[i] = 1;\n";
macroTL = macroTL + "        satCellMode[i] = \"Whole image\";\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "cellCentID = newArray(cellCount + 1);\n";
macroTL = macroTL + "cellCentX = newArray(cellCount + 1);\n";
macroTL = macroTL + "cellCentY = newArray(cellCount + 1);\n";
macroTL = macroTL + "cellCentDistance = newArray(cellCount + 1);\n";
macroTL = macroTL + "centCellID = newArray(centrosomeCount);\n";
macroTL = macroTL + "centLabel = newArray(centrosomeCount);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "for (cell = 0; cell <= cellCount; cell++) {\n";
macroTL = macroTL + "    cellCentID[cell] = 0;\n";
macroTL = macroTL + "    cellCentX[cell] = \"NA\";\n";
macroTL = macroTL + "    cellCentY[cell] = \"NA\";\n";
macroTL = macroTL + "    cellCentDistance[cell] = \"NA\";\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "for (c = 0; c < centrosomeCount; c++) {\n";
macroTL = macroTL + "    centCellID[c] = 0;\n";
macroTL = macroTL + "    centLabel[c] = \"\" + (c + 1);\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "hasCellAreaROIs = false;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (cellAssignmentMode == \"Existing cell ROIs in ROI Manager\") {\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";
macroTL = macroTL + "    roiManager(\"Open\", initialRoiZip);\n";
macroTL = macroTL + "    hasCellAreaROIs = true;\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (cellAssignmentMode == \"Manual cell ROIs during macro\") {\n";
macroTL = macroTL + "    if (File.exists(manualCellRoiZip)) {\n";
macroTL = macroTL + "        roiManager(\"Reset\");\n";
macroTL = macroTL + "        roiManager(\"Open\", manualCellRoiZip);\n";
macroTL = macroTL + "        hasCellAreaROIs = true;\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (cellAssignmentMode == \"Membrane marker\" || cellAssignmentMode == \"Cytoplasmic signal boundary\") {\n";
macroTL = macroTL + "    if (roiManager(\"count\") == cellCount && cellCount > 0) {\n";
macroTL = macroTL + "        hasCellAreaROIs = true;\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (hasCellAreaROIs && centrosomeCount > 0 && cellCount > 0) {\n";
macroTL = macroTL + "    selectWindow(\"Satellite_Projection\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    for (cell = 1; cell <= cellCount; cell++) {\n";
macroTL = macroTL + "        roiManager(\"Select\", cell - 1);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        localCent = newArray(centrosomeCount);\n";
macroTL = macroTL + "        localN = 0;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        for (c = 0; c < centrosomeCount; c++) {\n";
macroTL = macroTL + "            if (safeSelectionContains(centXpix[c], centYpix[c])) {\n";
macroTL = macroTL + "                localCent[localN] = c;\n";
macroTL = macroTL + "                localN = localN + 1;\n";
macroTL = macroTL + "                centCellID[c] = cell;\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (localN > 1) {\n";
macroTL = macroTL + "            for (a = 0; a < localN - 1; a++) {\n";
macroTL = macroTL + "                for (b = a + 1; b < localN; b++) {\n";
macroTL = macroTL + "                    if (centX[localCent[a]] > centX[localCent[b]]) {\n";
macroTL = macroTL + "                        temp = localCent[a];\n";
macroTL = macroTL + "                        localCent[a] = localCent[b];\n";
macroTL = macroTL + "                        localCent[b] = temp;\n";
macroTL = macroTL + "                    }\n";
macroTL = macroTL + "                }\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "                if (localN == 1) {\n";
macroTL = macroTL + "            c = localCent[0];\n";
macroTL = macroTL + "            centLabel[c] = \"\" + cell;\n";
macroTL = macroTL + "            cellCentID[cell] = c + 1;\n";
macroTL = macroTL + "            cellCentX[cell] = centX[c];\n";
macroTL = macroTL + "            cellCentY[cell] = centY[c];\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        ignoreThisCell = false;\n";
macroTL = macroTL + "        cellMidX = 0;\n";
macroTL = macroTL + "        cellMidY = 0;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (localN > 1) {\n";
macroTL = macroTL + "            for (j = 0; j < localN; j++) {\n";
macroTL = macroTL + "                c = localCent[j];\n";
macroTL = macroTL + "                centLabel[c] = \"\" + cell + \"_\" + (j + 1);\n";
macroTL = macroTL + "                cellMidX = cellMidX + centX[c];\n";
macroTL = macroTL + "                cellMidY = cellMidY + centY[c];\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "            cellMidX = cellMidX / localN;\n";
macroTL = macroTL + "            cellMidY = cellMidY / localN;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "            if (multiCentrosomeMode == \"Ignore cells with multiple centrosomes\") {\n";
macroTL = macroTL + "                ignoreThisCell = true;\n";
macroTL = macroTL + "                cellCentID[cell] = 0;\n";
macroTL = macroTL + "                cellCentX[cell] = \"NA\";\n";
macroTL = macroTL + "                cellCentY[cell] = \"NA\";\n";
macroTL = macroTL + "            } else if (multiCentrosomeMode == \"Use midpoint of centrosomes in cell\") {\n";
macroTL = macroTL + "                cellCentID[cell] = 0;\n";
macroTL = macroTL + "                cellCentX[cell] = cellMidX;\n";
macroTL = macroTL + "                cellCentY[cell] = cellMidY;\n";
macroTL = macroTL + "            } else {\n";
macroTL = macroTL + "                c = localCent[0];\n";
macroTL = macroTL + "                cellCentID[cell] = c + 1;\n";
macroTL = macroTL + "                cellCentX[cell] = centX[c];\n";
macroTL = macroTL + "                cellCentY[cell] = centY[c];\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        for (i = 0; i < satelliteCount; i++) {\n";
macroTL = macroTL + "            if (satCellID[i] == cell) {\n";
macroTL = macroTL + "                if (ignoreThisCell) {\n";
macroTL = macroTL + "                    satCellID[i] = -1;\n";
macroTL = macroTL + "                    satNearestCentID[i] = 0;\n";
macroTL = macroTL + "                    satNearestCentX[i] = \"NA\";\n";
macroTL = macroTL + "                    satNearestCentY[i] = \"NA\";\n";
macroTL = macroTL + "                    satNearestCentDistance[i] = \"NA\";\n";
macroTL = macroTL + "                    satAssignedCentLabel[i] = \"Ignored_multi_centrosome_cell\";\n";
macroTL = macroTL + "                } else if (localN > 1 && multiCentrosomeMode == \"Use midpoint of centrosomes in cell\") {\n";
macroTL = macroTL + "                    dx = satX[i] - cellMidX;\n";
macroTL = macroTL + "                    dy = satY[i] - cellMidY;\n";
macroTL = macroTL + "                    dist = sqrt(dx * dx + dy * dy);\n";
macroTL = macroTL + "                    satNearestCentID[i] = 0;\n";
macroTL = macroTL + "                    satNearestCentX[i] = cellMidX;\n";
macroTL = macroTL + "                    satNearestCentY[i] = cellMidY;\n";
macroTL = macroTL + "                    satNearestCentDistance[i] = dist;\n";
macroTL = macroTL + "                    satAssignedCentLabel[i] = \"\" + cell + \"_mid\";\n";
macroTL = macroTL + "                } else {\n";
macroTL = macroTL + "                    bestDistance = 999999999;\n";
macroTL = macroTL + "                    bestCent = -1;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "                    for (j = 0; j < localN; j++) {\n";
macroTL = macroTL + "                        c = localCent[j];\n";
macroTL = macroTL + "                        dx = satX[i] - centX[c];\n";
macroTL = macroTL + "                        dy = satY[i] - centY[c];\n";
macroTL = macroTL + "                        dist = sqrt(dx * dx + dy * dy);\n";
macroTL = macroTL + "                        if (dist < bestDistance) {\n";
