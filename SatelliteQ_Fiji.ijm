macro3Dsingle = macro3Dsingle + "        for (i = 0; i < satCount; i++) { satCellID3D[i] = 0; satCellVolume3D[i] = \"NaN\"; satAssignedCent3D[i] = \"NaN\"; satAssignedCentDist3D[i] = \"NaN\"; }\n";
