macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Centrosome rolling ball radius, pixels: \" + centRollingBall + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Centrosome gaussian sigma: \" + centGaussianSigma + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Centrosome bright threshold mode: \" + centBrightThresholdMode + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Centrosome SD multiplier: \" + centSDMultiplier + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Centrosome percent of image maximum: \" + centPercentMax + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Centrosome manual threshold: \" + centManualThreshold + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Minimum centrosome size: \" + minCentSize + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Maximum centrosome size: \" + maxCentSize + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Maximum centrosomes kept: \" + maxCentrosomesWholeImage + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Centrosome display diameter pixels: \" + centDisplayDiameter + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Manual centrosome review enabled: \" + reviewCentrosomesBeforeContinue + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Final centrosome count: \" + centrosomeCount + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"\\n[CELL AREA / CELL ASSIGNMENT]\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cell assignment mode: \" + cellAssignmentMode + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Membrane/cytoplasm boundary channel: \" + membraneChannel + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cell boundary source type: \" + cellBoundarySourceType + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cell ROI drawing/review display mode: \" + cellROIDisplayMode + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Centrosome radius for cell assignment, micrometers: \" + centrosomeRadiusMicron + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cell rolling ball radius, pixels: \" + cellRollingBall + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cell threshold mode: \" + cellThresholdMode + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cell global threshold method: \" + cellThreshold + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cell local threshold method: \" + cellLocalThresholdMethod + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cell local threshold radius, pixels: \" + cellLocalRadius + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Manual cell threshold value, AU: \" + cellManualThreshold + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Microtubule/cytoskeleton preprocessing strength: \" + cellPreprocessStrength + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cell watershed / split touching cell ROIs: \" + cellDoWatershed + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cell watershed over-splitting protection: \" + cellWatershedProtection + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Minimum cell area, pixels^2: \" + minCellArea + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Maximum cell area, pixels^2: \" + maxCellArea + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Where to detect/export satellites: \" + exportOutsideMode + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"If a cell contains >1 centrosome: \" + multiCentrosomeMode + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Detected/defined cell count: \" + cellCount + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"\\n[OUTPUT FILES]\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Combined CSV: \" + combinedCSV + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cell boundary ROI coordinate CSV: \" + cellBoundaryCSV + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Selected options summary: \" + selectedOptionsPath + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"\\n[PRIMARY CILIUM ANALYSIS]\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cilium channel: \" + ciliumChannel + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cilium projection method: Max Intensity\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cilium rolling ball radius, pixels: \" + ciliumRollingBall + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cilium Gaussian sigma, pixels: \" + ciliumGaussianSigma + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cilium threshold mode: \" + ciliumThresholdMode + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cilium mean + SD multiplier: \" + ciliumSDMultiplier + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cilium percent of image maximum: \" + ciliumPercentMax + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cilium manual threshold value, AU: \" + ciliumManualThreshold + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cilium minimum accepted length, um: \" + ciliumMinLength + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Cilium maximum accepted length, um: \" + ciliumMaxLength + \"\\n\";\n";
macro2Dsingle = macro2Dsingle + "optionsTxt = optionsTxt + \"Ciliated cell rule: at least one accepted cilium inside cell boundary\\n\";\n";
macro2Dsingle = macro2Dsingle + "File.saveString(optionsTxt, selectedOptionsPath);\n";
macro2Dsingle = macro2Dsingle + "File.append(\"Setting,\" + safeRunID + \",\" + safeTitle + emptyToSetting + \"Selected options summary text file,\" + selectedOptionsPath + \"\\n\", combinedCSV);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "msg = \"SatelliteQuantify analysis completed.\\n\\n\" + \"Run ID: \" + runID + \"\\n\" + \"Satellites detected before filtering: \" + satelliteCount + \"\\n\" + \"Assigned satellites exported: \" + exportedAssignedSatelliteCount + \"\\n\" + \"Unassigned satellites exported: \" + exportedUnassignedSatelliteCount + \"\\n\" + \"Total satellites exported: \" + exportedSatelliteCount + \"\\n\" + \"Cells: \" + cellCount + \"\\n\\n\" + \"One combined CSV saved to:\\n\" + combinedCSV + \"\\n\\nResult folder for this image:\\n\" + outputDir + \"\\n\\nQC images saved: \" + saveQCImages;\n";
macro2Dsingle = macro2Dsingle + "showMessage(\"SatelliteQuantify\", msg);\n";
    selectedMacroPath = tempDir + "SatelliteQ_selected_2D_single.ijm";
    File.saveString(macro2Dsingle, selectedMacroPath);
    runMacro(selectedMacroPath);
    exit();
}

if (analysisMode == "3D single stack") {
macro3Dsingle = "";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "requires(\"1.53\");\n";
macro3Dsingle = macro3Dsingle + "sqVersion = \"" + SATELLITEQ_VERSION + "\";\n";
macro3Dsingle = macro3Dsingle + "function safeSelectionContains(px, py) {\n";
macro3Dsingle = macro3Dsingle + "    if (selectionType() == -1) return false;\n";
macro3Dsingle = macro3Dsingle + "    return selectionContains(px, py);\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "// Primary-cilium length helper for the 3D mode. Cilia are intentionally measured in 2D from a max-Z projection.\n";
macro3Dsingle = macro3Dsingle + "function sqCiliumSkeletonSerialized(maskTitle, is3D, pw, ph, pz, lengthUnit, gaussianSigmaOriginalPixels) {\n";
macro3Dsingle = macro3Dsingle + "    if (!isOpen(maskTitle)) return \"\";\n";
macro3Dsingle = macro3Dsingle + "    if (isOpen(\"SQ_Cilium_SkeletonWork\")) { selectWindow(\"SQ_Cilium_SkeletonWork\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "    if (isOpen(\"SQ_Cilium_Scaled\")) { selectWindow(\"SQ_Cilium_Scaled\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "    selectWindow(maskTitle);\n";
macro3Dsingle = macro3Dsingle + "    run(\"Duplicate...\", \"title=SQ_Cilium_SkeletonWork duplicate\");\n";
macro3Dsingle = macro3Dsingle + "    selectWindow(\"SQ_Cilium_SkeletonWork\");\n";
macro3Dsingle = macro3Dsingle + "    run(\"8-bit\");\n";
macro3Dsingle = macro3Dsingle + "    setThreshold(1, 255);\n";
macro3Dsingle = macro3Dsingle + "    setOption(\"BlackBackground\", true);\n";
macro3Dsingle = macro3Dsingle + "    run(\"Convert to Mask\", \"method=Default background=Dark black stack\");\n";
macro3Dsingle = macro3Dsingle + "    if (is3D) run(\"Scale...\", \"x=3 y=3 z=3 interpolation=None create\");\n";
macro3Dsingle = macro3Dsingle + "    else run(\"Scale...\", \"x=3 y=3 interpolation=None create\");\n";
macro3Dsingle = macro3Dsingle + "    rename(\"SQ_Cilium_Scaled\");\n";
macro3Dsingle = macro3Dsingle + "    if (is3D) setVoxelSize(pw / 3, ph / 3, pz / 3, lengthUnit);\n";
macro3Dsingle = macro3Dsingle + "    else setVoxelSize(pw / 3, ph / 3, 1, lengthUnit);\n";
macro3Dsingle = macro3Dsingle + "    sigmaScaled = gaussianSigmaOriginalPixels * 3;\n";
macro3Dsingle = macro3Dsingle + "    if (sigmaScaled > 0) run(\"Gaussian Blur...\", \"sigma=\" + sigmaScaled + \" stack\");\n";
macro3Dsingle = macro3Dsingle + "    setThreshold(128, 255);\n";
macro3Dsingle = macro3Dsingle + "    setOption(\"BlackBackground\", true);\n";
macro3Dsingle = macro3Dsingle + "    run(\"Convert to Mask\", \"method=Default background=Dark black stack\");\n";
macro3Dsingle = macro3Dsingle + "    run(\"Skeletonize (2D/3D)\");\n";
macro3Dsingle = macro3Dsingle + "    cjs = \"var IJ=Packages.ij.IJ; var AS=Packages.sc.fiji.analyzeSkeleton.AnalyzeSkeleton_; var imp=IJ.getImage(); var sk=new AS(); sk.setup('',imp); var res=sk.run(AS.NONE,false,true,null,true,false); var lens=res.getShortestPathList(); var paths=sk.getShortestPathPoints(); var starts=res.getSpStartPosition(); var cal=imp.getCalibration(); var out=''; for(var i=0;i<lens.size();i++){var pp=paths[i]; var sx=0,sy=0,sz=0,ps=''; if(pp!=null && pp.size()>0){for(var j=0;j<pp.size();j++){var p=pp.get(j); var xx=p.x*cal.pixelWidth; var yy=p.y*cal.pixelHeight; var zz=p.z*cal.pixelDepth; sx+=xx; sy+=yy; sz+=zz; if(j>0)ps+=';'; ps+=xx+':'+yy+':'+zz;} sx/=pp.size(); sy/=pp.size(); sz/=pp.size();}else{sx=starts[i][0]; sy=starts[i][1]; sz=starts[i][2];} if(i>0)out+='#'; out+=(i+1)+'~'+Number(lens.get(i))+'~'+sx+'~'+sy+'~'+sz+'~'+ps;} out;\";\n";
macro3Dsingle = macro3Dsingle + "    serialized = eval(\"script\", cjs);\n";
macro3Dsingle = macro3Dsingle + "    if (isOpen(\"SQ_Cilium_Scaled\")) { selectWindow(\"SQ_Cilium_Scaled\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "    if (isOpen(\"SQ_Cilium_SkeletonWork\")) { selectWindow(\"SQ_Cilium_SkeletonWork\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "    return serialized;\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "function sqFindColumnIndex(headerLine, colName) {\n";
macro3Dsingle = macro3Dsingle + "    cols = split(headerLine, \",\");\n";
macro3Dsingle = macro3Dsingle + "    for (sqci = 0; sqci < cols.length; sqci++) {\n";
macro3Dsingle = macro3Dsingle + "        if (cols[sqci] == colName) return sqci;\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "    return -1;\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "run(\"Set Measurements...\", \"area mean min max centroid center integrated median redirect=None decimal=3\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "if (nImages == 0) exit(\"Open a 3D image first.\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "originalTitle = getTitle();\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "baseName = originalTitle;\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \".tif\", \"\");\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \".tiff\", \"\");\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \".TIF\", \"\");\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \".TIFF\", \"\");\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \" \", \"_\");\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \"-\", \"_\");\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \".\", \"_\");\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \"(\", \"_\");\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \")\", \"_\");\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \"[\", \"_\");\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \"]\", \"_\");\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \",\", \"_\");\n";
macro3Dsingle = macro3Dsingle + "baseName = replace(baseName, \";\", \"_\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "getDateAndTime(year, month, dayOfWeek, dayOfMonth, hour, minute, second, msec);\n";
macro3Dsingle = macro3Dsingle + "month = month + 1;\n";
macro3Dsingle = macro3Dsingle + "runID = baseName + \"_\" + d2s(year,0) + \"_\" + d2s(month,0) + \"_\" + d2s(dayOfMonth,0) + \"_\" + d2s(hour,0) + \"_\" + d2s(minute,0) + \"_\" + d2s(second,0);\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "getDimensions(width, height, channels, slices, frames);\n";
macro3Dsingle = macro3Dsingle + "getPixelSize(unit, pixelWidth, pixelHeight, voxelDepth);\n";
macro3Dsingle = macro3Dsingle + "if (pixelWidth == 0) pixelWidth = 1;\n";
macro3Dsingle = macro3Dsingle + "if (pixelHeight == 0) pixelHeight = pixelWidth;\n";
macro3Dsingle = macro3Dsingle + "if (voxelDepth == 0) voxelDepth = pixelWidth;\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "sqCalTempDir = getDirectory(\"temp\");\n";
macro3Dsingle = macro3Dsingle + "if (sqCalTempDir == \"\") sqCalTempDir = getDirectory(\"home\");\n";
macro3Dsingle = macro3Dsingle + "sqScalePath = sqCalTempDir + \"SQ_timelapse_scale_settings.txt\";\n";
macro3Dsingle = macro3Dsingle + "if (File.exists(sqScalePath)) File.delete(sqScalePath);\n";
macro3Dsingle = macro3Dsingle + "calibrationSource = \"Image metadata\";\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "if (File.exists(sqScalePath)) {\n";
macro3Dsingle = macro3Dsingle + "    sqScaleTxt = File.openAsString(sqScalePath);\n";
macro3Dsingle = macro3Dsingle + "    sqScaleTxt = replace(sqScaleTxt, \"\\n\", \"\");\n";
macro3Dsingle = macro3Dsingle + "    sqScaleTxt = replace(sqScaleTxt, \"\\r\", \"\");\n";
macro3Dsingle = macro3Dsingle + "    sqScaleVals = split(sqScaleTxt, \"|\");\n";
macro3Dsingle = macro3Dsingle + "    if (sqScaleVals.length >= 3) {\n";
macro3Dsingle = macro3Dsingle + "        pixelWidth = parseFloat(sqScaleVals[0]);\n";
macro3Dsingle = macro3Dsingle + "        pixelHeight = parseFloat(sqScaleVals[1]);\n";
macro3Dsingle = macro3Dsingle + "        voxelDepth = parseFloat(sqScaleVals[2]);\n";
macro3Dsingle = macro3Dsingle + "        if (sqScaleVals.length >= 4) calibrationSource = sqScaleVals[3]; else calibrationSource = \"Time-lapse parent calibration\";\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "} else {\n";
macro3Dsingle = macro3Dsingle + "    defaultScaleChoice = \"Use current image calibration\";\n";
macro3Dsingle = macro3Dsingle + "    if (unit == \"pixel\" || unit == \"pixels\") defaultScaleChoice = \"Enter pixel size manually in microns\";\n";
macro3Dsingle = macro3Dsingle + "    Dialog.create(\"SatelliteQ image scale / calibration\");\n";
macro3Dsingle = macro3Dsingle + "    Dialog.addMessage(\"Fiji detected this image scale from the image metadata: unit=\" + unit + \", XY pixel size=\" + pixelWidth + \" x \" + pixelHeight + \", Z step=\" + voxelDepth);\n";
macro3Dsingle = macro3Dsingle + "    Dialog.addChoice(\"Image scale/calibration:\", newArray(\"Use current image calibration\", \"Enter pixel size manually in microns\"), defaultScaleChoice);\n";
macro3Dsingle = macro3Dsingle + "    Dialog.addNumber(\"XY pixel size, microns per pixel:\", pixelWidth);\n";
macro3Dsingle = macro3Dsingle + "    Dialog.addNumber(\"Z-step size, microns per slice:\", voxelDepth);\n";
macro3Dsingle = macro3Dsingle + "    Dialog.show();\n";
macro3Dsingle = macro3Dsingle + "    scaleChoice = Dialog.getChoice();\n";
macro3Dsingle = macro3Dsingle + "    manualXY = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "    manualZ = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "    if (scaleChoice == \"Enter pixel size manually in microns\") {\n";
macro3Dsingle = macro3Dsingle + "        pixelWidth = manualXY;\n";
macro3Dsingle = macro3Dsingle + "        pixelHeight = manualXY;\n";
macro3Dsingle = macro3Dsingle + "        voxelDepth = manualZ;\n";
macro3Dsingle = macro3Dsingle + "        calibrationSource = \"Manual input\";\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "if (pixelWidth <= 0) pixelWidth = 1;\n";
macro3Dsingle = macro3Dsingle + "if (pixelHeight <= 0) pixelHeight = pixelWidth;\n";
macro3Dsingle = macro3Dsingle + "if (voxelDepth <= 0) voxelDepth = pixelWidth;\n";
macro3Dsingle = macro3Dsingle + "run(\"Properties...\", \"channels=\" + channels + \" slices=\" + slices + \" frames=\" + frames + \" unit=micron pixel_width=\" + pixelWidth + \" pixel_height=\" + pixelHeight + \" voxel_depth=\" + voxelDepth);\n";
macro3Dsingle = macro3Dsingle + "safeUnit = \"um\";\n";
macro3Dsingle = macro3Dsingle + "\n";macro3Dsingle = macro3Dsingle + "function exportCellBoundaryROIs(boundaryCSV, sourceTitleForBoundary, runIDForBoundary, frameForBoundary, pixelWidthForBoundary, pixelHeightForBoundary) {\n";
macro3Dsingle = macro3Dsingle + "    if (isOpen(\"ROI Manager\") == 0) return;\n";
macro3Dsingle = macro3Dsingle + "    if (!File.exists(boundaryCSV)) File.saveString(\"Source_Input,Run_ID,Image,Frame,Cell_ID,Point_Index,X_um,Y_um,X_pixel,Y_pixel\\n\", boundaryCSV);\n";
macro3Dsingle = macro3Dsingle + "    safeBoundaryImage = replace(sourceTitleForBoundary, \",\", \"_\");\n";
macro3Dsingle = macro3Dsingle + "    safeBoundaryRunID = replace(runIDForBoundary, \",\", \"_\");\n";
macro3Dsingle = macro3Dsingle + "    boundaryRoiCount = roiManager(\"count\");\n";
macro3Dsingle = macro3Dsingle + "    for (bc = 0; bc < boundaryRoiCount; bc++) {\n";
macro3Dsingle = macro3Dsingle + "        roiManager(\"Select\", bc);\n";
macro3Dsingle = macro3Dsingle + "        getSelectionCoordinates(boundaryXPoints, boundaryYPoints);\n";
macro3Dsingle = macro3Dsingle + "        for (bp = 0; bp < boundaryXPoints.length; bp++) {\n";
macro3Dsingle = macro3Dsingle + "            bxPix = boundaryXPoints[bp]; byPix = boundaryYPoints[bp];\n";
macro3Dsingle = macro3Dsingle + "            bxUm = bxPix * pixelWidthForBoundary; byUm = byPix * pixelHeightForBoundary;\n";
macro3Dsingle = macro3Dsingle + "            File.append(safeBoundaryImage + \",\" + safeBoundaryRunID + \",\" + safeBoundaryImage + \",\" + frameForBoundary + \",\" + (bc + 1) + \",\" + (bp + 1) + \",\" + bxUm + \",\" + byUm + \",\" + bxPix + \",\" + byPix + \"\\n\", boundaryCSV);\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "        if (boundaryXPoints.length > 0) {\n";
macro3Dsingle = macro3Dsingle + "            bxPix = boundaryXPoints[0]; byPix = boundaryYPoints[0];\n";
macro3Dsingle = macro3Dsingle + "            bxUm = bxPix * pixelWidthForBoundary; byUm = byPix * pixelHeightForBoundary;\n";
macro3Dsingle = macro3Dsingle + "            File.append(safeBoundaryImage + \",\" + safeBoundaryRunID + \",\" + safeBoundaryImage + \",\" + frameForBoundary + \",\" + (bc + 1) + \",\" + (boundaryXPoints.length + 1) + \",\" + bxUm + \",\" + byUm + \",\" + bxPix + \",\" + byPix + \"\\n\", boundaryCSV);\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "    roiManager(\"Deselect\");\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";

macro3Dsingle = macro3Dsingle + "if (slices < 2) exit(\"This macro is for 3D Z-stacks only. Your image has fewer than 2 Z-slices.\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "parentOutputDir = getDirectory(\"Choose main output folder for 3D satellite results\");\n";
macro3Dsingle = macro3Dsingle + "if (parentOutputDir == \"\") exit(\"No output folder selected.\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "Dialog.create(\"SatelliteQuantify 3D - Output options\");\n";
macro3Dsingle = macro3Dsingle + "Dialog.addMessage(\"A separate 3D result folder will be created for this image.\");\n";
macro3Dsingle = macro3Dsingle + "Dialog.addMessage(\"Intermediate images are optional TIFF files saved for checking the 3D analysis.\");\n";
macro3Dsingle = macro3Dsingle + "Dialog.addMessage(\"Examples include satellite max-projection snapshots, satellite review ROIs, centrosome review images, and cell-sphere review images.\");\n";
macro3Dsingle = macro3Dsingle + "Dialog.addMessage(\"Recommended: keep this ON while optimizing settings; turn it OFF later for faster runs and smaller output folders.\");\n";
macro3Dsingle = macro3Dsingle + "Dialog.addCheckbox(\"Save intermediate images for visual checking\", true);\n";
macro3Dsingle = macro3Dsingle + "Dialog.show();\n";
macro3Dsingle = macro3Dsingle + "saveQCImages = Dialog.getCheckbox();\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "outputDir = parentOutputDir + runID + \"_SatelliteQuantify_3D_satellites_only\" + File.separator;\n";
macro3Dsingle = macro3Dsingle + "if (!File.exists(outputDir)) File.makeDirectory(outputDir);\n";
macro3Dsingle = macro3Dsingle + "cellBoundaryCSV = outputDir + runID + \"_cell_boundaries_for_python.csv\";\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "if (saveQCImages) {\n";
macro3Dsingle = macro3Dsingle + "    qcDir = outputDir + \"Intermediate_saved_images\" + File.separator;\n";
macro3Dsingle = macro3Dsingle + "    if (!File.exists(qcDir)) File.makeDirectory(qcDir);\n";
macro3Dsingle = macro3Dsingle + "} else {\n";
