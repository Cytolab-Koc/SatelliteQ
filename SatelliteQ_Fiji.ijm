macroTL = macroTL + "        run(\"Duplicate...\", \"title=SQ3D_3D_Segmentation_Mask_Source duplicate channels=\" + satelliteChannel);\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=SQ3D_3D_Segmentation_Mask_Source\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    run(\"Subtract Background...\", \"rolling=\" + rollingBall + \" stack\");\n";
