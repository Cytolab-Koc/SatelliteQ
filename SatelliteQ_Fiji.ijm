macro2Dsingle = macro2Dsingle + "    Dialog.addChoice(\"Cell ROI drawing/review image:\", newArray(\"Cell signal channel + cell boundary only\", \"Cell signal channel + cell boundary + centrosome\", \"Cell signal channel + cell boundary + satellite\", \"Cell signal channel + cell boundary + centrosome + satellite\", \"Cell signal channel + cell boundary + centrosome + centrosome numbers + satellite\"), \"Cell signal channel + cell boundary only\");\n";
