macroTL = macroTL + "        } else {\n";
macroTL = macroTL + "            centThresholdValue = centManualThreshold;\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=SQ3D_centrosome_detection_mask\");\n";
macroTL = macroTL + "        setThreshold(centThresholdValue, 65535);\n";
macroTL = macroTL + "        run(\"Convert to Mask\", \"method=Default background=Default black\");\n";
macroTL = macroTL + "        run(\"Set Measurements...\", \"area mean min max centroid center integrated median redirect=None decimal=3\");\n";
macroTL = macroTL + "        run(\"Analyze Particles...\", \"size=\" + minCentArea + \"-\" + maxCentArea + \" show=Nothing display clear add\");\n";
macroTL = macroTL + "\n";
