macroTL = macroTL + "    Dialog.addNumber(\"Percent of image maximum:\", d_centPercentMax);\n";
macroTL = macroTL + "    Dialog.addNumber(\"Manual centrosome intensity threshold, AU:\", d_centManualThreshold);\n";
macroTL = macroTL + "    Dialog.addNumber(\"Minimum centrosome object size, pixels^2:\", d_minCentSize);\n";
macroTL = macroTL + "    Dialog.addNumber(\"Maximum centrosome object size, pixels^2:\", d_maxCentSize);\n";
macroTL = macroTL + "    Dialog.addNumber(\"Maximum centrosomes to keep, 0 = keep all thresholded objects:\", d_maxCentrosomesWholeImage);\n";
macroTL = macroTL + "    Dialog.addNumber(\"Centrosome display circle diameter, pixels:\", d_centDisplayDiameter);\n";
macroTL = macroTL + "    Dialog.addCheckbox(\"Review/edit detected centrosomes before continuing:\", d_reviewCentrosomesBeforeContinue);\n";
macroTL = macroTL + "    Dialog.addChoice(\"Centrosome ROI review image:\", newArray(\"Centrosome channel only\", \"Centrosome channel + satellite channel\"), d_centROIDisplayMode);\n";
macroTL = macroTL + "    Dialog.show();\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    centrosomeDetectionMode = Dialog.getChoice();\n";
