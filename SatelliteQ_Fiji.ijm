macro2Dsingle = macro2Dsingle + "    centrosomeRadiusMicron = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    cellRollingBall = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    cellBoundarySourceType = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "    cellThresholdMode = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "    cellThreshold = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "    cellLocalThresholdMethod = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "    cellLocalRadius = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    cellManualThreshold = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    cellPreprocessStrength = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "    cellCleanupMode = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "    cellROIDisplayMode = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "    cellDoWatershed = Dialog.getCheckbox();\n";
macro2Dsingle = macro2Dsingle + "    cellWatershedProtection = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "    minCellArea = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    maxCellArea = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    multiCentrosomeMode = d_multiCentrosomeMode;\n";
macro2Dsingle = macro2Dsingle + "    if (centrosomeDetectionMode != \"Skip centrosome\" && cellAssignmentMode != \"No cell assignment\") {\n";
macro2Dsingle = macro2Dsingle + "        Dialog.create(\"Multiple centrosomes in one cell\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addMessage(\"Some cells can contain more than one centrosome ROI after detection or manual editing.\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addMessage(\"This choice only affects cells with multiple centrosomes. Cells with one centrosome are assigned normally.\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addMessage(\"Choose how satellites should be assigned when a single cell contains more than one centrosome.\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addRadioButtonGroup(\"When a cell contains more than one centrosome:\", newArray(\"Use all centrosomes in cell (assign nearest)\", \"Use midpoint of centrosomes in cell\", \"Ignore cells with multiple centrosomes\"), 3, 1, d_multiCentrosomeMode);\n";
macro2Dsingle = macro2Dsingle + "        Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "        multiCentrosomeMode = Dialog.getRadioButton();\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "d_centrosomeDetectionMode = centrosomeDetectionMode;\n";
macro2Dsingle = macro2Dsingle + "d_centRollingBall = centRollingBall;\n";
macro2Dsingle = macro2Dsingle + "d_centGaussianSigma = centGaussianSigma;\n";
macro2Dsingle = macro2Dsingle + "d_centBrightThresholdMode = centBrightThresholdMode;\n";
macro2Dsingle = macro2Dsingle + "d_centSDMultiplier = centSDMultiplier;\n";
macro2Dsingle = macro2Dsingle + "d_centPercentMax = centPercentMax;\n";
macro2Dsingle = macro2Dsingle + "d_centManualThreshold = centManualThreshold;\n";
macro2Dsingle = macro2Dsingle + "d_minCentSize = minCentSize;\n";
macro2Dsingle = macro2Dsingle + "d_maxCentSize = maxCentSize;\n";
macro2Dsingle = macro2Dsingle + "d_maxCentrosomesWholeImage = maxCentrosomesWholeImage;\n";
macro2Dsingle = macro2Dsingle + "d_centDisplayDiameter = centDisplayDiameter;\n";
macro2Dsingle = macro2Dsingle + "d_reviewCentrosomesBeforeContinue = reviewCentrosomesBeforeContinue;\n";
macro2Dsingle = macro2Dsingle + "d_centROIDisplayMode = centROIDisplayMode;\n";
macro2Dsingle = macro2Dsingle + "d_cellROIDisplayMode = cellROIDisplayMode;\n";
macro2Dsingle = macro2Dsingle + "d_cellAssignmentMode = cellAssignmentMode;\n";
macro2Dsingle = macro2Dsingle + "d_centrosomeRadiusMicron = centrosomeRadiusMicron;\n";
macro2Dsingle = macro2Dsingle + "d_cellRollingBall = cellRollingBall;\n";
macro2Dsingle = macro2Dsingle + "d_cellThreshold = cellThreshold;\n";
macro2Dsingle = macro2Dsingle + "d_cellBoundarySourceType = cellBoundarySourceType;\n";
macro2Dsingle = macro2Dsingle + "d_cellThresholdMode = cellThresholdMode;\n";
macro2Dsingle = macro2Dsingle + "d_cellLocalThresholdMethod = cellLocalThresholdMethod;\n";
macro2Dsingle = macro2Dsingle + "d_cellLocalRadius = cellLocalRadius;\n";
macro2Dsingle = macro2Dsingle + "d_cellManualThreshold = cellManualThreshold;\n";
macro2Dsingle = macro2Dsingle + "d_cellPreprocessStrength = cellPreprocessStrength;\n";
macro2Dsingle = macro2Dsingle + "d_minCellArea = minCellArea;\n";
macro2Dsingle = macro2Dsingle + "d_maxCellArea = maxCellArea;\n";
macro2Dsingle = macro2Dsingle + "d_cellCleanupMode = cellCleanupMode;\n";
macro2Dsingle = macro2Dsingle + "d_cellDoWatershed = cellDoWatershed;\n";
macro2Dsingle = macro2Dsingle + "d_cellWatershedProtection = cellWatershedProtection;\n";
macro2Dsingle = macro2Dsingle + "d_multiCentrosomeMode = multiCentrosomeMode;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "centThresholdMode = \"Auto\";\n";
macro2Dsingle = macro2Dsingle + "centThreshold = \"Otsu\";\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"No cell assignment\") {\n";
macro2Dsingle = macro2Dsingle + "    exportOutsideMode = \"Whole image - export all satellites\";\n";
macro2Dsingle = macro2Dsingle + "} else {\n";
macro2Dsingle = macro2Dsingle + "    if (sqTLUseSame && sqTLHasPrev) {\n";
macro2Dsingle = macro2Dsingle + "        exportOutsideMode = d_exportOutsideMode;\n";
macro2Dsingle = macro2Dsingle + "    } else {\n";
macro2Dsingle = macro2Dsingle + "        Dialog.create(\"SatelliteQuantify 2D - Step 4/4: Processing/export mode\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addMessage(\"This controls satellites outside selected cell ROIs, cell masks, or centrosome-radius regions.\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addMessage(\"Choose whether to export only assigned satellites or keep all satellites for whole-image QC.\");\n";
macro2Dsingle = macro2Dsingle + "        exportModeAssignedOnly = \"Selected cell areas only - ignore outside\";\n";
macro2Dsingle = macro2Dsingle + "        exportModeWholeImage = \"Whole image - export outside as Cell_ID NaN\";\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addRadioButtonGroup(\n";
macro2Dsingle = macro2Dsingle + "            \"Export mode:\",\n";
macro2Dsingle = macro2Dsingle + "            newArray(exportModeAssignedOnly, exportModeWholeImage),\n";
macro2Dsingle = macro2Dsingle + "            2,\n";
macro2Dsingle = macro2Dsingle + "            1,\n";
macro2Dsingle = macro2Dsingle + "            d_exportOutsideMode\n";
macro2Dsingle = macro2Dsingle + "        );\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addMessage(\"Selected cell areas only: exports only satellites assigned to a cell/ROI/radius region.\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addMessage(\"Whole image: exports assigned satellites plus unassigned satellites at the bottom with Cell_ID = NaN.\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "        exportOutsideMode = Dialog.getRadioButton();\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "d_exportOutsideMode = exportOutsideMode;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (sqTLActive) {\n";
macro2Dsingle = macro2Dsingle + "    sqTL2DSave = \"\" + d_treatSlicesAsChannels + \"|\" + d_saveQCImages + \"|\" + d_satelliteChannel + \"|\" + d_centrosomeChannel + \"|\" + d_membraneChannel + \"|\" + d_projectionMethod + \"|\" + d_satRollingBall + \"|\" + d_satThresholdMode + \"|\" + d_satThreshold + \"|\" + d_satManualThreshold + \"|\" + d_satHysteresisMultiplier + \"|\" + d_minSatSize + \"|\" + d_maxSatSize + \"|\" + d_doSatWatershed + \"|\" + d_reviewSatellitesBeforeContinue + \"|\" + d_centrosomeDetectionMode + \"|\" + d_centRollingBall + \"|\" + d_centGaussianSigma + \"|\" + d_centBrightThresholdMode + \"|\" + d_centSDMultiplier + \"|\" + d_centPercentMax + \"|\" + d_centManualThreshold + \"|\" + d_minCentSize + \"|\" + d_maxCentSize + \"|\" + d_maxCentrosomesWholeImage + \"|\" + d_centDisplayDiameter + \"|\" + d_reviewCentrosomesBeforeContinue + \"|\" + d_cellAssignmentMode + \"|\" + d_centrosomeRadiusMicron + \"|\" + d_cellRollingBall + \"|\" + d_cellThreshold + \"|\" + d_minCellArea + \"|\" + d_maxCellArea + \"|\" + d_exportOutsideMode + \"|\" + d_multiCentrosomeMode + \"|\" + d_cellBoundarySourceType + \"|\" + d_cellThresholdMode + \"|\" + d_cellLocalThresholdMethod + \"|\" + d_cellLocalRadius + \"|\" + d_cellManualThreshold + \"|\" + d_cellPreprocessStrength + \"|\" + d_cellWatershedProtection + \"|0|false|20|Otsu|20|1000|\" + d_satSplitMethod + \"|\" + d_satPeakProminence + \"|\" + d_satLargeSplitMinSize + \"|\" + d_satForcedSpotRadiusPix + \"|\" + d_centROIDisplayMode + \"|\" + d_cellROIDisplayMode;\n";
macro2Dsingle = macro2Dsingle + "    File.saveString(sqTL2DSave, sqTL2DSettingsPath);\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "includeUnassignedSatellites = false;\n";
macro2Dsingle = macro2Dsingle + "if (exportOutsideMode == \"Whole image - export outside as Cell_ID NaN\") includeUnassignedSatellites = true;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (centrosomeDetectionMode == \"Segmentation from channel\" && centrosomeChannel == 0) exit(\"Centrosome segmentation selected, but centrosome channel is 0.\");\n";
macro2Dsingle = macro2Dsingle + "if (centrosomeDetectionMode == \"Bright puncta threshold + top intensity\" && centrosomeChannel == 0) exit(\"Bright puncta centrosome detection selected, but centrosome channel is 0.\");\n";
macro2Dsingle = macro2Dsingle + "if (centrosomeDetectionMode == \"Manual centrosome ROIs during macro\" && centrosomeChannel == 0) exit(\"Manual centrosome ROI mode selected, but centrosome channel is 0.\");\n";
macro2Dsingle = macro2Dsingle + "if ((cellAssignmentMode == \"Membrane marker\" || cellAssignmentMode == \"Cytoplasmic signal boundary\") && membraneChannel == 0) exit(\"Cell boundary assignment selected, but membrane/cytoplasmic boundary channel is 0.\");\n";
macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"Centrosome radius\" && centrosomeChannel == 0 && centrosomeDetectionMode != \"Existing ROIs in ROI Manager\") exit(\"Centrosome radius mode needs centrosomes.\");\n";
macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"Existing cell ROIs in ROI Manager\" && initialRoiCount == 0) exit(\"Existing cell ROIs selected, but ROI Manager had 0 ROIs at the start.\");\n";
macro2Dsingle = macro2Dsingle + "if (centrosomeDetectionMode == \"Existing ROIs in ROI Manager\" && initialRoiCount == 0) exit(\"Existing centrosome ROIs selected, but ROI Manager had 0 ROIs at the start.\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "selectWindow(originalTitle);\n";
macro2Dsingle = macro2Dsingle + "if (channels > 1) run(\"Split Channels\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "satelliteProjection = projectChannel(satelliteChannel, originalTitle, projectionMethod, \"Satellite_Projection\", slices);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "satelliteDetectionAccepted = false;\n";
macro2Dsingle = macro2Dsingle + "while (satelliteDetectionAccepted == false) {\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Satellite_BackgroundSubtracted\")) { selectWindow(\"Satellite_BackgroundSubtracted\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Satellite_Mask\")) { selectWindow(\"Satellite_Mask\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Satellite_QC_Outlines\")) { selectWindow(\"Satellite_QC_Outlines\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Satellite_Selected_ROI_Review_QC\")) { selectWindow(\"Satellite_Selected_ROI_Review_QC\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(satelliteProjection);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Select None\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Duplicate...\", \"title=Satellite_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Satellite_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Subtract Background...\", \"rolling=\" + satRollingBall);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    thresholdToMask(\"Satellite_BackgroundSubtracted\", \"Satellite_Mask\", satThresholdMode, satThreshold, satManualThreshold, satHysteresisMultiplier, doSatWatershed);\n";
macro2Dsingle = macro2Dsingle + "    if (satSplitMethod == \"Local intensity peaks\") {\n";
macro2Dsingle = macro2Dsingle + "        splitSatelliteMaskByLocalPeaks(\"Satellite_BackgroundSubtracted\", \"Satellite_Mask\", \"Satellite_Mask_PeakSplit\", satPeakProminence);\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(\"Satellite_Mask\")) { selectWindow(\"Satellite_Mask\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Satellite_Mask_PeakSplit\");\n";
macro2Dsingle = macro2Dsingle + "        rename(\"Satellite_Mask\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    if (satSplitMethod == \"Local intensity peaks\" || satSplitMethod == \"Local intensity peaks\" || satSplitMethod == \"Local intensity peaks\") {\n";
macro2Dsingle = macro2Dsingle + "        selectiveLargeSatelliteSplit(\"Satellite_BackgroundSubtracted\", \"Satellite_Mask\", \"Satellite_Mask_LargeSelectiveSplit\", satSplitMethod, satLargeSplitMinSize, satPeakProminence, satForcedSpotRadiusPix);\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(\"Satellite_Mask\")) { selectWindow(\"Satellite_Mask\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Satellite_Mask_LargeSelectiveSplit\");\n";
macro2Dsingle = macro2Dsingle + "        rename(\"Satellite_Mask\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Set Measurements...\", \"area mean integrated centroid center shape redirect=None decimal=3\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Satellite_Mask\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Analyze Particles...\", \"size=\" + minSatSize + \"-\" + maxSatSize + \" show=Outlines display clear add\");\n";
macro2Dsingle = macro2Dsingle + "    rename(\"Satellite_QC_Outlines\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Set Measurements...\", \"area mean integrated centroid center shape redirect=None decimal=3\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Satellite_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Deselect\");\n";
macro2Dsingle = macro2Dsingle + "    if (roiManager(\"count\") > 0) roiManager(\"Measure\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (satThresholdMode == \"Hysteresis-like\") {\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Satellite_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "        setAutoThreshold(satThreshold + \" dark\");\n";
macro2Dsingle = macro2Dsingle + "        getThreshold(satLowThresholdValue, satUpperThresholdValue);\n";
macro2Dsingle = macro2Dsingle + "        satHighThresholdValue = satLowThresholdValue * satHysteresisMultiplier;\n";
macro2Dsingle = macro2Dsingle + "        resetThreshold();\n";
macro2Dsingle = macro2Dsingle + "        satRoiCount = roiManager(\"count\");\n";
macro2Dsingle = macro2Dsingle + "        keepSatRoi = newArray(satRoiCount);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        for (hs = 0; hs < satRoiCount; hs++) {\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Select\", hs);\n";
macro2Dsingle = macro2Dsingle + "            getStatistics(hAreaTmp, hMeanTmp, hMinTmp, hMaxTmp, hStdTmp);\n";
macro2Dsingle = macro2Dsingle + "            if (hMaxTmp >= satHighThresholdValue) keepSatRoi[hs] = 1;\n";
macro2Dsingle = macro2Dsingle + "            else keepSatRoi[hs] = 0;\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        for (hs = satRoiCount - 1; hs >= 0; hs--) {\n";
macro2Dsingle = macro2Dsingle + "            if (keepSatRoi[hs] == 0) {\n";
macro2Dsingle = macro2Dsingle + "                roiManager(\"Select\", hs);\n";
macro2Dsingle = macro2Dsingle + "                roiManager(\"Delete\");\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Set Measurements...\", \"area mean integrated centroid center shape redirect=None decimal=3\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Deselect\");\n";
macro2Dsingle = macro2Dsingle + "        if (roiManager(\"count\") > 0) roiManager(\"Measure\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(\"Satellite_QC_Outlines\")) {\n";
macro2Dsingle = macro2Dsingle + "            selectWindow(\"Satellite_QC_Outlines\");\n";
macro2Dsingle = macro2Dsingle + "            close();\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (reviewSatellitesBeforeContinue) {\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Satellite_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "        waitForUser(\"Satellite review\",\n";
macro2Dsingle = macro2Dsingle + "            \"Review detected satellites now.\\n\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"- Delete incorrect ROIs from ROI Manager\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"- Add missing satellites manually as area ROIs if needed\\n\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"Click OK when you are done reviewing.\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Satellite_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Set Measurements...\", \"area mean integrated centroid center shape redirect=None decimal=3\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Deselect\");\n";
macro2Dsingle = macro2Dsingle + "        if (roiManager(\"count\") > 0) {\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Measure\");\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (saveQCImages && roiManager(\"count\") > 0) {\n";
macro2Dsingle = macro2Dsingle + "            selectWindow(\"Satellite_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "            run(\"Flatten\");\n";
macro2Dsingle = macro2Dsingle + "            rename(\"Satellite_Selected_ROI_Review_QC\");\n";
macro2Dsingle = macro2Dsingle + "            saveAs(\"Tiff\", qcDir + runID + \"_satellite_selected_ROI_review_QC.tif\");\n";
macro2Dsingle = macro2Dsingle + "            setOption(\"Changes\", false);\n";
macro2Dsingle = macro2Dsingle + "            close();\n";
macro2Dsingle = macro2Dsingle + "            selectWindow(\"Satellite_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(\"Satellite_QC_Outlines\")) {\n";
macro2Dsingle = macro2Dsingle + "            selectWindow(\"Satellite_QC_Outlines\");\n";
macro2Dsingle = macro2Dsingle + "            close();\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Satellite_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.create(\"Accept satellites?\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addMessage(\"Detected / selected satellite ROIs: \" + roiManager(\"count\"));\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addRadioButtonGroup(\"Next step:\", newArray(\"Accept satellites and continue\", \"Change satellite settings and re-detect\"), 2, 1, \"Accept satellites and continue\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "        satelliteDecision = Dialog.getRadioButton();\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (satelliteDecision == \"Accept satellites and continue\") {\n";
macro2Dsingle = macro2Dsingle + "            satelliteDetectionAccepted = true;\n";
macro2Dsingle = macro2Dsingle + "        } else {\n";
macro2Dsingle = macro2Dsingle + "            Dialog.create(\"Redo satellite detection settings\");\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Satellite rolling ball radius:\", satRollingBall);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addChoice(\"Satellite threshold mode:\", newArray(\"Auto\", \"Manual value\", \"Hysteresis-like\"), satThresholdMode);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addChoice(\"Satellite auto-threshold method:\", newArray(\"Otsu\", \"Triangle\", \"Moments\", \"Default\", \"Li\", \"Yen\"), satThreshold);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Manual satellite threshold value:\", satManualThreshold);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Hysteresis high-threshold multiplier:\", satHysteresisMultiplier);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Minimum satellite size:\", minSatSize);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Maximum satellite size:\", maxSatSize);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addCheckbox(\"Use binary watershed for touching satellites\", doSatWatershed);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addChoice(\"Large-cluster satellite splitting:\", newArray(\"Off\", \"Local intensity peaks\"), satSplitMethod);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Only split satellite objects larger than this size:\", satLargeSplitMinSize);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Forced peak-centered spot radius, pixels:\", satForcedSpotRadiusPix);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Local-peak prominence for cluster splitting, AU:\", satPeakProminence);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "            satRollingBall = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "            satThresholdMode = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "            satThreshold = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "            satManualThreshold = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "            satHysteresisMultiplier = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "            minSatSize = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "            maxSatSize = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "            doSatWatershed = Dialog.getCheckbox();\n";
macro2Dsingle = macro2Dsingle + "            satSplitMethod = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "            satLargeSplitMinSize = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "            satForcedSpotRadiusPix = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "            satPeakProminence = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "            d_satRollingBall = satRollingBall;\n";
macro2Dsingle = macro2Dsingle + "            d_satThresholdMode = satThresholdMode;\n";
macro2Dsingle = macro2Dsingle + "            d_satThreshold = satThreshold;\n";
macro2Dsingle = macro2Dsingle + "            d_satManualThreshold = satManualThreshold;\n";
macro2Dsingle = macro2Dsingle + "            d_satHysteresisMultiplier = satHysteresisMultiplier;\n";
macro2Dsingle = macro2Dsingle + "            d_minSatSize = minSatSize;\n";
macro2Dsingle = macro2Dsingle + "            d_maxSatSize = maxSatSize;\n";
macro2Dsingle = macro2Dsingle + "            d_doSatWatershed = doSatWatershed;\n";
macro2Dsingle = macro2Dsingle + "            d_satSplitMethod = satSplitMethod;\n";
macro2Dsingle = macro2Dsingle + "            d_satPeakProminence = satPeakProminence;\n";
macro2Dsingle = macro2Dsingle + "            d_satLargeSplitMinSize = satLargeSplitMinSize;\n";
macro2Dsingle = macro2Dsingle + "            d_satForcedSpotRadiusPix = satForcedSpotRadiusPix;\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    } else {\n";
macro2Dsingle = macro2Dsingle + "        satelliteDetectionAccepted = true;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "satelliteCount = nResults;\n";
macro2Dsingle = macro2Dsingle + "satArea = newArray(satelliteCount);\n";
macro2Dsingle = macro2Dsingle + "satCircularity2D = newArray(satelliteCount);\n";
macro2Dsingle = macro2Dsingle + "satMean = newArray(satelliteCount);\n";
macro2Dsingle = macro2Dsingle + "satIntDen = newArray(satelliteCount);\n";
macro2Dsingle = macro2Dsingle + "satX = newArray(satelliteCount);\n";
macro2Dsingle = macro2Dsingle + "satY = newArray(satelliteCount);\n";
macro2Dsingle = macro2Dsingle + "satXpix = newArray(satelliteCount);\n";
macro2Dsingle = macro2Dsingle + "satYpix = newArray(satelliteCount);\n";
macro2Dsingle = macro2Dsingle + "satCellID = newArray(satelliteCount);\n";
macro2Dsingle = macro2Dsingle + "satCellMode = newArray(satelliteCount);\n";
macro2Dsingle = macro2Dsingle + "satCellArea = newArray(satelliteCount);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "for (i = 0; i < satelliteCount; i++) {\n";
macro2Dsingle = macro2Dsingle + "    satArea[i] = getResult(\"Area\", i);\n";
macro2Dsingle = macro2Dsingle + "    satCircularity2D[i] = getResult(\"Circ.\", i);\n";
macro2Dsingle = macro2Dsingle + "    satMean[i] = getResult(\"Mean\", i);\n";
macro2Dsingle = macro2Dsingle + "    satIntDen[i] = getResult(\"RawIntDen\", i);\n";
macro2Dsingle = macro2Dsingle + "    satX[i] = getResult(\"X\", i);\n";
macro2Dsingle = macro2Dsingle + "    satY[i] = getResult(\"Y\", i);\n";
macro2Dsingle = macro2Dsingle + "    satXpix[i] = satX[i] / pixelWidth;\n";
macro2Dsingle = macro2Dsingle + "    satYpix[i] = satY[i] / pixelHeight;\n";
macro2Dsingle = macro2Dsingle + "    satCellID[i] = 0;\n";
macro2Dsingle = macro2Dsingle + "    satCellMode[i] = \"Unassigned\";\n";
macro2Dsingle = macro2Dsingle + "    satCellArea[i] = \"NaN\";\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "centrosomeDetectionAccepted = false;\n";
macro2Dsingle = macro2Dsingle + "while (centrosomeDetectionAccepted == false) {\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Centrosome_Projection\")) { selectWindow(\"Centrosome_Projection\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Centrosome_BackgroundSubtracted\")) { selectWindow(\"Centrosome_BackgroundSubtracted\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Centrosome_Filtered\")) { selectWindow(\"Centrosome_Filtered\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Centrosome_BrightPuncta_Mask\")) { selectWindow(\"Centrosome_BrightPuncta_Mask\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Centrosome_Mask\")) { selectWindow(\"Centrosome_Mask\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Centrosome_QC_Outlines\")) { selectWindow(\"Centrosome_QC_Outlines\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Centrosome_Selected_QC\")) { selectWindow(\"Centrosome_Selected_QC\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "    if (isOpen(\"Centrosome_Selected_ROI_Review_QC\")) { selectWindow(\"Centrosome_Selected_ROI_Review_QC\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "centrosomeCount = 0;\n";
macro2Dsingle = macro2Dsingle + "centX = newArray(0);\n";
macro2Dsingle = macro2Dsingle + "centY = newArray(0);\n";
macro2Dsingle = macro2Dsingle + "centXpix = newArray(0);\n";
macro2Dsingle = macro2Dsingle + "centYpix = newArray(0);\n";
macro2Dsingle = macro2Dsingle + "centIntensity = newArray(0);\n";
macro2Dsingle = macro2Dsingle + "centArea = newArray(0);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (centrosomeDetectionMode == \"Bright puncta threshold + top intensity\") {\n";
macro2Dsingle = macro2Dsingle + "    centrosomeProjection = projectChannel(centrosomeChannel, originalTitle, projectionMethod, \"Centrosome_Projection\", slices);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(centrosomeProjection);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Duplicate...\", \"title=Centrosome_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Centrosome_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Subtract Background...\", \"rolling=\" + centRollingBall);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    run(\"Duplicate...\", \"title=Centrosome_Filtered\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Centrosome_Filtered\");\n";
macro2Dsingle = macro2Dsingle + "    if (centGaussianSigma > 0) {\n";
macro2Dsingle = macro2Dsingle + "        run(\"Gaussian Blur...\", \"sigma=\" + centGaussianSigma);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    getStatistics(imgArea, imgMean, imgMin, imgMax, imgStd);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (centBrightThresholdMode == \"Mean + SD multiplier\") {\n";
macro2Dsingle = macro2Dsingle + "        centThresholdValue = imgMean + centSDMultiplier * imgStd;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    if (centBrightThresholdMode == \"Percent of image maximum\") {\n";
macro2Dsingle = macro2Dsingle + "        centThresholdValue = imgMax * centPercentMax / 100;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    if (centBrightThresholdMode == \"Manual value\") {\n";
macro2Dsingle = macro2Dsingle + "        centThresholdValue = centManualThreshold;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    setThreshold(centThresholdValue, imgMax);\n";
macro2Dsingle = macro2Dsingle + "    setOption(\"BlackBackground\", false);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Convert to Mask\");\n";
macro2Dsingle = macro2Dsingle + "    rename(\"Centrosome_BrightPuncta_Mask\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Set Measurements...\", \"area mean integrated centroid center redirect=Centrosome_BackgroundSubtracted decimal=3\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Centrosome_BrightPuncta_Mask\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Analyze Particles...\", \"size=\" + minCentSize + \"-\" + maxCentSize + \" show=Outlines display clear add\");\n";
macro2Dsingle = macro2Dsingle + "    rename(\"Centrosome_QC_Outlines\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    candidateCount = nResults;\n";
macro2Dsingle = macro2Dsingle + "    candX = newArray(candidateCount);\n";
macro2Dsingle = macro2Dsingle + "    candY = newArray(candidateCount);\n";
macro2Dsingle = macro2Dsingle + "    candXpix = newArray(candidateCount);\n";
macro2Dsingle = macro2Dsingle + "    candYpix = newArray(candidateCount);\n";
macro2Dsingle = macro2Dsingle + "    candIntensity = newArray(candidateCount);\n";
macro2Dsingle = macro2Dsingle + "    candArea = newArray(candidateCount);\n";
macro2Dsingle = macro2Dsingle + "    candUsed = newArray(candidateCount);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    for (k = 0; k < candidateCount; k++) {\n";
macro2Dsingle = macro2Dsingle + "        candArea[k] = getResult(\"Area\", k);\n";
macro2Dsingle = macro2Dsingle + "        candIntensity[k] = getResult(\"RawIntDen\", k);\n";
macro2Dsingle = macro2Dsingle + "        candX[k] = getResult(\"X\", k);\n";
macro2Dsingle = macro2Dsingle + "        candY[k] = getResult(\"Y\", k);\n";
macro2Dsingle = macro2Dsingle + "        candXpix[k] = candX[k] / pixelWidth;\n";
macro2Dsingle = macro2Dsingle + "        candYpix[k] = candY[k] / pixelHeight;\n";
macro2Dsingle = macro2Dsingle + "        candUsed[k] = 0;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (maxCentrosomesWholeImage == 0) {\n";
macro2Dsingle = macro2Dsingle + "        centrosomeCount = candidateCount;\n";
macro2Dsingle = macro2Dsingle + "        centX = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "        centY = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "        centXpix = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "        centYpix = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "        centIntensity = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "        centArea = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        for (k = 0; k < candidateCount; k++) {\n";
macro2Dsingle = macro2Dsingle + "            centX[k] = candX[k];\n";
macro2Dsingle = macro2Dsingle + "            centY[k] = candY[k];\n";
macro2Dsingle = macro2Dsingle + "            centXpix[k] = candXpix[k];\n";
macro2Dsingle = macro2Dsingle + "            centYpix[k] = candYpix[k];\n";
macro2Dsingle = macro2Dsingle + "            centIntensity[k] = candIntensity[k];\n";
macro2Dsingle = macro2Dsingle + "            centArea[k] = candArea[k];\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    } else {\n";
macro2Dsingle = macro2Dsingle + "        centrosomeCount = 0;\n";
macro2Dsingle = macro2Dsingle + "        centX = newArray(maxCentrosomesWholeImage);\n";
macro2Dsingle = macro2Dsingle + "        centY = newArray(maxCentrosomesWholeImage);\n";
macro2Dsingle = macro2Dsingle + "        centXpix = newArray(maxCentrosomesWholeImage);\n";
macro2Dsingle = macro2Dsingle + "        centYpix = newArray(maxCentrosomesWholeImage);\n";
macro2Dsingle = macro2Dsingle + "        centIntensity = newArray(maxCentrosomesWholeImage);\n";
macro2Dsingle = macro2Dsingle + "        centArea = newArray(maxCentrosomesWholeImage);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        for (pick = 0; pick < maxCentrosomesWholeImage; pick++) {\n";
macro2Dsingle = macro2Dsingle + "            bestK = -1;\n";
macro2Dsingle = macro2Dsingle + "            bestIntensity = -1;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "            for (k = 0; k < candidateCount; k++) {\n";
macro2Dsingle = macro2Dsingle + "                if (candUsed[k] == 0) {\n";
macro2Dsingle = macro2Dsingle + "                    if (candIntensity[k] > bestIntensity) {\n";
macro2Dsingle = macro2Dsingle + "                        bestIntensity = candIntensity[k];\n";
macro2Dsingle = macro2Dsingle + "                        bestK = k;\n";
macro2Dsingle = macro2Dsingle + "                    }\n";
macro2Dsingle = macro2Dsingle + "                }\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "            if (bestK >= 0) {\n";
macro2Dsingle = macro2Dsingle + "                candUsed[bestK] = 1;\n";
macro2Dsingle = macro2Dsingle + "                centX[centrosomeCount] = candX[bestK];\n";
macro2Dsingle = macro2Dsingle + "                centY[centrosomeCount] = candY[bestK];\n";
macro2Dsingle = macro2Dsingle + "                centXpix[centrosomeCount] = candXpix[bestK];\n";
macro2Dsingle = macro2Dsingle + "                centYpix[centrosomeCount] = candYpix[bestK];\n";
macro2Dsingle = macro2Dsingle + "                centIntensity[centrosomeCount] = candIntensity[bestK];\n";
macro2Dsingle = macro2Dsingle + "                centArea[centrosomeCount] = candArea[bestK];\n";
macro2Dsingle = macro2Dsingle + "                centrosomeCount = centrosomeCount + 1;\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Centrosome_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (centDisplayDiameter < 2) centDisplayDiameter = 2;\n";
macro2Dsingle = macro2Dsingle + "    centRadius = centDisplayDiameter / 2;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    for (c = 0; c < centrosomeCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "        makeOval(centXpix[c] - centRadius, centYpix[c] - centRadius, centDisplayDiameter, centDisplayDiameter);\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Add\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (centrosomeCount > 0) {\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Show All\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (reviewCentrosomesBeforeContinue) {\n";
macro2Dsingle = macro2Dsingle + "        centReviewTitle = prepareCentrosomeDrawingView(centROIDisplayMode);\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(centReviewTitle);\n";
macro2Dsingle = macro2Dsingle + "        if (centrosomeCount > 0) roiManager(\"Show All\");\n";
macro2Dsingle = macro2Dsingle + "        waitForUser(\"Review/edit centrosomes\",\n";
macro2Dsingle = macro2Dsingle + "            \"Detected centrosomes are shown as ROIs on the selected centrosome review image.\\n\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"You can now edit them in ROI Manager:\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"- Delete wrong centrosome ROIs\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"- Move/resize circles if needed\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"- Add a missing centrosome by drawing an oval/point and pressing T\\n\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"When the ROI Manager contains the final centrosomes, click OK.\");\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(centReviewTitle);\n";
macro2Dsingle = macro2Dsingle + "        if (selectionType() != -1) roiManager(\"Update\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    centrosomeCount = roiManager(\"count\");\n";
macro2Dsingle = macro2Dsingle + "    centX = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "    centY = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "    centXpix = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "    centYpix = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "    centIntensity = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "    centArea = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Centrosome_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "    for (c = 0; c < centrosomeCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Select\", c);\n";
macro2Dsingle = macro2Dsingle + "        getSelectionBounds(rx, ry, rw, rh);\n";
macro2Dsingle = macro2Dsingle + "        centXpix[c] = rx + rw / 2;\n";
macro2Dsingle = macro2Dsingle + "        centYpix[c] = ry + rh / 2;\n";
macro2Dsingle = macro2Dsingle + "        centX[c] = centXpix[c] * pixelWidth;\n";
macro2Dsingle = macro2Dsingle + "        centY[c] = centYpix[c] * pixelHeight;\n";
macro2Dsingle = macro2Dsingle + "        px = floor(centXpix[c] + 0.5);\n";
macro2Dsingle = macro2Dsingle + "        py = floor(centYpix[c] + 0.5);\n";
macro2Dsingle = macro2Dsingle + "        centIntensity[c] = getPixel(px, py);\n";
macro2Dsingle = macro2Dsingle + "        getStatistics(roiArea, roiMean, roiMin, roiMax, roiStd);\n";
macro2Dsingle = macro2Dsingle + "        centArea[c] = roiArea;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (centrosomeCount > 0) {\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Save\", roiDir + runID + \"_selected_centrosome_rois_AFTER_REVIEW.zip\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (reviewCentrosomesBeforeContinue) {\n";
macro2Dsingle = macro2Dsingle + "        if (saveQCImages && isOpen(\"Centrosome_QC_Outlines\")) {\n";
macro2Dsingle = macro2Dsingle + "            selectWindow(\"Centrosome_QC_Outlines\");\n";
macro2Dsingle = macro2Dsingle + "            saveAs(\"Tiff\", qcDir + runID + \"_centrosome_INITIAL_detection_QC_outlines.tif\");\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(\"Centrosome_QC_Outlines\")) { selectWindow(\"Centrosome_QC_Outlines\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(\"Centrosome_Selected_ROI_Review_QC\")) { selectWindow(\"Centrosome_Selected_ROI_Review_QC\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "        finalCentReviewTitle = prepareCentrosomeDrawingView(centROIDisplayMode);\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(finalCentReviewTitle);\n";
macro2Dsingle = macro2Dsingle + "        run(\"Remove Overlay\");\n";
macro2Dsingle = macro2Dsingle + "        if (centrosomeCount > 0) roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Flatten\");\n";
macro2Dsingle = macro2Dsingle + "        rename(\"Centrosome_Selected_ROI_Review_QC\");\n";
macro2Dsingle = macro2Dsingle + "        if (saveQCImages) saveAs(\"Tiff\", qcDir + runID + \"_centrosome_selected_ROI_review_QC.tif\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Centrosome_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Duplicate...\", \"title=Centrosome_Selected_QC\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Centrosome_Selected_QC\");\n";
macro2Dsingle = macro2Dsingle + "    setColor(\"white\");\n";
macro2Dsingle = macro2Dsingle + "    for (c = 0; c < centrosomeCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "        makeOval(centXpix[c] - centRadius, centYpix[c] - centRadius, centDisplayDiameter, centDisplayDiameter);\n";
macro2Dsingle = macro2Dsingle + "        run(\"Draw\", \"slice\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    if (reviewCentrosomesBeforeContinue && isOpen(\"Centrosome_Selected_ROI_Review_QC\")) selectWindow(\"Centrosome_Selected_ROI_Review_QC\");\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (centrosomeDetectionMode == \"Segmentation from channel\") {\n";
macro2Dsingle = macro2Dsingle + "    centrosomeProjection = projectChannel(centrosomeChannel, originalTitle, projectionMethod, \"Centrosome_Projection\", slices);\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(centrosomeProjection);\n";
macro2Dsingle = macro2Dsingle + "    run(\"Duplicate...\", \"title=Centrosome_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Centrosome_BackgroundSubtracted\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Subtract Background...\", \"rolling=\" + centRollingBall);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    thresholdToMask(\"Centrosome_BackgroundSubtracted\", \"Centrosome_Mask\", centThresholdMode, centThreshold, centManualThreshold, 1.0, true);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    run(\"Clear Results\");\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Set Measurements...\", \"area mean integrated centroid center shape redirect=Centrosome_BackgroundSubtracted decimal=3\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Centrosome_Mask\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Analyze Particles...\", \"size=\" + minCentSize + \"-\" + maxCentSize + \" show=Outlines display clear add\");\n";
macro2Dsingle = macro2Dsingle + "    rename(\"Centrosome_QC_Outlines\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    centrosomeCount = nResults;\n";
macro2Dsingle = macro2Dsingle + "    centX = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "    centY = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "    centXpix = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "    centYpix = newArray(centrosomeCount);\n";
