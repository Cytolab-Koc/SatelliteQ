macro2Dsingle = macro2Dsingle + "        if (startsWith(ciliumPreSerialized, \"Error\") || indexOf(ciliumPreSerialized, \"Exception\") >= 0) { showMessage(\"Cilium skeleton analysis warning\", \"AnalyzeSkeleton could not return cilium lengths.\\n\\n\" + ciliumPreSerialized); ciliumPreSerialized = \"\"; }\n";
macro2Dsingle = macro2Dsingle + "        if (lengthOf(ciliumPreSerialized) > 0) ciliumPreParts = split(ciliumPreSerialized, \"#\"); else ciliumPreParts = newArray(0);\n";
macro2Dsingle = macro2Dsingle + "        for (ri = roiManager(\"count\") - 1; ri >= 0; ri--) {\n";
