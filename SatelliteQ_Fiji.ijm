macro3Dsingle = macro3Dsingle + "            rename(\"SQ3D_centrosome_REAL_3D_OBJECTS_review_stack\");\n";
macro3Dsingle = macro3Dsingle + "            run(\"Make Composite\", \"display=Composite\");\n";
macro3Dsingle = macro3Dsingle + "            centReviewImageTitle = getTitle();\n";
macro3Dsingle = macro3Dsingle + "        } else {\n";
