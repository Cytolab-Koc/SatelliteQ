macro2Dsingle = macro2Dsingle + "        if (cellPreprocessStrength == \"Light\") { run(\"Gaussian Blur...\", \"sigma=3\"); run(\"Maximum...\", \"radius=1\"); }\n";
macro2Dsingle = macro2Dsingle + "        if (cellPreprocessStrength == \"Medium\") { run(\"Gaussian Blur...\", \"sigma=5\"); run(\"Maximum...\", \"radius=2\"); }\n";
macro2Dsingle = macro2Dsingle + "        if (cellPreprocessStrength == \"Strong\") { run(\"Gaussian Blur...\", \"sigma=7\"); run(\"Maximum...\", \"radius=3\"); }\n";
macro2Dsingle = macro2Dsingle + "        if (cellPreprocessStrength == \"Very strong\") { run(\"Gaussian Blur...\", \"sigma=10\"); run(\"Maximum...\", \"radius=4\"); }\n";
macro2Dsingle = macro2Dsingle + "        run(\"Enhance Contrast...\", \"saturated=0.35 normalize\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    cellThresholdToMask(\"Cell_BackgroundSubtracted\", \"Cell_Mask\", cellThresholdMode, cellThreshold, cellLocalThresholdMethod, cellLocalRadius, cellManualThreshold);\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Cell_Mask\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"8-bit\");\n";
macro2Dsingle = macro2Dsingle + "    if (cellCleanupMode == \"Very light\") {\n";
macro2Dsingle = macro2Dsingle + "        run(\"Fill Holes\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    if (cellCleanupMode == \"Standard\") {\n";
macro2Dsingle = macro2Dsingle + "        run(\"Close-\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Fill Holes\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    if (cellCleanupMode == \"Medium-strong\") {\n";
macro2Dsingle = macro2Dsingle + "        run(\"Close-\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Close-\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Fill Holes\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    if (cellCleanupMode == \"Strong\") {\n";
macro2Dsingle = macro2Dsingle + "        run(\"Close-\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Close-\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Close-\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Fill Holes\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    if (cellCleanupMode == \"Very strong\") {\n";
macro2Dsingle = macro2Dsingle + "        run(\"Close-\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Close-\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Close-\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Fill Holes\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Open\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Close-\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Fill Holes\");\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    cellAnalyzeMinArea = minCellArea;\n";
macro2Dsingle = macro2Dsingle + "    if (cellDoWatershed) {\n";
macro2Dsingle = macro2Dsingle + "        run(\"Watershed\");\n";
macro2Dsingle = macro2Dsingle + "        if (cellWatershedProtection == \"Light\") cellAnalyzeMinArea = minCellArea * 1.5;\n";
macro2Dsingle = macro2Dsingle + "        if (cellWatershedProtection == \"Medium\") cellAnalyzeMinArea = minCellArea * 2.5;\n";
macro2Dsingle = macro2Dsingle + "        if (cellWatershedProtection == \"Strong\") cellAnalyzeMinArea = minCellArea * 4.0;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Cell_Mask\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Set Measurements...\", \"area mean centroid center redirect=None decimal=3\");\n";
macro2Dsingle = macro2Dsingle + "    run(\"Analyze Particles...\", \"size=\" + cellAnalyzeMinArea + \"-\" + maxCellArea + \" show=Nothing clear add\");\n";
macro2Dsingle = macro2Dsingle + "    cellCount = roiManager(\"count\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (cellCount > 0) {\n";
macro2Dsingle = macro2Dsingle + "        Dialog.create(\"Cell ROI drawing/review image\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addMessage(\"Choose what to show while reviewing detected cell ROIs. The membrane/cytoplasmic cell signal channel used for cell-boundary detection is included in every option.\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addChoice(\"Show during cell ROI review:\", newArray(\"Cell signal channel + cell boundary only\", \"Cell signal channel + cell boundary + centrosome\", \"Cell signal channel + cell boundary + satellite\", \"Cell signal channel + cell boundary + centrosome + satellite\", \"Cell signal channel + cell boundary + centrosome + centrosome numbers + satellite\"), cellROIDisplayMode);\n";
macro2Dsingle = macro2Dsingle + "        Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "        cellROIDisplayMode = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "        cellROIDrawingTitle = prepareCellROIDrawingView(cellProjection, cellROIDisplayMode);\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(cellROIDrawingTitle);\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "        waitForUser(\"Review/edit detected cell ROIs\",\n";
macro2Dsingle = macro2Dsingle + "            \"Detected cell ROIs are shown.\\n\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"Use ROI Manager to delete bad ROIs, add missing cells, or modify boundaries.\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"For cytoplasmic signal mode, keep only true cell boundary ROIs.\\n\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"When the final cell ROIs are correct, click OK.\");\n";
macro2Dsingle = macro2Dsingle + "        cellCount = roiManager(\"count\");\n";
macro2Dsingle = macro2Dsingle + "        if (saveQCImages) {\n";
macro2Dsingle = macro2Dsingle + "            selectWindow(cellROIDrawingTitle);\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "            run(\"Flatten\");\n";
macro2Dsingle = macro2Dsingle + "            rename(\"Cell_Selected_ROI_Review_QC\");\n";
macro2Dsingle = macro2Dsingle + "            saveAs(\"Tiff\", qcDir + runID + \"_cell_selected_ROI_review_QC.tif\");\n";
macro2Dsingle = macro2Dsingle + "            saveAs(\"Tiff\", qcDir + runID + \"_cell_ROI_review_final.tif\");\n";
macro2Dsingle = macro2Dsingle + "            setOption(\"Changes\", false);\n";
macro2Dsingle = macro2Dsingle + "            close();\n";
macro2Dsingle = macro2Dsingle + "            if (isOpen(cellROIDrawingTitle)) selectWindow(cellROIDrawingTitle);\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(\"Cell_ROI_Review\")) {\n";
macro2Dsingle = macro2Dsingle + "            selectWindow(\"Cell_ROI_Review\");\n";
macro2Dsingle = macro2Dsingle + "            close();\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Satellite_Projection\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    for (c = 0; c < cellCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Select\", c);\n";
macro2Dsingle = macro2Dsingle + "        for (i = 0; i < satelliteCount; i++) {\n";
macro2Dsingle = macro2Dsingle + "            if (safeSelectionContains(satXpix[i], satYpix[i])) {\n";
macro2Dsingle = macro2Dsingle + "                satCellID[i] = c + 1;\n";
macro2Dsingle = macro2Dsingle + "                satCellMode[i] = cellAssignmentMode;\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(cellROIDrawingTitle)) selectWindow(cellROIDrawingTitle);\n";
macro2Dsingle = macro2Dsingle + "        else if (isOpen(\"Cell_ROI_Review\")) selectWindow(\"Cell_ROI_Review\");\n";
macro2Dsingle = macro2Dsingle + "        else if (isOpen(\"Cell_Projection\")) selectWindow(\"Cell_Projection\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.create(\"Accept cell ROIs?\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addMessage(\"Detected / selected cell ROIs: \" + cellCount);\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addRadioButtonGroup(\"Next step:\", newArray(\"Accept cell ROIs and continue\", \"Change cell ROI settings and re-detect\"), 2, 1, \"Accept cell ROIs and continue\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "        cellDecision = Dialog.getRadioButton();\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (cellDecision == \"Accept cell ROIs and continue\") {\n";
macro2Dsingle = macro2Dsingle + "            cellDetectionAccepted = true;\n";
macro2Dsingle = macro2Dsingle + "        } else {\n";
macro2Dsingle = macro2Dsingle + "            Dialog.create(\"Redo cell ROI settings\");\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Cell rolling ball radius, pixels:\", cellRollingBall);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addChoice(\"Cell boundary source type:\", newArray(\"Membrane/boundary marker\", \"Diffuse cytoplasmic protein\", \"Microtubule/cytoskeleton staining\"), cellBoundarySourceType);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addChoice(\"Cell threshold mode:\", newArray(\"Global auto threshold\", \"Local auto threshold\", \"Manual threshold\"), cellThresholdMode);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addChoice(\"Cell global threshold method:\", newArray(\"Otsu\", \"Triangle\", \"Moments\", \"Default\", \"Li\", \"Yen\", \"Huang\"), cellThreshold);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addChoice(\"Cell local threshold method:\", newArray(\"Phansalkar\", \"Sauvola\", \"Bernsen\", \"Niblack\", \"Mean\", \"Median\"), cellLocalThresholdMethod);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Local threshold radius, pixels:\", cellLocalRadius);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Manual cell threshold value, AU:\", cellManualThreshold);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addChoice(\"Microtubule/cytoskeleton preprocessing strength:\", newArray(\"Off\", \"Light\", \"Medium\", \"Strong\", \"Very strong\"), cellPreprocessStrength);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addChoice(\"Cell mask cleanup strength:\", newArray(\"None\", \"Very light\", \"Standard\", \"Medium-strong\", \"Strong\", \"Very strong\"), cellCleanupMode);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addCheckbox(\"Split touching/large cell ROIs with watershed\", cellDoWatershed);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addChoice(\"Watershed over-splitting protection:\", newArray(\"Off\", \"Light\", \"Medium\", \"Strong\"), cellWatershedProtection);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Minimum cell area, pixels^2:\", minCellArea);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.addNumber(\"Maximum cell area, pixels^2:\", maxCellArea);\n";
macro2Dsingle = macro2Dsingle + "            Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "            cellRollingBall = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "            cellBoundarySourceType = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "            cellThresholdMode = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "            cellThreshold = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "            cellLocalThresholdMethod = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "            cellLocalRadius = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "            cellManualThreshold = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "            cellPreprocessStrength = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "            cellCleanupMode = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "            cellDoWatershed = Dialog.getCheckbox();\n";
macro2Dsingle = macro2Dsingle + "            cellWatershedProtection = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "            minCellArea = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "            maxCellArea = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "            d_cellRollingBall = cellRollingBall;\n";
macro2Dsingle = macro2Dsingle + "            d_cellThreshold = cellThreshold;\n";
macro2Dsingle = macro2Dsingle + "            d_cellBoundarySourceType = cellBoundarySourceType;\n";
macro2Dsingle = macro2Dsingle + "            d_cellThresholdMode = cellThresholdMode;\n";
macro2Dsingle = macro2Dsingle + "            d_cellLocalThresholdMethod = cellLocalThresholdMethod;\n";
macro2Dsingle = macro2Dsingle + "            d_cellLocalRadius = cellLocalRadius;\n";
macro2Dsingle = macro2Dsingle + "            d_cellManualThreshold = cellManualThreshold;\n";
macro2Dsingle = macro2Dsingle + "            d_cellPreprocessStrength = cellPreprocessStrength;\n";
macro2Dsingle = macro2Dsingle + "            d_minCellArea = minCellArea;\n";
macro2Dsingle = macro2Dsingle + "            d_maxCellArea = maxCellArea;\n";
macro2Dsingle = macro2Dsingle + "            d_cellCleanupMode = cellCleanupMode;\n";
macro2Dsingle = macro2Dsingle + "            d_cellDoWatershed = cellDoWatershed;\n";
macro2Dsingle = macro2Dsingle + "            d_cellWatershedProtection = cellWatershedProtection;\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"Centrosome radius\") {\n";
macro2Dsingle = macro2Dsingle + "    centrosomeRadiusAccepted = false;\n";
macro2Dsingle = macro2Dsingle + "    centrosomeRadiusCellRoiZip = roiDir + runID + \"_centrosome_radius_cell_rois.zip\";\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    while (!centrosomeRadiusAccepted) {\n";
macro2Dsingle = macro2Dsingle + "        radiusPixels = centrosomeRadiusMicron / pixelWidth;\n";
macro2Dsingle = macro2Dsingle + "        if (radiusPixels < 1) radiusPixels = 1;\n";
macro2Dsingle = macro2Dsingle + "        diameterPixels = radiusPixels * 2;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Satellite_Projection\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Select None\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        for (c = 0; c < centrosomeCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "            makeOval(centXpix[c] - radiusPixels, centYpix[c] - radiusPixels, diameterPixels, diameterPixels);\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Add\");\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Select\", c);\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Rename\", \"Cell_\" + (c + 1) + \"_radius_around_centrosome_\" + (c + 1));\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "        cellCount = roiManager(\"count\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (isOpen(\"Centrosome_Radius_Cell_ROI_Review\")) { selectWindow(\"Centrosome_Radius_Cell_ROI_Review\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Satellite_Projection\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Select None\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Duplicate...\", \"title=Centrosome_Radius_Cell_ROI_Review\");\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Centrosome_Radius_Cell_ROI_Review\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        waitForUser(\"Review centrosome-radius cell ROIs\",\n";
macro2Dsingle = macro2Dsingle + "            \"I drew one circular Cell ROI around each selected centrosome.\\n\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"Radius = \" + centrosomeRadiusMicron + \" micrometers.\\n\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"You can edit these circles in ROI Manager now:\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"- select a ROI, move/resize it, then click Update in ROI Manager\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"- if you moved only the currently selected ROI, I will also auto-update it when you click OK\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"- delete unwanted ROIs\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"- add extra ROIs manually with T if needed\\n\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"Each ROI will become a separate Cell_ID.\\n\" +\n";
macro2Dsingle = macro2Dsingle + "            \"When the ROI Manager contains the final circular cell ROIs, click OK.\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Centrosome_Radius_Cell_ROI_Review\");\n";
macro2Dsingle = macro2Dsingle + "        if (selectionType() != -1) roiManager(\"Update\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        cellCount = roiManager(\"count\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        Dialog.create(\"Accept centrosome-radius cell ROIs?\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addChoice(\"Next step:\", newArray(\"Accept ROIs and continue\", \"Change radius and redraw\"), \"Accept ROIs and continue\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addNumber(\"Radius for redraw, micrometers:\", centrosomeRadiusMicron);\n";
macro2Dsingle = macro2Dsingle + "        Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "        radiusNextStep = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "        centrosomeRadiusMicron = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (radiusNextStep == \"Accept ROIs and continue\") {\n";
macro2Dsingle = macro2Dsingle + "            selectWindow(\"Centrosome_Radius_Cell_ROI_Review\");\n";
macro2Dsingle = macro2Dsingle + "            if (selectionType() != -1) roiManager(\"Update\");\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "            centrosomeRadiusAccepted = true;\n";
macro2Dsingle = macro2Dsingle + "        } else {\n";
macro2Dsingle = macro2Dsingle + "            if (isOpen(\"Centrosome_Radius_Cell_ROI_Review\")) { selectWindow(\"Centrosome_Radius_Cell_ROI_Review\"); setOption(\"Changes\", false); close(); }\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (cellCount > 0) roiManager(\"Save\", centrosomeRadiusCellRoiZip);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (saveQCImages && isOpen(\"Centrosome_Radius_Cell_ROI_Review\")) {\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Centrosome_Radius_Cell_ROI_Review\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Show All with labels\");\n";
macro2Dsingle = macro2Dsingle + "        run(\"Flatten\");\n";
macro2Dsingle = macro2Dsingle + "        rename(\"Centrosome_Radius_Cell_ROI_Review_QC\");\n";
macro2Dsingle = macro2Dsingle + "        saveAs(\"Tiff\", qcDir + runID + \"_centrosome_radius_cell_ROI_review_QC.tif\");\n";
macro2Dsingle = macro2Dsingle + "        setOption(\"Changes\", false);\n";
macro2Dsingle = macro2Dsingle + "        close();\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    radiusCellCenterXpix = newArray(cellCount);\n";
macro2Dsingle = macro2Dsingle + "    radiusCellCenterYpix = newArray(cellCount);\n";
macro2Dsingle = macro2Dsingle + "    radiusCellCenterX = newArray(cellCount);\n";
macro2Dsingle = macro2Dsingle + "    radiusCellCenterY = newArray(cellCount);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Satellite_Projection\");\n";
macro2Dsingle = macro2Dsingle + "    for (cell = 1; cell <= cellCount; cell++) {\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Select\", cell - 1);\n";
macro2Dsingle = macro2Dsingle + "        getSelectionBounds(rx, ry, rw, rh);\n";
macro2Dsingle = macro2Dsingle + "        radiusCellCenterXpix[cell - 1] = rx + rw / 2;\n";
macro2Dsingle = macro2Dsingle + "        radiusCellCenterYpix[cell - 1] = ry + rh / 2;\n";
macro2Dsingle = macro2Dsingle + "        radiusCellCenterX[cell - 1] = radiusCellCenterXpix[cell - 1] * pixelWidth;\n";
macro2Dsingle = macro2Dsingle + "        radiusCellCenterY[cell - 1] = radiusCellCenterYpix[cell - 1] * pixelHeight;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    for (i = 0; i < satelliteCount; i++) {\n";
macro2Dsingle = macro2Dsingle + "        bestDistance = 999999999;\n";
macro2Dsingle = macro2Dsingle + "        bestCell = 0;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        for (cell = 1; cell <= cellCount; cell++) {\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Select\", cell - 1);\n";
macro2Dsingle = macro2Dsingle + "            if (safeSelectionContains(satXpix[i], satYpix[i])) {\n";
macro2Dsingle = macro2Dsingle + "                dx = satX[i] - radiusCellCenterX[cell - 1];\n";
macro2Dsingle = macro2Dsingle + "                dy = satY[i] - radiusCellCenterY[cell - 1];\n";
macro2Dsingle = macro2Dsingle + "                dist = sqrt(dx * dx + dy * dy);\n";
macro2Dsingle = macro2Dsingle + "                if (dist < bestDistance) {\n";
macro2Dsingle = macro2Dsingle + "                    bestDistance = dist;\n";
macro2Dsingle = macro2Dsingle + "                    bestCell = cell;\n";
macro2Dsingle = macro2Dsingle + "                }\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (bestCell > 0) {\n";
macro2Dsingle = macro2Dsingle + "            satCellID[i] = bestCell;\n";
macro2Dsingle = macro2Dsingle + "            satCellMode[i] = \"Centrosome radius\";\n";
macro2Dsingle = macro2Dsingle + "            satNearestCentID[i] = bestCell;\n";
macro2Dsingle = macro2Dsingle + "            satNearestCentX[i] = radiusCellCenterX[bestCell - 1];\n";
macro2Dsingle = macro2Dsingle + "            satNearestCentY[i] = radiusCellCenterY[bestCell - 1];\n";
macro2Dsingle = macro2Dsingle + "            satNearestCentDistance[i] = bestDistance;\n";
macro2Dsingle = macro2Dsingle + "            satAssignedCentLabel[i] = \"Radius_ROI_\" + bestCell;\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Deselect\");\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"Manual cell ROIs during macro\" ||\n";
macro2Dsingle = macro2Dsingle + "    cellAssignmentMode == \"Existing cell ROIs in ROI Manager\" ||\n";
macro2Dsingle = macro2Dsingle + "    cellAssignmentMode == \"Membrane marker\" ||\n";
macro2Dsingle = macro2Dsingle + "    cellAssignmentMode == \"Cytoplasmic signal boundary\" ||\n";
macro2Dsingle = macro2Dsingle + "    cellAssignmentMode == \"Centrosome radius\") {\n";
macro2Dsingle = macro2Dsingle + "    if (cellCount > 0) {\n";
macro2Dsingle = macro2Dsingle + "        exportCellBoundaryROIs(cellBoundaryCSV, originalTitle, runID, boundaryFrame, pixelWidth, pixelHeight);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";

macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"No cell assignment\") {\n";
macro2Dsingle = macro2Dsingle + "    cellCount = 1;\n";
macro2Dsingle = macro2Dsingle + "    for (i = 0; i < satelliteCount; i++) {\n";
macro2Dsingle = macro2Dsingle + "        satCellID[i] = 1;\n";
macro2Dsingle = macro2Dsingle + "        satCellMode[i] = \"Whole image\";\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "cellCentID = newArray(cellCount + 1);\n";
macro2Dsingle = macro2Dsingle + "cellCentX = newArray(cellCount + 1);\n";
macro2Dsingle = macro2Dsingle + "cellCentY = newArray(cellCount + 1);\n";
macro2Dsingle = macro2Dsingle + "cellCentDistance = newArray(cellCount + 1);\n";
macro2Dsingle = macro2Dsingle + "centCellID = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "centLabel = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "for (cell = 0; cell <= cellCount; cell++) {\n";
macro2Dsingle = macro2Dsingle + "    cellCentID[cell] = 0;\n";
macro2Dsingle = macro2Dsingle + "    cellCentX[cell] = \"NA\";\n";
macro2Dsingle = macro2Dsingle + "    cellCentY[cell] = \"NA\";\n";
macro2Dsingle = macro2Dsingle + "    cellCentDistance[cell] = \"NA\";\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "for (c = 0; c < centrosomeCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "    centCellID[c] = 0;\n";
macro2Dsingle = macro2Dsingle + "    centLabel[c] = \"\" + (c + 1);\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "hasCellAreaROIs = false;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"Existing cell ROIs in ROI Manager\") {\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Open\", initialRoiZip);\n";
macro2Dsingle = macro2Dsingle + "    hasCellAreaROIs = true;\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"Manual cell ROIs during macro\") {\n";
macro2Dsingle = macro2Dsingle + "    if (File.exists(manualCellRoiZip)) {\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Open\", manualCellRoiZip);\n";
macro2Dsingle = macro2Dsingle + "        hasCellAreaROIs = true;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"Membrane marker\" || cellAssignmentMode == \"Cytoplasmic signal boundary\") {\n";
macro2Dsingle = macro2Dsingle + "    if (roiManager(\"count\") == cellCount && cellCount > 0) {\n";
macro2Dsingle = macro2Dsingle + "        hasCellAreaROIs = true;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (hasCellAreaROIs && centrosomeCount > 0 && cellCount > 0) {\n";
macro2Dsingle = macro2Dsingle + "    selectWindow(\"Satellite_Projection\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    for (cell = 1; cell <= cellCount; cell++) {\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Select\", cell - 1);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        localCent = newArray(centrosomeCount);\n";
macro2Dsingle = macro2Dsingle + "        localN = 0;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        for (c = 0; c < centrosomeCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "            if (safeSelectionContains(centXpix[c], centYpix[c])) {\n";
macro2Dsingle = macro2Dsingle + "                localCent[localN] = c;\n";
macro2Dsingle = macro2Dsingle + "                localN = localN + 1;\n";
macro2Dsingle = macro2Dsingle + "                centCellID[c] = cell;\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (localN > 1) {\n";
macro2Dsingle = macro2Dsingle + "            for (a = 0; a < localN - 1; a++) {\n";
macro2Dsingle = macro2Dsingle + "                for (b = a + 1; b < localN; b++) {\n";
macro2Dsingle = macro2Dsingle + "                    if (centX[localCent[a]] > centX[localCent[b]]) {\n";
macro2Dsingle = macro2Dsingle + "                        temp = localCent[a];\n";
macro2Dsingle = macro2Dsingle + "                        localCent[a] = localCent[b];\n";
macro2Dsingle = macro2Dsingle + "                        localCent[b] = temp;\n";
macro2Dsingle = macro2Dsingle + "                    }\n";
macro2Dsingle = macro2Dsingle + "                }\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "                if (localN == 1) {\n";
macro2Dsingle = macro2Dsingle + "            c = localCent[0];\n";
macro2Dsingle = macro2Dsingle + "            centLabel[c] = \"\" + cell;\n";
macro2Dsingle = macro2Dsingle + "            cellCentID[cell] = c + 1;\n";
macro2Dsingle = macro2Dsingle + "            cellCentX[cell] = centX[c];\n";
macro2Dsingle = macro2Dsingle + "            cellCentY[cell] = centY[c];\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        ignoreThisCell = false;\n";
macro2Dsingle = macro2Dsingle + "        cellMidX = 0;\n";
macro2Dsingle = macro2Dsingle + "        cellMidY = 0;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (localN > 1) {\n";
macro2Dsingle = macro2Dsingle + "            for (j = 0; j < localN; j++) {\n";
macro2Dsingle = macro2Dsingle + "                c = localCent[j];\n";
macro2Dsingle = macro2Dsingle + "                centLabel[c] = \"\" + cell + \"_\" + (j + 1);\n";
macro2Dsingle = macro2Dsingle + "                cellMidX = cellMidX + centX[c];\n";
macro2Dsingle = macro2Dsingle + "                cellMidY = cellMidY + centY[c];\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "            cellMidX = cellMidX / localN;\n";
macro2Dsingle = macro2Dsingle + "            cellMidY = cellMidY / localN;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "            if (multiCentrosomeMode == \"Ignore cells with multiple centrosomes\") {\n";
macro2Dsingle = macro2Dsingle + "                ignoreThisCell = true;\n";
macro2Dsingle = macro2Dsingle + "                cellCentID[cell] = 0;\n";
macro2Dsingle = macro2Dsingle + "                cellCentX[cell] = \"NA\";\n";
macro2Dsingle = macro2Dsingle + "                cellCentY[cell] = \"NA\";\n";
macro2Dsingle = macro2Dsingle + "            } else if (multiCentrosomeMode == \"Use midpoint of centrosomes in cell\") {\n";
macro2Dsingle = macro2Dsingle + "                cellCentID[cell] = 0;\n";
macro2Dsingle = macro2Dsingle + "                cellCentX[cell] = cellMidX;\n";
macro2Dsingle = macro2Dsingle + "                cellCentY[cell] = cellMidY;\n";
macro2Dsingle = macro2Dsingle + "            } else {\n";
macro2Dsingle = macro2Dsingle + "                c = localCent[0];\n";
macro2Dsingle = macro2Dsingle + "                cellCentID[cell] = c + 1;\n";
macro2Dsingle = macro2Dsingle + "                cellCentX[cell] = centX[c];\n";
macro2Dsingle = macro2Dsingle + "                cellCentY[cell] = centY[c];\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        for (i = 0; i < satelliteCount; i++) {\n";
macro2Dsingle = macro2Dsingle + "            if (satCellID[i] == cell) {\n";
macro2Dsingle = macro2Dsingle + "                if (ignoreThisCell) {\n";
macro2Dsingle = macro2Dsingle + "                    satCellID[i] = -1;\n";
macro2Dsingle = macro2Dsingle + "                    satNearestCentID[i] = 0;\n";
macro2Dsingle = macro2Dsingle + "                    satNearestCentX[i] = \"NA\";\n";
macro2Dsingle = macro2Dsingle + "                    satNearestCentY[i] = \"NA\";\n";
macro2Dsingle = macro2Dsingle + "                    satNearestCentDistance[i] = \"NA\";\n";
macro2Dsingle = macro2Dsingle + "                    satAssignedCentLabel[i] = \"Ignored_multi_centrosome_cell\";\n";
macro2Dsingle = macro2Dsingle + "                } else if (localN > 1 && multiCentrosomeMode == \"Use midpoint of centrosomes in cell\") {\n";
macro2Dsingle = macro2Dsingle + "                    dx = satX[i] - cellMidX;\n";
macro2Dsingle = macro2Dsingle + "                    dy = satY[i] - cellMidY;\n";
macro2Dsingle = macro2Dsingle + "                    dist = sqrt(dx * dx + dy * dy);\n";
macro2Dsingle = macro2Dsingle + "                    satNearestCentID[i] = 0;\n";
macro2Dsingle = macro2Dsingle + "                    satNearestCentX[i] = cellMidX;\n";
macro2Dsingle = macro2Dsingle + "                    satNearestCentY[i] = cellMidY;\n";
macro2Dsingle = macro2Dsingle + "                    satNearestCentDistance[i] = dist;\n";
macro2Dsingle = macro2Dsingle + "                    satAssignedCentLabel[i] = \"\" + cell + \"_mid\";\n";
macro2Dsingle = macro2Dsingle + "                } else {\n";
macro2Dsingle = macro2Dsingle + "                    bestDistance = 999999999;\n";
macro2Dsingle = macro2Dsingle + "                    bestCent = -1;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "                    for (j = 0; j < localN; j++) {\n";
macro2Dsingle = macro2Dsingle + "                        c = localCent[j];\n";
macro2Dsingle = macro2Dsingle + "                        dx = satX[i] - centX[c];\n";
macro2Dsingle = macro2Dsingle + "                        dy = satY[i] - centY[c];\n";
macro2Dsingle = macro2Dsingle + "                        dist = sqrt(dx * dx + dy * dy);\n";
macro2Dsingle = macro2Dsingle + "                        if (dist < bestDistance) {\n";
macro2Dsingle = macro2Dsingle + "                            bestDistance = dist;\n";
macro2Dsingle = macro2Dsingle + "                            bestCent = c;\n";
macro2Dsingle = macro2Dsingle + "                        }\n";
macro2Dsingle = macro2Dsingle + "                    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "                    if (bestCent >= 0) {\n";
macro2Dsingle = macro2Dsingle + "                        satNearestCentID[i] = bestCent + 1;\n";
macro2Dsingle = macro2Dsingle + "                        satNearestCentX[i] = centX[bestCent];\n";
macro2Dsingle = macro2Dsingle + "                        satNearestCentY[i] = centY[bestCent];\n";
macro2Dsingle = macro2Dsingle + "                        satNearestCentDistance[i] = bestDistance;\n";
macro2Dsingle = macro2Dsingle + "                        satAssignedCentLabel[i] = centLabel[bestCent];\n";
macro2Dsingle = macro2Dsingle + "                    }\n";
macro2Dsingle = macro2Dsingle + "                }\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"Centrosome radius\" && centrosomeCount > 0) {\n";
macro2Dsingle = macro2Dsingle + "    for (c = 0; c < centrosomeCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "        centCellID[c] = c + 1;\n";
macro2Dsingle = macro2Dsingle + "        centLabel[c] = \"\" + (c + 1);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";

macro2Dsingle = macro2Dsingle + "if (!hasCellAreaROIs && cellAssignmentMode != \"Centrosome radius\" && centrosomeCount > 0) {\n";
macro2Dsingle = macro2Dsingle + "    for (i = 0; i < satelliteCount; i++) {\n";
macro2Dsingle = macro2Dsingle + "        bestDistance = 999999999;\n";
macro2Dsingle = macro2Dsingle + "        bestCent = -1;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        for (c = 0; c < centrosomeCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "            dx = satX[i] - centX[c];\n";
macro2Dsingle = macro2Dsingle + "            dy = satY[i] - centY[c];\n";
macro2Dsingle = macro2Dsingle + "            dist = sqrt(dx * dx + dy * dy);\n";
macro2Dsingle = macro2Dsingle + "            if (dist < bestDistance) {\n";
macro2Dsingle = macro2Dsingle + "                bestDistance = dist;\n";
macro2Dsingle = macro2Dsingle + "                bestCent = c;\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "        if (bestCent >= 0) {\n";
macro2Dsingle = macro2Dsingle + "            satNearestCentID[i] = bestCent + 1;\n";
macro2Dsingle = macro2Dsingle + "            satNearestCentX[i] = centX[bestCent];\n";
macro2Dsingle = macro2Dsingle + "            satNearestCentY[i] = centY[bestCent];\n";
macro2Dsingle = macro2Dsingle + "            satNearestCentDistance[i] = bestDistance;\n";
macro2Dsingle = macro2Dsingle + "            satAssignedCentLabel[i] = centLabel[bestCent];\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "for (i = 0; i < satelliteCount; i++) {\n";
macro2Dsingle = macro2Dsingle + "    satCellArea[i] = \"NaN\";\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"Centrosome radius\") {\n";
macro2Dsingle = macro2Dsingle + "    radiusArea = 3.14159265359 * centrosomeRadiusMicron * centrosomeRadiusMicron;\n";
macro2Dsingle = macro2Dsingle + "    for (i = 0; i < satelliteCount; i++) {\n";
macro2Dsingle = macro2Dsingle + "        if (satCellID[i] > 0) satCellArea[i] = radiusArea;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"No cell assignment\") {\n";
macro2Dsingle = macro2Dsingle + "    wholeImageArea = width * height * pixelWidth * pixelHeight;\n";
macro2Dsingle = macro2Dsingle + "    for (i = 0; i < satelliteCount; i++) {\n";
macro2Dsingle = macro2Dsingle + "        if (satCellID[i] > 0) satCellArea[i] = wholeImageArea;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (cellAssignmentMode == \"Manual cell ROIs during macro\" || cellAssignmentMode == \"Existing cell ROIs in ROI Manager\" || cellAssignmentMode == \"Membrane marker\" || cellAssignmentMode == \"Cytoplasmic signal boundary\") {\n";
macro2Dsingle = macro2Dsingle + "    if (cellAssignmentMode == \"Manual cell ROIs during macro\" && File.exists(manualCellRoiZip)) {\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Open\", manualCellRoiZip);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    if (cellAssignmentMode == \"Existing cell ROIs in ROI Manager\" && File.exists(initialRoiZip)) {\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Reset\");\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Open\", initialRoiZip);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    measuredCellCount = roiManager(\"count\");\n";
macro2Dsingle = macro2Dsingle + "    if (measuredCellCount > 0) {\n";
macro2Dsingle = macro2Dsingle + "        selectWindow(\"Satellite_Projection\");\n";
macro2Dsingle = macro2Dsingle + "        for (c = 0; c < measuredCellCount; c++) {\n";
macro2Dsingle = macro2Dsingle + "            roiManager(\"Select\", c);\n";
macro2Dsingle = macro2Dsingle + "            getStatistics(tmpCellArea, tmpCellMean, tmpCellMin, tmpCellMax, tmpCellStd);\n";
macro2Dsingle = macro2Dsingle + "            for (i = 0; i < satelliteCount; i++) {\n";
macro2Dsingle = macro2Dsingle + "                if (satCellID[i] == c + 1) satCellArea[i] = tmpCellArea;\n";
macro2Dsingle = macro2Dsingle + "            }\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "// -------------------------------------------------------------------------\n";
macro2Dsingle = macro2Dsingle + "// -------------------------------------------------------------------------\n";
macro2Dsingle = macro2Dsingle + "// Primary-cilium cell assignment/export (2D) - after final cell boundaries\n";
macro2Dsingle = macro2Dsingle + "// -------------------------------------------------------------------------\n";
macro2Dsingle = macro2Dsingle + "if (ciliumChannel > 0) {\n";
macro2Dsingle = macro2Dsingle + "    ciliumCellRoiZip = outputDir + runID + \"_TEMP_cilium_cell_rois.zip\";\n";
macro2Dsingle = macro2Dsingle + "    ciliumCellRoisSaved = false;\n";
macro2Dsingle = macro2Dsingle + "    if ((cellAssignmentMode == \"Manual cell ROIs during macro\" || cellAssignmentMode == \"Existing cell ROIs in ROI Manager\" || cellAssignmentMode == \"Membrane marker\" || cellAssignmentMode == \"Cytoplasmic signal boundary\") && roiManager(\"count\") > 0) {\n";
macro2Dsingle = macro2Dsingle + "        if (File.exists(ciliumCellRoiZip)) File.delete(ciliumCellRoiZip);\n";
macro2Dsingle = macro2Dsingle + "        roiManager(\"Save\", ciliumCellRoiZip); ciliumCellRoisSaved = File.exists(ciliumCellRoiZip);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    ciliumCellTotal = 0;\n";
macro2Dsingle = macro2Dsingle + "    if (ciliumCellRoisSaved) ciliumCellTotal = roiManager(\"count\");\n";
macro2Dsingle = macro2Dsingle + "    for (ci=0; ci<ciliumCount; ci++) {\n";
macro2Dsingle = macro2Dsingle + "        cCell[ci] = \"NaN\";\n";
macro2Dsingle = macro2Dsingle + "        if (ciliumCellRoisSaved) {\n";
macro2Dsingle = macro2Dsingle + "            for (ccx=0; ccx<roiManager(\"count\"); ccx++) { roiManager(\"Select\",ccx); if (safeSelectionContains(cX[ci]/pixelWidth,cY[ci]/pixelHeight)) {cCell[ci]=ccx+1;ccx=roiManager(\"count\");} }\n";
macro2Dsingle = macro2Dsingle + "        }\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    cHeader=\"Run_ID,Image,Frame,Mode,Cilium_ID,Cell_ID,Cilium_Length_um,Cilium_X_um,Cilium_Y_um,Cilium_Z_um,Ciliated,Ciliation_Length_Threshold_um\\n\"; File.saveString(cHeader,ciliumQuantPath);\n";
macro2Dsingle = macro2Dsingle + "    skHeader=\"Run_ID,Image,Frame,Mode,Cilium_ID,Cell_ID,Point_Index,X_um,Y_um,Z_um\\n\"; File.saveString(skHeader,ciliumSkeletonPath);\n";
macro2Dsingle = macro2Dsingle + "    for(ci=0;ci<ciliumCount;ci++) {\n";
macro2Dsingle = macro2Dsingle + "        cflag=1;\n";
macro2Dsingle = macro2Dsingle + "        File.append(runID+\",\"+originalTitle+\",,2D,\"+(ci+1)+\",\"+cCell[ci]+\",\"+cLen[ci]+\",\"+cX[ci]+\",\"+cY[ci]+\",\"+cZ[ci]+\",\"+cflag+\",\"+ciliumMinLength+\"\\n\",ciliumQuantPath);\n";
macro2Dsingle = macro2Dsingle + "        if(lengthOf(cPath[ci])>0){pts=split(cPath[ci],\";\");for(pi=0;pi<pts.length;pi++){xyz=split(pts[pi],\":\");if(xyz.length>=3)File.append(runID+\",\"+originalTitle+\",,2D,\"+(ci+1)+\",\"+cCell[ci]+\",\"+(pi+1)+\",\"+xyz[0]+\",\"+xyz[1]+\",\"+xyz[2]+\"\\n\",ciliumSkeletonPath);}}\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    csHeader=\"Run_ID,Image,Frame,Mode,Cell_ID,Cilium_Count,Longest_Cilium_Length_um,Mean_Cilium_Length_um,Ciliated,Ciliation_Length_Threshold_um\\n\"; File.saveString(csHeader,ciliumCellSummaryPath);\n";
macro2Dsingle = macro2Dsingle + "    for(cellC=1;cellC<=ciliumCellTotal;cellC++) {\n";
macro2Dsingle = macro2Dsingle + "        nC=0;sumC=0;maxC=0;for(ci=0;ci<ciliumCount;ci++)if(cCell[ci]==cellC){nC++;sumC+=cLen[ci];if(cLen[ci]>maxC)maxC=cLen[ci];}\n";
macro2Dsingle = macro2Dsingle + "        meanC=0;if(nC>0)meanC=sumC/nC;ciliatedC=0;if(nC>0)ciliatedC=1;\n";
macro2Dsingle = macro2Dsingle + "        File.append(runID+\",\"+originalTitle+\",,2D,\"+cellC+\",\"+nC+\",\"+maxC+\",\"+meanC+\",\"+ciliatedC+\",\"+ciliumMinLength+\"\\n\",ciliumCellSummaryPath);\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "    if(ciliumCellRoisSaved){roiManager(\"Reset\");roiManager(\"Open\",ciliumCellRoiZip);}\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "safeTitle = replace(originalTitle, \",\", \";\");\n";
macro2Dsingle = macro2Dsingle + "safeRunID = replace(runID, \",\", \";\");\n";
macro2Dsingle = macro2Dsingle + "safeUnit = replace(unit, \",\", \";\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "combinedCSV = outputDir + runID + \"_SatelliteQuantify_Fiji_Output.csv\";\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "header = \"Row_Type,Run_ID,Image,Cell_ID,Cell_Area_um2,Satellite_ID,Centrosome_ID,Centrosome_Label,Satellite_Area_um2,Circularity_2D,Mean_Intensity_AU,Integrated_Intensity_AU,X_um,Y_um,X_pixel,Y_pixel,Nearest_Centrosome_ID,Nearest_Centrosome_X_um,Nearest_Centrosome_Y_um,Distance_to_Nearest_Centrosome_um,Cell_Assignment_Mode,Centrosome_X_um,Centrosome_Y_um,Centrosome_X_pixel,Centrosome_Y_pixel,Centrosome_Intensity_AU,Centrosome_Area_um2,Setting,Value\\n\";\n";
macro2Dsingle = macro2Dsingle + "File.saveString(header, combinedCSV);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "exportedSatelliteCount = 0;\n";
