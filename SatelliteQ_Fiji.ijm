macroTL = macroTL + "        if(lengthOf(cPath[ci])>0){pts=split(cPath[ci],\";\");for(pi=0;pi<pts.length;pi++){xyz=split(pts[pi],\":\");if(xyz.length>=3)File.append(runID+\",\"+originalTitle+\",\"+boundaryFrame+\",2D,\"+(ci+1)+\",\"+cCell[ci]+\",\"+(pi+1)+\",\"+xyz[0]+\",\"+xyz[1]+\",\"+xyz[2]+\"\\n\",ciliumSkeletonPath);}}\n";
