macro2Dsingle = macro2Dsingle + "    multiCentrosomeMode = d_multiCentrosomeMode;\n";
macro2Dsingle = macro2Dsingle + "} else {\n";
macro2Dsingle = macro2Dsingle + "    Dialog.create(\"SatelliteQuantify 2D - Step 3a/4: Centrosomes\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addMessage(\"Optional: detect centrosomes so each satellite can be assigned a distance to its cell centrosome.\");\n";
