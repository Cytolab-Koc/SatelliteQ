macroTL = macroTL + "            cellCount2D = roiManager(\"count\");\n";
macroTL = macroTL + "            selectWindow(cellProjectionTitle);\n";
macroTL = macroTL + "            roiManager(\"Show All with labels\");\n";
macroTL = macroTL + "            waitForUser(\"Review/edit projected cell ROIs - frame \" + boundaryFrame, \"Detected projected cell ROIs: \" + cellCount2D + \"\\n\\nEdit/delete/add ROIs in ROI Manager. These accepted ROIs define Cell_ID for this frame.\\nClick OK when done.\");\n";
macroTL = macroTL + "            cellCount2D = roiManager(\"count\");\n";
