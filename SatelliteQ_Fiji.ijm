macroTL = macroTL + "    saveAs(\"Tiff\", qcDir + runID + \"_satellite_selection_mask_max_projection.tif\");\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (saveQCImages && (!haveXY || satCount == 0)) {\n";
macroTL = macroTL + "    note = \"Numbered QC image was not created. \";\n";
macroTL = macroTL + "    if (!haveXY) note = note + \"X/Y columns were not identified in the 3D Objects Counter+ results table. \";\n";
macroTL = macroTL + "    if (satCount == 0) note = note + \"No satellites were detected in the saved results table.\";\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "centrosomeCount = 0;\n";
macroTL = macroTL + "centHaveXYZ = false;\n";
macroTL = macroTL + "centXArr = newArray(1);\n";
macroTL = macroTL + "centYArr = newArray(1);\n";
macroTL = macroTL + "centZArr = newArray(1);\n";
macroTL = macroTL + "centIdArr = newArray(1);\n";
macroTL = macroTL + "centThresholdValue = \"NA\";\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (review3DSatellitesBeforeContinue) {\n";
macroTL = macroTL + "        Dialog.create(\"Accept 3D satellites?\");\n";
macroTL = macroTL + "        Dialog.addMessage(\"Detected / selected 3D satellites: \" + satCount);\n";
macroTL = macroTL + "        Dialog.addRadioButtonGroup(\"Next step:\", newArray(\"Accept 3D satellites and continue\", \"Change 3D satellite settings and re-detect\"), 2, 1, \"Accept 3D satellites and continue\");\n";
macroTL = macroTL + "        Dialog.show();\n";
macroTL = macroTL + "        sat3DDecision = Dialog.getRadioButton();\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (sat3DDecision == \"Accept 3D satellites and continue\") {\n";
macroTL = macroTL + "            satellite3DDetectionAccepted = true;\n";
macroTL = macroTL + "        } else {\n";
macroTL = macroTL + "            Dialog.create(\"Redo 3D satellite detection settings\");\n";
macroTL = macroTL + "            Dialog.addNumber(\"Satellite channel:\", satelliteChannel);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Rolling ball radius:\", rollingBall);\n";
macroTL = macroTL + "            Dialog.addChoice(\"Threshold mode:\", newArray(\"Auto\", \"Manual value\"), thresholdMode);\n";
macroTL = macroTL + "            Dialog.addChoice(\"Auto-threshold method:\", newArray(\"Otsu\"), autoMethod);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Manual threshold value:\", manualThreshold);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Minimum object size, pixels (3D stack object size; 0 = keep every detected object):\", minVoxels);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Maximum object size, pixels (3D stack object size):\", maxVoxels);\n";
macroTL = macroTL + "            Dialog.addCheckbox(\"Exclude objects touching stack edges\", excludeEdges);\n";
macroTL = macroTL + "            Dialog.addCheckbox(\"Override size/edge filters and quantify every detected 3D satellite object\", forceQuantifyAll3D);\n";
macroTL = macroTL + "            Dialog.addCheckbox(\"Review detected 3D satellites in scrollable 2D/Z stack before final export:\", review3DSatellitesBeforeContinue);\n";
macroTL = macroTL + "            Dialog.show();\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "            satelliteChannel = Dialog.getNumber();\n";
macroTL = macroTL + "            rollingBall = Dialog.getNumber();\n";
macroTL = macroTL + "            thresholdMode = Dialog.getChoice();\n";
macroTL = macroTL + "            autoMethod = Dialog.getChoice();\n";
macroTL = macroTL + "            manualThreshold = Dialog.getNumber();\n";
macroTL = macroTL + "            minVoxels = Dialog.getNumber();\n";
macroTL = macroTL + "            maxVoxels = Dialog.getNumber();\n";
macroTL = macroTL + "            if (minVoxels < 1) minVoxels = 1;\n";
macroTL = macroTL + "            if (maxVoxels < minVoxels) maxVoxels = 999999999;\n";
macroTL = macroTL + "            excludeEdges = Dialog.getCheckbox();\n";
macroTL = macroTL + "            forceQuantifyAll3D = Dialog.getCheckbox();\n";
macroTL = macroTL + "            review3DSatellitesBeforeContinue = Dialog.getCheckbox();\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        satellite3DDetectionAccepted = true;\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (centrosomeChannel > 0) {\n";
macroTL = macroTL + "    centrosome3DDetectionAccepted = false;\n";
macroTL = macroTL + "    while (centrosome3DDetectionAccepted == false) {\n";
macroTL = macroTL + "        if (savedAnyTable) File.saveString(finalTxt, resultsPath);\n";
macroTL = macroTL + "        roiManager(\"Reset\");\n";
macroTL = macroTL + "        run(\"Clear Results\");\n";
macroTL = macroTL + "        if (isOpen(\"SQ3D_processed_centrosome\")) { selectWindow(\"SQ3D_processed_centrosome\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"SQ3D_centrosome_final_QC\")) { selectWindow(\"SQ3D_centrosome_final_QC\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"SQ3D_centrosome_review_guide\")) { selectWindow(\"SQ3D_centrosome_review_guide\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"SQ3D_centrosome_REVIEW_stack_WITH_ROIS\")) { selectWindow(\"SQ3D_centrosome_REVIEW_stack_WITH_ROIS\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"SQ3D_centrosome_REVIEW_raw_for_overlay\")) { selectWindow(\"SQ3D_centrosome_REVIEW_raw_for_overlay\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"SQ3D_centrosome_REVIEW_satellite_stack\")) { selectWindow(\"SQ3D_centrosome_REVIEW_satellite_stack\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"SQ3D_centrosome_REAL_3D_Object_Mask\")) { selectWindow(\"SQ3D_centrosome_REAL_3D_Object_Mask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"SQ3D_centrosome_REAL_3D_OBJECTS_review_stack\")) { selectWindow(\"SQ3D_centrosome_REAL_3D_OBJECTS_review_stack\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"SQ3D_centrosome_BGsubtracted_for_review\")) { selectWindow(\"SQ3D_centrosome_BGsubtracted_for_review\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (centrosomeChannel > 0) {\n";
macroTL = macroTL + "    selectWindow(originalTitle);\n";
macroTL = macroTL + "    if (channels > 1) {\n";
macroTL = macroTL + "        Stack.setChannel(centrosomeChannel);\n";
