macro3Dsingle = macro3Dsingle + "            centReviewImageTitle = getTitle();\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "        getDimensions(centWtmp, centHtmp, centCtmp, centZtmp, centFtmp);\n";
macro3Dsingle = macro3Dsingle + "        if (nSlices > 1) { midSliceTmp = floor(nSlices / 2) + 1; if (midSliceTmp > nSlices) midSliceTmp = nSlices; setSlice(midSliceTmp); }\n";
macro3Dsingle = macro3Dsingle + "        roiManager(\"Show All with labels\");\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    waitForUser(\"Review/edit centrosomes\",\n";
macro3Dsingle = macro3Dsingle + "        \"Scroll through Z and review the centrosomes.\\n\\n\" +\n";
macro3Dsingle = macro3Dsingle + "        \"- Delete wrong ROIs\\n\" +\n";
macro3Dsingle = macro3Dsingle + "        \"- Add missing centrosomes with a small circle and press T\\n\" +\n";
