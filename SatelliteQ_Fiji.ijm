macro3Dsingle = macro3Dsingle + "        run(\"Duplicate...\", \"title=SQ3D_centrosome_final_QC\");\n";
macro3Dsingle = macro3Dsingle + "        centFinalQCTitle = getTitle();\n";
macro3Dsingle = macro3Dsingle + "        run(\"RGB Color\");\n";
macro3Dsingle = macro3Dsingle + "        setFont(\"SansSerif\", 16, \"bold antialiased\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        for (c = 0; c < centrosomeCount; c++) {\n";
macro3Dsingle = macro3Dsingle + "            if (isOpen(centReviewImageTitle)) selectWindow(centReviewImageTitle);\n";
macro3Dsingle = macro3Dsingle + "            roiManager(\"Select\", c);\n";
macro3Dsingle = macro3Dsingle + "            getSelectionBounds(rx, ry, rw, rh);\n";
macro3Dsingle = macro3Dsingle + "            cxPix = rx + rw / 2;\n";
macro3Dsingle = macro3Dsingle + "            cyPix = ry + rh / 2;\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "            selectWindow(centReviewStackTitle);\n";
macro3Dsingle = macro3Dsingle + "            px = floor(cxPix + 0.5);\n";
macro3Dsingle = macro3Dsingle + "            py = floor(cyPix + 0.5);\n";
macro3Dsingle = macro3Dsingle + "            bestSlice = 1;\n";
macro3Dsingle = macro3Dsingle + "            bestVal = -999999999;\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "            for (zz = 1; zz <= cSlices; zz++) {\n";
macro3Dsingle = macro3Dsingle + "                setSlice(zz);\n";
macro3Dsingle = macro3Dsingle + "                val = getPixel(px, py);\n";
macro3Dsingle = macro3Dsingle + "                if (val > bestVal) {\n";
macro3Dsingle = macro3Dsingle + "                    bestVal = val;\n";
macro3Dsingle = macro3Dsingle + "                    bestSlice = zz;\n";
macro3Dsingle = macro3Dsingle + "                }\n";
macro3Dsingle = macro3Dsingle + "            }\n";
macro3Dsingle = macro3Dsingle + "\n";
