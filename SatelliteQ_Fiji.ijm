macroTL = macroTL + "        yArr = newYArr;\n";
macroTL = macroTL + "        zArr = newZArr;\n";
macroTL = macroTL + "        idArr = newIdArr;\n";
macroTL = macroTL + "        finalTxt = newFinalTxt;\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        File.saveString(finalTxt, resultsPath);\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    if (isOpen(reviewTitle)) {\n";
macroTL = macroTL + "        selectWindow(reviewTitle);\n";
macroTL = macroTL + "        close();\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "    if (isOpen(\"SQ3D_Satellite_Review_Source\")) {\n";
macroTL = macroTL + "        selectWindow(\"SQ3D_Satellite_Review_Source\");\n";
macroTL = macroTL + "        close();\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (saveQCImages && savedAnyTable && haveXY && satCount > 0) {\n";
macroTL = macroTL + "    selectWindow(originalTitle);\n";
macroTL = macroTL + "    if (channels > 1) {\n";
macroTL = macroTL + "        Stack.setChannel(satelliteChannel);\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=SQ3D_LabelSource duplicate channels=\" + satelliteChannel);\n";
macroTL = macroTL + "    } else {\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=SQ3D_LabelSource\");\n";
macroTL = macroTL + "    }\n";
