macro3Dsingle = macro3Dsingle + "    selectWindow(reviewTitle);\n";
macro3Dsingle = macro3Dsingle + "    setFont(\"SansSerif\", 4, \"plain antialiased\");\n";
macro3Dsingle = macro3Dsingle + "    labelCSV = outputDir + runID + \"_satellite_3D_review_label_positions.csv\";\n";
macro3Dsingle = macro3Dsingle + "    labelTxt = \"Satellite_ID,X_pixel,Y_pixel,Z_slice_label,Placement_mode,Raw_Z_value\\n\";\n";
macro3Dsingle = macro3Dsingle + "    labelSearchRadius = 2;\n";
macro3Dsingle = macro3Dsingle + "    labelZRadius = 3;\n";
macro3Dsingle = macro3Dsingle + "    maxLocalLabelChecks = 12000;\n";
macro3Dsingle = macro3Dsingle + "    localMaskLabeling = false;\n";
macro3Dsingle = macro3Dsingle + "    skippedLocalMaskLabeling = false;\n";
macro3Dsingle = macro3Dsingle + "    if (satBoundaryTitle != \"\" && isOpen(satBoundaryTitle) && satCount * (2 * labelZRadius + 1) <= maxLocalLabelChecks) localMaskLabeling = true;\n";
macro3Dsingle = macro3Dsingle + "    if (satBoundaryTitle != \"\" && isOpen(satBoundaryTitle) && satCount * (2 * labelZRadius + 1) > maxLocalLabelChecks) skippedLocalMaskLabeling = true;\n";
macro3Dsingle = macro3Dsingle + "    for (i = 0; i < satCount; i++) {\n";
macro3Dsingle = macro3Dsingle + "        cx = xArr[i];\n";
macro3Dsingle = macro3Dsingle + "        cy = yArr[i];\n";
macro3Dsingle = macro3Dsingle + "        rawZLabel = zArr[i];\n";
macro3Dsingle = macro3Dsingle + "        if (cx == cx && cy == cy) {\n";
macro3Dsingle = macro3Dsingle + "            offsetCase = i % 8;\n";
macro3Dsingle = macro3Dsingle + "            dxLabel = 2; dyLabel = -2;\n";
macro3Dsingle = macro3Dsingle + "            if (offsetCase == 1) { dxLabel = -8; dyLabel = -2; }\n";
macro3Dsingle = macro3Dsingle + "            if (offsetCase == 2) { dxLabel = 2; dyLabel = 7; }\n";
macro3Dsingle = macro3Dsingle + "            if (offsetCase == 3) { dxLabel = -8; dyLabel = 7; }\n";
macro3Dsingle = macro3Dsingle + "            if (offsetCase == 4) { dxLabel = 7; dyLabel = 1; }\n";
macro3Dsingle = macro3Dsingle + "            if (offsetCase == 5) { dxLabel = -12; dyLabel = 1; }\n";
macro3Dsingle = macro3Dsingle + "            if (offsetCase == 6) { dxLabel = -1; dyLabel = -8; }\n";
macro3Dsingle = macro3Dsingle + "            if (offsetCase == 7) { dxLabel = -1; dyLabel = 10; }\n";
macro3Dsingle = macro3Dsingle + "            labelAdded = 0;\n";
macro3Dsingle = macro3Dsingle + "            labelZ = round(rawZLabel);\n";
macro3Dsingle = macro3Dsingle + "            physMaxForZ = (reviewZtmp - 1) * voxelDepth + 0.5;\n";
macro3Dsingle = macro3Dsingle + "            if (voxelDepth > 0 && rawZLabel >= 0 && rawZLabel <= physMaxForZ) labelZ = round(rawZLabel / voxelDepth) + 1;\n";
macro3Dsingle = macro3Dsingle + "            if (labelZ < 1 || labelZ > reviewZtmp) labelZ = round(rawZLabel) + 1;\n";
macro3Dsingle = macro3Dsingle + "            if (labelZ < 1 || labelZ > reviewZtmp) labelZ = round(rawZLabel);\n";
macro3Dsingle = macro3Dsingle + "            if (labelZ < 1 || labelZ > reviewZtmp) labelZ = floor(reviewZtmp / 2) + 1;\n";
macro3Dsingle = macro3Dsingle + "            if (localMaskLabeling) {\n";
macro3Dsingle = macro3Dsingle + "                zStart = labelZ - labelZRadius;\n";
macro3Dsingle = macro3Dsingle + "                zEnd = labelZ + labelZRadius;\n";
macro3Dsingle = macro3Dsingle + "                if (zStart < 1) zStart = 1;\n";
macro3Dsingle = macro3Dsingle + "                if (zEnd > reviewZtmp) zEnd = reviewZtmp;\n";
macro3Dsingle = macro3Dsingle + "                sx = round(cx); sy = round(cy);\n";
macro3Dsingle = macro3Dsingle + "                selectWindow(satBoundaryTitle);\n";
macro3Dsingle = macro3Dsingle + "                getDimensions(boundWFast, boundHFast, boundCFast, boundZFast, boundFFast);\n";
macro3Dsingle = macro3Dsingle + "                if (zEnd > boundZFast) zEnd = boundZFast;\n";
macro3Dsingle = macro3Dsingle + "                for (maskZ = zStart; maskZ <= zEnd; maskZ++) {\n";
macro3Dsingle = macro3Dsingle + "                    setSlice(maskZ);\n";
macro3Dsingle = macro3Dsingle + "                    foundMaskNearCentroid = 0;\n";
macro3Dsingle = macro3Dsingle + "                    for (yy = sy - labelSearchRadius; yy <= sy + labelSearchRadius; yy++) {\n";
macro3Dsingle = macro3Dsingle + "                        if (yy >= 0 && yy < boundHFast && foundMaskNearCentroid == 0) {\n";
macro3Dsingle = macro3Dsingle + "                            for (xx = sx - labelSearchRadius; xx <= sx + labelSearchRadius; xx++) {\n";
macro3Dsingle = macro3Dsingle + "                                if (xx >= 0 && xx < boundWFast && foundMaskNearCentroid == 0) {\n";
macro3Dsingle = macro3Dsingle + "                                    if (getPixel(xx, yy) > 0) foundMaskNearCentroid = 1;\n";
macro3Dsingle = macro3Dsingle + "                                }\n";
macro3Dsingle = macro3Dsingle + "                            }\n";
macro3Dsingle = macro3Dsingle + "                        }\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                    if (foundMaskNearCentroid == 1) {\n";
macro3Dsingle = macro3Dsingle + "                        selectWindow(reviewTitle);\n";
macro3Dsingle = macro3Dsingle + "                        setSlice(maskZ);\n";
macro3Dsingle = macro3Dsingle + "                        setFont(\"SansSerif\", 4, \"plain antialiased\");\n";
macro3Dsingle = macro3Dsingle + "                        makeText(\"\" + idArr[i], cx + dxLabel, cy + dyLabel);\n";
macro3Dsingle = macro3Dsingle + "                        Roi.setStrokeColor(\"yellow\");\n";
macro3Dsingle = macro3Dsingle + "                        Roi.setPosition(maskZ);\n";
macro3Dsingle = macro3Dsingle + "                        Overlay.addSelection();\n";
macro3Dsingle = macro3Dsingle + "                        run(\"Select None\");\n";
macro3Dsingle = macro3Dsingle + "                        labelAdded = labelAdded + 1;\n";
macro3Dsingle = macro3Dsingle + "                        labelTxt = labelTxt + idArr[i] + \",\" + cx + \",\" + cy + \",\" + maskZ + \",local_mask_window,\" + rawZLabel + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "                        selectWindow(satBoundaryTitle);\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                }\n";
macro3Dsingle = macro3Dsingle + "            }\n";
macro3Dsingle = macro3Dsingle + "            if (labelAdded == 0) {\n";
macro3Dsingle = macro3Dsingle + "                selectWindow(reviewTitle);\n";
macro3Dsingle = macro3Dsingle + "                for (dzLabel = -1; dzLabel <= 1; dzLabel++) {\n";
macro3Dsingle = macro3Dsingle + "                    thisLabelZ = labelZ + dzLabel;\n";
macro3Dsingle = macro3Dsingle + "                    if (thisLabelZ >= 1 && thisLabelZ <= reviewZtmp) {\n";
macro3Dsingle = macro3Dsingle + "                        setSlice(thisLabelZ);\n";
macro3Dsingle = macro3Dsingle + "                        setFont(\"SansSerif\", 4, \"plain antialiased\");\n";
macro3Dsingle = macro3Dsingle + "                        makeText(\"\" + idArr[i], cx + dxLabel, cy + dyLabel);\n";
macro3Dsingle = macro3Dsingle + "                        Roi.setStrokeColor(\"yellow\");\n";
macro3Dsingle = macro3Dsingle + "                        Roi.setPosition(thisLabelZ);\n";
macro3Dsingle = macro3Dsingle + "                        Overlay.addSelection();\n";
macro3Dsingle = macro3Dsingle + "                        run(\"Select None\");\n";
macro3Dsingle = macro3Dsingle + "                        labelAdded = labelAdded + 1;\n";
macro3Dsingle = macro3Dsingle + "                        labelTxt = labelTxt + idArr[i] + \",\" + cx + \",\" + cy + \",\" + thisLabelZ + \",estimated_near_centroid,\" + rawZLabel + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                }\n";
macro3Dsingle = macro3Dsingle + "            }\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "    File.saveString(labelTxt, labelCSV);\n";


macro3Dsingle = macro3Dsingle + "    if (nSlices > 1) { midSliceTmp = floor(nSlices / 2) + 1; if (midSliceTmp > nSlices) midSliceTmp = nSlices; setSlice(midSliceTmp); }\n";
macro3Dsingle = macro3Dsingle + "    Overlay.show;\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    if (satBoundaryTitle != \"\" && isOpen(satBoundaryTitle)) {\n";
macro3Dsingle = macro3Dsingle + "        selectWindow(satBoundaryTitle);\n";
macro3Dsingle = macro3Dsingle + "        setOption(\"Changes\", false);\n";
macro3Dsingle = macro3Dsingle + "        close();\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    roiManager(\"Reset\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    waitForUser(\"3D satellite review in 2D/Z stack\",\n";
macro3Dsingle = macro3Dsingle + "        \"Review detected 3D satellites in a normal Fiji stack window. Scroll through Z with the slice slider.\\n\\n\" +\n";
macro3Dsingle = macro3Dsingle + "        \"- Magenta/purple boundary overlay is generated from the real segmented satellite mask on each Z slice\\n\" +\n";
macro3Dsingle = macro3Dsingle + "        \"- Smaller yellow IDs are shown on the Z-slices where the detected purple mask is present near that satellite\\n\" +\n";
macro3Dsingle = macro3Dsingle + "        \"- Scroll through Z; IDs should appear together with the purple boundary instead of staying on unrelated slices\\n\" +\n";
macro3Dsingle = macro3Dsingle + "        \"- Detected satellites before visual review: \" + satCount + \"\\n\\n\" +\n";
macro3Dsingle = macro3Dsingle + "        \"Click OK to continue. This review is visual only and will not remove or reduce any detected satellites.\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    if (!isOpen(reviewTitle)) {\n";
macro3Dsingle = macro3Dsingle + "        reviewTitle = getTitle();\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    if (saveQCImages) {\n";
macro3Dsingle = macro3Dsingle + "        if (roiManager(\"count\") > 0) roiManager(\"Save\", qcDir + runID + \"_satellite_review_rois_AFTER_EDIT.zip\");\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(reviewTitle)) {\n";
macro3Dsingle = macro3Dsingle + "            selectWindow(reviewTitle);\n";
macro3Dsingle = macro3Dsingle + "            saveAs(\"Tiff\", qcDir + runID + \"_satellite_review_2D_Z_boundaries_and_IDs_overlay_live.tif\");\n";
macro3Dsingle = macro3Dsingle + "            run(\"Duplicate...\", \"title=SQ3D_review_QC_overlay_duplicate duplicate\");\n";
macro3Dsingle = macro3Dsingle + "            reviewQCDupTitle = getTitle();\n";
macro3Dsingle = macro3Dsingle + "            run(\"Flatten\");\n";
macro3Dsingle = macro3Dsingle + "            rename(\"SQ3D_satellite_review_BOUNDARIES_AND_IDS_FLATTENED_QC\");\n";
macro3Dsingle = macro3Dsingle + "            saveAs(\"Tiff\", qcDir + runID + \"_satellite_review_2D_Z_boundaries_and_IDs_FLATTENED_QC.tif\");\n";
macro3Dsingle = macro3Dsingle + "            setOption(\"Changes\", false);\n";
macro3Dsingle = macro3Dsingle + "            close();\n";
macro3Dsingle = macro3Dsingle + "            if (isOpen(reviewQCDupTitle)) { selectWindow(reviewQCDupTitle); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "    } else {\n";
macro3Dsingle = macro3Dsingle + "        if (roiManager(\"count\") > 0) roiManager(\"Save\", outputDir + runID + \"_satellite_review_rois_AFTER_EDIT.zip\");\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    roiManager(\"Reset\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    if (isOpen(reviewTitle)) {\n";
macro3Dsingle = macro3Dsingle + "        selectWindow(reviewTitle);\n";
macro3Dsingle = macro3Dsingle + "        close();\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "    if (isOpen(\"SQ3D_Satellite_Review_Source\")) {\n";
macro3Dsingle = macro3Dsingle + "        selectWindow(\"SQ3D_Satellite_Review_Source\");\n";
macro3Dsingle = macro3Dsingle + "        close();\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "if (saveQCImages && savedAnyTable && haveXY && satCount > 0) {\n";
macro3Dsingle = macro3Dsingle + "    selectWindow(originalTitle);\n";
macro3Dsingle = macro3Dsingle + "    if (channels > 1) {\n";
macro3Dsingle = macro3Dsingle + "        Stack.setChannel(satelliteChannel);\n";
macro3Dsingle = macro3Dsingle + "        run(\"Duplicate...\", \"title=SQ3D_LabelSource duplicate channels=\" + satelliteChannel);\n";
macro3Dsingle = macro3Dsingle + "    } else {\n";
macro3Dsingle = macro3Dsingle + "        run(\"Duplicate...\", \"title=SQ3D_LabelSource\");\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    run(\"Subtract Background...\", \"rolling=\" + rollingBall + \" stack\");\n";
macro3Dsingle = macro3Dsingle + "    getDimensions(lWidth, lHeight, lChannels, lSlices, lFrames);\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    if (lSlices > 1) {\n";
macro3Dsingle = macro3Dsingle + "        run(\"Z Project...\", \"start=1 stop=\" + lSlices + \" projection=[Max Intensity]\");\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    run(\"Enhance Contrast\", \"saturated=0.35\");\n";
macro3Dsingle = macro3Dsingle + "    run(\"RGB Color\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    setFont(\"SansSerif\", 7, \"antialiased\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    for (i = 0; i < satCount; i++) {\n";
macro3Dsingle = macro3Dsingle + "        cx = xArr[i];\n";
macro3Dsingle = macro3Dsingle + "        cy = yArr[i];\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        setColor(0, 255, 255);\n";
macro3Dsingle = macro3Dsingle + "        makeOval(cx - 2, cy - 2, 4, 4);\n";
macro3Dsingle = macro3Dsingle + "        if (selectionType() != -1) run(\"Draw\", \"slice\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        setColor(255, 255, 0);\n";
macro3Dsingle = macro3Dsingle + "        drawString(\"\" + idArr[i], cx + 4, cy - 4);\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    saveAs(\"Tiff\", qcDir + runID + \"_satellite_ID_labeled_max_projection_SMALL_LABELS.tif\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    selectWindow(originalTitle);\n";
macro3Dsingle = macro3Dsingle + "    if (channels > 1) {\n";
macro3Dsingle = macro3Dsingle + "        Stack.setChannel(satelliteChannel);\n";
macro3Dsingle = macro3Dsingle + "        run(\"Duplicate...\", \"title=SQ3D_3D_Segmentation_Mask_Source duplicate channels=\" + satelliteChannel);\n";
macro3Dsingle = macro3Dsingle + "    } else {\n";
macro3Dsingle = macro3Dsingle + "        run(\"Duplicate...\", \"title=SQ3D_3D_Segmentation_Mask_Source\");\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    run(\"Subtract Background...\", \"rolling=\" + rollingBall + \" stack\");\n";
macro3Dsingle = macro3Dsingle + "    setThreshold(thresholdValue, 65535);\n";
macro3Dsingle = macro3Dsingle + "    setOption(\"BlackBackground\", false);\n";
macro3Dsingle = macro3Dsingle + "    run(\"Convert to Mask\", \"method=Default background=Default black\");\n";
macro3Dsingle = macro3Dsingle + "    rename(\"SQ3D_3D_binary_segmentation_mask\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    getDimensions(mWidth, mHeight, mChannels, mSlices, mFrames);\n";
macro3Dsingle = macro3Dsingle + "    if (mSlices > 1) {\n";
macro3Dsingle = macro3Dsingle + "        run(\"Z Project...\", \"start=1 stop=\" + mSlices + \" projection=[Max Intensity]\");\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "    rename(\"SQ3D_2D_max_projection_of_3D_mask\");\n";
macro3Dsingle = macro3Dsingle + "    saveAs(\"Tiff\", qcDir + runID + \"_satellite_selection_mask_max_projection.tif\");\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "if (saveQCImages && (!haveXY || satCount == 0)) {\n";
macro3Dsingle = macro3Dsingle + "    note = \"Numbered QC image was not created. \";\n";
macro3Dsingle = macro3Dsingle + "    if (!haveXY) note = note + \"X/Y columns were not identified in the 3D Objects Counter+ results table. \";\n";
macro3Dsingle = macro3Dsingle + "    if (satCount == 0) note = note + \"No satellites were detected in the saved results table.\";\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "centrosomeCount = 0;\n";
macro3Dsingle = macro3Dsingle + "centHaveXYZ = false;\n";
macro3Dsingle = macro3Dsingle + "centXArr = newArray(1);\n";
macro3Dsingle = macro3Dsingle + "centYArr = newArray(1);\n";
macro3Dsingle = macro3Dsingle + "centZArr = newArray(1);\n";
macro3Dsingle = macro3Dsingle + "centIdArr = newArray(1);\n";
macro3Dsingle = macro3Dsingle + "centThresholdValue = \"NA\";\n";
macro3Dsingle = macro3Dsingle + "centrosome3DDetectionAccepted = true;\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    if (review3DSatellitesBeforeContinue) {\n";
macro3Dsingle = macro3Dsingle + "        Dialog.create(\"Accept 3D satellites?\");\n";
macro3Dsingle = macro3Dsingle + "        Dialog.addMessage(\"Detected / selected 3D satellites: \" + satCount);\n";
macro3Dsingle = macro3Dsingle + "        Dialog.addRadioButtonGroup(\"Next step:\", newArray(\"Accept 3D satellites and continue\", \"Change 3D satellite settings and re-detect\"), 2, 1, \"Accept 3D satellites and continue\");\n";
macro3Dsingle = macro3Dsingle + "        Dialog.show();\n";
macro3Dsingle = macro3Dsingle + "        sat3DDecision = Dialog.getRadioButton();\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        if (sat3DDecision == \"Accept 3D satellites and continue\") {\n";
macro3Dsingle = macro3Dsingle + "            satellite3DDetectionAccepted = true;\n";
macro3Dsingle = macro3Dsingle + "        } else {\n";
macro3Dsingle = macro3Dsingle + "            Dialog.create(\"Redo 3D satellite detection settings\");\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addNumber(\"Satellite channel:\", satelliteChannel);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addNumber(\"Rolling ball radius:\", rollingBall);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addChoice(\"Threshold mode:\", newArray(\"Auto\", \"Manual value\"), thresholdMode);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addChoice(\"Auto-threshold method:\", newArray(\"Otsu\"), autoMethod);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addNumber(\"Manual threshold value:\", manualThreshold);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addNumber(\"Minimum object size, pixels (3D stack object size; 0 = keep every detected object):\", minVoxels);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addNumber(\"Maximum object size, pixels (3D stack object size):\", maxVoxels);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addCheckbox(\"Exclude objects touching stack edges\", excludeEdges);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addCheckbox(\"Override size/edge filters and quantify every detected 3D satellite object\", forceQuantifyAll3D);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addCheckbox(\"Review detected 3D satellites in scrollable 2D/Z stack before final export:\", review3DSatellitesBeforeContinue);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.show();\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "            satelliteChannel = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "            rollingBall = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "            thresholdMode = Dialog.getChoice();\n";
macro3Dsingle = macro3Dsingle + "            autoMethod = Dialog.getChoice();\n";
macro3Dsingle = macro3Dsingle + "            manualThreshold = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "            minVoxels = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "            maxVoxels = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "            if (minVoxels < 1) minVoxels = 1;\n";
macro3Dsingle = macro3Dsingle + "            if (maxVoxels < minVoxels) maxVoxels = 999999999;\n";
macro3Dsingle = macro3Dsingle + "            sat3DSplitMode = \"Off\";\n";
macro3Dsingle = macro3Dsingle + "            sat3DSplitMinVoxels = 0;\n";
macro3Dsingle = macro3Dsingle + "            sat3DPeakProminence = 0;\n";
macro3Dsingle = macro3Dsingle + "            sat3DPeakSigma = 0;\n";
macro3Dsingle = macro3Dsingle + "            excludeEdges = Dialog.getCheckbox();\n";
macro3Dsingle = macro3Dsingle + "            forceQuantifyAll3D = Dialog.getCheckbox();\n";
macro3Dsingle = macro3Dsingle + "            review3DSatellitesBeforeContinue = Dialog.getCheckbox();\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "    } else {\n";
macro3Dsingle = macro3Dsingle + "        satellite3DDetectionAccepted = true;\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "if (centrosomeChannel > 0) {\n";
macro3Dsingle = macro3Dsingle + "    centrosome3DDetectionAccepted = false;\n";
macro3Dsingle = macro3Dsingle + "    while (centrosome3DDetectionAccepted == false) {\n";
