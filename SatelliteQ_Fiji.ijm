macroTL = macroTL + "                        xArr[parsedRows] = parseFloat(xs);\n";
macroTL = macroTL + "                        yArr[parsedRows] = parseFloat(ys);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "                        if (haveXYZ && cfields.length > coordZCol) {\n";
macroTL = macroTL + "                            zs = replace(cfields[coordZCol], \"\\\"\", \"\");\n";
macroTL = macroTL + "                            zArr[parsedRows] = parseFloat(zs);\n";
