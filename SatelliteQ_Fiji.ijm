macro3Dsingle = macro3Dsingle + "        getStatistics(cAreaTmp, cMean, cMin, cMax, cStd);\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        if (centThresholdMode == \"Mean + SD multiplier\") {\n";
