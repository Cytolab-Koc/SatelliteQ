macroTL = macroTL + "optionsTxt = optionsTxt + \"Cell boundary source type: \" + cellBoundarySourceType + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Cell ROI drawing/review image: \" + cellROIDisplayMode + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Cell rolling ball radius, pixels: \" + cellRollingBall + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Cell threshold mode: \" + cellThresholdMode + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Cell global threshold method: \" + cellThreshold + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Cell local threshold method: \" + cellLocalThresholdMethod + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Local threshold radius, pixels: \" + cellLocalRadius + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Manual cell threshold value, AU: \" + cellManualThreshold + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Microtubule/cytoskeleton preprocessing strength: \" + cellPreprocessStrength + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Cell mask cleanup strength: \" + cellCleanupMode + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Split touching/large cell ROIs or volumes with watershed: \" + cellDoWatershed + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Watershed over-splitting protection: \" + cellWatershedProtection + \"\\n\";\n";
macroTL = macroTL + "if (cellAssignmentMode == \"Skip cell assignment\") {\n";
macroTL = macroTL + "    optionsTxt = optionsTxt + \"Minimum projected cell area filter: Not applied (cell assignment skipped)\\n\";\n";
macroTL = macroTL + "    optionsTxt = optionsTxt + \"Maximum projected cell area filter: Not applied (cell assignment skipped)\\n\";\n";
macroTL = macroTL + "} else {\n";
macroTL = macroTL + "    optionsTxt = optionsTxt + \"Minimum projected cell area filter, microns^2: \" + minCellArea + \"\\n\";\n";
macroTL = macroTL + "    optionsTxt = optionsTxt + \"Maximum projected cell area filter, microns^2: \" + maxCellArea + \"\\n\";\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Where to detect/export satellites: \" + exportOutsideMode + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"If a cell contains >1 centrosome: \" + multiCentrosomeMode + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Cell sphere radius, microns: \" + cellSphereRadius + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Satellites outside all spheres: \" + outsideSphereMode + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"If a satellite falls inside >1 sphere: \" + multiSphereMode + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"\\n[OUTPUT FILES]\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Clean 3D results CSV: \" + resultsPath + \"\\n\";\n";

macroTL = macroTL + "optionsTxt = optionsTxt + \"Cell boundary ROI coordinate CSV: \" + cellBoundaryCSV + \"\\n\";\n";
macroTL = macroTL + "optionsTxt = optionsTxt + \"Selected options summary: \" + selectedOptionsPath + \"\\n\";\n";
macroTL = macroTL + "File.saveString(optionsTxt, selectedOptionsPath);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (centrosomeChannel > 0 && File.exists(centStackForReviewPath)) {\n";
macroTL = macroTL + "    File.delete(centStackForReviewPath);\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (File.exists(rawResultsPath)) {\n";
macroTL = macroTL + "    File.delete(rawResultsPath);\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (centrosomeChannel > 0 && File.exists(centCoordPath)) {\n";
macroTL = macroTL + "    File.delete(centCoordPath);\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "// Do not globally close image windows inside the per-frame 3D child macro.\n";
macroTL = macroTL + "// The outer time-lapse controller cleans temporary images while preserving the source hyperstack.\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "if (isOpen(\"Results\")) {\n";
macroTL = macroTL + "    selectWindow(\"Results\");\n";
macroTL = macroTL + "    run(\"Close\");\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "if (isOpen(\"Log\")) {\n";
macroTL = macroTL + "    selectWindow(\"Log\");\n";
macroTL = macroTL + "    print(\"\\\\Clear\");\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "if (isOpen(\"Summary\")) {\n";
macroTL = macroTL + "    selectWindow(\"Summary\");\n";
macroTL = macroTL + "    run(\"Close\");\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "if (isOpen(\"ROI Manager\")) {\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";
macroTL = macroTL + "    selectWindow(\"ROI Manager\");\n";
macroTL = macroTL + "    run(\"Close\");\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "if (isOpen(\"Threshold\")) {\n";
macroTL = macroTL + "    selectWindow(\"Threshold\");\n";
macroTL = macroTL + "    run(\"Close\");\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "if (isOpen(\"B&C\")) {\n";
macroTL = macroTL + "    selectWindow(\"B&C\");\n";
macroTL = macroTL + "    run(\"Close\");\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "if (isOpen(\"Brightness/Contrast\")) {\n";
macroTL = macroTL + "    selectWindow(\"Brightness/Contrast\");\n";
macroTL = macroTL + "    run(\"Close\");\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "// Final cleanup of leftover result/quantification windows.\n";
macroTL = macroTL + "run(\"Clear Results\");\n";
macroTL = macroTL + "allWinTitles = getList(\"window.titles\");\n";
macroTL = macroTL + "for (ww = allWinTitles.length - 1; ww >= 0; ww--) {\n";
macroTL = macroTL + "    thisWin = allWinTitles[ww];\n";
macroTL = macroTL + "    lw = toLowerCase(thisWin);\n";
macroTL = macroTL + "    if (lw == \"results\" || lw == \"summary\" || indexOf(lw, \"results\") >= 0 || indexOf(lw, \"summary\") >= 0 || indexOf(lw, \"3d objects\") >= 0 || indexOf(lw, \"3d object\") >= 0 || indexOf(lw, \"counter\") >= 0 || indexOf(lw, \"quantification\") >= 0 || indexOf(lw, \"measure\") >= 0) {\n";
macroTL = macroTL + "        selectWindow(thisWin);\n";
macroTL = macroTL + "        run(\"Close\");\n";
macroTL = macroTL + "    }\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "run(\"Collect Garbage\");\n";
        selectedMacroPath = tempDir + "SatelliteQ_selected_3D_timelapse.ijm";
    }
    if (File.exists(selectedMacroPath)) File.delete(selectedMacroPath);
    File.saveString(macroTL, selectedMacroPath);
    File.saveString("SatelliteQ time-lapse log\nMode," + analysisMode + "\nImage," + tlInputTitle + "\nOutput," + tlOut + "\nFrame settings behavior," + frameSettingsBehavior + "\nNote,The macro clears stray Fiji Log-window return values such as 1; this CSV is the real run log.\n\nStatus,Frame,Message\n", logPath);
    combinedHeaderWritten = false;

    for (f = firstFrame; f <= lastFrame; f++) {
        showProgress(f - firstFrame + 1, lastFrame - firstFrame + 1);

        // If the user chose USE_SAME_SETTINGS, process frames unattended.
        // The Continue/Abort prompt is only shown in the interactive per-frame mode.
        if (frameSettingsBehavior != "USE_SAME_SETTINGS") {
            Dialog.create("SatelliteQ time-lapse - continue?");
            Dialog.addMessage("Ready to process frame " + f + " of " + lastFrame + ".");
            Dialog.addMessage("Choose Abort if you want to stop the whole time-lapse now without closing Fiji.");
            Dialog.addRadioButtonGroup("Action:", newArray("Process this frame", "Abort time-lapse now"), 2, 1, "Process this frame");
            Dialog.show();
            tlAbortDecision = Dialog.getRadioButton();

            if (tlAbortDecision == "Abort time-lapse now") {
                File.append("ABORTED," + f + ",User aborted before processing this frame\n", logPath);

                if (File.exists(tempStackPath)) File.delete(tempStackPath);
                if (File.exists(sqModePath)) File.delete(sqModePath);
                if (File.exists(sq2dSettingsPath)) File.delete(sq2dSettingsPath);
                if (File.exists(sq3dSettingsPath)) File.delete(sq3dSettingsPath);
                if (File.exists(sqScalePath)) File.delete(sqScalePath);

                showProgress(1, 1);
                showMessage("SatelliteQ time-lapse aborted",
                    "Time-lapse analysis was stopped before frame " + f + ".\n\n" +
                    "Already processed frame outputs were kept.\n\n" +
                    "Output folder:\n" + tlOut);
                exit("SatelliteQ time-lapse aborted by user.");
            }
        }
        File.append("STARTED," + f + ",Processing frame\n", logPath);

        // Extract the requested timepoint from the ORIGINAL source image.
        // Use the source image ID so focus/title changes cannot redirect extraction.
        if (!isOpen(tlInputID)) {
            exit("SatelliteQ time-lapse source image was closed unexpectedly: " + tlInputTitle);
        }
        selectImage(tlInputID);

        // Re-read dimensions from the live source as a safety check.
        getDimensions(loopW, loopH, loopC, loopZ, loopT);
        if (f > loopT) {
            exit("Requested frame " + f + " but the source image currently has only " + loopT + " frames.");
        }

        frameName = "SQF_" + pad3(f);
        if (isOpen(frameName)) {
            selectWindow(frameName);
            setOption("Changes", false);
            close();
            selectImage(tlInputID);
        }

        // Extract frame f using a method that matches how Fiji actually stores the source.
        // Some TIFF movies report Frames>1 but are NOT flagged as HyperStacks.
        // Reduce Dimensionality only works on true HyperStacks, so handle both cases.
        sourceIsHyper = Stack.isHyperstack;

        if (sourceIsHyper) {
            // True hyperstack: Duplicate can address C/Z/T directly.
            dupOptions = "title=" + frameName +
                         " duplicate channels=1-" + loopC +
                         " slices=1-" + loopZ +
                         " frames=" + f + "-" + f;
            run("Duplicate...", dupOptions);
            extractionMode = "Hyperstack_CZT";
            sourcePlaneStart = (f - 1) * loopC * loopZ + 1;
            sourcePlaneEnd = f * loopC * loopZ;
        } else {
            // Ordinary stack with C/Z/T dimensions attached:
            // ImageJ stores planes in CZT order, so one timepoint is one
            // contiguous block of C*Z planes.
            planesPerFrame = loopC * loopZ;
            sourcePlaneStart = (f - 1) * planesPerFrame + 1;
            sourcePlaneEnd = f * planesPerFrame;

            stackSizeNow = nSlices;
            if (sourcePlaneStart < 1 || sourcePlaneEnd > stackSizeNow) {
                exit("SatelliteQ cannot extract frame " + f +
                     ". Calculated stack-plane range " + sourcePlaneStart + "-" + sourcePlaneEnd +
                     " but the source stack contains " + stackSizeNow + " planes.");
            }

            rangeOptions = "title=" + frameName + " duplicate range=" +
                           sourcePlaneStart + "-" + sourcePlaneEnd;
            run("Duplicate...", rangeOptions);
            extractionMode = "Linear_stack_range";

            // A linear range loses explicit channel structure.
            // Restore C/Z dimensions only when multiple channels are present.
            // For C=1, a normal Z-stack is exactly what the 2D/3D child macros need.
            if (loopC > 1) {
                run("Stack to Hyperstack...",
                    "order=xyczt(default) channels=" + loopC +
                    " slices=" + loopZ +
                    " frames=1 display=Composite");
            }
        }

        extractedID = getImageID();
        if (extractedID == tlInputID) {
            exit("SatelliteQ could not extract frame " + f + " as a separate image.");
        }
        rename(frameName);

        // Validate the extracted dimensions. It must represent exactly one timepoint.
        getDimensions(frameWCheck, frameHCheck, frameCCheck, frameZCheck, frameTCheck);
        if (frameTCheck != 1) {
            exit("SatelliteQ extracted frame " + f + " but the new image still has " +
                 frameTCheck + " timepoints instead of 1.");
        }

        // For one-channel data, the extracted Z dimension should equal the source Z.
        // For multichannel data, restoring the hyperstack should recover both C and Z.
        if (frameCCheck != loopC || frameZCheck != loopZ) {
            exit("SatelliteQ extracted frame " + f +
                 " but dimensions do not match the source frame. Expected C=" + loopC +
                 ", Z=" + loopZ + "; got C=" + frameCCheck + ", Z=" + frameZCheck + ".");
        }

        File.append("FRAME_READY," + f +
                    ",Mode=" + extractionMode +
                    ",Planes=" + sourcePlaneStart + "-" + sourcePlaneEnd +
                    ",Extracted_as=" + frameName +
                    ",C=" + frameCCheck +
                    ",Z=" + frameZCheck +
                    ",T=" + frameTCheck + "\n", logPath);

        sqFrameMacroReturn = runMacro(selectedMacroPath);
        if (isOpen("Log")) {
            selectWindow("Log");
            print("\\Clear");
        }
        timeMin = (f - firstFrame) * timeInterval;

        if (analysisMode == "2D time-lapse") {
            frameOutDir = tlOut + frameName + "_SQ2D/";
            frameCSV = frameOutDir + frameName + "_SatelliteQuantify_Fiji_Output.csv";
            if (File.exists(frameCSV)) {
                File.append(summarize2DCSV(frameCSV, f, timeMin) + "\n", summaryCSV);
                combinedHeaderWritten = append2DFrameRows(frameCSV, f, timeMin, combinedCSV, combinedHeaderWritten);
                File.append("PROCESSED," + f + ",OK\n", logPath);
            } else {
                File.append("FAILED," + f + ",Could not find frame CSV: " + frameCSV + "\n", logPath);
            }
        } else {
            frameOutDir = tlOut + frameName + "_SQ3D/";
            frameCSV = "";
            frameFiles = getFileList(frameOutDir);
            for (ff = 0; ff < frameFiles.length; ff++) {
                candidateName = frameFiles[ff];
                if (endsWith(candidateName, "_results.csv") && indexOf(candidateName, "_3D_") >= 0) {
                    frameCSV = frameOutDir + candidateName;
                }
            }
            if (frameCSV == "" && File.exists(frameOutDir + "satellite_3D_results_clean.csv")) {
                frameCSV = frameOutDir + "satellite_3D_results_clean.csv";
            }
            if (frameCSV != "" && File.exists(frameCSV)) {
                File.append(summarize3DCSV(frameCSV, f, timeMin) + "\n", summaryCSV);
                combinedHeaderWritten = append3DFrameRows(frameCSV, f, timeMin, combinedCSV, combinedHeaderWritten);
                File.append("PROCESSED," + f + ",OK\n", logPath);
            } else {
                File.append("FAILED," + f + ",Could not find renamed 3D result CSV in: " + frameOutDir + "\n", logPath);
            }
        }

        if (isOpen("Log")) {
            selectWindow("Log");
            print("\\Clear");
        }
        imgs = getList("image.titles");
        for (w = imgs.length - 1; w >= 0; w--) {
            // Keep the original time-lapse hyperstack open for the next frame.
            // The source is also tracked by tlInputID for extraction/reselection.
            if (imgs[w] != tlInputTitle) {
                selectWindow(imgs[w]);
                setOption("Changes", false);
                close();
            }
        }
        if (isOpen(tlInputID)) selectImage(tlInputID);
        if (isOpen("ROI Manager")) {
            roiManager("Reset");
            selectWindow("ROI Manager");
            run("Close");
        }
        run("Clear Results");
        allWinTitles = getList("window.titles");
        for (ww = allWinTitles.length - 1; ww >= 0; ww--) {
            thisWin = allWinTitles[ww];
            lw = toLowerCase(thisWin);
            if (lw == "results" || lw == "summary" || indexOf(lw, "results") >= 0 || indexOf(lw, "summary") >= 0 || indexOf(lw, "3d objects") >= 0 || indexOf(lw, "3d object") >= 0 || indexOf(lw, "counter") >= 0 || indexOf(lw, "quantification") >= 0 || indexOf(lw, "measure") >= 0) {
                selectWindow(thisWin);
                run("Close");
            }
        }
        if (isOpen("Threshold")) { selectWindow("Threshold"); run("Close"); }
        if (isOpen("B&C")) { selectWindow("B&C"); run("Close"); }
        if (isOpen("Brightness/Contrast")) { selectWindow("Brightness/Contrast"); run("Close"); }
    }

    if (File.exists(tempStackPath)) File.delete(tempStackPath);
    if (File.exists(sqModePath)) File.delete(sqModePath);
    if (File.exists(sq2dSettingsPath)) File.delete(sq2dSettingsPath);
    if (File.exists(sq3dSettingsPath)) File.delete(sq3dSettingsPath);

    if (isOpen("Log")) {
        selectWindow("Log");
        print("\\Clear");
    }
    if (isOpen("ROI Manager")) {
        roiManager("Reset");
        selectWindow("ROI Manager");
        run("Close");
    }
    if (isOpen("Results")) { selectWindow("Results"); run("Close"); }
    if (isOpen("Summary")) { selectWindow("Summary"); run("Close"); }
    if (isOpen("Threshold")) { selectWindow("Threshold"); run("Close"); }
    if (isOpen("B&C")) { selectWindow("B&C"); run("Close"); }
    if (isOpen("Brightness/Contrast")) { selectWindow("Brightness/Contrast"); run("Close"); }
    showProgress(1, 1);
    waitForUser("SatelliteQ time-lapse finished",
        "Time-lapse analysis finished for the full selected frame range.\n\n" +
        "Output folder:\n" + tlOut + "\n\n" +
        "Combined satellite table:\n" + combinedCSV + "\n\n" +
        "Frame summary table:\n" + summaryCSV);
}
