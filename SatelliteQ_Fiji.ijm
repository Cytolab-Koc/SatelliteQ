macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (maxCentrosomesKeep > 0) {\n";
macroTL = macroTL + "            currentN = roiManager(\"count\");\n";
macroTL = macroTL + "            if (currentN > maxCentrosomesKeep) {\n";
