macroTL = macroTL + "    Dialog.addMessage(\"Choose how satellites should be assigned to cells.\");\n";
macroTL = macroTL + "    Dialog.addChoice(\"Cell assignment mode:\", newArray(\"No cell assignment\", \"Membrane marker\", \"Cytoplasmic signal boundary\", \"Centrosome radius\", \"Manual cell ROIs during macro\", \"Existing cell ROIs in ROI Manager\"), d_cellAssignmentMode);\n";
