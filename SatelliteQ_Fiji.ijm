macroTL = macroTL + "    skHeader=\"Run_ID,Image,Frame,Mode,Cilium_ID,Cell_ID,Point_Index,X_um,Y_um,Z_um\\n\"; File.saveString(skHeader,ciliumSkeletonPath);\n";
