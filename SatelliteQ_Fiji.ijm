macroTL = macroTL + "    multiSphereMode = d_multiSphereMode;\n";
macroTL = macroTL + "} else {\n";
macroTL = macroTL + "    Dialog.create(\"SatelliteQuantify 3D time-lapse - Step 1/4: Channels\");\n";
macroTL = macroTL + "    Dialog.addMessage(\"Choose the image channels first. These choices will be reused across the selected frames.\");\n";
