macroTL = macroTL + "    selectWindow(\"Centrosome_BackgroundSubtracted\");\n";
macroTL = macroTL + "    run(\"Subtract Background...\", \"rolling=\" + centRollingBall);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "    roiManager(\"Reset\");\n";
macroTL = macroTL + "    centReviewTitle = prepareCentrosomeDrawingView(centROIDisplayMode);\n";
macroTL = macroTL + "    selectWindow(centReviewTitle);\n";
macroTL = macroTL + "\n";
