macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        has2DProjectedCellROIs = false;\n";
macroTL = macroTL + "        cellCount2D = 0;\n";
macroTL = macroTL + "        cellRoiZip = outputDir + runID + \"_cell_2D_projection_ROIs.zip\";\n";
macroTL = macroTL + "        satCellID2D = newArray(satCount); satCellArea2D = newArray(satCount); satCellVolume2D = newArray(satCount); satAssignedCent2D = newArray(satCount); satAssignedCentDist2D = newArray(satCount);\n";
macroTL = macroTL + "        for (i = 0; i < satCount; i++) { satCellID2D[i] = 0; satCellArea2D[i] = \"NaN\"; satCellVolume2D[i] = \"NaN\"; satAssignedCent2D[i] = \"NaN\"; satAssignedCentDist2D[i] = \"NaN\"; }\n";
macroTL = macroTL + "        if (cellAssignmentMode == \"Membrane marker - 2D projected ROI\" || cellAssignmentMode == \"Cytoplasmic signal boundary - 2D projected ROI\") {\n";
macroTL = macroTL + "            roiManager(\"Reset\"); run(\"Clear Results\");\n";
macroTL = macroTL + "            selectWindow(originalTitle);\n";
macroTL = macroTL + "            run(\"Duplicate...\", \"title=SQ3D_TL_Cell_Channel_For2DROI duplicate channels=\" + membraneChannel);\n";
macroTL = macroTL + "            selectWindow(\"SQ3D_TL_Cell_Channel_For2DROI\");\n";
macroTL = macroTL + "            run(\"Z Project...\", \"projection=[Max Intensity]\");\n";
macroTL = macroTL + "            rename(\"SQ3D_TL_Cell_Projection\");\n";
macroTL = macroTL + "            cellProjectionTitle = getTitle();\n";
macroTL = macroTL + "            run(\"Duplicate...\", \"title=SQ3D_TL_Cell_BackgroundSubtracted\");\n";
macroTL = macroTL + "            selectWindow(\"SQ3D_TL_Cell_BackgroundSubtracted\");\n";
macroTL = macroTL + "            if (cellRollingBall > 0) run(\"Subtract Background...\", \"rolling=\" + cellRollingBall);\n";
macroTL = macroTL + "            effectiveCellSourceType = cellBoundarySourceType;\n";
macroTL = macroTL + "            if (cellAssignmentMode == \"Cytoplasmic signal boundary - 2D projected ROI\" && effectiveCellSourceType == \"Membrane/boundary marker\") effectiveCellSourceType = \"Diffuse cytoplasmic protein\";\n";
macroTL = macroTL + "            if (effectiveCellSourceType == \"Diffuse cytoplasmic protein\") { run(\"Gaussian Blur...\", \"sigma=2\"); run(\"Enhance Contrast...\", \"saturated=0.35 normalize\"); }\n";
macroTL = macroTL + "            if (effectiveCellSourceType == \"Microtubule/cytoskeleton staining\") { if (cellPreprocessStrength == \"Light\") { run(\"Gaussian Blur...\", \"sigma=3\"); run(\"Maximum...\", \"radius=1\"); } if (cellPreprocessStrength == \"Medium\") { run(\"Gaussian Blur...\", \"sigma=5\"); run(\"Maximum...\", \"radius=2\"); } if (cellPreprocessStrength == \"Strong\") { run(\"Gaussian Blur...\", \"sigma=7\"); run(\"Maximum...\", \"radius=3\"); } if (cellPreprocessStrength == \"Very strong\") { run(\"Gaussian Blur...\", \"sigma=10\"); run(\"Maximum...\", \"radius=4\"); } run(\"Enhance Contrast...\", \"saturated=0.35 normalize\"); }\n";
macroTL = macroTL + "            selectWindow(\"SQ3D_TL_Cell_BackgroundSubtracted\");\n";
macroTL = macroTL + "            run(\"Duplicate...\", \"title=SQ3D_TL_Cell_Projection_Mask\");\n";
macroTL = macroTL + "            selectWindow(\"SQ3D_TL_Cell_Projection_Mask\");\n";
macroTL = macroTL + "            if (cellLocalRadius < 1) cellLocalRadius = 15;\n";
macroTL = macroTL + "            if (cellThresholdMode == \"Manual threshold\") { setThreshold(cellManualThreshold, 65535); setOption(\"BlackBackground\", false); run(\"Convert to Mask\"); }\n";
macroTL = macroTL + "            else if (cellThresholdMode == \"Local auto threshold\") { run(\"8-bit\"); run(\"Auto Local Threshold\", \"method=\" + cellLocalThresholdMethod + \" radius=\" + cellLocalRadius + \" parameter_1=0 parameter_2=0 white\"); selectWindow(\"SQ3D_TL_Cell_Projection_Mask\"); run(\"8-bit\"); setThreshold(1, 255); setOption(\"BlackBackground\", false); run(\"Convert to Mask\"); }\n";
macroTL = macroTL + "            else { setAutoThreshold(cellThreshold + \" dark\"); setOption(\"BlackBackground\", false); run(\"Convert to Mask\"); }\n";
macroTL = macroTL + "            run(\"8-bit\");\n";
macroTL = macroTL + "            if (cellCleanupMode == \"Very light\") { run(\"Fill Holes\"); }\n";
macroTL = macroTL + "            if (cellCleanupMode == \"Standard\") { run(\"Close-\"); run(\"Fill Holes\"); }\n";
macroTL = macroTL + "            if (cellCleanupMode == \"Medium-strong\") { run(\"Close-\"); run(\"Close-\"); run(\"Fill Holes\"); }\n";
macroTL = macroTL + "            if (cellCleanupMode == \"Strong\") { run(\"Close-\"); run(\"Close-\"); run(\"Close-\"); run(\"Fill Holes\"); }\n";
macroTL = macroTL + "            if (cellCleanupMode == \"Very strong\") { run(\"Close-\"); run(\"Close-\"); run(\"Close-\"); run(\"Fill Holes\"); run(\"Open\"); run(\"Close-\"); run(\"Fill Holes\"); }\n";
macroTL = macroTL + "            cellAnalyzeMinArea = minCellArea;\n";
macroTL = macroTL + "            if (cellDoWatershed) { run(\"Watershed\"); if (cellWatershedProtection == \"Light\") cellAnalyzeMinArea = minCellArea * 1.5; if (cellWatershedProtection == \"Medium\") cellAnalyzeMinArea = minCellArea * 2.5; if (cellWatershedProtection == \"Strong\") cellAnalyzeMinArea = minCellArea * 4.0; }\n";
macroTL = macroTL + "            roiManager(\"Reset\");\n";
macroTL = macroTL + "            run(\"Set Measurements...\", \"area mean centroid center redirect=None decimal=3\");\n";
