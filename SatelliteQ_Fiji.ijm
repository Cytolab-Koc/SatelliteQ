macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 39) d_cellLocalRadius = parseFloat(sqVals[38]);\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 40) d_cellManualThreshold = parseFloat(sqVals[39]);\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 41) d_cellPreprocessStrength = sqVals[40];\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 42) d_cellWatershedProtection = sqVals[41];\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 36) d_cellBoundarySourceType = sqVals[35];\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 37) d_cellThresholdMode = sqVals[36];\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 38) d_cellLocalThresholdMethod = sqVals[37];\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 39) d_cellLocalRadius = parseFloat(sqVals[38]);\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 40) d_cellManualThreshold = parseFloat(sqVals[39]);\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 41) d_cellPreprocessStrength = sqVals[40];\n";
macro2Dsingle = macro2Dsingle + "        if (sqVals.length >= 42) d_cellWatershedProtection = sqVals[41];\n";
macro2Dsingle = macro2Dsingle + "        sqTLHasPrev = true;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (channels == 1 && slices > 1) {\n";
macro2Dsingle = macro2Dsingle + "    if (sqTLUseSame && sqTLHasPrev) {\n";
macro2Dsingle = macro2Dsingle + "        treatSlicesAsChannels = d_treatSlicesAsChannels;\n";
macro2Dsingle = macro2Dsingle + "    } else {\n";
macro2Dsingle = macro2Dsingle + "        Dialog.create(\"SatelliteQuantify: image dimensions\");\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addMessage(\"Fiji currently sees this image as Channels=\" + channels + \", Slices=\" + slices + \", Frames=\" + frames);\n";
macro2Dsingle = macro2Dsingle + "        Dialog.addCheckbox(\"Treat slices as channels\", d_treatSlicesAsChannels);\n";
macro2Dsingle = macro2Dsingle + "        Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "        treatSlicesAsChannels = Dialog.getCheckbox();\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    d_treatSlicesAsChannels = treatSlicesAsChannels;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    if (treatSlicesAsChannels) {\n";
macro2Dsingle = macro2Dsingle + "        run(\"Stack to Hyperstack...\", \"order=xyczt(default) channels=\" + slices + \" slices=1 frames=1 display=Composite\");\n";
macro2Dsingle = macro2Dsingle + "        originalTitle = getTitle();\n";
macro2Dsingle = macro2Dsingle + "        baseName = cleanFileName(originalTitle);\n";
macro2Dsingle = macro2Dsingle + "        getDimensions(width, height, channels, slices, frames);\n";
macro2Dsingle = macro2Dsingle + "        runID = baseName + \"_\" + runTimestamp;\n";
macro2Dsingle = macro2Dsingle + "    }\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "parentOutputDir = getDirectory(\"Choose main output folder for SatelliteQuantify results\");\n";
macro2Dsingle = macro2Dsingle + "if (parentOutputDir == \"\") exit(\"No output folder selected.\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (sqTLUseSame && sqTLHasPrev) {\n";
macro2Dsingle = macro2Dsingle + "    saveQCImages = d_saveQCImages;\n";
macro2Dsingle = macro2Dsingle + "} else {\n";
macro2Dsingle = macro2Dsingle + "    Dialog.create(\"SatelliteQuantify output options\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addMessage(\"A separate result folder will be created for this image.\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addMessage(\"Intermediate images are optional TIFF files saved for checking the analysis.\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addMessage(\"Examples: satellite masks, background-subtracted images, ROI review snapshots, centrosome review images, and cell masks.\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addMessage(\"Recommended: keep this ON while optimizing settings; turn it OFF later for faster runs and smaller folders.\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addCheckbox(\"Save intermediate images for visual checking\", d_saveQCImages);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "    saveQCImages = Dialog.getCheckbox();\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "d_saveQCImages = saveQCImages;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "outputDir = parentOutputDir + runID + \"_SatelliteQuantify_results\" + File.separator;\n";
macro2Dsingle = macro2Dsingle + "if (!File.exists(outputDir)) File.makeDirectory(outputDir);\n";
macro2Dsingle = macro2Dsingle + "cellBoundaryCSV = outputDir + runID + \"_cell_boundaries_for_python.csv\";\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "roiDir = outputDir + \"ROIs\" + File.separator;\n";
macro2Dsingle = macro2Dsingle + "if (!File.exists(roiDir)) File.makeDirectory(roiDir);\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (saveQCImages) {\n";
macro2Dsingle = macro2Dsingle + "    qcDir = outputDir + \"Intermediate_saved_images\" + File.separator;\n";
macro2Dsingle = macro2Dsingle + "    if (!File.exists(qcDir)) File.makeDirectory(qcDir);\n";
macro2Dsingle = macro2Dsingle + "} else {\n";
macro2Dsingle = macro2Dsingle + "    qcDir = \"\";\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "initialRoiZip = roiDir + runID + \"_initial_rois.zip\";\n";
macro2Dsingle = macro2Dsingle + "if (initialRoiCount > 0) {\n";
macro2Dsingle = macro2Dsingle + "    roiManager(\"Save\", initialRoiZip);\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (sqTLUseSame && sqTLHasPrev) {\n";
macro2Dsingle = macro2Dsingle + "    satelliteChannel = d_satelliteChannel;\n";
macro2Dsingle = macro2Dsingle + "    centrosomeChannel = d_centrosomeChannel;\n";
macro2Dsingle = macro2Dsingle + "    membraneChannel = d_membraneChannel;\n";
macro2Dsingle = macro2Dsingle + "    ciliumChannel = d_ciliumChannel;\n";
macro2Dsingle = macro2Dsingle + "    projectionMethod = d_projectionMethod;\n";
macro2Dsingle = macro2Dsingle + "} else {\n";
macro2Dsingle = macro2Dsingle + "    Dialog.create(\"SatelliteQuantify 2D - Step 1/4: Channels\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addMessage(\"Image: \" + originalTitle);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addMessage(\"Channels: \" + channels + \", Z-slices: \" + slices + \", ROI Manager at start: \" + initialRoiCount + \" ROI(s)\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addMessage(\"Use 0 to skip optional channels.\");\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Satellite marker channel:\", d_satelliteChannel);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Centrosome marker channel, 0 to skip:\", d_centrosomeChannel);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Membrane / cytoplasmic boundary channel, 0 to skip:\", d_membraneChannel);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addNumber(\"Primary cilium marker channel, 0 to skip cilium analysis:\", d_ciliumChannel);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.addChoice(\"Projection method:\", newArray(\"Max Intensity\", \"Sum Slices\", \"Average Intensity\"), d_projectionMethod);\n";
macro2Dsingle = macro2Dsingle + "    Dialog.show();\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "    satelliteChannel = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    centrosomeChannel = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    membraneChannel = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    ciliumChannel = Dialog.getNumber();\n";
macro2Dsingle = macro2Dsingle + "    projectionMethod = Dialog.getChoice();\n";
macro2Dsingle = macro2Dsingle + "}\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "d_satelliteChannel = satelliteChannel;\n";
macro2Dsingle = macro2Dsingle + "d_centrosomeChannel = centrosomeChannel;\n";
macro2Dsingle = macro2Dsingle + "d_membraneChannel = membraneChannel;\n";
macro2Dsingle = macro2Dsingle + "d_ciliumChannel = ciliumChannel;\n";
macro2Dsingle = macro2Dsingle + "d_projectionMethod = projectionMethod;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (satelliteChannel < 1 || satelliteChannel > channels) exit(\"Satellite channel must be between 1 and \" + channels + \".\");\n";
macro2Dsingle = macro2Dsingle + "if (centrosomeChannel != 0 && (centrosomeChannel < 1 || centrosomeChannel > channels)) exit(\"Centrosome channel must be 0 or between 1 and \" + channels + \".\");\n";
macro2Dsingle = macro2Dsingle + "if (membraneChannel != 0 && (membraneChannel < 1 || membraneChannel > channels)) exit(\"Membrane channel must be 0 or between 1 and \" + channels + \".\");\n";
macro2Dsingle = macro2Dsingle + "if (ciliumChannel != 0 && (ciliumChannel < 1 || ciliumChannel > channels)) exit(\"Cilium channel must be 0 or between 1 and \" + channels + \".\");\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "// Optional primary-cilium analysis defaults. Settings are collected with the other analysis options before ROI processing.\n";
macro2Dsingle = macro2Dsingle + "ciliumRollingBall = 20;\n";
macro2Dsingle = macro2Dsingle + "ciliumGaussianSigma = 1.0;\n";
macro2Dsingle = macro2Dsingle + "ciliumThresholdMode = \"Mean + SD multiplier\";\n";
macro2Dsingle = macro2Dsingle + "ciliumSDMultiplier = 2.0;\n";
macro2Dsingle = macro2Dsingle + "ciliumPercentMax = 25.0;\n";
macro2Dsingle = macro2Dsingle + "ciliumManualThreshold = 100;\n";
macro2Dsingle = macro2Dsingle + "ciliumMinLength = 1.0;\n";
macro2Dsingle = macro2Dsingle + "ciliumMaxLength = 10.0;\n";
macro2Dsingle = macro2Dsingle + "ciliumSkeletonSigma = 0.75;\n";
macro2Dsingle = macro2Dsingle + "ciliumReview = true;\n";
macro2Dsingle = macro2Dsingle + "ciliationLengthThreshold = ciliumMinLength;\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "\n";
macro2Dsingle = macro2Dsingle + "if (sqTLUseSame && sqTLHasPrev) {\n";
macro2Dsingle = macro2Dsingle + "    satRollingBall = d_satRollingBall;\n";
macro2Dsingle = macro2Dsingle + "    satThresholdMode = d_satThresholdMode;\n";
macro2Dsingle = macro2Dsingle + "    satThreshold = d_satThreshold;\n";
macro2Dsingle = macro2Dsingle + "    satManualThreshold = d_satManualThreshold;\n";
macro2Dsingle = macro2Dsingle + "    satHysteresisMultiplier = d_satHysteresisMultiplier;\n";
macro2Dsingle = macro2Dsingle + "    minSatSize = d_minSatSize;\n";
macro2Dsingle = macro2Dsingle + "    maxSatSize = d_maxSatSize;\n";
macro2Dsingle = macro2Dsingle + "    doSatWatershed = d_doSatWatershed;\n";
macro2Dsingle = macro2Dsingle + "    satSplitMethod = d_satSplitMethod;\n";
macro2Dsingle = macro2Dsingle + "    satPeakProminence = d_satPeakProminence;\n";
