macro3Dsingle = macro3Dsingle + "                                    candidateSumZ = candidateSumZ + centZArr[c];\n";
macro3Dsingle = macro3Dsingle + "                                    if (candDist < bestInsideDist) {\n";
macro3Dsingle = macro3Dsingle + "                                        bestInsideDist = candDist;\n";
macro3Dsingle = macro3Dsingle + "                                        bestInsideCent = c;\n";
macro3Dsingle = macro3Dsingle + "                                    }\n";
macro3Dsingle = macro3Dsingle + "                                }\n";
macro3Dsingle = macro3Dsingle + "                            }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                            if (candidateCount == 0) {\n";
macro3Dsingle = macro3Dsingle + "                                cellID = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "                                cellVolume = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "                                assignedCent = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "                                insideSphere = 0;\n";
macro3Dsingle = macro3Dsingle + "                                assignedDist = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "                            } else if (candidateCount == 1 || multiSphereMode == \"Use all overlapping spheres (assign nearest centrosome)\") {\n";
macro3Dsingle = macro3Dsingle + "                                cellID = centIdArr[bestInsideCent];\n";
macro3Dsingle = macro3Dsingle + "                                cellVolume = (4.0 / 3.0) * 3.14159265359 * cellSphereRadius * cellSphereRadius * cellSphereRadius;\n";
macro3Dsingle = macro3Dsingle + "                                assignedCent = centIdArr[bestInsideCent];\n";
macro3Dsingle = macro3Dsingle + "                                insideSphere = 1;\n";
macro3Dsingle = macro3Dsingle + "                                assignedDist = bestInsideDist;\n";
macro3Dsingle = macro3Dsingle + "                            } else if (multiSphereMode == \"Use midpoint of overlapping centrosomes\") {\n";
macro3Dsingle = macro3Dsingle + "                                midX = candidateSumX / candidateCount;\n";
macro3Dsingle = macro3Dsingle + "                                midY = candidateSumY / candidateCount;\n";
macro3Dsingle = macro3Dsingle + "                                midZ = candidateSumZ / candidateCount;\n";
macro3Dsingle = macro3Dsingle + "                                dx = satXAssign + (-1 * midX);\n";
macro3Dsingle = macro3Dsingle + "                                dy = satYAssign + (-1 * midY);\n";
macro3Dsingle = macro3Dsingle + "                                dz = satZAssign + (-1 * midZ);\n";
macro3Dsingle = macro3Dsingle + "                                midDist = sqrt(dx * dx + dy * dy + dz * dz);\n";
macro3Dsingle = macro3Dsingle + "                                if (midDist != midDist) midDist = sqrt(dx * dx + dy * dy);\n";
macro3Dsingle = macro3Dsingle + "                                if (midDist != midDist) midDist = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "                                cellID = centIdArr[bestInsideCent];\n";
macro3Dsingle = macro3Dsingle + "                                cellVolume = (4.0 / 3.0) * 3.14159265359 * cellSphereRadius * cellSphereRadius * cellSphereRadius;\n";
macro3Dsingle = macro3Dsingle + "                                assignedCent = \"midpoint\";\n";
macro3Dsingle = macro3Dsingle + "                                insideSphere = 1;\n";
macro3Dsingle = macro3Dsingle + "                                assignedDist = midDist;\n";
macro3Dsingle = macro3Dsingle + "                            } else {\n";
macro3Dsingle = macro3Dsingle + "                                cellID = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "                                cellVolume = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "                                assignedCent = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "                                insideSphere = 0;\n";
macro3Dsingle = macro3Dsingle + "                                assignedDist = \"NaN\";\n";
macro3Dsingle = macro3Dsingle + "                            }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                            if (insideSphere == 1 || outsideSphereMode == \"Keep as Cell_ID NaN\") {\n";
macro3Dsingle = macro3Dsingle + "                                cleanWithDistanceTxt = cleanWithDistanceTxt + metricLine + sep + nearestID + sep + nearestDist + sep + cellID + sep + cellVolume + sep + assignedCent + sep + insideSphere + sep + assignedDist + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "                            }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                        } else if (cellAssignmentMode == \"Membrane marker - 2D projected ROI\" || cellAssignmentMode == \"Cytoplasmic signal boundary - 2D projected ROI\") {\n";
macro3Dsingle = macro3Dsingle + "                            cellID = satCellID2D[distanceRowIndex];\n";
macro3Dsingle = macro3Dsingle + "                            if (cellID < 0) { cellID = \"NaN\"; insideCell2D = 0; cellAreaValue = \"NaN\"; cellVolumeValue = \"NaN\"; assignedCent = \"Ignored_multi_centrosome_cell\"; assignedDist = \"NaN\"; }\n";
macro3Dsingle = macro3Dsingle + "                            else if (cellID > 0) { insideCell2D = 1; cellAreaValue = satCellArea2D[distanceRowIndex]; cellVolumeValue = satCellVolume2D[distanceRowIndex]; assignedCent = satAssignedCent2D[distanceRowIndex]; assignedDist = satAssignedCentDist2D[distanceRowIndex]; }\n";
macro3Dsingle = macro3Dsingle + "                            else { cellID = \"NaN\"; insideCell2D = 0; cellAreaValue = \"NaN\"; cellVolumeValue = \"NaN\"; assignedCent = \"NaN\"; assignedDist = \"NaN\"; }\n";
macro3Dsingle = macro3Dsingle + "                            if (insideCell2D == 1 || exportOutsideMode == \"Whole image - export outside as Cell_ID NaN\") {\n";
macro3Dsingle = macro3Dsingle + "                                cleanWithDistanceTxt = cleanWithDistanceTxt + metricLine + sep + nearestID + sep + nearestDist + sep + cellID + sep + cellAreaValue + sep + cellVolumeValue + sep + assignedCent + sep + insideCell2D + sep + assignedDist + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "                            }\n";
macro3Dsingle = macro3Dsingle + "                        } else if (cellAssignmentMode == \"Membrane marker - true 3D volume\" || cellAssignmentMode == \"Cytoplasmic signal boundary - true 3D volume\") {\n";
macro3Dsingle = macro3Dsingle + "                            cellID = satCellID3D[distanceRowIndex];\n";
macro3Dsingle = macro3Dsingle + "                            if (cellID < 0) { cellID = \"NaN\"; insideCellVol = 0; cellVolValue = \"NaN\"; assignedCent = \"Ignored_multi_centrosome_cell\"; assignedDist = \"NaN\"; }\n";
macro3Dsingle = macro3Dsingle + "                            else if (cellID > 0) { insideCellVol = 1; cellVolValue = satCellVolume3D[distanceRowIndex]; assignedCent = satAssignedCent3D[distanceRowIndex]; assignedDist = satAssignedCentDist3D[distanceRowIndex]; }\n";
macro3Dsingle = macro3Dsingle + "                            else { cellID = \"NaN\"; insideCellVol = 0; cellVolValue = \"NaN\"; assignedCent = \"NaN\"; assignedDist = \"NaN\"; }\n";
macro3Dsingle = macro3Dsingle + "                            if (insideCellVol == 1 || exportOutsideMode == \"Whole image - export outside as Cell_ID NaN\") {\n";
macro3Dsingle = macro3Dsingle + "                                cleanWithDistanceTxt = cleanWithDistanceTxt + metricLine + sep + nearestID + sep + nearestDist + sep + cellID + sep + cellVolValue + sep + assignedCent + sep + insideCellVol + sep + assignedDist + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "                            }\n";
macro3Dsingle = macro3Dsingle + "                        } else {\n";
macro3Dsingle = macro3Dsingle + "                            cleanWithDistanceTxt = cleanWithDistanceTxt + metricLine + sep + nearestID + sep + nearestDist + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "                        }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                        distanceRowIndex = distanceRowIndex + 1;\n";
macro3Dsingle = macro3Dsingle + "                    }\n";
macro3Dsingle = macro3Dsingle + "                }\n";
macro3Dsingle = macro3Dsingle + "            }\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        File.saveString(cleanWithDistanceTxt, resultsPath);\n";
macro3Dsingle = macro3Dsingle + "        excelTsvTxt = replace(cleanWithDistanceTxt, \",\", \"\\t\");\n";

macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        if (saveQCImages && cellAssignmentMode == \"Centrosome-centered sphere\" && centrosomeCount > 0) {\n";
macro3Dsingle = macro3Dsingle + "            sphereRadiusPixX = cellSphereRadius / pixelWidth;\n";
macro3Dsingle = macro3Dsingle + "            sphereDiameterPix = sphereRadiusPixX * 2;\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "            centReviewQCPath = qcDir + runID + \"_centrosome_BGsubtracted_max_projection_for_review.tif\";\n";
macro3Dsingle = macro3Dsingle + "            if (File.exists(centReviewQCPath)) {\n";
macro3Dsingle = macro3Dsingle + "                open(centReviewQCPath);\n";
macro3Dsingle = macro3Dsingle + "                rename(\"SQ3D_cell_sphere_overlay_QC\");\n";
macro3Dsingle = macro3Dsingle + "                run(\"RGB Color\");\n";
macro3Dsingle = macro3Dsingle + "                setFont(\"SansSerif\", 16, \"bold antialiased\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                for (c = 0; c < centrosomeCount; c++) {\n";
macro3Dsingle = macro3Dsingle + "                    cxPixSphere = centXArr[c] / pixelWidth;\n";
macro3Dsingle = macro3Dsingle + "                    cyPixSphere = centYArr[c] / pixelHeight;\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                    setLineWidth(4);\n";
macro3Dsingle = macro3Dsingle + "                    setColor(0, 255, 255);\n";
macro3Dsingle = macro3Dsingle + "                    makeOval(cxPixSphere - sphereRadiusPixX, cyPixSphere - sphereRadiusPixX, sphereDiameterPix, sphereDiameterPix);\n";
macro3Dsingle = macro3Dsingle + "                    if (selectionType() != -1) run(\"Draw\", \"slice\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                    setColor(0, 0, 0);\n";
macro3Dsingle = macro3Dsingle + "                    drawString(\"Cell \" + centIdArr[c], cxPixSphere + 7, cyPixSphere - 7);\n";
macro3Dsingle = macro3Dsingle + "                    drawString(\"Cell \" + centIdArr[c], cxPixSphere + 5, cyPixSphere - 9);\n";
macro3Dsingle = macro3Dsingle + "                    setColor(255, 255, 0);\n";
macro3Dsingle = macro3Dsingle + "                    drawString(\"Cell \" + centIdArr[c], cxPixSphere + 6, cyPixSphere - 8);\n";
macro3Dsingle = macro3Dsingle + "                }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                saveAs(\"Tiff\", qcDir + runID + \"_cell_sphere_overlay_on_centrosome_projection.tif\");\n";
macro3Dsingle = macro3Dsingle + "                close();\n";
macro3Dsingle = macro3Dsingle + "            }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "            newImage(\"SQ3D_cell_sphere_mask_projection\", \"8-bit black\", width, height, 1);\n";
macro3Dsingle = macro3Dsingle + "            setFont(\"SansSerif\", 16, \"bold antialiased\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "            for (c = 0; c < centrosomeCount; c++) {\n";
macro3Dsingle = macro3Dsingle + "                cxPixSphere = centXArr[c] / pixelWidth;\n";
macro3Dsingle = macro3Dsingle + "                cyPixSphere = centYArr[c] / pixelHeight;\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "                setLineWidth(4);\n";
macro3Dsingle = macro3Dsingle + "                setColor(255);\n";
macro3Dsingle = macro3Dsingle + "                makeOval(cxPixSphere - sphereRadiusPixX, cyPixSphere - sphereRadiusPixX, sphereDiameterPix, sphereDiameterPix);\n";
macro3Dsingle = macro3Dsingle + "                if (selectionType() != -1) run(\"Draw\", \"slice\");\n";
macro3Dsingle = macro3Dsingle + "                drawString(\"Cell \" + centIdArr[c], cxPixSphere + 6, cyPixSphere - 8);\n";
macro3Dsingle = macro3Dsingle + "            }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "            saveAs(\"Tiff\", qcDir + runID + \"_cell_sphere_mask_projection.tif\");\n";
macro3Dsingle = macro3Dsingle + "            close();\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "    } else if (centrosomeChannel > 0) {\n";
macro3Dsingle = macro3Dsingle + "        diagTxt = \"Nearest centrosome columns were not added to the clean satellite table.\\n\";\n";
macro3Dsingle = macro3Dsingle + "        diagTxt = diagTxt + \"Satellite haveXY: \" + haveXY + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "        diagTxt = diagTxt + \"Satellite haveXYZ: \" + haveXYZ + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "        diagTxt = diagTxt + \"Satellite X column index: \" + xCol + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "        diagTxt = diagTxt + \"Satellite Y column index: \" + yCol + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "        diagTxt = diagTxt + \"Satellite Z column index: \" + zCol + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "        diagTxt = diagTxt + \"Centrosome haveXYZ: \" + centHaveXYZ + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "        diagTxt = diagTxt + \"Satellite count: \" + satCount + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "        diagTxt = diagTxt + \"Centrosome count: \" + centrosomeCount + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "        diagTxt = diagTxt + \"Clean satellite table path: \" + resultsPath + \"\\n\";\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "    }\n";
macro3Dsingle = macro3Dsingle + "}\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "// -------------------------------------------------------------------------\n";
macro3Dsingle = macro3Dsingle + "// -------------------------------------------------------------------------\n";
macro3Dsingle = macro3Dsingle + "// Primary-cilium detection/review for 3D source data: 2D max-Z projection, after centrosomes and before cell boundaries\n";
macro3Dsingle = macro3Dsingle + "// Length is the calibrated longest-shortest-path along the skeletonized signal.\n";
macro3Dsingle = macro3Dsingle + "ciliumQuantPath = outputDir + runID + \"_CiliumQuantification.csv\";\n";
macro3Dsingle = macro3Dsingle + "ciliumCellSummaryPath = outputDir + runID + \"_CiliumCellSummary.csv\";\n";
macro3Dsingle = macro3Dsingle + "ciliumSkeletonPath = outputDir + runID + \"_CiliumSkeletonPoints.csv\";\n";
macro3Dsingle = macro3Dsingle + "ciliumCount = 0;\n";
macro3Dsingle = macro3Dsingle + "cLen = newArray(0); cX = newArray(0); cY = newArray(0); cZ = newArray(0); cCell = newArray(0); cPath = newArray(0);\n";
macro3Dsingle = macro3Dsingle + "if (ciliumChannel > 0) {\n";
macro3Dsingle = macro3Dsingle + "    ciliumDetectionAccepted = false;\n";
macro3Dsingle = macro3Dsingle + "    ciliumShowSettings = false;\n";
macro3Dsingle = macro3Dsingle + "    while (ciliumDetectionAccepted == false) {\n";
macro3Dsingle = macro3Dsingle + "        if (ciliumShowSettings) {\n";
macro3Dsingle = macro3Dsingle + "            Dialog.create(\"SatelliteQ 3D - Change primary cilium settings (2D max projection)\");\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addMessage(\"Change settings and re-detect from the original cilium channel. Only cilia whose measured skeleton path length is inside the selected range will be shown for review.\");\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addNumber(\"Cilium rolling ball radius, pixels:\", ciliumRollingBall);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addNumber(\"Cilium Gaussian sigma, pixels:\", ciliumGaussianSigma);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addChoice(\"Cilium intensity threshold mode:\", newArray(\"Mean + SD multiplier\", \"Percent of image maximum\", \"Manual value\"), ciliumThresholdMode);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addNumber(\"Mean + SD multiplier:\", ciliumSDMultiplier);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addNumber(\"Percent of image maximum:\", ciliumPercentMax);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addNumber(\"Manual cilium intensity threshold, AU:\", ciliumManualThreshold);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addNumber(\"Minimum accepted cilium path length, micrometers:\", ciliumMinLength);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.addNumber(\"Maximum accepted cilium path length, micrometers:\", ciliumMaxLength);\n";
macro3Dsingle = macro3Dsingle + "            Dialog.show();\n";
macro3Dsingle = macro3Dsingle + "            ciliumRollingBall = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "            ciliumGaussianSigma = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "            ciliumThresholdMode = Dialog.getChoice();\n";
macro3Dsingle = macro3Dsingle + "            ciliumSDMultiplier = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "            ciliumPercentMax = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "            ciliumManualThreshold = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "            ciliumMinLength = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "            ciliumMaxLength = Dialog.getNumber();\n";
macro3Dsingle = macro3Dsingle + "            if (ciliumRollingBall < 0) ciliumRollingBall = 0;\n";
macro3Dsingle = macro3Dsingle + "            if (ciliumGaussianSigma < 0) ciliumGaussianSigma = 0;\n";
macro3Dsingle = macro3Dsingle + "            if (ciliumMinLength < 0) ciliumMinLength = 0;\n";
macro3Dsingle = macro3Dsingle + "            if (ciliumMaxLength <= ciliumMinLength) ciliumMaxLength = ciliumMinLength + 0.001;\n";
macro3Dsingle = macro3Dsingle + "            ciliationLengthThreshold = ciliumMinLength;\n";
macro3Dsingle = macro3Dsingle + "        }\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"Cilium_Projection\")) { selectWindow(\"Cilium_Projection\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"Cilium_BackgroundSubtracted\")) { selectWindow(\"Cilium_BackgroundSubtracted\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"Cilium_Filtered\")) { selectWindow(\"Cilium_Filtered\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"Cilium_BinaryMask\")) { selectWindow(\"Cilium_BinaryMask\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"Cilium_ReviewSelectionMask\")) { selectWindow(\"Cilium_ReviewSelectionMask\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"Cilium_FinalMask\")) { selectWindow(\"Cilium_FinalMask\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"Cilium_AutoSelectionMask\")) { selectWindow(\"Cilium_AutoSelectionMask\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"Cilium_ManualAdditionMask\")) { selectWindow(\"Cilium_ManualAdditionMask\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"Cilium_AutoFinalMask\")) { selectWindow(\"Cilium_AutoFinalMask\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        roiManager(\"Reset\"); run(\"Clear Results\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        if (isOpen(\"SQ3D_Cilium_Channel\")) { selectWindow(\"SQ3D_Cilium_Channel\"); setOption(\"Changes\", false); close(); }\n";
macro3Dsingle = macro3Dsingle + "        selectWindow(originalTitle);\n";
macro3Dsingle = macro3Dsingle + "        Stack.setChannel(ciliumChannel);\n";
macro3Dsingle = macro3Dsingle + "        run(\"Duplicate...\", \"title=SQ3D_Cilium_Channel duplicate channels=\" + ciliumChannel);\n";
macro3Dsingle = macro3Dsingle + "        selectWindow(\"SQ3D_Cilium_Channel\"); getDimensions(cilW3, cilH3, cilC3, cilZ3, cilT3);\n";
macro3Dsingle = macro3Dsingle + "        if (cilZ3 > 1) { run(\"Z Project...\", \"projection=[Max Intensity]\"); rename(\"Cilium_Projection\"); } else { run(\"Duplicate...\", \"title=Cilium_Projection\"); }\n";
macro3Dsingle = macro3Dsingle + "        ciliumProjection = \"Cilium_Projection\";\n";
macro3Dsingle = macro3Dsingle + "        selectWindow(ciliumProjection); run(\"Select None\"); run(\"Duplicate...\", \"title=Cilium_BackgroundSubtracted\");\n";
macro3Dsingle = macro3Dsingle + "        selectWindow(\"Cilium_BackgroundSubtracted\");\n";
macro3Dsingle = macro3Dsingle + "        if (ciliumRollingBall > 0) run(\"Subtract Background...\", \"rolling=\" + ciliumRollingBall);\n";
macro3Dsingle = macro3Dsingle + "        run(\"Duplicate...\", \"title=Cilium_Filtered\");\n";
macro3Dsingle = macro3Dsingle + "        selectWindow(\"Cilium_Filtered\");\n";
macro3Dsingle = macro3Dsingle + "        if (ciliumGaussianSigma > 0) run(\"Gaussian Blur...\", \"sigma=\" + ciliumGaussianSigma);\n";
macro3Dsingle = macro3Dsingle + "        getStatistics(cilArea, cilMean, cilMin, cilMax, cilStd);\n";
macro3Dsingle = macro3Dsingle + "        if (ciliumThresholdMode == \"Mean + SD multiplier\") ciliumThresholdValue = cilMean + ciliumSDMultiplier * cilStd;\n";
macro3Dsingle = macro3Dsingle + "        else if (ciliumThresholdMode == \"Percent of image maximum\") ciliumThresholdValue = cilMax * ciliumPercentMax / 100;\n";
macro3Dsingle = macro3Dsingle + "        else ciliumThresholdValue = ciliumManualThreshold;\n";
macro3Dsingle = macro3Dsingle + "        setThreshold(ciliumThresholdValue, cilMax);\n";
macro3Dsingle = macro3Dsingle + "        setOption(\"BlackBackground\", false); run(\"Convert to Mask\"); rename(\"Cilium_BinaryMask\"); run(\"8-bit\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        roiManager(\"Reset\"); run(\"Clear Results\");\n";
macro3Dsingle = macro3Dsingle + "        run(\"Set Measurements...\", \"area centroid redirect=None decimal=3\");\n";
macro3Dsingle = macro3Dsingle + "        selectWindow(\"Cilium_BinaryMask\"); run(\"Analyze Particles...\", \"size=0-Infinity show=Nothing clear add\");\n";
macro3Dsingle = macro3Dsingle + "        ciliumRawCandidateCount = roiManager(\"count\");\n";
macro3Dsingle = macro3Dsingle + "\n";
macro3Dsingle = macro3Dsingle + "        // Measure skeleton path lengths BEFORE review, then remove out-of-range ROIs.\n";
macro3Dsingle = macro3Dsingle + "        ciliumPreSerialized = \"\";\n";
macro3Dsingle = macro3Dsingle + "        if (ciliumRawCandidateCount > 0) ciliumPreSerialized = sqCiliumSkeletonSerialized(\"Cilium_BinaryMask\", false, pixelWidth, pixelHeight, voxelDepth, unit, ciliumSkeletonSigma);\n";
macro3Dsingle = macro3Dsingle + "        if (startsWith(ciliumPreSerialized, \"Error\") || indexOf(ciliumPreSerialized, \"Exception\") >= 0) { showMessage(\"Cilium skeleton analysis warning\", \"AnalyzeSkeleton could not return cilium lengths.\\n\\n\" + ciliumPreSerialized); ciliumPreSerialized = \"\"; }\n";
macro3Dsingle = macro3Dsingle + "        if (lengthOf(ciliumPreSerialized) > 0) ciliumPreParts = split(ciliumPreSerialized, \"#\"); else ciliumPreParts = newArray(0);\n";
macro3Dsingle = macro3Dsingle + "        for (ri = roiManager(\"count\") - 1; ri >= 0; ri--) {\n";
macro3Dsingle = macro3Dsingle + "            roiManager(\"Select\", ri);\n";
macro3Dsingle = macro3Dsingle + "            keepLengthROI = false;\n";
macro3Dsingle = macro3Dsingle + "            for (ti = 0; ti < ciliumPreParts.length; ti++) {\n";
macro3Dsingle = macro3Dsingle + "                tfi = split(ciliumPreParts[ti], \"~\");\n";
macro3Dsingle = macro3Dsingle + "                if (tfi.length >= 5) {\n";
macro3Dsingle = macro3Dsingle + "                    tlen0 = parseFloat(tfi[1]);\n";
macro3Dsingle = macro3Dsingle + "                    if (tlen0 >= ciliumMinLength && tlen0 <= ciliumMaxLength) {\n";
macro3Dsingle = macro3Dsingle + "                        treeTouchesROI = false;\n";
macro3Dsingle = macro3Dsingle + "                        if (tfi.length >= 6) {\n";
macro3Dsingle = macro3Dsingle + "                            tpts = split(tfi[5], \";\");\n";
macro3Dsingle = macro3Dsingle + "                            for (tpi = 0; tpi < tpts.length; tpi++) {\n";
macro3Dsingle = macro3Dsingle + "                                txyz = split(tpts[tpi], \":\");\n";
macro3Dsingle = macro3Dsingle + "                                if (txyz.length >= 2) {\n";
macro3Dsingle = macro3Dsingle + "                                    if (safeSelectionContains(parseFloat(txyz[0]) / pixelWidth, parseFloat(txyz[1]) / pixelHeight)) { treeTouchesROI = true; tpi = tpts.length; }\n";
macro3Dsingle = macro3Dsingle + "                                }\n";
macro3Dsingle = macro3Dsingle + "                            }\n";
macro3Dsingle = macro3Dsingle + "                        } else {\n";
