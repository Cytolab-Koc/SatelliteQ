macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "satNearestCentID = newArray(satelliteCount);\n";
macroTL = macroTL + "satNearestCentX = newArray(satelliteCount);\n";
macroTL = macroTL + "satNearestCentY = newArray(satelliteCount);\n";
macroTL = macroTL + "satNearestCentDistance = newArray(satelliteCount);\n";
macroTL = macroTL + "satAssignedCentLabel = newArray(satelliteCount);\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "for (i = 0; i < satelliteCount; i++) {\n";
macroTL = macroTL + "    satNearestCentID[i] = 0;\n";
macroTL = macroTL + "    satNearestCentX[i] = \"NA\";\n";
macroTL = macroTL + "    satNearestCentY[i] = \"NA\";\n";
macroTL = macroTL + "    satNearestCentDistance[i] = \"NA\";\n";
macroTL = macroTL + "    satAssignedCentLabel[i] = \"NA\";\n";
macroTL = macroTL + "}\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "// Primary-cilium detection/review (2D) - after centrosomes, before cell boundaries\n";
macroTL = macroTL + "// Length is the calibrated longest-shortest-path along the skeletonized signal.\n";
macroTL = macroTL + "ciliumQuantPath = outputDir + runID + \"_CiliumQuantification.csv\";\n";
macroTL = macroTL + "ciliumCellSummaryPath = outputDir + runID + \"_CiliumCellSummary.csv\";\n";
macroTL = macroTL + "ciliumSkeletonPath = outputDir + runID + \"_CiliumSkeletonPoints.csv\";\n";
macroTL = macroTL + "ciliumCount = 0;\n";
macroTL = macroTL + "cLen = newArray(0); cX = newArray(0); cY = newArray(0); cZ = newArray(0); cCell = newArray(0); cPath = newArray(0);\n";
macroTL = macroTL + "if (ciliumChannel > 0) {\n";
macroTL = macroTL + "    ciliumDetectionAccepted = false;\n";
macroTL = macroTL + "    ciliumShowSettings = false;\n";
macroTL = macroTL + "    while (ciliumDetectionAccepted == false) {\n";
macroTL = macroTL + "        if (ciliumShowSettings) {\n";
macroTL = macroTL + "            Dialog.create(\"SatelliteQ 2D - Change primary cilium settings\");\n";
macroTL = macroTL + "            Dialog.addMessage(\"Change settings and re-detect from the original cilium channel. Only cilia whose measured skeleton path length is inside the selected range will be shown for review.\");\n";
macroTL = macroTL + "            Dialog.addNumber(\"Cilium rolling ball radius, pixels:\", ciliumRollingBall);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Cilium Gaussian sigma, pixels:\", ciliumGaussianSigma);\n";
macroTL = macroTL + "            Dialog.addChoice(\"Cilium intensity threshold mode:\", newArray(\"Mean + SD multiplier\", \"Percent of image maximum\", \"Manual value\"), ciliumThresholdMode);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Mean + SD multiplier:\", ciliumSDMultiplier);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Percent of image maximum:\", ciliumPercentMax);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Manual cilium intensity threshold, AU:\", ciliumManualThreshold);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Minimum accepted cilium path length, micrometers:\", ciliumMinLength);\n";
macroTL = macroTL + "            Dialog.addNumber(\"Maximum accepted cilium path length, micrometers:\", ciliumMaxLength);\n";
macroTL = macroTL + "            Dialog.show();\n";
macroTL = macroTL + "            ciliumRollingBall = Dialog.getNumber();\n";
macroTL = macroTL + "            ciliumGaussianSigma = Dialog.getNumber();\n";
macroTL = macroTL + "            ciliumThresholdMode = Dialog.getChoice();\n";
macroTL = macroTL + "            ciliumSDMultiplier = Dialog.getNumber();\n";
macroTL = macroTL + "            ciliumPercentMax = Dialog.getNumber();\n";
macroTL = macroTL + "            ciliumManualThreshold = Dialog.getNumber();\n";
macroTL = macroTL + "            ciliumMinLength = Dialog.getNumber();\n";
macroTL = macroTL + "            ciliumMaxLength = Dialog.getNumber();\n";
macroTL = macroTL + "            if (ciliumRollingBall < 0) ciliumRollingBall = 0;\n";
macroTL = macroTL + "            if (ciliumGaussianSigma < 0) ciliumGaussianSigma = 0;\n";
macroTL = macroTL + "            if (ciliumMinLength < 0) ciliumMinLength = 0;\n";
macroTL = macroTL + "            if (ciliumMaxLength <= ciliumMinLength) ciliumMaxLength = ciliumMinLength + 0.001;\n";
macroTL = macroTL + "            ciliationLengthThreshold = ciliumMinLength;\n";
macroTL = macroTL + "        }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        if (isOpen(\"Cilium_Projection\")) { selectWindow(\"Cilium_Projection\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"Cilium_BackgroundSubtracted\")) { selectWindow(\"Cilium_BackgroundSubtracted\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"Cilium_Filtered\")) { selectWindow(\"Cilium_Filtered\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"Cilium_BinaryMask\")) { selectWindow(\"Cilium_BinaryMask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"Cilium_ReviewSelectionMask\")) { selectWindow(\"Cilium_ReviewSelectionMask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"Cilium_FinalMask\")) { selectWindow(\"Cilium_FinalMask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"Cilium_AutoSelectionMask\")) { selectWindow(\"Cilium_AutoSelectionMask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"Cilium_ManualAdditionMask\")) { selectWindow(\"Cilium_ManualAdditionMask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        if (isOpen(\"Cilium_AutoFinalMask\")) { selectWindow(\"Cilium_AutoFinalMask\"); setOption(\"Changes\", false); close(); }\n";
macroTL = macroTL + "        roiManager(\"Reset\"); run(\"Clear Results\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        ciliumProjection = projectChannel(ciliumChannel, originalTitle, \"Max Intensity\", \"Cilium_Projection\", slices);\n";
macroTL = macroTL + "        selectWindow(ciliumProjection); run(\"Select None\"); run(\"Duplicate...\", \"title=Cilium_BackgroundSubtracted\");\n";
macroTL = macroTL + "        selectWindow(\"Cilium_BackgroundSubtracted\");\n";
macroTL = macroTL + "        if (ciliumRollingBall > 0) run(\"Subtract Background...\", \"rolling=\" + ciliumRollingBall);\n";
macroTL = macroTL + "        run(\"Duplicate...\", \"title=Cilium_Filtered\");\n";
macroTL = macroTL + "        selectWindow(\"Cilium_Filtered\");\n";
macroTL = macroTL + "        if (ciliumGaussianSigma > 0) run(\"Gaussian Blur...\", \"sigma=\" + ciliumGaussianSigma);\n";
macroTL = macroTL + "        getStatistics(cilArea, cilMean, cilMin, cilMax, cilStd);\n";
macroTL = macroTL + "        if (ciliumThresholdMode == \"Mean + SD multiplier\") ciliumThresholdValue = cilMean + ciliumSDMultiplier * cilStd;\n";
macroTL = macroTL + "        else if (ciliumThresholdMode == \"Percent of image maximum\") ciliumThresholdValue = cilMax * ciliumPercentMax / 100;\n";
macroTL = macroTL + "        else ciliumThresholdValue = ciliumManualThreshold;\n";
macroTL = macroTL + "        setThreshold(ciliumThresholdValue, cilMax);\n";
macroTL = macroTL + "        setOption(\"BlackBackground\", false); run(\"Convert to Mask\"); rename(\"Cilium_BinaryMask\"); run(\"8-bit\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        roiManager(\"Reset\"); run(\"Clear Results\");\n";
macroTL = macroTL + "        run(\"Set Measurements...\", \"area centroid redirect=None decimal=3\");\n";
macroTL = macroTL + "        selectWindow(\"Cilium_BinaryMask\"); run(\"Analyze Particles...\", \"size=0-Infinity show=Nothing clear add\");\n";
macroTL = macroTL + "        ciliumRawCandidateCount = roiManager(\"count\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "        // Measure skeleton path lengths BEFORE review, then remove out-of-range ROIs.\n";
macroTL = macroTL + "        ciliumPreSerialized = \"\";\n";
macroTL = macroTL + "        if (ciliumRawCandidateCount > 0) ciliumPreSerialized = sqCiliumSkeletonSerialized(\"Cilium_BinaryMask\", false, pixelWidth, pixelHeight, voxelDepth, unit, ciliumSkeletonSigma);\n";
macroTL = macroTL + "        if (startsWith(ciliumPreSerialized, \"Error\") || indexOf(ciliumPreSerialized, \"Exception\") >= 0) { showMessage(\"Cilium skeleton analysis warning\", \"AnalyzeSkeleton could not return cilium lengths.\\n\\n\" + ciliumPreSerialized); ciliumPreSerialized = \"\"; }\n";
macroTL = macroTL + "        if (lengthOf(ciliumPreSerialized) > 0) ciliumPreParts = split(ciliumPreSerialized, \"#\"); else ciliumPreParts = newArray(0);\n";
macroTL = macroTL + "        for (ri = roiManager(\"count\") - 1; ri >= 0; ri--) {\n";
macroTL = macroTL + "            roiManager(\"Select\", ri);\n";
macroTL = macroTL + "            keepLengthROI = false;\n";
macroTL = macroTL + "            for (ti = 0; ti < ciliumPreParts.length; ti++) {\n";
macroTL = macroTL + "                tfi = split(ciliumPreParts[ti], \"~\");\n";
macroTL = macroTL + "                if (tfi.length >= 5) {\n";
macroTL = macroTL + "                    tlen0 = parseFloat(tfi[1]);\n";
macroTL = macroTL + "                    if (tlen0 >= ciliumMinLength && tlen0 <= ciliumMaxLength) {\n";
macroTL = macroTL + "                        treeTouchesROI = false;\n";
macroTL = macroTL + "                        if (tfi.length >= 6) {\n";
macroTL = macroTL + "                            tpts = split(tfi[5], \";\");\n";
macroTL = macroTL + "                            for (tpi = 0; tpi < tpts.length; tpi++) {\n";
macroTL = macroTL + "                                txyz = split(tpts[tpi], \":\");\n";
macroTL = macroTL + "                                if (txyz.length >= 2) {\n";
macroTL = macroTL + "                                    if (safeSelectionContains(parseFloat(txyz[0]) / pixelWidth, parseFloat(txyz[1]) / pixelHeight)) { treeTouchesROI = true; tpi = tpts.length; }\n";
macroTL = macroTL + "                                }\n";
macroTL = macroTL + "                            }\n";
macroTL = macroTL + "                        } else {\n";
