macroTL = macroTL + "                }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "                saveAs(\"Tiff\", qcDir + runID + \"_cell_sphere_overlay_on_centrosome_projection.tif\");\n";
macroTL = macroTL + "                close();\n";
macroTL = macroTL + "            }\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "            newImage(\"SQ3D_cell_sphere_mask_projection\", \"8-bit black\", width, height, 1);\n";
macroTL = macroTL + "            setFont(\"SansSerif\", 16, \"bold antialiased\");\n";
macroTL = macroTL + "\n";
macroTL = macroTL + "            for (c = 0; c < centrosomeCount; c++) {\n";
macroTL = macroTL + "                cxPixSphere = centXArr[c] / pixelWidth;\n";
